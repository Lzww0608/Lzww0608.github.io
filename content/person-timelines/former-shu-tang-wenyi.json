  "personId": "former-shu-tang-wenyi",
  "events": [
    {
      "id": "former-shu-tang-wenyi-promote-zongyan-heir",
      "title": "参与促立郑王宗衍为太子",
      "summary": "徐贤妃欲立其子郑王，通过唐文扆讽张格上表；新史又记徐妃与唐文扆教相者称郑王相贵，宗衍由此得立。",
      "year": 913,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "乾化三年冬十月甲午为立储结果日，促立过程未独日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p135",
          "originalRevision": 1,
          "originalSha256": "1d1e6375a17962135f1e433ee56cdca09ace453239cbd286f50fa88f25fb49da",
          "excerpt": "鄭王宗衍最幼，其母徐賢妃有寵，欲立其子，使飛龍使唐文扆諷張格上表請立宗衍。"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p135",
          "originalRevision": 1,
          "originalSha256": "1d1e6375a17962135f1e433ee56cdca09ace453239cbd286f50fa88f25fb49da",
          "excerpt": "蜀主以為眾人實欲立宗衍，不得已許之，曰：「宗衍幼懦，能堪其任乎？」甲午，立宗衍為太子。"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p89",
          "originalRevision": 1,
          "originalSha256": "7699b55dd3825075074cb4b6c7cb251762d1b58e2f40c9680cf3f0adfa5d0808",
          "excerpt": "太祖神武元聖孝皇帝下乾化三年（癸酉，公元九一三年）"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p134",
          "originalRevision": 1,
          "originalSha256": "36f88cafbc9cea610c9b854f2cc1f7d7568457da4c14c0648932b4e8d8deac63",
          "excerpt": "冬，十月，己巳朔，燕主守光帥眾五千夜出，將入檀州。"
        },
        {
          "chapterId": "new-v63",
          "paragraphId": "new-v63-p26",
          "originalRevision": 1,
          "originalSha256": "9aaa00b98ba1c38757a99c77e10bc0580e25c00c50382ffa559f0c375f2b8f01",
          "excerpt": "而徐妃專寵，建老昏耄，妃與宦者唐文扆教相者上言衍相最貴，又諷宰相張格贊成之，衍由是得為太子。"
        }
      ],
      "notes": [
        "913限定元膺败亡后至立储的过程；不把请托、送金、教相者和张格上表都定在甲午。",
        "纪年标头沿用太祖尊号的排版差别保留，不据此把本事归朱温在位期。"
      ],
      "variants": [
        {
          "label": "张格传的送金与本纪夹引之别",
          "sourceDate": "元膺之变后、郑王立储前，未独记送金日",
          "summary": "张格传记徐贤妃暗令唐文扆持金百镒赠格；卷37夹引《幸蜀记》作徐氏赠金而不另叙经手人。两种叙法各存，不以同源引述凑独立见证。",
          "evidence": [
            {
              "chapterId": "shiguochunqiu-v041",
              "paragraphId": "shiguochunqiu-v041-p7",
              "originalRevision": 1,
              "originalSha256": "2d5dc3b8342a46108efff1171e39f1193f189b53de2f2fdf19c730cb5889beed",
              "excerpt": "居無何，太子元膺之變起，時後主封鄭王，年最幼，而順聖太后爲賢妃，有寵，陰令飛龍使唐文扆以金百鎰貽格，諷格請立鄭王爲皇太子。"
            },
            {
              "chapterId": "shiguochunqiu-v037",
              "paragraphId": "shiguochunqiu-v037-p2",
              "originalRevision": 1,
              "originalSha256": "9cdbcc2d669062d71a3627011d4abb08ed7ea7a181553dcb9bc54e9c21a44b0b",
              "excerpt": "〈宋居白幸蜀記云：衍母徐氏以金百鎰遺宰相張格，言上已許衍爲太子，願相公助之。〉"
            }
          ]
        }
      ]
    },
    {
      "id": "former-shu-tang-wenyi-maoyu-slander",
      "title": "与毛文锡争权，借宴乐事谗毁",
      "summary": "唐文扆与张格相附，与毛文锡争权。毛氏拟婚而在枢密院会亲奏乐，唐文扆乘王建询问而谗毁，毛文锡与庾传素随后遭贬。",
      "year": 917,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "贞明三年八月庚寅为毛、庾处分日；谗毁本身未独记日",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p6",
          "originalRevision": 1,
          "originalSha256": "2472791ebecb55fdfac4994c2caf554994943bb13ddca81be55c6f4b9d43fbba",
          "excerpt": "蜀飛龍使唐文扆居中用事，張格附之，與司徒、判樞密院事毛文錫爭權。文錫將以女適左僕射兼中書侍郎、同平章事庾傳素之子，會親族於樞密院用樂，不先表聞，蜀主聞樂聲，怪之，文扆從而譖之。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p6",
          "originalRevision": 1,
          "originalSha256": "2472791ebecb55fdfac4994c2caf554994943bb13ddca81be55c6f4b9d43fbba",
          "excerpt": "八月，庚寅，貶文錫茂州司馬，其子司封員外郎詢流維州，籍沒其家；貶文錫弟翰林學士文晏為榮經尉；傳素罷為工部尚書。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p3",
          "originalRevision": 1,
          "originalSha256": "615f6723868e06a3b70fd0baaa1db794d66159b8dd8ad73562be0769a2f1b9fd",
          "excerpt": "均王中貞明三年（丁丑，公元九一七年）"
        },
        {
          "chapterId": "shiguochunqiu-v041",
          "paragraphId": "shiguochunqiu-v041-p10",
          "originalRevision": 1,
          "originalSha256": "64cdd687506af9f9aafae354b5291fcdffb94312742c3daf45a7aae8976f121c",
          "excerpt": "天漢元年，爲宦者唐文扆所譖，罷爲工部尚書；未幾，改兵部。"
        }
      ],
      "notes": [
        "917是本段政争、宴乐及随后处分的叙次，争权起始未载。庚寅不移作唐文扆任职或每次谗毁日期。",
        "《通鉴》作将以女适；《十国春秋》毛传直接作以女适，不在摘要强合婚礼是否已完。",
        "贬官处分不改写为唐文扆亲自下令。"
      ]
    },
    {
      "id": "former-shu-tang-wenyi-gate-guard-and-pan-mission",
      "title": "派兵守宫门，遣潘在迎侦察",
      "summary": "王建病重时，唐文扆意图排除大臣，派人守宫门，使旧将不得入见，并遣潘在迎侦察外事；潘把谋划告知王宗弼等。",
      "year": 918,
      "sortOrder": 5,
      "precision": "month",
      "sourceDate": "贞明四年五月王建病重的叙次，守门、派遣未独日",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p37",
          "originalRevision": 1,
          "originalSha256": "a9f792e120b0295d9ae8558ad743e7dae1be719fe828fd69241714b7304b3149",
          "excerpt": "內飛龍使唐文扆久典禁兵，參預機密，欲去諸大臣，遣人守宮門。王宗弼等三十餘人日至朝堂，不得入見，文扆屢以蜀主之命慰撫之，伺蜀主殂，即作難。遣其黨內皇城使潘在迎偵察外事，在迎以其謀告宗弼等。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p36",
          "originalRevision": 1,
          "originalSha256": "6b7172315c859f0f9317c24762371ce52562cd132238dd683dce14f16bed5671",
          "excerpt": "以北面行營招討使兼中書令王宗弼沉靜有謀，五月，召還，以為馬步都指揮使。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p24",
          "originalRevision": 1,
          "originalSha256": "ee68389392dd1234dda5e5093d49b82215eeda299163aeec4d4ea53c08b44d54",
          "excerpt": "均王中貞明四年（戊寅，公元九一八年）"
        },
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p10",
          "originalRevision": 1,
          "originalSha256": "c66edb6b604a23e400463f52b771072c04ff971ff61692f2344ebf555cb3f3e1",
          "excerpt": "及高祖疾，以兵入宿衛，謀盡去諸大臣，遣人守宫門。"
        }
      ],
      "notes": [
        "久典禁兵是此前已有职事，不从五月叙次推定始掌兵日。",
        "派人、遣潘与本人亲临、亲自守门分别理解，不增写亲率或亲临。",
        "《九国志》另作谋害宿将；保各书措辞，不一概断言杀害所有大臣已实施。"
      ]
    },
    {
      "id": "former-shu-tang-wenyi-demoted-meizhou",
      "title": "被贬为眉州刺史",
      "summary": "王宗弼等入宫陈述唐文扆之罪后，《通鉴》记丙子日将他贬为眉州刺史；本传也记告罪次日贬眉州。",
      "year": 918,
      "sortOrder": 6,
      "precision": "day",
      "sourceDate": "贞明四年五月丙子；本传作告罪明日",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p37",
          "originalRevision": 1,
          "originalSha256": "a9f792e120b0295d9ae8558ad743e7dae1be719fe828fd69241714b7304b3149",
          "excerpt": "宗弼等排闥入，言文扆之罪，以天冊府掌書記崔延昌權判六軍事，召太子入侍疾。丙子，貶唐文扆為眉州刺史。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p36",
          "originalRevision": 1,
          "originalSha256": "6b7172315c859f0f9317c24762371ce52562cd132238dd683dce14f16bed5671",
          "excerpt": "以北面行營招討使兼中書令王宗弼沉靜有謀，五月，召還，以為馬步都指揮使。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p24",
          "originalRevision": 1,
          "originalSha256": "ee68389392dd1234dda5e5093d49b82215eeda299163aeec4d4ea53c08b44d54",
          "excerpt": "均王中貞明四年（戊寅，公元九一八年）"
        },
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p10",
          "originalRevision": 1,
          "originalSha256": "c66edb6b604a23e400463f52b771072c04ff971ff61692f2344ebf555cb3f3e1",
          "excerpt": "在迎慮事敗，以其謀洩於宗弼，宗弼等排闥入，言文扆欲爲變。明日，貶文扆眉州刺史，未幾削官流雅州。"
        }
      ],
      "notes": [
        "保原书记日，只核准西历年份，不另换写现代确日。眉州任命是处分，不推断他已到任。"
      ]
    },
    {
