  "events": [
    {
      "id": "nantang-li-yu-younger-zhou-wedding",
      "title": "本纪记十一月纳后、立为国后",
      "summary": "马令本纪在开宝元年冬十一月记纳后，陆游本纪同月记立周氏为国后。后妃传另叙纳采以鹅代雁、亲迎围观及次日群臣宴诗；这些步骤的月日没有各自独记，相关命令、议礼与诗讽也各有施事。",
      "year": 968,
      "sortOrder": 0,
      "precision": "month",
      "sourceDate": "本纪开宝元年冬十一月纳后、立后；后妃传礼仪步骤未各记月日",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p9",
          "originalRevision": 1,
          "originalSha256": "ad8887d2d1b3ca9a41d53b113875625fae38d2dc8e18f7f56e3aba702cc1aaa0",
          "excerpt": "至納后，乃成禮而已。翼日，大燕羣臣"
        },
        {
          "chapterId": "nantangma-v006",
          "paragraphId": "nantangma-v006-p9",
          "originalRevision": 1,
          "originalSha256": "82b039bce5c27658fda87123e2654d072ad3e5f3a48c623f87707673f851114f",
          "excerpt": "及親迎民庶觀者或登屋極至有墜瓦而斃者"
        },
        {
          "chapterId": "shiguochunqiu-v017",
          "paragraphId": "shiguochunqiu-v017-p10",
          "originalRevision": 1,
          "originalSha256": "228bb6e9dd9a8d9d98ce6ea8d5ac37e18a3c3e1c308f68c992f4c6f7fc791e94",
          "excerpt": "冬十一月，立周氏爲國后。"
        }
      ],
      "notes": [
        "校鹅字义保疑；徐铉／徐游戏言施事分源，不把戏语写作鬼神致病。",
        "开宝元年十一月整月在西历968年。月份只用于本纪明确记载的纳后、立后终点，不把前一始议范围、全部礼仪步骤或各人行动都定为同月同日。"
      ],
      "variants": [
        {
          "label": "两本纪明记十一月纳后、立后",
          "sourceDate": "开宝元年冬十一月，未独记日",
          "summary": "马令本纪记纳后周氏、昭惠之母弟，陆游本纪同月立国后周氏；以同月正式纳后、立后为纪年依据，女宪传纳采亲迎各步骤未各记月日。",
          "evidence": [
            {
              "chapterId": "nantangma-v005",
              "paragraphId": "nantangma-v005-p6",
              "originalRevision": 1,
              "originalSha256": "c3389d7f808b454b76d79d29c3282278a362d262a9243e408b03e8e7f4d5151b",
              "excerpt": "開寳元年夏江王景逷卒冬十有一月納后周氏昭惠之母弟也"
            },
            {
              "chapterId": "nantanglu-v003",
              "paragraphId": "nantanglu-v003-p10",
              "originalRevision": 1,
              "originalSha256": "fbb084c3eb749b6f48de53403ef70a61db976eec7264be160bdaccfb7dd2db49",
              "excerpt": "冬十一月立國后周氏"
            }
          ],
          "year": 968
        }
      ]
    },
    {
      "id": "nantang-li-yu-younger-zhou-kaishan-buddhist-court-practice",
      "title": "与后主服僧衣诵经拜跪",
      "year": 970,
      "precision": "year",
      "phase": "rule",
      "sourceDate": "开宝三年春叙次，未独记月日",
      "summary": "本纪在继后已立、昭惠及钟后均已卒的叙次，记国主与后着僧衣诵经拜跪；此后对应继后周氏。原书未另记受戒、出家或独立日次。",
      "notes": [
        "本纪“预僧伽帽”字有疑，保存原字并依服饰语境释；不把僧帽袈裟推作正式僧籍。",
        "本段由春叙事转夏四月，仅采用970年，不补某月初一或诵经确日。",
        "《十国春秋》记国主与后服僧衣诵经；马令另载的具体场所、频次及是否同一次仪式未详。"
      ],
      "sortOrder": 0,
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v017",
          "paragraphId": "shiguochunqiu-v017-p12",
          "originalRevision": 1,
          "originalSha256": "e116f0232e52dbd74c20e4144b2afdca164769266521482c8c7715c015d61592",
          "excerpt": "開寶三年，春，命境內崇修佛寺。〈馬令《南唐書》云：建康城中僧徒迨至數千，給稟米緡帛以供之。〉改寶公院爲開善道場，國主與后預僧伽帽衣袈裟，誦佛經，拜跪頓顙，至爲瘤贅。"
        }
      ],
      "variants": [
        {
          "label": "马令另叙宫中精舍和帝后诵经",
          "sourceDate": "开宝三年段，未独记此段仪式月日",
          "summary": "马令另记命崇修佛寺、广署僧尼精舍及国主与后服僧衣诵经拜跪，未在此处写开善道场名称。不足将两书的具体场景确定为一次仪式，保留为来源并列，不据此相加或合并实际仪式次数。",
          "evidence": [
            {
              "chapterId": "nantangma-v005",
              "paragraphId": "nantangma-v005-p6",
              "originalRevision": 1,
              "originalSha256": "c3389d7f808b454b76d79d29c3282278a362d262a9243e408b03e8e7f4d5151b",
              "excerpt": "命境内崇修佛寺又於禁中廣署僧尼精舍多聚徒衆國主與后頂僧伽帽衣袈裟誦佛經拜跪頓顙至為瘤贅由是建康城中僧徒迨至數千給廪米緡帛以供之"
            }
          ]
        }
      ]
    },
    {
