{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "liu-zhiyuan",
  "events": [
    {
      "id": "liu-zhiyuan-birth",
      "title": "生于太原",
      "summary": "母安氏于太原生下刘知远；原书说其先世本为沙陀部人。",
      "year": 895,
      "sortOrder": 0,
      "precision": "day",
      "sourceDate": "唐乾宁二年二月四日",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p1",
          "originalRevision": 1,
          "originalSha256": "c0d85935b9d915427a90e314f51e3ae86d5fe40447ba039ceec9c5bb5668eda8",
          "excerpt": "皇妣吳國太夫人安氏，追謚章懿皇后。後以唐乾寧二年，歲在乙卯，二月四日生帝於太原。"
        }
      ]
    },
    {
      "id": "liu-zhiyuan-weizhou",
      "title": "卫州护石敬瑭并杀闵帝随从",
      "summary": "石敬瑭与出奔的李从厚在卫州相遇，刘知远部署石敢防变，事发后率兵杀死闵帝随从；不是一般护卫任职。",
      "year": 934,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "后唐应顺初；闵帝出奔时",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "new-v10",
          "paragraphId": "new-v10-p2",
          "originalRevision": 1,
          "originalSha256": "d0a7bca880dca54b968f0f28a2b6ad5f91eb8159f1e3b128d3e90ea52134386d",
          "excerpt": "知遠遣勇士石敢袖鐵槌侍高祖以虞變。高祖與愍帝議事未決，左右欲兵之，知遠擁高祖入室，敢與左右格鬬而死，知遠即率兵盡殺愍帝左右，留帝傳舍而去。"
        }
      ],
      "notes": [
        "旧史本纪此处写“唐明宗召赴阙”，与当时明宗已卒的上下文不合，未据此改变人物或时序。"
      ]
    },
    {
      "id": "liu-zhiyuan-taiyuan-coup",
      "title": "参与石敬瑭太原起兵",
      "summary": "刘知远与桑维翰秘密协助石敬瑭谋划，在石敬瑭奉命调镇后支持起兵。",
      "year": 936,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "后唐清泰三年夏",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p3",
          "originalRevision": 1,
          "originalSha256": "626daded44b8e92d9269d15b966b77784138dba30150938331aafadd7a68c258",
          "excerpt": "三年夏，移鎮汶陽。帝勸晉高祖舉義，贊成密計，經綸之始，中外賴之。晉高祖以帝為北京馬步軍都指揮使。"
        },
        {
          "chapterId": "new-v10",
          "paragraphId": "new-v10-p3",
          "originalRevision": 1,
          "originalSha256": "c6a9d2faad7a7a6f2cedb8bbb0176e4cba86e2a396dc160c53b12e7aec605cf8",
          "excerpt": "高祖將舉兵，知遠與桑維翰密為高祖謀畫，贊成之。"
        }
      ]
    },
    {
      "id": "liu-zhiyuan-kill-prisoners",
      "title": "杀晋阳降军",
      "summary": "契丹援军击败张敬达军后，石敬瑭打算将降军编入亲卫，刘知远杀死这一千余人。",
      "year": 936,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "清泰三年；晋阳援战后",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p3",
          "originalRevision": 1,
          "originalSha256": "626daded44b8e92d9269d15b966b77784138dba30150938331aafadd7a68c258",
          "excerpt": "及契丹以全軍赴難，大破張敬達之眾於晉陽城下，有降軍千餘人，晉高祖將置之於親衛，帝盡殺之。"
        }
      ]
    },
    {
      "id": "liu-zhiyuan-jin-military",
      "title": "晋初统禁军并领保义",
      "summary": "后晋建立后任侍卫亲军都虞候，领保义军节度使；入洛阳后奉命巡警都城。",
      "year": 936,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "晋国初建",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "new-v10",
          "paragraphId": "new-v10-p3",
          "originalRevision": 1,
          "originalSha256": "c6a9d2faad7a7a6f2cedb8bbb0176e4cba86e2a396dc160c53b12e7aec605cf8",
          "excerpt": "高祖即位於太原，以知遠為侍衞親軍都虞候，領保義軍節度使。"
        },
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p3",
          "originalRevision": 1,
          "originalSha256": "626daded44b8e92d9269d15b966b77784138dba30150938331aafadd7a68c258",
          "excerpt": "晉高祖入洛，委帝巡警，都邑肅然，無敢犯令。"
        }
      ]
    },
    {
      "id": "liu-zhiyuan-xuzhou",
      "title": "移任许州而继续典军",
      "summary": "加检校太保后改许州节度使，仍统领禁军。",
      "year": 937,
      "sortOrder": 5,
      "precision": "month",
      "sourceDate": "后晋天福二年四月、八月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p4",
          "originalRevision": 1,
          "originalSha256": "dc4a84c4bd4d6843cb5afd16eebe5a9126171eb87fc9054cf5074b3669ca5060",
          "excerpt": "天福二年夏四月，加檢校太保。八月，改許州節度使，典軍如故。"
        }
      ]
    },
    {
      "id": "liu-zhiyuan-du-reward",
      "title": "升禁军统帅并领宋州",
      "summary": "旧史记十月授侍卫亲军马步军都指挥使，十一月领宋州并加检校太尉。",
      "year": 938,
      "sortOrder": 6,
      "precision": "month",
      "sourceDate": "后晋天福三年十月、十一月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p4",
          "originalRevision": 1,
          "originalSha256": "dc4a84c4bd4d6843cb5afd16eebe5a9126171eb87fc9054cf5074b3669ca5060",
          "excerpt": "冬十月，授侍衛親軍馬步軍都指揮使。十一月，移授宋州，加檢校太尉。"
        }
      ],
      "variants": [
        {
          "label": "新史禁军统帅任期",
          "year": 937,
          "sourceDate": "天福二年",
          "summary": "新史将迁侍卫马步军都指挥使记在天福二年，旧史记三年十月；不将两书合为同一确定任命日。",
          "evidence": [
            {
              "chapterId": "new-v10",
              "paragraphId": "new-v10-p4",
              "originalRevision": 1,
              "originalSha256": "df519e68f7fecf14d57b43009203e6827ae6e5da03a64a0bde65dc95305f2a0d",
              "excerpt": "天福二年，遷侍衞馬步軍都指揮使，領忠武軍節度使。"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-zhiyuan-yedu",
      "title": "任邺都留守",
      "summary": "转任邺都留守，兼侍卫亲军马步军都指挥使；九月赴朝，石敬瑭亲临其宅。",
      "year": 940,
      "sortOrder": 7,
      "precision": "month",
      "sourceDate": "后晋天福五年三月、九月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p4",
          "originalRevision": 1,
          "originalSha256": "dc4a84c4bd4d6843cb5afd16eebe5a9126171eb87fc9054cf5074b3669ca5060",
          "excerpt": "五年三月，改鄴都留守兼侍衛親軍馬步軍都指揮使。九月，奉詔赴闕，晉高祖幸其第。"
        }
      ]
    },
    {
      "id": "liu-zhiyuan-hedong",
      "title": "镇河东留守北京",
      "summary": "授河东节度使、北京留守，自此在太原积累地方军政力量。",
      "year": 941,
      "sortOrder": 8,
      "precision": "month",
      "sourceDate": "后晋天福六年七月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p4",
          "originalRevision": 1,
          "originalSha256": "dc4a84c4bd4d6843cb5afd16eebe5a9126171eb87fc9054cf5074b3669ca5060",
          "excerpt": "六年七月，授北京留守、河東節度使。"
        }
      ]
    },
    {
      "id": "liu-zhiyuan-chudi-rank",
      "title": "出帝朝进中书令",
      "summary": "晋高祖去世后受出帝加检校太师，次年三月进中书令；新史指出出帝优待中也怀疑其异志。",
      "year": 943,
      "sortOrder": 9,
      "precision": "month",
      "sourceDate": "后晋天福八年三月；前接七年六月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p4",
          "originalRevision": 1,
          "originalSha256": "dc4a84c4bd4d6843cb5afd16eebe5a9126171eb87fc9054cf5074b3669ca5060",
          "excerpt": "六月，晉高祖崩於鄴宮，少帝即位，加帝檢校太師。八年三月，進位中書令。"
        },
        {
          "chapterId": "new-v10",
          "paragraphId": "new-v10-p5",
          "originalRevision": 1,
          "originalSha256": "d4d0193d1a2a9aecf637f4adbc1f1dfb840d610ef67c0bd83b0cf0ae03bd743f",
          "excerpt": "常疑知遠勳位已高，幸晉多故而有異志，每優尊之。"
        }
      ]
    },
    {
      "id": "liu-zhiyuan-xinkou",
      "title": "击败攻雁门的契丹军",
      "summary": "受幽州道行营招讨使任命，在忻口击败契丹伟王；奉诏至乐平，遇契丹退兵而返。",
      "year": 944,
      "sortOrder": 10,
      "precision": "month",
      "sourceDate": "后晋开运元年正月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p5",
          "originalRevision": 1,
          "originalSha256": "90f7bdbe62ef472eef21a9e8dc5a537b4571c5d8b1d88ae24c6a5a88db2e0f62",
          "excerpt": "開運元年正月，契丹南下，契丹主以大軍直抵澶州，遣蕃將偉王率兵入雁門。朝廷以帝為幽州道行營招討使，帝大破偉王於忻口。尋奉詔起兵至土門，軍至樂平，會契丹退，乃還。"
        }
      ],
      "notes": [
        "新史称击败于秀容，与旧史忻口地名分别保留。"
      ],
      "variants": [
        {
          "label": "新史秀容地名",
          "year": 944,
          "sourceDate": "契丹寇澶州、分兵雁门时",
          "summary": "新史记败伟王于秀容，旧史记忻口。",
          "evidence": [
            {
              "chapterId": "new-v10",
              "paragraphId": "new-v10-p5",
              "originalRevision": 1,
              "originalSha256": "d4d0193d1a2a9aecf637f4adbc1f1dfb840d610ef67c0bd83b0cf0ae03bd743f",
              "excerpt": "契丹寇澶州，別遣偉王攻鴈門，敗之于秀容。"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-zhiyuan-taiyuan-prince",
