  "personId": "liu-zhiyuan",
  "events": [
    {
      "id": "liu-zhiyuan-birth",
      "title": "生于太原",
      "summary": "母安氏于太原生下刘知远；原书说其先世本为沙陀部人。",
      "year": 895,
      "sortOrder": 0,
      "precision": "day",
      "sourceDate": "唐乾宁二年二月四日",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p1",
          "originalRevision": 1,
          "originalSha256": "c0d85935b9d915427a90e314f51e3ae86d5fe40447ba039ceec9c5bb5668eda8",
          "excerpt": "皇妣吳國太夫人安氏，追謚章懿皇后。後以唐乾寧二年，歲在乙卯，二月四日生帝於太原。"
        }
      ]
    },
    {
      "id": "liu-zhiyuan-desheng-rescue",
      "title": "德胜换马救石敬瑭",
      "summary": "同在李嗣源军中任职时，于德胜交战中把自己的坐骑让给遇险的石敬瑭，骑坏甲之马断后；通鉴编年将这次记载系于919年冬十月。",
      "year": 919,
      "sortOrder": 36,
      "precision": "month",
      "sourceDate": "通鉴系于梁贞明五年冬十月；新史本传本段未记年月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v271",
          "paragraphId": "tongjian-v271-p5",
          "originalRevision": 1,
          "originalSha256": "3e00fcb88c691629a69eef1933e710bf01c0c58183e3184c1fadece01a0455f4",
          "excerpt": "左射軍使石敬瑭與梁人戰於河壖，梁人擊敬瑭，斷其馬甲，橫衝兵馬使劉知遠以所乘馬授之，自乘斷甲者徐行為殿；"
        },
        {
          "chapterId": "new-v10",
          "paragraphId": "new-v10-p1",
          "originalRevision": 1,
          "originalSha256": "bc8e0851f773aa0f4111a21d1fd36d6fde653046611d49326db1856b149a6e15",
          "excerpt": "明宗及梁人戰德勝，晉高祖馬甲斷，梁兵幾及，知遠以所乘馬授之，復取高祖馬殿而還，高祖德之。"
        }
      ],
      "notes": [
        "新史本传未记具体年月；通鉴卷271第3段明列贞明五年己卯919，第4段进入冬十月，第5段载救马。不把德胜多年战事一概定于该月。"
      ]
    },
    {
      "id": "liu-zhiyuan-weizhou",
      "title": "卫州护石敬瑭并杀闵帝随从",
      "summary": "石敬瑭与出奔的李从厚在卫州相遇，刘知远部署石敢防变，事发后率兵杀死闵帝随从；不是一般护卫任职。",
      "year": 934,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "后唐应顺初；闵帝出奔时",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "new-v10",
          "paragraphId": "new-v10-p2",
          "originalRevision": 1,
          "originalSha256": "d0a7bca880dca54b968f0f28a2b6ad5f91eb8159f1e3b128d3e90ea52134386d",
          "excerpt": "知遠遣勇士石敢袖鐵槌侍高祖以虞變。高祖與愍帝議事未決，左右欲兵之，知遠擁高祖入室，敢與左右格鬬而死，知遠即率兵盡殺愍帝左右，留帝傳舍而去。"
        }
      ],
      "notes": [
        "旧史本纪此处写“唐明宗召赴阙”，与当时明宗已卒的上下文不合，未据此改变人物或时序。"
      ]
    },
    {
      "id": "liu-zhiyuan-taiyuan-coup",
      "title": "参与石敬瑭太原起兵",
      "summary": "刘知远与桑维翰秘密协助石敬瑭谋划，在石敬瑭奉命调镇后支持起兵。",
      "year": 936,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "后唐清泰三年夏",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p3",
          "originalRevision": 1,
          "originalSha256": "626daded44b8e92d9269d15b966b77784138dba30150938331aafadd7a68c258",
          "excerpt": "三年夏，移鎮汶陽。帝勸晉高祖舉義，贊成密計，經綸之始，中外賴之。晉高祖以帝為北京馬步軍都指揮使。"
        },
        {
          "chapterId": "new-v10",
          "paragraphId": "new-v10-p3",
          "originalRevision": 1,
          "originalSha256": "c6a9d2faad7a7a6f2cedb8bbb0176e4cba86e2a396dc160c53b12e7aec605cf8",
          "excerpt": "高祖將舉兵，知遠與桑維翰密為高祖謀畫，贊成之。"
        }
      ],
      "variants": [
        {
          "label": "通鉴记求援条件的劝谏",
          "year": 936,
          "sourceDate": "后唐清泰三年；求援契丹时",
          "summary": "通鉴记刘知远赞成起兵，但反对向契丹行父礼及预先许地；石敬瑭不听。赞成起兵不等于同意全部求援条件。",
          "evidence": [
            {
              "chapterId": "tongjian-v280",
              "paragraphId": "tongjian-v280-p15",
              "originalRevision": 1,
              "originalSha256": "2fc84b516bb62493478ffc9e38ec4039d91c573388db906c3c4d381be21d0a79",
              "excerpt": "都押牙劉知遠曰：「明公久將兵，得士卒心；今據形勝之地，士馬精強，若稱兵傳檄，帝業可成，奈何以一紙制書自投虎口乎！」"
            },
            {
              "chapterId": "tongjian-v280",
              "paragraphId": "tongjian-v280-p26",
              "originalRevision": 1,
              "originalSha256": "532c99945c4cb23099902c8f9b37675206c9181b7564e1e2a61acf1d69e4a5fc",
              "excerpt": "劉知遠諫曰：「稱臣可矣，以父事之太過。厚以金帛賂之，自足致其兵，不必許以土田，恐異日大為中國之患，悔之無及。」敬瑭不從。"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-zhiyuan-kill-prisoners",
      "title": "杀晋阳降军",
      "summary": "契丹援军击败张敬达军后，石敬瑭打算将降军编入亲卫，刘知远杀死这一千余人。",
      "year": 936,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "清泰三年；晋阳援战后",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p3",
          "originalRevision": 1,
          "originalSha256": "626daded44b8e92d9269d15b966b77784138dba30150938331aafadd7a68c258",
          "excerpt": "及契丹以全軍赴難，大破張敬達之眾於晉陽城下，有降軍千餘人，晉高祖將置之於親衛，帝盡殺之。"
        }
      ],
      "variants": [
        {
          "label": "通鉴记劝石敬瑭杀降兵",
          "year": 936,
          "sourceDate": "后唐清泰三年九月辛丑之战后",
          "summary": "旧史记刘知远将降军尽杀；通鉴则记石敬瑭得到唐降兵后，刘知远劝石敬瑭尽杀。劝杀与实际执行的叙法分别保留。",
          "evidence": [
            {
              "chapterId": "tongjian-v280",
              "paragraphId": "tongjian-v280-p31",
              "originalRevision": 1,
              "originalSha256": "0c889c503281363dd5852e245efb42cbd02adc011465a98e27a9603daeadb6a5",
              "excerpt": "敬瑭得唐降兵千餘人，劉知遠勸敬瑭盡殺之。"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-zhiyuan-jin-military",
      "title": "晋初统禁军并领保义",
      "summary": "后晋建立后任侍卫亲军都虞候，领保义军节度使；入洛阳后奉命巡警都城。",
      "year": 936,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "晋国初建",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "new-v10",
          "paragraphId": "new-v10-p3",
          "originalRevision": 1,
          "originalSha256": "c6a9d2faad7a7a6f2cedb8bbb0176e4cba86e2a396dc160c53b12e7aec605cf8",
          "excerpt": "高祖即位於太原，以知遠為侍衞親軍都虞候，領保義軍節度使。"
        },
        {
          "chapterId": "old-v099",
          "paragraphId": "old-v099-p3",
          "originalRevision": 1,
          "originalSha256": "626daded44b8e92d9269d15b966b77784138dba30150938331aafadd7a68c258",
          "excerpt": "晉高祖入洛，委帝巡警，都邑肅然，無敢犯令。"
        }
      ],
      "notes": [
        "936年适用于太原即位后授侍卫亲军都虞候、领保义军节度使；入洛后的巡警是随后阶段。通鉴将入洛系于天福元年闰十一月辛巳，实际已跨西历937年，不能把巡警也定为936年。"
      ]
    },
