        }
      ]
    },
    {
      "id": "liu-zhiyuan-bai-chengfu",
      "title": "杀白承福五族",
      "summary": "诛杀吐浑白承福等五族共四百人，以王义宗统领余众；新史另记夺取大量财物和良马。",
      "year": 946,
      "sortOrder": 13,
      "precision": "month",
      "sourceDate": "旧史开运三年五月",
