    {
      "id": "an-yuanxin-replace-liuxun",
      "title": "代刘训镇襄州，后移归德",
      "summary": "朝廷讨高季兴时刘训拖延军期，调安元信任山南东道节度使代之；一年多后又移归德。",
      "year": null,
      "sortOrder": 11,
      "precision": "undated",
      "sourceDate": "明宗时期讨高季兴后，传中未单列年次",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "王師之討高季興，襄帥劉訓逗撓軍期，移授元信山南東道節度使以代訓。"
        }
      ]
    }
