{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "an-yuanxin",
  "events": [
    {
      "id": "an-yuanxin-luzhou",
      "title": "从救上党，破夹寨",
      "summary": "李存勖承晋王位后随军救上党，破夹寨、复泽潞，授辽州刺史。",
      "year": 908,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "庄宗嗣晋王位后救上党；周德威传同役天祐五年五月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "莊宗嗣晉王位，元信從救上黨，破夾寨，復澤、潞，以功授檢校司空、遼州刺史，賜玉鞭名馬。"
        },
        {
          "chapterId": "old-v056",
          "paragraphId": "old-v056-p5",
          "originalRevision": 1,
          "originalSha256": "84bfa83bfa91b78f8d5bac9efff989e42607721d7b394dbb284a80e27d44b2ad",
          "excerpt": "五月朔，晨霧晦暝，王師伏於三垂崗下。翌日，直趨夾城，斬關破壘，梁人大敗，解潞州之圍。"
        }
      ]
    },
    {
      "id": "an-yuanxin-baixiang-wounded",
      "title": "柏乡重伤，晋王亲为敷药",
      "summary": "柏乡战斗中受重伤，李存勖亲自为他敷药；该年改武州刺史等职。",
      "year": 911,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "柏乡之役；周德威传同役天祐八年正月二日，授职另以其年叙",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "柏鄉之役，日晚戰酣，元信重傷，莊宗自臨傅藥。"
        },
        {
          "chapterId": "old-v056",
          "paragraphId": "old-v056-p7",
          "originalRevision": 1,
          "originalSha256": "7a6428b761cf83c37ec022e0f5f700e2a952b79061f6b8e2664b1d0a1912cabf",
          "excerpt": "八年正月二日，德威率騎軍致師於柏鄉，設伏於村塢間，令三百騎以壓汴營。"
        }
      ]
    },
    {
      "id": "an-yuanxin-cross-sea-command",
      "title": "平河南后任横海节度使",
      "summary": "李存勖平定河南后，安元信被调任横海军节度使；之后随李嗣源、霍彦威屯常山防契丹。",
      "year": 925,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "庄宗平定河南后；庄宗纪同光三年二月甲戌授沧州（横海）",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "莊宗平定河南，移授橫海軍節度使。"
        },
        {
          "chapterId": "old-v032",
          "paragraphId": "old-v032-p16",
          "originalRevision": 1,
          "originalSha256": "e4d1971387c82c4c11f0931b602cb38c2002617c19c2a9502e0bbd5e789560b2",
          "excerpt": "同光三年春正月甲午朔，帝御明堂殿受朝賀，仗衛如式。"
        },
        {
          "chapterId": "old-v032",
          "paragraphId": "old-v032-p17",
          "originalRevision": 1,
          "originalSha256": "3d842b2460820938b2baae1ca86d898e541b68941eb2d5046f3a531e8735fb52",
          "excerpt": "二月甲子朔，詔："
        },
        {
          "chapterId": "old-v032",
          "paragraphId": "old-v032-p17",
          "originalRevision": 1,
          "originalSha256": "3d842b2460820938b2baae1ca86d898e541b68941eb2d5046f3a531e8735fb52",
          "excerpt": "甲戌，以滄州節度使李紹斌為幽州節度使，依前檢校太保；以大同軍留後安元信為滄州節度使。"
        }
      ]
    },
    {
      "id": "an-yuanxin-mingzong-reward",
      "title": "明宗加同平章事",
      "summary": "李嗣源即位后，念其曾任内衙都校，厚待并加同中书门下平章事。",
      "year": 926,
      "sortOrder": 4,
      "precision": "month",
      "sourceDate": "明宗即位；明宗纪天成元年五月加同平章事",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "明宗即位，以元信嘗為內衙都校，尤厚待之，加同中書門下平章事。"
        },
        {
          "chapterId": "old-v036",
          "paragraphId": "old-v036-p2",
          "originalRevision": 1,
          "originalSha256": "c657cbf1a74e96c14c58230cf4836ce20ba5e74b94126c8ccef01a645c7ff6a9",
          "excerpt": "五月丙辰朔，帝不視朝，臨於西宮。"
        },
        {
          "chapterId": "old-v036",
          "paragraphId": "old-v036-p2",
          "originalRevision": 1,
          "originalSha256": "c657cbf1a74e96c14c58230cf4836ce20ba5e74b94126c8ccef01a645c7ff6a9",
          "excerpt": "滄州節度使、檢校太傅安元信加同平章事，移鎮徐州；"
        }
      ]
    },
    {
      "id": "an-yuanxin-death-luzhou",
      "title": "清泰三年卒于潞州任上",
      "summary": "末帝任他为潞州节度使，清泰三年二月因病卒，旧史记七十四岁，赠太师；后晋谥忠懿。",
      "year": 936,
      "sortOrder": 5,
      "precision": "month",
      "sourceDate": "清泰三年二月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "清泰三年二月，以疾卒於鎮，時年七十四。贈太師。"
        }
      ]
    },
    {
      "id": "an-yuanxin-early-defection",
      "title": "早事李克用，败后奔定州",
      "summary": "幼事李克用、随平巢蔡；光启中抵御赫连铎在居庸关失利，不敢归河东，奔定州为王处存突骑都校。",
      "year": null,
      "sortOrder": 6,
      "precision": "undated",
      "sourceDate": "光启中",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "光啟中，吐渾赫連鐸寇雲中，武皇使元信拒之，元信兵敗於居庸關。武皇性嚴急，元信不敢還，遂奔定州；王處存待之甚厚，用為突騎都校。"
        }
      ]
    },
    {
      "id": "an-yuanxin-return-hedong",
      "title": "随王郜归河东，领铁林军",
      "summary": "梁军攻定州时，随王郜奔太原，李克用待如初，用为铁林军使。",
      "year": null,
      "sortOrder": 7,
      "precision": "undated",
      "sourceDate": "本传未记具体年次",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "郜懼，挈其族奔太原，元信從之；武皇待之如初，用為鐵林軍使。"
        }
      ]
    },
    {
      "id": "an-yuanxin-kill-qinwu",
      "title": "上党援军战中杀秦武",
      "summary": "李思安攻上党，河东军高河营地受逼，安元信与梁将秦武交战将其杀死，军营得以建成，升突阵都将。",
      "year": null,
      "sortOrder": 8,
      "precision": "undated",
      "sourceDate": "李思安攻上党时",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "別將秦武者，尤為難敵，元信與鬥，斃之。由是梁軍解去，城壘得立。"
        }
      ]
    },
    {
      "id": "an-yuanxin-wei-desheng",
      "title": "定魏博后任博州刺史",
      "summary": "随李存勖定魏博，任博州刺史；德胜渡对梁军时为右厢排阵使，后任大同军节度使。",
      "year": null,
      "sortOrder": 9,
      "precision": "undated",
      "sourceDate": "定魏博、德胜渡对垒期间",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p4",
          "originalRevision": 1,
          "originalSha256": "9482fd631e8804d4e4f37bc304184c76c7b188f8e74a683efa76891a8af11639",
          "excerpt": "從莊宗定魏博，移為博州刺史。與梁對壘德勝渡，元信為右廂排陣使。未幾，為大同軍節度使。"
        }
      ]
    },
