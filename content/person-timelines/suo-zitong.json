  "events": [
    {
      "id": "suo-zitong-xinzhou",
      "title": "明宗即位后任忻州刺史",
      "summary": "从随驾左右厢马军都指挥授忻州刺史；岁余召还典禁兵。",
      "year": 926,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "本纪天成元年五月壬午授忻州刺史；岁余召还属后续，未另载年月",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v065",
          "paragraphId": "old-v065-p13",
          "originalRevision": 1,
          "originalSha256": "350dc45481b12e9e08b0c77b8d97180b2cd30ad506bff46c9c76be0b001ee71d",
          "excerpt": "明宗即位，自隨駕左右廂馬軍都指揮授忻州刺史。"
        },
        {
          "chapterId": "old-v036",
          "paragraphId": "old-v036-p2",
          "originalRevision": 1,
          "originalSha256": "c657cbf1a74e96c14c58230cf4836ce20ba5e74b94126c8ccef01a645c7ff6a9",
          "excerpt": "五月丙辰朔，帝不視朝，臨於西宮。"
        },
        {
          "chapterId": "old-v036",
          "paragraphId": "old-v036-p5",
          "originalRevision": 1,
          "originalSha256": "b175a17a89d55fd778bff2536797fa20877e8330a200742b4d82c56c2d6882de",
          "excerpt": "壬午，以前蔚州刺史張溫為振武留後，以左右廂突陣指揮使康義誠為汾州刺史，以左右廂馬軍都指揮使索自通為忻州刺史。"
        },
        {
          "chapterId": "old-v065",
          "paragraphId": "old-v065-p13",
          "originalRevision": 1,
          "originalSha256": "350dc45481b12e9e08b0c77b8d97180b2cd30ad506bff46c9c76be0b001ee71d",
          "excerpt": "歲餘召還，復典禁兵，領韶州刺史，"
        }
      ],
      "notes": [
        "926年五月仅系授忻州刺史；原传接叙一年多后召还典禁兵，不把后续召还也定在926年。"
      ]
    },
    {
      "id": "suo-zitong-death-luo",
      "title": "末帝即位后惧祸，投洛水自杀",
      "summary": "旧任河中与李从珂有怨，李从珂即位后忧惧求死，清泰元年七月退朝后投洛水。",
      "year": 934,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "清泰元年七月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v065",
          "paragraphId": "old-v065-p13",
          "originalRevision": 1,
          "originalSha256": "350dc45481b12e9e08b0c77b8d97180b2cd30ad506bff46c9c76be0b001ee71d",
          "excerpt": "清泰元年七月，因朝退涉洛，自溺而卒。"
        }
      ]
    },
    {
      "id": "suo-zitong-hunting-appointment",
      "title": "因射猎获晋王赏识，补军使",
      "summary": "李存勖镇太原时野外遇其，因善骑射补右番厅直军使，随猎射鹿后转指挥使。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "庄宗镇太原时",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v065",
          "paragraphId": "old-v065-p13",
          "originalRevision": 1,
          "originalSha256": "350dc45481b12e9e08b0c77b8d97180b2cd30ad506bff46c9c76be0b001ee71d",
          "excerpt": "莊宗鎮太原時，遇之於野，訊其姓名，即補右番廳直軍使。"
        }
      ]
    },
    {
