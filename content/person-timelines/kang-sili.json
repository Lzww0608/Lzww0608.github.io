  "events": [
    {
      "id": "kang-sili-zhaowu",
      "title": "领昭武节度、利巴集观察",
      "summary": "天成四年领昭武军节度及利巴集等州观察处置，改赐耀忠保节功臣号。",
      "year": 929,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "天成四年；本纪六月戊申由宿州任利州（昭武军）",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p10",
          "originalRevision": 1,
          "originalSha256": "cd0def8a6802b6c901281b21d20fe22b201a1a32fa91c017272004fe134d1154",
          "excerpt": "四年，領昭武軍節度、利巴集等州觀察處置等使。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p6",
          "originalRevision": 1,
          "originalSha256": "17090de0c22a11bb5b5639c3f3967470883ce476d868e66204102be1dd990661",
          "excerpt": "六月辛丑，以左散騎常侍姚顗為兵部侍郎。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p6",
          "originalRevision": 1,
          "originalSha256": "17090de0c22a11bb5b5639c3f3967470883ce476d868e66204102be1dd990661",
          "excerpt": "戊申，以宿州團練使康思立為利州節度使。"
        }
      ]
    },
    {
      "id": "kang-sili-shanzhou",
      "title": "移镇陕州",
      "summary": "长兴二年由此前西面行营军职移镇陕州。",
      "year": 932,
      "sortOrder": 2,
      "precision": "day",
      "sourceDate": "长兴二年十二月庚午；核历跨西历932年1月（本纪同事）",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p10",
          "originalRevision": 1,
          "originalSha256": "cd0def8a6802b6c901281b21d20fe22b201a1a32fa91c017272004fe134d1154",
          "excerpt": "二年，移鎮陝州。"
        },
        {
          "chapterId": "old-v042",
          "paragraphId": "old-v042-p13",
          "originalRevision": 1,
          "originalSha256": "f83ac99a68ccf1ddaabd3d064bbc1322c951406fbed9abe3f58f9469105d72b8",
          "excerpt": "十二月甲寅朔，詔開鐵禁，許百姓自鑄農器、什器之屬，於夏秋田畝上，每畝輸農器錢一錢五分。"
        },
        {
          "chapterId": "old-v042",
          "paragraphId": "old-v042-p13",
          "originalRevision": 1,
          "originalSha256": "f83ac99a68ccf1ddaabd3d064bbc1322c951406fbed9abe3f58f9469105d72b8",
          "excerpt": "庚午，以前利州節度使康思立為陝州節度使。"
        }
      ]
    },
    {
      "id": "kang-sili-right-shenwu",
      "title": "入朝为右神武统军",
      "summary": "清泰二年被召入朝，任右神武统军。",
      "year": 935,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "清泰二年；本纪八月庚寅同事入右神武统军",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p10",
          "originalRevision": 1,
          "originalSha256": "cd0def8a6802b6c901281b21d20fe22b201a1a32fa91c017272004fe134d1154",
          "excerpt": "二年，入為右神武統軍。"
        },
        {
          "chapterId": "old-v047",
          "paragraphId": "old-v047-p14",
          "originalRevision": 1,
          "originalSha256": "721deb7488de4bb6b1de2bf6689b12ffd4120e853121e76726dd3b625658b3e5",
          "excerpt": "八月庚午，滑州節度使高允韜卒。"
        },
        {
          "chapterId": "old-v047",
          "paragraphId": "old-v047-p14",
          "originalRevision": 1,
          "originalSha256": "721deb7488de4bb6b1de2bf6689b12ffd4120e853121e76726dd3b625658b3e5",
          "excerpt": "庚寅，以前兗州節度使楊漢章為左神武統軍，以前邢州節度使康思立為右神武統軍。"
        }
      ]
    },
    {
      "id": "kang-sili-north-general",
      "title": "充北面行营马军都指挥",
      "summary": "清泰三年出任北面行营马军都指挥使，奉命加强北军。",
      "year": 936,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "清泰三年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v070",
