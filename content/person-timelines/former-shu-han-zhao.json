  "events": [
    {
      "id": "former-shu-han-zhao-wensi-promotion",
      "title": "升文思殿大学士",
      "summary": "原任礼部尚书兼成都尹的韩昭获任文思殿大学士，位在翰林承旨之上。",
      "sourceDate": "《通鉴》贞明六年七月乙卯；春秋乾德二年叙次，未另列七月标题",
      "year": 920,
      "precision": "month",
      "phase": "service",
      "sortOrder": 1,
      "evidence": [
        {
          "chapterId": "tongjian-v271",
          "paragraphId": "tongjian-v271-p25",
          "originalRevision": 1,
          "originalSha256": "92864d40a3295bc62c53df208ec114d94b7ef89e74a61a8fa564fb8432b86881",
          "excerpt": "乙卯，蜀主下詔北巡，以禮部尚書兼成都尹長安韓昭為文思殿大學士，位在翰林承旨上。"
        },
        {
          "chapterId": "tongjian-v271",
          "paragraphId": "tongjian-v271-p12",
          "originalRevision": 1,
          "originalSha256": "e8dfb9fa237a99f2dfb6fa3b912ae971e838094aa13878331cf2a96c6b753cdc",
          "excerpt": "均王下貞明六年（庚辰，公元九二零年）"
        },
        {
          "chapterId": "tongjian-v271",
          "paragraphId": "tongjian-v271-p24",
          "originalRevision": 1,
          "originalSha256": "5f17b9e32596e2be0bcc54d3f0034b60ce30cff1afa174f163509a047077befa",
          "excerpt": "劉鄩等圍同州，朱友謙求救於晉。秋，七月，晉王遣李存審、李嗣昭、李建及、慈州刺史李存質將兵救之。"
        },
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p4",
          "originalRevision": 1,
          "originalSha256": "eccecce0c36740042c724f726b85a96c2541bd61a731db08d5431332923f7790",
          "excerpt": "乾德二年，後主下詔北巡，進昭文思殿大學士，位在翰林承旨上。"
        }
      ],
      "notes": [
        "原书记日保留，不补具体西历日；不把前段闰月庚申朔移作韩的任命日。"
      ]
    },
    {
      "id": "former-shu-han-zhao-sale-request",
      "title": "请卖刺史职位以营宅，获准",
      "summary": "韩昭向王衍请求出售通、渠、巴、集等州刺史职位以营建宅第，王衍答应。",
      "sourceDate": "《通鉴》贞明六年任文思殿后接叙；请求未独记日",
      "year": 920,
      "precision": "year",
      "phase": "service",
      "sortOrder": 2,
      "evidence": [
        {
          "chapterId": "tongjian-v271",
          "paragraphId": "tongjian-v271-p25",
          "originalRevision": 1,
          "originalSha256": "92864d40a3295bc62c53df208ec114d94b7ef89e74a61a8fa564fb8432b86881",
          "excerpt": "昭無文學，以便佞得幸，出入宮禁，就蜀主乞通、渠、巴、集數州刺史賣之以營居第，蜀主許之。"
        },
        {
          "chapterId": "tongjian-v271",
          "paragraphId": "tongjian-v271-p12",
          "originalRevision": 1,
          "originalSha256": "e8dfb9fa237a99f2dfb6fa3b912ae971e838094aa13878331cf2a96c6b753cdc",
          "excerpt": "均王下貞明六年（庚辰，公元九二零年）"
        },
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p4",
          "originalRevision": 1,
          "originalSha256": "eccecce0c36740042c724f726b85a96c2541bd61a731db08d5431332923f7790",
          "excerpt": "昭恃寵無厭，乞賣通、渠、巴、集數州刺史以爲營第費，後主悉報可。"
        }
      ],
      "notes": [
        "记录请求及获准；具体实际成交与任官者、数额未载，不虚列交易。"
      ]
    },
    {
      "id": "former-shu-han-zhao-chongyang-mocking",
      "title": "重阳宴上以酒悲搪塞宗寿",
      "summary": "王宗寿在重阳宴劝王衍以社稷为念并流泪，韩昭、潘在迎等用酒悲说法和谐笑搪塞。",
      "sourceDate": "《通鉴》同光元年九月庚戌；春秋乾德五年重阳",
      "year": 923,
      "precision": "month",
      "phase": "service",
      "sortOrder": 3,
      "evidence": [
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p28",
          "originalRevision": 1,
          "originalSha256": "dcc455e02f1d3a2c0599a5a824e1b40efd25ca2c1efb6df87b15e3b59a4e1d01",
          "excerpt": "九月，庚戌，蜀主以重陽宴近臣於宣華宛，酒酣，嘉王宗壽乘間極言社稷將危，流涕不已。韓昭、潘在迎曰：「嘉王好酒悲。」因諧笑而罷。"
        },
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p3",
          "originalRevision": 1,
          "originalSha256": "4527593f9618b65fbfb910c66a48b0cec246e59d73308125ee87e7f5e7f8d782",
          "excerpt": "莊宗光聖神閔孝皇帝上同光元年（癸未，公元九二三年）"
        },
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p6",
          "originalRevision": 1,
          "originalSha256": "ad675f383a864888a0124234a5a4de711a353dd3b00c1be8abea5583393aebc2",
          "excerpt": "庚戌，重陽節，宴近臣於宣華苑。酒半行，嘉王宗壽乘間言社稷將危狀，繼以隕涕，韓昭輩共以諧笑溷之。"
        }
      ],
      "notes": [
        "九国志及宗寿传未独记本次年月，不将它们反作第二次确定的重阳宴。"
      ]
    },
    {
      "id": "former-shu-han-zhao-libu-appointment",
      "title": "任吏部侍郎，判三铨",
      "summary": "本书在乾德五年冬十月记韩昭任吏部侍郎、主管三铨。",
      "sourceDate": "《十国春秋》乾德五年冬十月",
      "year": 923,
      "precision": "month",
      "phase": "service",
      "sortOrder": 4,
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p6",
          "originalRevision": 1,
          "originalSha256": "ad675f383a864888a0124234a5a4de711a353dd3b00c1be8abea5583393aebc2",
          "excerpt": "冬十月，以韓昭爲吏部侍郎，判三銓。"
        }
      ],
      "notes": [
        "礼部尚书兼成都尹与此处吏部侍郎各按原书；不擅补升贬原因或调任确日。"
      ]
    },
    {
      "id": "former-shu-han-zhao-appointment-complaint",
      "title": "因任官受诉，答称所指为后妃国舅之戚",
      "summary": "选人击鼓诉韩昭受赂徇私，并作州县讥语；韩昭被问后称所指是太后、太妃、国舅亲戚，并非自己亲属。",
      "sourceDate": "乾德五年任官后接叙，受诉与答问未独载月日",
      "year": 923,
      "precision": "year",
      "phase": "service",
      "sortOrder": 5,
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p6",
          "originalRevision": 1,
          "originalSha256": "ad675f383a864888a0124234a5a4de711a353dd3b00c1be8abea5583393aebc2",
          "excerpt": "冬十月，以韓昭爲吏部侍郎，判三銓。昭受賂狥私，選人詣鼓院撾鼓上訴，又爲嘲語曰：“嘉、眉、卭、蜀，侍郎骨肉。導江、青城，侍郎親情。果、閬二州，侍郎自留。巴、蓬、集、壁，侍郎不惜。”帝聞言召問，昭對曰：“此皆太后、太妃、國舅之戚，非臣之親。”帝默然。"
        }
      ],
      "notes": [
        "保本书当年叙次；不将所涉各项任官都定为十月发生，讥语和韩自辩亦不作为已经确证的谱系。"
      ]
    },
    {
      "id": "former-shu-han-zhao-pu-threat",
      "title": "因蒲禹卿劝谏而出言威吓",
      "summary": "韩昭得到反对秦州游幸的奏表，大怒，扬言待王衍西归后让狱吏逐字追问蒲禹卿。",
      "sourceDate": "《通鉴》同光三年九月邀游叙次，威吓未另记日",
      "year": 925,
      "precision": "year",
      "phase": "service",
      "sortOrder": 6,
      "evidence": [
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p110",
          "originalRevision": 1,
          "originalSha256": "175556dc3f169fee51206fcae73a24eaef7be18b49b5ac48e1dd0f65d771a586",
          "excerpt": "韓昭謂禹卿曰：「吾收汝表，俟主上西歸，當使獄吏字字問汝！」王承休妻嚴氏美，蜀主私焉，故銳意欲行。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p80",
          "originalRevision": 1,
          "originalSha256": "caa8fd2a1edcfd1ad786022efe47e81c7fde7d36fb94b610286b6075392ace44",
          "excerpt": "莊宗光聖神閔孝皇帝中同光三年（乙酉，公元九二五年）"
        },
        {
          "chapterId": "shiguochunqiu-v043",
          "paragraphId": "shiguochunqiu-v043-p10",
          "originalRevision": 1,
          "originalSha256": "5f3e021ba2df2b02257a3c53e1bf794b53e5be291bd72ec15a4d82d5a19e7c80",
          "excerpt": "韓昭得禹卿表，大怒，叱之曰：“俟主上西歸，當使獄吏字字問汝！”未幾，唐師大至，從後主歸唐。"
        }
      ],
      "notes": [
        "威吓与实际审讯分开；蒲传后续随王衍归唐者为蒲，不能由紧接韩的引语便认韩同往。"
      ]
    },
    {
      "id": "former-shu-han-zhao-death",
      "title": "王宗弼指责其佞谀并将其杀死",
      "summary": "王宗弼杀韩昭，并在金马坊门悬首；新史记与宋光嗣等一同被收杀、首级装匣送李继岌，本传明记韩的梟斩和送首。",
      "sourceDate": "《通鉴》同光三年十一月；诛韩未独记日",
      "year": 925,
      "precision": "month",
      "phase": "fall",
      "sortOrder": 7,
      "evidence": [
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p10",
          "originalRevision": 1,
          "originalSha256": "021a2331861d53aee35863a475a0a0f7081030360ec7dc938e920aab0e01f949",
          "excerpt": "王宗弼稱蜀君臣久欲歸命，而內樞密使宋光嗣、景潤澄、宣徽使李周輅、歐陽晃熒惑蜀主；皆斬之，函首送繼岌。又責文思殿大學士、禮部尚書、成都尹韓昭佞諛，梟於金馬坊門。"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p3",
          "originalRevision": 1,
          "originalSha256": "3c0fc95eb4cd1a755cd3d91b7b6dbdbaa76c4ecd9d0ac84bab8cfe1c2002d35a",
          "excerpt": "莊宗光聖神閔孝皇帝下同光三年（乙酉，公元九二五年）"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p4",
          "originalRevision": 1,
          "originalSha256": "f8d6d20ab12ee38e160822b42cbe609fcec9fa8bec65bb726d3d0b2ecc104015",
          "excerpt": "十一月，丙申，蜀主至成都，百官及後宮迎於七里亭。蜀主入妃嬪中作回鶻隊入宮。丁酉，出見群臣於文明殿，泣下沾襟，君臣相視，竟無一言以救國患。"
        },
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p4",
          "originalRevision": 1,
          "originalSha256": "eccecce0c36740042c724f726b85a96c2541bd61a731db08d5431332923f7790",
          "excerpt": "頃之，唐師入蜀，後主方與羣臣相對泣，王宗弼遽自綿谷馳歸，登大元門，責昭以佞諛僨事，梟斬於金馬坊門，已而函首送魏王繼岌。"
        },
        {
          "chapterId": "new-v63",
          "paragraphId": "new-v63-p34",
          "originalRevision": 1,
          "originalSha256": "de42365053bde337e186dcc0e1a5172d2e08868c3f5cb86bfdf1aa766a77b67d",
          "excerpt": "而宗弼亦自緜谷馳歸，登太玄門，收成都尹韓昭、宦者宋光嗣景潤澄歐陽晃等殺之，函首送于繼岌。"
        }
      ],
      "notes": [
        "王宗弼的归命说与责佞谀之辞保其发言归属；不写成后唐魏王事先命他行刑。",
        "大元门、太元门、太玄门为各书所记宗弼登门处；不抹成一个原字或误作韩的悬首门名。"
      ],
      "variants": [
        {
          "label": "周彦章参与及大安楼胁主",
          "sourceDate": "国变后，未独载年月日",
          "summary": "春秋记周彦章参与宗弼诛韩有力；北梦另记周率兵到大安楼胁后主诛韩等，不由此确认周亲自行刑。",
          "evidence": [
            {
              "chapterId": "shiguochunqiu-v043",
              "paragraphId": "shiguochunqiu-v043-p15",
              "originalRevision": 1,
              "originalSha256": "3aa0efbb8e404a817291354e84cdbbc924bf7a0fba56207986ce932c830264d4",
              "excerpt": "後遇國變，王宗弼勒兵誅韓昭等，彦章亦與有力焉。"
            },
            {
              "chapterId": "beimeng-v020",
              "paragraphId": "beimeng-v020-p25",
              "originalRevision": 1,
              "originalSha256": "53f94b71a79275e2075e3f68bc199168837ae31863a588f7e679a76fb6cb8bff",
              "excerpt": "唐鳳翔李曮令公𭣣蜀充饋運使於蜀城東門外下營魏王與郭侍中入居蜀宫玉帛子女他人無復見矣中令寂寞無以遣適潁川陳昭符仕蜀累剖竹符早在歧山微有階縁而得候謁因求一美人以獻之有蕭夫人者乃蜀先主之寵愛也曽賜與鳳翔歸降指揮使王胡〈忘其名〉賜名丞弇王胡乃歧王賜姓連彥字卒後蕭氏寡而無子其容態明悟國人具聞陳致媒氏誘之而獻抱衾之夕中令於𥦗隙中窺之歎其妍妙乃詰所來左右方以王胡為對中令止之曰王胡背恩投蜀誠不可容然其向來吾之子姪矣此事不可遽令約迴時有知者皆重中令少年而忍欲復禮誠貴達人難事潁川每為愚話之　周彥章本姓王以軍功為金吾衞使後主采選宫妓王有女甚美因命内人欲選入宫王乃按劒曰某是先皇令與周氏作義男本姓王為衆所聞也豈有王氏女而事王氏乎因召左右小軍將無婦者以女衣襟結之便為夫妻爾後國變王乃領兵於大安樓前脅後主誅君側韓昭等即其事也"
            }
          ]
        }
      ]
    },
    {
      "id": "former-shu-han-zhao-court-service",
      "title": "以近臣身份出入宫禁，陪侍游宴",
      "summary": "本传记韩昭累官礼部尚书兼成都尹，与潘在迎、顾在珣等为王衍狎客，日夜陪饮；初任与入侍年月未载。",
      "sourceDate": "本传及新史后主时期合叙，未独载初任年月",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 8,
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p4",
