      "id": "nantang-li-yu-palace-qiao-sutra-gift",
      "title": "奉佛并受赐金字心经",
      "summary": "原书记乔氏善书，居宫曾出家奉佛，受赐后主手书金字心经；未明出家是否离宫或具体年月。",
      "year": null,
      "sortOrder": 1,
      "precision": "undated",
      "sourceDate": "居宫期间；未独记年月",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p12",
          "originalRevision": 1,
          "originalSha256": "4cac4c54d6335ffb945ddec489e4b04ad34ba1c82fe130b4997a32ef57f77708",
          "excerpt": "喬氏，亦後主宮人。善書，居宮中，常出家奉佛，後主手書金字《心經》賜之。"
        }
      ],
      "notes": [
        "徐锴集出家诰同人仅编者问句，不作独立确证。"
      ]
    },
    {
      "id": "nantang-li-yu-palace-qiao-song-palace",
      "title": "国亡后入宋禁中",
      "summary": "原书记国亡后她入宋禁中；本句未给独立日期，也未记她的后续生卒。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "国亡以后；未独记年月",
      "phase": "uncertain",
      "evidence": [
