        }
      ]
    },
    {
      "id": "jin-shi-chonggui-mother-an-northward-947",
      "title": "随少帝北迁",
      "summary": "安太妃与李太后、冯后等随少帝北行，被迁往契丹控制地区。",
      "year": 947,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "明年正月癸卯；通鉴天福十二年叙次",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v085",
          "paragraphId": "old-v085-p8",
          "originalRevision": 1,
          "originalSha256": "85c002418e6f4513f882947fa090313e6cc003a99f16db46f0044eb21465c9a1",
          "excerpt": "癸卯，帝與皇太后李氏、皇太妃安氏、皇后馮氏、皇弟重睿、皇子延煦延寶俱北行"
        },
        {
          "chapterId": "tongjian-v286",
          "paragraphId": "tongjian-v286-p16",
          "originalRevision": 1,
          "originalSha256": "530e4f89f4865573e9c68f759e8d115760947bfd9b9c942e2bcafc7fc9be7ee3",
          "excerpt": "癸卯，晉主與李太后、安太妃、馮后及弟睿、子延煦、延寶俱北遷，後宮左右從者百餘人。"
        }
      ],
      "notes": [
        "北行名单逐名列出；后文裸称太后或泛称妃后的行为，不逐项分配给安氏。"
      ]
    },
    {
      "id": "jin-shi-chonggui-mother-an-died-en-route-949",
      "title": "赴建州途中去世",
      "summary": "乾祐二年自辽阳赴建州途中，安太妃病卒。史书又载她希望焚骨南扬；实际叙述则为焚化后载燼骨至建州。",
      "year": 949,
      "sortOrder": 5,
      "precision": "year",
      "sourceDate": "汉乾祐二年二月赴建州途中",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v085",
          "paragraphId": "old-v085-p11",
          "originalRevision": 1,
          "originalSha256": "ce4ad8ce048153042f4fbca71ae5976fa86f2897bf7e974244c65d2fa2438834",
          "excerpt": "漢乾祐二年二月，帝自遼陽城發赴建州。行至中路，太妃安氏得疾而薨，乃焚之，載其燼骨而行。"
        },
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p20",
          "originalRevision": 1,
          "originalSha256": "d075cee21bc1a6856c07168dc3f5e76dbe793628164c01688edb3600d88e0be1",
          "excerpt": "妃老而失明，從出帝北遷，自遼陽徙建州，卒於道中。"
        },
        {
          "chapterId": "tongjian-v288",
          "paragraphId": "tongjian-v288-p83",
          "originalRevision": 1,
          "originalSha256": "6d9ccf297e417ef39f334149e7cf6e1f0e77bbbf276cd3cbac006a56762e668e",
          "excerpt": "未至，安太妃卒於路。遺令：「必焚我骨，南向揚之，庶幾魂魄歸達於漢。」"
        }
      ],
      "notes": [
        "二月是出发赴建州的记月，途中卒未独载日；不补具体卒日。",
        "新史记砂碛无草木，毁奚车焚化，携燼骨至建州，后来与李太后并葬。并葬不等同年同日去世。",
        "焚骨南扬属于遗愿，不写成已将骨灰送回或扬向南方。",
        "旧史卷86所引契丹国志另作天禄二年；迁徙、卒事的年次有异，不将各书都改成949。"
      ],
      "variants": [
        {
          "label": "辑补旧史引契丹国志作天禄二年",
          "year": 948,
          "sourceDate": "天禄二年春二月",
          "summary": "旧史卷86引契丹国志记天禄二年春二月迁晋侯、太后于建州，中途安太妃卒。此年次为948，与旧少帝纪、新史及通鉴的乾祐二年949叙次不同，分别保留，不统一底本。",
          "evidence": [
            {
              "chapterId": "old-v086",
              "paragraphId": "old-v086-p4",
              "originalRevision": 1,
              "originalSha256": "a24ad63356f598833c3c346009bfe71dbd522692b6e62a02253046ac835e1123",
              "excerpt": "《契丹國志》云：天祿二年春二月，徙晉侯、太后於建州，中途安太妃卒"
            }
          ]
        }
      ]
    },
