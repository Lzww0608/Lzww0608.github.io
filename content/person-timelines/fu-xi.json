{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "fu-xi",
  "events": [
    {
      "id": "fu-xi-qingzhou",
      "title": "由邢州移青州",
      "summary": "同光初任邢州节度，次年移青州。",
      "year": 924,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "本传同光初之明年；本纪同光二年三月乙巳任青州",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p6",
          "originalRevision": 1,
          "originalSha256": "1b23d29380f5f0a0f7c8faf9958d807aeae1ff11e54486701fa18c8c84366187",
          "excerpt": "同光初，以習為邢州節度。明年，移鎮青州。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p1",
          "originalRevision": 1,
          "originalSha256": "56aeec50377f2b2ccf3e459c7bfe207e6f01c8817e3bd6c9000b7f3148a86eed",
          "excerpt": "同光二年春正月庚子朔，帝御明堂殿受朝賀，仗衛如式。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p9",
          "originalRevision": 1,
          "originalSha256": "e48ba9d10da07b124254ce3c9e596cf74e5b0fdc3c7247a7de3b8a99495978e6",
          "excerpt": "三月甲辰，故河陽節度使王師範贈太尉。乙巳，以滄州節度使、檢校太傅、同平章事符習為青州節度使，以北京衙內馬步軍都指揮使、右領軍衛大將軍李紹斌為滄州節度使。"
        }
      ]
    },
    {
      "id": "fu-xi-wei-campaign",
      "title": "奉诏讨赵在礼，遇兵变退军",
      "summary": "率淄青兵赴魏州讨赵在礼，抵达后适逢军乱，退军渡河。",
      "year": 926,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "同光四年二月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p6",
          "originalRevision": 1,
          "originalSha256": "1b23d29380f5f0a0f7c8faf9958d807aeae1ff11e54486701fa18c8c84366187",
          "excerpt": "四年二月，趙在禮盜據魏州，習受詔以淄、青之師進討；至則會軍亂，習乃退軍渡河。"
        }
      ]
    },
    {
      "id": "fu-xi-follow-mingzong",
      "title": "胙县谒李嗣源，随入汴",
      "summary": "受李嗣源召令起初未及时赴，在胙县经霍彦威劝随入汴；明宗即位加侍中，欲归青州时王公俨拒命，改授天平节度。",
      "year": 926,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "同光四年，明宗赴洛期间",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p6",
          "originalRevision": 1,
          "originalSha256": "1b23d29380f5f0a0f7c8faf9958d807aeae1ff11e54486701fa18c8c84366187",
          "excerpt": "明宗自鄴赴洛，遣使召之，習不時而至。既至，謁明宗於胙縣。霍彥威謂習曰：「主上所知者十人，公在其四，何猶豫乎！」習乃從明宗入汴。明宗即位，加兼侍中，令歸本鎮。屬青州守將王公儼拒命，復授天平軍節度使。"
        }
      ]
    },
    {
      "id": "fu-xi-bianzhou",
      "title": "天成四年移汴州节度",
      "summary": "由天平军移汴州节度使。",
      "year": 929,
      "sortOrder": 4,
      "precision": "month",
      "sourceDate": "天成四年；本纪同事三月乙未授汴州",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p6",
          "originalRevision": 1,
          "originalSha256": "1b23d29380f5f0a0f7c8faf9958d807aeae1ff11e54486701fa18c8c84366187",
          "excerpt": "四年，移汴州節度使。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p3",
          "originalRevision": 1,
          "originalSha256": "38d1c300fe27ea8dff96954dda0fd92dc10c518240641284f533429c615118c7",
          "excerpt": "三月甲戌，馮道進表乞命相。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p3",
          "originalRevision": 1,
          "originalSha256": "38d1c300fe27ea8dff96954dda0fd92dc10c518240641284f533429c615118c7",
          "excerpt": "乙未，以前鄆州節度使符習為汴州節度使。"
        }
      ]
    },
    {
      "id": "fu-xi-early-wangrong",
      "title": "在王镕军中成长，奉命助晋",
      "summary": "早年为成德王镕部将，积功至列校；王镕与晋结盟后常率军随李存勖征讨。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "本传未记具体年次",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p5",
          "originalRevision": 1,
          "originalSha256": "fd66fe424318db3443c8b86aa7933d1bb8a4566ac595ef7ad0174213e79d216b",
          "excerpt": "少從軍，事節度使王鎔，積功至列校。"
        }
      ]
    },
    {
      "id": "fu-xi-avenge-rong",
      "title": "拒归张文礼，愿为旧主复仇",
      "summary": "王镕被害时符习在德胜，拒张文礼召回，向李存勖哭诉，请率本军复仇，任成德留后并得阎宝、史建瑭助讨。",
      "year": null,
      "sortOrder": 6,
      "precision": "undated",
      "sourceDate": "王镕被张文礼害后",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p5",
          "originalRevision": 1,
          "originalSha256": "fd66fe424318db3443c8b86aa7933d1bb8a4566ac595ef7ad0174213e79d216b",
          "excerpt": "莊宗即令閻寶、史建瑭助習討文禮，乃以習為成德軍兵馬留後。"
        }
      ]
    },
    {
      "id": "fu-xi-decline-chengde",
      "title": "辞成德节钺，请自己攻河南镇",
      "summary": "以旧主未葬为由不受节钺，晋王拟割相卫建义宁又被他辞拒，转授天平、东南招讨。",
      "year": null,
      "sortOrder": 7,
      "precision": "undated",
      "sourceDate": "张文礼诛后",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p5",
          "originalRevision": 1,
          "originalSha256": "fd66fe424318db3443c8b86aa7933d1bb8a4566ac595ef7ad0174213e79d216b",
          "excerpt": "但授臣河南一鎮，臣自攻取。」乃授天平軍節度、東南面招討使。"
        }
      ]
    },
    {
      "id": "fu-xi-retire-death",
      "title": "罢汴州后归昭庆，后来中风卒",
      "summary": "与安重诲不合，因加耗钱粮的奏告被罢，授太子太师致仕，归昭庆。数年后中风卒，赠太师。",
      "year": null,
      "sortOrder": 8,
      "precision": "undated",
      "sourceDate": "天成四年移汴后及退休数年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p6",
          "originalRevision": 1,
          "originalSha256": "1b23d29380f5f0a0f7c8faf9958d807aeae1ff11e54486701fa18c8c84366187",
          "excerpt": "如此累年，中風而卒。贈太師。"
        }
      ]
    }
  ]
}
