    {
      "id": "du-xiao-west-mountain-prayer-mission",
      "title": "获命赴西岳祈旱",
      "summary": "久旱已伤农事，朱温下诏命于兢赴中岳、杜晓赴西岳虔诚祈祷。杜晓所受差遣是赴西岳。",
      "year": 912,
      "sortOrder": 6,
      "precision": "day",
      "sourceDate": "乾化二年五月辛卯",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v007",
          "paragraphId": "old-v007-p1",
          "originalRevision": 1,
          "originalSha256": "7bc8352c9cc9b535dcdc167c45fb0a40a4c135052ecd0df2cc711b9e9391f1ba",
          "excerpt": "乾化二年"
        },
        {
          "chapterId": "old-v007",
          "paragraphId": "old-v007-p6",
          "originalRevision": 1,
          "originalSha256": "4c7a792c12ca63584f8665a3e272fa05068da7302a647ed02da38e3d6efa463a",
          "excerpt": "五月己卯朔，"
        },
        {
          "chapterId": "old-v007",
          "paragraphId": "old-v007-p6",
          "originalRevision": 1,
          "originalSha256": "4c7a792c12ca63584f8665a3e272fa05068da7302a647ed02da38e3d6efa463a",
          "excerpt": "辛卯，詔曰：「亢陽滋甚，農事已傷，宜令宰臣於兢赴中嶽，杜曉赴西嶽，精切祈禱。"
        }
