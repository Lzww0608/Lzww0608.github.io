      ]
    },
    {
      "id": "du-xiao-death-in-military-disorder",
      "title": "在讨友珪后的兵乱中遇害",
      "summary": "袁象先等率禁兵讨朱友珪后，军队大肆掠夺。旧传记杜晓中重创而卒，新传及通鉴记被乱兵杀死。",
      "year": 913,
      "sortOrder": 7,
      "precision": "day",
      "sourceDate": "乾化三年二月庚寅；本传未独记日",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v018",
          "paragraphId": "old-v018-p10",
          "originalRevision": 1,
          "originalSha256": "7dda01670007698df3a0d4f3aea8f476c442938fdac320e5ce0e1af429891b76",
          "excerpt": "及袁象先之討友珪，禁兵大縱，曉中重創而卒。"
        },
        {
          "chapterId": "new-v03",
          "paragraphId": "new-v03-p3",
          "originalRevision": 1,
          "originalSha256": "98ebdbbbc451796519c9d488d15c694a34b8bb055a6e0bd4609c78e9a233c955",
          "excerpt": "乾化二年六月，太祖遇弒，友珪自立，"
        },
        {
          "chapterId": "new-v03",
          "paragraphId": "new-v03-p5",
          "originalRevision": 1,
          "originalSha256": "c20dd417cce653f90ac6d34c0cf41ffbf572132dd866ca2ed618a4ffdf17a370",
          "excerpt": "明年，友珪改元曰鳳曆。"
        },
        {
          "chapterId": "new-v03",
          "paragraphId": "new-v03-p6",
          "originalRevision": 1,
          "originalSha256": "284da97e4e53dc6846016de362b330d38e7dca8cd77db4850725c54833d58134",
          "excerpt": "庚寅，象先等以禁兵討賊，友珪死，杜曉見殺。"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p89",
          "originalRevision": 1,
          "originalSha256": "7699b55dd3825075074cb4b6c7cb251762d1b58e2f40c9680cf3f0adfa5d0808",
          "excerpt": "太祖神武元聖孝皇帝下乾化三年（癸酉，公元九一三年）"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p94",
          "originalRevision": 1,
          "originalSha256": "72aeddd36bb6ef588932108e4d649c96fdd9b22d69674b3bc78c2c640947f36f",
          "excerpt": "二月，壬午，蜀大赦。"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p97",
          "originalRevision": 1,
          "originalSha256": "3ae78c4da3601f30ac8daee3dc1b21798aa5cf298ae1f490b5815bdd3ba8198e",
          "excerpt": "庚寅旦，袁象先等帥禁兵數千人突入宮中。"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p97",
          "originalRevision": 1,
          "originalSha256": "3ae78c4da3601f30ac8daee3dc1b21798aa5cf298ae1f490b5815bdd3ba8198e",
          "excerpt": "諸軍十餘萬大掠都市，百司逃散，中書侍郎、同平章事杜曉、侍講學士李珽皆為亂兵所殺，"
        }
      ],
      "notes": [
        "讨友珪、军队纵掠与杜晓被害分开叙述，不能据此说袁象先亲手杀杜晓，或说杜晓参与谋弑。",
        "新史“明年”承乾化二年事后叙次，不因其前另有乾化三年标题再加一年。"
      ],
      "variants": [
        {
          "label": "新史本传及春秋的兵乱记载",
          "sourceDate": "袁象先等讨贼时／乾化三年二月",
          "summary": "新传记杜晓为乱兵所杀，春秋记西都军大掠杀杜晓；均不指明具体持刃者。",
          "evidence": [
            {
              "chapterId": "new-v35",
              "paragraphId": "new-v35-p25",
              "originalRevision": 1,
              "originalSha256": "80022dd07c4f24dd33f05a282109abdb3e5407919c7ff8fb0e14acf7169131d0",
              "excerpt": "袁象先等討賊，兵大掠，曉為亂兵所殺，"
            },
            {
              "chapterId": "chunqiu-v001",
              "paragraphId": "chunqiu-v001-p8",
              "originalRevision": 1,
              "originalSha256": "ee515e8dde92e9ed495b297f7e9d1c053863ce39b265eb33ce482f69b953d4ca",
              "excerpt": "癸酉乾化三年二月，帝卽位於東都，誅友珪。西都軍大掠，殺杜曉。"
            },
            {
              "chapterId": "old-v018",
              "paragraphId": "old-v018-p10",
              "originalRevision": 1,
              "originalSha256": "7dda01670007698df3a0d4f3aea8f476c442938fdac320e5ce0e1af429891b76",
              "excerpt": "及袁象先之討友珪，禁兵大縱，曉中重創而卒。"
            }
          ],
          "year": 913
        }
      ]
    },
    {
      "id": "du-xiao-posthumous-right-pushe",
      "title": "末帝即位后获赠右仆射",
      "summary": "杜晓在兵乱中去世，末帝即位后下诏追赠他右仆射；新传亦记其获赠右仆射。",
      "year": 913,
      "sortOrder": 8,
      "precision": "year",
      "sourceDate": "末帝即位后，追赠诏未独记月日",
