    {
      "id": "nantang-geng-xiansheng-court-favor",
      "title": "书载因荐进、制香获宠",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 1,
      "sourceDate": "初因宋齐丘进；制香得幸均无独立年月",
      "summary": "陆游记耿先生先因宋齐丘进见，后在龙脑香故事中受到元宗宠爱；近事亦称女冠获宠。炼物神异与受宠称说分层，不补册妃。",
      "evidence": [
        {
          "chapterId": "nantanglu-v017",
          "paragraphId": "nantanglu-v017-p16",
          "originalRevision": 1,
          "originalSha256": "19a4d0caeedce600a5033bdf586d28dce005fc98495c9cb4008e39f562236dc4",
          "excerpt": "始因宋齊丘進"
        },
        {
          "chapterId": "nantanglu-v017",
          "paragraphId": "nantanglu-v017-p16",
          "originalRevision": 1,
          "originalSha256": "19a4d0caeedce600a5033bdf586d28dce005fc98495c9cb4008e39f562236dc4",
          "excerpt": "香味逾於所進，遂得幸於元宗。"
        },
        {
          "chapterId": "nantangjinshi-v002",
          "paragraphId": "nantangjinshi-v002-p24",
          "originalRevision": 1,
          "originalSha256": "dc21fde06e8fa5a8082e76e177ac8c5c1703de5f4549c3e74b10b6028a9bab1e",
          "excerpt": "獲寵於元宗"
        }
      ],
      "notes": [
        "不把后段宋太后事件的943—945年范围覆盖初荐进与制香。"
      ],
      "variants": [
        {
          "label": "《十国春秋》记保大中入宫",
          "sourceDate": "保大中，未独记年月",
          "summary": "本书记耿先生在保大中因宋齐丘入宫，元宗安置于别院，称先生；后文得幸、问术及隐去为不同叙次。",
          "notes": [
            "保大中的入宫叙次不覆盖后来全部术数故事，也不据此推定册妃。"
          ],
          "evidence": [
            {
              "chapterId": "shiguochunqiu-v034",
              "paragraphId": "shiguochunqiu-v034-p9",
