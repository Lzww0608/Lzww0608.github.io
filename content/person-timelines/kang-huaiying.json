  "events": [
    {
      "id": "kang-huaiying-join",
      "title": "以兖州降朱温",
      "summary": "康怀英原事朱瑾为牙将，朱瑾到丰沛搜粮时留他守城，他见郓州已破，向葛从周献城，归朱温。",
      "year": 897,
      "sortOrder": 0,
      "precision": "year",
      "sourceDate": "乾宁四年春",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p18",
          "originalRevision": 1,
          "originalSha256": "cd6dcce3efac8421570e3a0947f308f42bf0b74d56f82a00296d187b0c96facf",
          "excerpt": "唐乾寧四年春，太祖既平鄆，命葛從周乘勝急攻兗州。時朱瑾在豐沛間搜索糧餉，留懷英守其城。及從周軍至，懷英聞鄆失守，乃出降。"
        }
      ],
      "notes": [
        "原名怀贞，避梁末帝讳改怀英；不另建身份。"
      ]
    },
    {
      "id": "kang-huaiying-dengzhou",
      "title": "从氏叔琮攻下邓州",
      "summary": "康怀英随氏叔琮伐襄汉，以一军夺邓州。",
      "year": 898,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "光化元年秋",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p18",
          "originalRevision": 1,
          "originalSha256": "cd6dcce3efac8421570e3a0947f308f42bf0b74d56f82a00296d187b0c96facf",
          "excerpt": "光化元年秋，從氏叔琮伐襄、漢，懷英以一軍攻下鄧州。"
        }
      ]
    },
    {
      "id": "kang-huaiying-north",
      "title": "协张存敬击燕军",
      "summary": "康怀英随朱温征河朔，协张存敬在易水上败燕軍。",
      "year": 900,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "光化三年，本纪同次易水援中山败役十一月，合法900年11月25日至12月24日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p18",
          "originalRevision": 1,
          "originalSha256": "cd6dcce3efac8421570e3a0947f308f42bf0b74d56f82a00296d187b0c96facf",
          "excerpt": "三年，從征河朔，佐張存敬敗燕軍於易水之上。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p3",
          "originalRevision": 1,
          "originalSha256": "c8b02a9a0e69664da94ea536a636cd138c7243c0f19f89ba087fe21361bf33bc",
          "excerpt": "十一月，以張存敬為上將，自甘陵發軍，北侵幽、薊，連拔瀛、莫二郡，遂移軍以攻中山。定帥王郜以精甲二萬戰於懷德亭，盡殪之。郜懼，奔於太原。遲明，大軍集於城下，郜季父處直持印鑰乞降，亦以繒帛三十萬為獻，帝即以處直代郜領其鎮焉。是月，燕人劉守光赴援中山，寨于易水之上，繼為康懷英、張存敬等所敗，斬獲甚眾。由是河朔知懼，皆弭伏焉。"
        }
      ]
    },
    {
      "id": "kang-huaiying-hangu",
      "title": "夜战汉谷，伏败岐军",
      "summary": "康怀英以较少骑兵在汉谷迎击符道昭，战酣发伏，大败岐军。",
      "year": 902,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "天复二年四月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p19",
          "originalRevision": 1,
          "originalSha256": "78f34fe5092f40b215d826e478514cc3fab27b9db94872a6eaa2263d4e31b86b",
          "excerpt": "二年四月，符道昭復領大軍屯於虢縣之漢穀。其建寨之所，前臨巨澗，後倚峻阜，險不可升，太祖遣懷英提騎數千急擊之。道昭以懷英兵寡，有俯視之意，乃率甲士萬人，絕澗以挑戰。懷英始以千騎夜鬥，戰酣，發伏以擊之，岐軍大敗。"
        }
      ]
    },
    {
      "id": "kang-huaiying-sanyuan",
      "title": "三原逐李周彝，取翟州",
      "summary": "李周彝援凤翔，康怀英攻其三原军，追到梨园，取翟州；奉天又以两千余人独抗夜袭，受十余伤。",
      "year": 902,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "天复二年八月起",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p19",
          "originalRevision": 1,
          "originalSha256": "78f34fe5092f40b215d826e478514cc3fab27b9db94872a6eaa2263d4e31b86b",
          "excerpt": "秋八月，鄜帥李周彝屯軍於三原，以援鳳翔；太祖命懷英討之，周彝拔軍而遁，追至梨園，因攻下翟州，擒其守來獻。俄而岐軍屯奉天，太祖令懷英寨於岐軍之東北，以備敵人。一夕，岐軍大至，急攻其營。懷英以夜中不可驚動諸軍，獨以二千餘人抗數萬之眾，自乙夜至四鼓，身被十餘創，岐軍不勝而退。"
        }
      ]
    },
    {
      "id": "kang-huaiying-zhaozong-honor",
      "title": "昭宗返京后受功臣号，救宿州",
      "summary": "唐昭宗返回长安后，康怀英获迎銮毅勇功臣号；同年淮军趁青兖叛乱攻宿，康率骑救援、淮军退，权知宿州刺史。",
      "year": 903,
      "sortOrder": 5,
      "precision": "year",
      "sourceDate": "昭宗还京后、是岁淮军攻宿",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p5",
          "originalRevision": 1,
          "originalSha256": "41a52940f8000e80ae7659667497d9e24f380dc5ae9cf5c7e6bdf290f9225214",
          "excerpt": "天復元年正月乙酉朔，唐宰相崔允潛使人以帝密旨告于侍衛軍將孫德昭已下，令誅左右中尉劉季述、王仲先等，即時迎昭宗於東內，禦樓反正。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p9",
          "originalRevision": 1,
          "originalSha256": "02e93c9c73878385510e35b646505e0165e8d0e37d0c092e09524b42625d1866",
          "excerpt": "三年正月甲寅，岐人啟壁"
        },
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p19",
          "originalRevision": 1,
          "originalSha256": "78f34fe5092f40b215d826e478514cc3fab27b9db94872a6eaa2263d4e31b86b",
          "excerpt": "昭宗還京，賜迎鑾毅勇功臣。是歲，淮人聞青、兗之叛，遣兵數萬以寇宿州。太祖命懷英馳騎以救之，淮人遁去，即以懷英為權知宿州刺史。"
        }
      ]
    },
    {
      "id": "kang-huaiying-meiyuan",
      "title": "协刘知俊败邠凤军，领陕州",
      "summary": "康怀英协刘知俊在美原败邠凤军，乘胜取鄜州，获陕州节度使。",
      "year": 906,
      "sortOrder": 6,
      "precision": "month",
      "sourceDate": "本传天祐三年冬；本纪十月美原、十一月取鄜；授陕本传未独月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p19",
          "originalRevision": 1,
          "originalSha256": "78f34fe5092f40b215d826e478514cc3fab27b9db94872a6eaa2263d4e31b86b",
          "excerpt": "天祐三年冬，佐劉知俊破邠、鳳之眾五萬於美原，收五十餘寨，乘勝引軍攻下鄜州，以功授陝州節度使。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p18",
          "originalRevision": 1,
          "originalSha256": "d053ebd1ec22f1c800bb520b37eae8988eb1e314a5306787f84f4c7697b783be",
          "excerpt": "十月辛巳，邠州楊崇本以鳳翔、邠、寧、涇、鄜、秦、隴之眾合五六萬來寇，屯于美原，列十五寨，其勢甚盛。帝命同州節度使劉知俊、都將康懷英帥師禦之。知俊等大破邠寇，殺二萬餘眾，奪馬三千餘匹，擒其列校百餘人，楊崇本、胡章僅以身免。十一月庚戌，懷英乘勝進軍，遂收鄜州。"
        }
      ]
    },
    {
      "id": "kang-huaiying-lu-siege",
      "title": "统军围潞州，降为都虞候",
      "summary": "受朱温严厉嘱咐后康怀英围潞州、筑夹城，但受周德威扰击，不敢出战，被李思安代替。",
      "year": 907,
      "sortOrder": 7,
      "precision": "year",
      "sourceDate": "开平元年夏至六月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p20",
          "originalRevision": 1,
          "originalSha256": "538e08ea2aa7370b5ca6eaa398374233de8c75f115c480a8059b51d0a663db84",
          "excerpt": "開平元年夏，命將大軍以伐潞州。將行，太祖謂懷英曰：「卿位居上將，勇冠三軍，向來破敵摧鋒，動無遺悔，至於高爵重祿，我亦無負於卿。夫忠臣事君，有死無二，韓信所謂『漢王載我以車，衣我以衣，食我以食，食人之祿，死人之憂』。我每思韓信此言，真忠烈丈夫耳！如丁會受我待遇之恩，不謂不至，懷黃拖紫，裂土分茅，設令木石偶人，須感恩義，一朝反噬，倒戈授人，苟有天道明神，安能容此！大凡孤恩負理，忠良不為。我今掃境內委卿，卿當勉思竭盡。況晉人新得上黨，眾心未葉和，以十萬之師，一舉可克。予當置酒高會，望卿歌舞凱旋。」懷英惶恐而退。六月，懷英領大軍至潞，率眾晝夜攻城，半月之間，機巧百變。懷英懼太祖之言，期於必取，乃築壘環城，浚鑿池塹，然而屢為晉將周德威騎軍所撓，懷英不敢即戰。太祖乃以李思安代之，降為行營都虞候。"
        }
      ]
    },
    {
      "id": "kang-huaiying-lu-defeat",
      "title": "夹城大败，逃回获宽宥",
      "summary": "晋军攻破夹城，康怀英以百骑逃回请求治罪，朱温宽宥并授右卫上将军。",
      "year": 908,
      "sortOrder": 8,
      "precision": "year",
      "sourceDate": "开平二年夏五月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p20",
          "originalRevision": 1,
          "originalSha256": "538e08ea2aa7370b5ca6eaa398374233de8c75f115c480a8059b51d0a663db84",
          "excerpt": "夏五月，晉王率蕃漢大軍攻下夾城，懷英逃歸，詣銀台門待罪，太祖宥之，改授右衛上將軍。"
        },
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p5",
          "originalRevision": 1,
          "originalSha256": "324c424d906eb801c8bdcac55b4dc7ad0e0dfa0871917559c744ba2834545b59",
          "excerpt": "懷英大敗，亡大將三百人，懷英以百騎遁歸，詣闕請死。太祖曰：「去歲興兵，太陰虧食，占者以為不利，吾獨違之而致敗，非爾過也。」釋之，以為右衞上將軍。"
        },
        {
          "chapterId": "tongjian-v266",
          "paragraphId": "tongjian-v266-p65",
          "originalRevision": 1,
          "originalSha256": "2b936ed15f05130350ae856237c3659b8fde47870d7eea130e6926fcb957f75e",
          "excerpt": "太祖神武元聖孝皇帝上開平二年（戊辰，公元九零八年）"
        },
        {
          "chapterId": "tongjian-v266",
          "paragraphId": "tongjian-v266-p86",
          "originalRevision": 1,
          "originalSha256": "ab6c51d215bcff9bbe013b02a5c2e288e2e9e8ec3b05eee0312b0480d8152f36",
          "excerpt": "五月，辛未朔，晉王伏兵三垂岡下，詰旦大霧，進兵直抵夾寨。梁軍無斥候，不意晉兵之至，將士尚未起，軍中驚擾。晉王命周德威、李嗣源分兵為二道，德威攻西北隅，嗣源攻東北隅，填塹燒寨，鼓噪而入。梁兵大潰，南走，招討使符道昭馬倒，為晉人所殺。失亡將校士卒以萬計，委棄資糧、器械山積。周德威等至城下，呼李嗣昭曰：「先王已薨，今王自來，破賊夾寨。賊已去矣，可開門！」嗣昭不信，曰：「此必為賊所得，使來誑我耳。」欲射之。左右止之，嗣昭曰：「王果來，可見乎？」王自往呼之。嗣昭見王白服，大慟幾絕，城中皆哭，遂開門。初，德威與嗣昭有隙，晉王克用臨終謂晉王存勖曰：「進通忠孝，吾愛之深。今不出重圍，豈德威不忘舊怨邪！汝為吾以此意諭之。若潞圍不解，吾死不瞑目。」進通，嗣昭小名也。晉王存勖以告德威，德威感泣，由是戰夾寨甚力；既與嗣昭相見，遂歡好如初。康懷貞以百餘騎自天井關遁歸。"
        }
      ]
    },
    {
