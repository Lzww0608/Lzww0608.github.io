{
  "schemaVersion": 1,
  "personId": "ma-xisheng",
  "scope": "current-archive",
  "events": [
    {
      "id": "ma-xisheng-kill-gaoyu",
      "year": 929,
      "sourceDate": "天成四年八月（通鉴同事）；新史只记父亲卒前一年",
      "title": "听荆南挑拨，矫命杀高郁",
      "summary": "信“亡马氏者必高郁”的挑拨，夺其军职，后以父亲名义处死；马殷当时未预知。",
      "evidence": [
        {
          "chapterId": "new-v66",
          "paragraphId": "new-v66-p14",
          "originalRevision": 1,
          "originalSha256": "fcf7530adffb02caab777d3f4b2b7eb11ad61361d9931fe45d652975afaadd23",
          "excerpt": "希聲字若訥，殷次子也。殷建國，以希聲判內外諸軍事。荊南高季昌聞殷將高郁素教殷以計策而楚以彊，患之，嘗使諜者行間於殷，殷不聽。希聲用事，諜者語希聲曰：「季昌聞楚用高郁，大喜，以為亡馬氏者必郁也。」希聲素愚，以為然，遽奪郁兵職，郁怒曰：「吾事君王久矣，亟營西山，將老焉，犬子漸大，能咋人矣！」希聲聞之，矯殷令殺郁。殷老不復省事，莫知郁死，是日大霧四塞，殷怪之，語左右曰：「吾嘗從孫儒，儒每殺不辜，天必大霧，豈馬步獄有冤死乎？」明日，吏以狀白，殷拊膺大哭曰：「吾荒耄如此，而殺吾勳舊！」顧左右曰：「吾亦不久於此矣！」明年殷薨。"
        },
        {
          "chapterId": "tongjian-v276",
          "paragraphId": "tongjian-v276-p82",
          "originalRevision": 1,
          "originalSha256": "9e20379d9f9c72c306add67700105f80f5bb222cb6c9cfe254e8f2b07f66e97b",
          "excerpt": "明宗聖德和武欽孝皇帝中之上天成四年（己丑，公元九二九年）"
        },
        {
          "chapterId": "tongjian-v276",
          "paragraphId": "tongjian-v276-p104",
          "originalRevision": 1,
          "originalSha256": "c6027f25d9eee0dc9e6d7c029f5712a1fde451c18928f2543c9561c38bf3ddcf",
          "excerpt": "八月，吳武昌節度使兼侍中李簡以疾求還江都，"
        },
        {
          "chapterId": "tongjian-v276",
          "paragraphId": "tongjian-v276-p105",
          "originalRevision": 1,
          "originalSha256": "1c8cc5f998525c0f23fb09366074e198ff3af3ded124fc666b0a45dfa7de12e7",
          "excerpt": "希聲聞之，益怒，明日，矯以殷命殺鬱於府捨，"
        }
      ],
      "phase": "early",
      "precision": "month",
      "sortOrder": 0
    },
    {
      "id": "ma-xisheng-accession",
      "year": 930,
      "sourceDate": "长兴元年十一月丙戌（通鉴同次承主；新史接马殷卒后）",
      "title": "承掌军府，受两军节度使职",
      "summary": "承主后受武安、静江等军节度使，不虚称在位皇帝。",
      "evidence": [
        {
          "chapterId": "new-v66",
          "paragraphId": "new-v66-p12",
          "originalRevision": 1,
          "originalSha256": "601dec153910b5fa84c5522ec75956e91577f9c94969102343e3419d0d2522e8",
          "excerpt": "天成二年，請建行臺。明宗封殷楚國王，有司言無封國王禮，請如三公用竹冊，乃遣尚書右丞李序持節以竹冊封之。殷以潭州為長沙府，建國承制，自置官屬，以其弟賨為靜江軍節度使，子希振武順軍節度使，次子希聲判內外諸軍事，姚彥章為左相，許德勳為右相，李鐸為司徒，崔穎為司空，拓拔常為僕射，馬珙為尚書，文武皆進位。謚其曾祖筠曰文肅、祖正曰莊穆、父元豐曰景莊，立三廟于長沙。長興元年，殷卒，年七十九，詔曰「馬殷官爵俱高，無以為贈，謚曰武穆」而已。子希聲立。"
        },
        {
          "chapterId": "new-v66",
          "paragraphId": "new-v66-p15",
          "originalRevision": 1,
          "originalSha256": "97dcdd2c183d6149737ee025b7a73bc4886f2fd4833f35f2d9da0bbdbdbdd565",
          "excerpt": "希聲立，授武安、靜江等軍節度使。希聲嘗聞梁太祖好食鷄，慕之，乃日烹五十鷄以供膳。葬殷上潢，希聲不哭泣，頓食鷄肉數器而起，其禮部侍郎潘起譏之曰：「昔阮籍居喪而食蒸豚，世豈乏賢邪！」長興三年，希聲卒，追封衡陽王。弟希範立。"
        },
        {
          "chapterId": "tongjian-v277",
          "paragraphId": "tongjian-v277-p3",
          "originalRevision": 1,
          "originalSha256": "8709486d3034a19b82c73e1fa48043499cc6c8a01be3b44793d787b2c3b2641f",
          "excerpt": "明宗聖德和武欽孝皇帝中之下長興元年（庚寅，公元九三零年）"
        },
        {
          "chapterId": "tongjian-v277",
          "paragraphId": "tongjian-v277-p49",
          "originalRevision": 1,
          "originalSha256": "640ec5fca1c89637140c58e9653bc85e783db1ce6055bdcd779ffd4f2527b8ae",
          "excerpt": "十一月，戊辰，"
        },
        {
          "chapterId": "tongjian-v277",
          "paragraphId": "tongjian-v277-p52",
          "originalRevision": 1,
          "originalSha256": "178c49d668fe649dcab22a8ac968cae7b38d49eb83cbc4d987b6328923f543ff",
          "excerpt": "丙戌，馬希聲襲位，稱遺命去建國之制，復籓鎮之舊。"
        }
      ],
      "phase": "rule",
      "precision": "day",
      "sortOrder": 1
    },
    {
      "id": "ma-xisheng-drought",
      "year": 932,
      "sourceDate": "长兴三年七月记事，湖南比年大旱",
      "title": "大旱闭神祠，未能得雨",
      "summary": "因连续干旱命闭南岳及境内神祠，仍不下雨；这是当时求雨措施，不视为可验证超自然成因。",
      "evidence": [
        {
          "chapterId": "tongjian-v278",
          "paragraphId": "tongjian-v278-p3",
          "originalRevision": 1,
          "originalSha256": "c88b3f61203095fba9a422d2fca873ff5aed5d14b31bf88b87f63870d4707c2f",
          "excerpt": "明宗聖德和武欽孝皇帝下長興三年（壬辰，公元九三二年）"
        },
        {
          "chapterId": "tongjian-v278",
          "paragraphId": "tongjian-v278-p7",
          "originalRevision": 1,
          "originalSha256": "602a9155862667c24157ed28377b70a64f90fed9ec2fe917260f4acac94d60ed",
          "excerpt": "武安、靜江節度使馬希聲以湖南比年大旱，命閉南嶽及境內諸神祠門，竟不雨。辛卯，希聲卒，六軍使袁詮、潘約等迎鎮南節度使希範於朗州而立之。"
        },
        {
          "chapterId": "tongjian-v278",
          "paragraphId": "tongjian-v278-p4",
          "originalRevision": 1,
          "originalSha256": "5614b0d5f96779bbf9b26acc9dd6cc39b13f4734c26771b8bd7c1915996c4636",
          "excerpt": "秋，七月，辛巳，"
        }
      ],
      "phase": "rule",
      "precision": "month",
      "sortOrder": 2
    },
