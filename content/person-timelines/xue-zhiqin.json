  "events": [
    {
      "id": "xue-zhiqin-shangyuan-escape",
      "title": "上源驿护送李克用突围",
      "summary": "随李克用援陈许、平黄巢，遇上源驿袭击时登楼射击，扶李克用离去并率部血战过桥，护送其回营。",
      "year": 884,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "中和四年上源驿之难；同役史敬思传记六月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p4",
          "originalRevision": 1,
          "originalSha256": "e0d979de6635a9d8b66ffaefe86fff8fa2e08e3b80d191564da7874266f4f351",
          "excerpt": "因扶武皇而去。雷雨暴猛，汴人扼橋，誌勤以其屬血戰擊敗之，得侍武皇還營，由是恩顧益厚。"
        },
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p5",
          "originalRevision": 1,
          "originalSha256": "2a4c699148de32ef9e2b6a865212889b93c3de14292da189b2c83802f8a3398f",
          "excerpt": "中和四年，從援陳、許，為前鋒，"
        }
      ],
      "notes": [
        "年份据同卷史敬思传中和四年记事，原传本段没有单独写年。"
      ]
    },
    {
      "id": "xue-zhiqin-meng-keng",
      "title": "蒙坑败韩建，收晋绛",
      "summary": "张浚攻太原时，与李承嗣率三千骑抵御，败韩建于蒙坑，收晋、绛，因功授忻州刺史。",
      "year": 890,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "大顺初年十月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p4",
          "originalRevision": 1,
          "originalSha256": "e0d979de6635a9d8b66ffaefe86fff8fa2e08e3b80d191564da7874266f4f351",
          "excerpt": "大順初，張浚以天子之師來侵太原。十月，大軍入陰地，誌勤與李承嗣帥騎三千抗之，敗韓建之軍於蒙坑，進收晉、絳，以功授忻州刺史。"
        }
      ]
    },
    {
      "id": "xue-zhiqin-zhenzhou",
      "title": "随军攻镇州，先登陷阵",
      "summary": "随李克用讨镇州，收天长、临城，在战斗中先登城、冲敌阵。",
      "year": 891,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "大顺二年；武皇纪同役十月取临城",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p4",
          "originalRevision": 1,
          "originalSha256": "e0d979de6635a9d8b66ffaefe86fff8fa2e08e3b80d191564da7874266f4f351",
          "excerpt": "二年，從討鎮州，收天長、臨城，誌勤皆先登陷陣，勇敢無前。"
        },
        {
          "chapterId": "old-v025",
          "paragraphId": "old-v025-p26",
          "originalRevision": 1,
          "originalSha256": "203f5dc62a0db50d1539a2fb839ee713a787d9c9e28aa99bf43ee4ba98676143",
          "excerpt": "大順二年春正月，武皇上章申理，"
        },
        {
          "chapterId": "old-v025",
          "paragraphId": "old-v025-p27",
          "originalRevision": 1,
          "originalSha256": "6a38fa5e2794eecc6276f995dc358f8e5f8054c0eb7475c2ad1089d7b4b149d6",
          "excerpt": "十月，李存孝董前軍攻臨城，鎮人五萬營於臨城西北龍尾崗。"
        }
      ]
    },
    {
