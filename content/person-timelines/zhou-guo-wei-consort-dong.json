{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "zhou-guo-wei-consort-dong",
  "events": [
    {
      "id": "zhou-guo-wei-consort-dong-defei-conferral",
      "title": "册为德妃",
      "summary": "周初中宫虚位，董氏获册德妃。",
      "year": 951,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "广顺元年四月甲午",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v111",
          "paragraphId": "old-v111-p3",
          "originalRevision": 1,
          "originalSha256": "ca95f2a0a896eed032a0ccaa5c116dbb3e3d086bd2f28f2ec498a2be37c9a319",
          "excerpt": "甲午，以夫人董氏為德妃，仍令所司備禮冊命。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-dong-attendant-arrangement",
      "title": "病中安排内人从行而受阻",
      "summary": "董氏患病时安排司簿以下人员随行，并派内使传意；郭威命郑仁诲拦阻，不证明内人已经到行营。",
      "year": 953,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "旧本传广顺三年夏，源年与本纪病卒年不同",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v121",
          "paragraphId": "old-v121-p6",
          "originalRevision": 1,
          "originalSha256": "b3dfdc650c2129879c0fa1ba17dfe19d7dfe2f211d13bb3bba9c38f42177ed8c",
          "excerpt": "司簿已下典事者，各已處分從行。"
        },
        {
          "chapterId": "old-v121",
          "paragraphId": "old-v121-p6",
          "originalRevision": 1,
          "originalSha256": "b3dfdc650c2129879c0fa1ba17dfe19d7dfe2f211d13bb3bba9c38f42177ed8c",
          "excerpt": "如德妃津置內人東來，便須上聞約住，或取索鞍馬，不得供應。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-dong-lost-and-fostered",
      "title": "幼年失散并受养育",
      "summary": "董氏七岁与家人失散，受潞州牙将妻疼爱养育。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "七岁起，绝对年未详",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p12",
          "originalRevision": 1,
          "originalSha256": "ee1087d45cfa7ab9189de4e568751b62a9221025f2e7b5cf6a9c407244847f0a",
          "excerpt": "年七歲，鎮州亂，其家失之，為潞州牙將所得，寘諸褚中以歸。"
        },
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p12",
          "originalRevision": 1,
          "originalSha256": "ee1087d45cfa7ab9189de4e568751b62a9221025f2e7b5cf6a9c407244847f0a",
          "excerpt": "潞將妻嘗生女，輒不育，得妃憐之，養以為子，過於所生。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-dong-returned-home",
      "title": "兄寻访后十三岁归家",
      "summary": "兄瑀长期寻访，后潞将欣然送还董氏，时年十三；年数六七/五六分别保存。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "十三岁，绝对年未详",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p12",
          "originalRevision": 1,
          "originalSha256": "ee1087d45cfa7ab9189de4e568751b62a9221025f2e7b5cf6a9c407244847f0a",
          "excerpt": "潞將仕于京師，遇瑀，欣然歸之，年十三。"
        },
        {
          "chapterId": "old-v121",
          "paragraphId": "old-v121-p6",
          "originalRevision": 1,
          "originalSha256": "b3dfdc650c2129879c0fa1ba17dfe19d7dfe2f211d13bb3bba9c38f42177ed8c",
          "excerpt": "其兄瑀諸處求訪，垂六七年。"
        },
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p12",
          "originalRevision": 1,
          "originalSha256": "ee1087d45cfa7ab9189de4e568751b62a9221025f2e7b5cf6a9c407244847f0a",
          "excerpt": "居五六年，妃家悲思，其兄瑀求之人間，莫知所在。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-dong-liu-marriage-and-widowhood",
      "title": "嫁刘进超，夫亡后寡居洛阳",
      "summary": "董氏归家后嫁同乡刘进超；契丹破晋时夫亡，后寡居洛阳。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "归家逾年；契丹破晋之岁",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p13",
          "originalRevision": 1,
          "originalSha256": "ac08d99622e208e66ac8dd14a51904081bc275b859fa14f7cddf6426d9cc2ae9",
          "excerpt": "瑀以嫁里人劉進超，進超亦仕晉為內職。"
        },
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p13",
          "originalRevision": 1,
          "originalSha256": "ac08d99622e208e66ac8dd14a51904081bc275b859fa14f7cddf6426d9cc2ae9",
          "excerpt": "契丹犯闕，進超歿于虜中，妃嫠居洛陽。"
        },
        {
          "chapterId": "old-v121",
          "paragraphId": "old-v121-p6",
          "originalRevision": 1,
          "originalSha256": "b3dfdc650c2129879c0fa1ba17dfe19d7dfe2f211d13bb3bba9c38f42177ed8c",
          "excerpt": "妃歸逾年，嫁為里人劉進超之妻"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-dong-guo-marriage",
      "title": "由郭威聘娶",
      "summary": "郭威随汉高祖经过洛阳时，按本传记闻董氏贤行而聘娶。",
      "year": null,
      "sortOrder": 6,
      "precision": "undated",
      "sourceDate": "汉高祖由太原入京过洛时",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p13",
          "originalRevision": 1,
          "originalSha256": "ac08d99622e208e66ac8dd14a51904081bc275b859fa14f7cddf6426d9cc2ae9",
          "excerpt": "漢高祖由太原入京師，太祖從，過洛陽，聞妃有賢行，聘之。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-dong-death-and-burial",
      "title": "病卒及安葬，年次分源",
      "summary": "本纪广顺二年六月记董氏卒、十月记葬德妃；两本传则记广顺三年卒。来源年次并存，不统一成唯一卒年。",
      "year": null,
      "sortOrder": 7,
      "precision": "range",
      "sourceDate": "本纪广顺二年六月癸卯、十月丁酉；本传广顺三年夏/三年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v112",
          "paragraphId": "old-v112-p9",
          "originalRevision": 1,
          "originalSha256": "d683b40b3d8784be282ba06299bbb99ce32c6486f7690220dc29b044093b6466",
          "excerpt": "癸卯，德妃董氏薨。"
        },
        {
          "chapterId": "old-v112",
          "paragraphId": "old-v112-p13",
          "originalRevision": 1,
          "originalSha256": "2c17c814f318cf1dab1338ecb66cd4be7c4e269a287da0b09f0aae628557a088",
          "excerpt": "丁酉，葬德妃，廢朝。"
        }
      ],
      "yearRange": {
        "start": 952,
        "end": 953
      },
      "variants": [
        {
          "label": "两史本传三年",
          "summary": "旧本传记三年夏患病后卒，新本传直记三年卒。",
          "evidence": [
            {
              "chapterId": "old-v121",
              "paragraphId": "old-v121-p6",
              "originalRevision": 1,
              "originalSha256": "b3dfdc650c2129879c0fa1ba17dfe19d7dfe2f211d13bb3bba9c38f42177ed8c",
              "excerpt": "廣順三年夏，遇疾，"
            },
            {
              "chapterId": "new-v19",
              "paragraphId": "new-v19-p13",
              "originalRevision": 1,
              "originalSha256": "ac08d99622e208e66ac8dd14a51904081bc275b859fa14f7cddf6426d9cc2ae9",
              "excerpt": "廣順三年卒，年三十九。"
            }
          ],
          "sourceDate": "广顺三年夏（旧本传）；广顺三年（新本传）"
        }
      ]
    }
  ]
}
