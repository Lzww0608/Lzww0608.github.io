          "originalRevision": 1,
          "originalSha256": "6b6b59509fb789974ac73f2f42524a30f142bb87ece04716a7ee592cf6a399b6",
          "excerpt": "唐元敬宋太后殂。"
        }
      ],
      "variants": [
        {
          "label": "马令谥元恭",
          "sourceDate": "保大三年，马令未独记月日",
          "summary": "马令记该年殂、葬永陵，谥元恭。",
