    {
      "id": "nantang-song-fujin-mourn-li-parents",
      "title": "陪李昪为李氏考妣服丧",
      "summary": "李昪恢复李姓后为亡父母发哀，宋皇后与他服斩衰、居庐；礼仪时长与父母当年的去世时间分开。",
      "year": 939,
      "precision": "day",
      "phase": "service",
      "sortOrder": 4,
      "sourceDate": "昇元三年二月己卯，为李氏考妣发哀时",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v015",
          "paragraphId": "shiguochunqiu-v015-p5",
          "originalRevision": 1,
          "originalSha256": "8720035d31f21bad4a4d75ff6d184cbe79817e8037a13024d5eb9edd236a0733",
          "excerpt": "己卯，帝御興祥殿，改國號曰大唐，復姓李氏，爲考妣發哀，與皇后服斬衰，居廬，如始喪禮，持考妣喪各二十七日，凡五十四日不視朝，旦暮臨。"
        },
        {
          "chapterId": "nantanglu-v001",
          "paragraphId": "nantanglu-v001-p6",
          "originalRevision": 1,
          "originalSha256": "7a7b65ffa39a2b8580afa626078026c3d2006042722797550cf31892f407ef7a",
          "excerpt": "已夘帝御興祥殿復姓為考妣發哀與皇后皆服斬縗居廬如始喪禮服考妣喪各二十七日凡五十四日不視朝旦暮臨"
        }
      ],
      "notes": [
        "各二十七日、合五十四日为原书所记礼仪时长，不据此计算宋后独立终服日。"
      ]
    },
    {
      "id": "nantang-song-fujin-decline-regency",
      "title": "拒绝临朝听政提议",
      "summary": "烈祖殁后，孙晟拟称遗诏奉宋后听政，她以武后故事拒绝，未实际临朝。",
      "year": 943,
      "precision": "year",
      "phase": "later",
      "sortOrder": 5,
      "sourceDate": "烈祖晏驾后、元宗即位交接叙次；未独记月日",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p3",
          "originalRevision": 1,
          "originalSha256": "9457139a552006c5c0c2ea53ef33a48c60ad23463a85eac3a583a9deea86b19e",
          "excerpt": "及晏駕，中書侍郎孫晟懼魏岑、馮延巳、延魯以東官舊僚用事，欲稱遺詔奉后臨朝聽政，后不許，曰：「此武后故事，吾豈爲之！」"
        }
      ],
      "variants": [
        {
          "label": "陆游姓名异写",
          "sourceDate": "烈祖殂后、元宗即位交接时，未独记日",
          "summary": "陆游本段主谋名写孙忌，拒绝之事同按本源保存。",
          "evidence": [
            {
              "chapterId": "nantanglu-v016",
              "paragraphId": "nantanglu-v016-p3",
              "originalRevision": 1,
              "originalSha256": "5ddfc08c1852cb07cf197425373f088e86209e1017075d5497c8081d515f629a",
              "excerpt": "中書侍郎孫忌懼魏岑馮延己延魯以東宮舊僚用事欲稱遺詔奉后臨朝聽政后不許"
            }
          ]
        },
        {
          "label": "马令记李夷邺阻止监国议",
          "sourceDate": "烈祖殂后、元宗即位交接时，未独记日",
          "summary": "大臣欲奉宋后监国，命孙晟草诏；李夷邺反对，议遂寝。与宋后本人拒绝的叙法分源，不改为已经监国。",
          "evidence": [
            {
              "chapterId": "nantangma-v010",
              "paragraphId": "nantangma-v010-p16",
              "originalRevision": 1,
              "originalSha256": "b72179b01804b5ea552150b17ef6228dd0780c0240df648ccae7f43541499861",
              "excerpt": "烈祖殂大臣欲以宋后監國命中書侍郎孫晟草遺詔夷鄴曰此非先旨必姦人詐為大行嘗云婦人預政亂之本也安𡧓自作禍階且嗣君明徳聞於天下汝曹何遽為亡國之事乎若遂宣行吾對百寮裂之必矣於是監國之議遂寢"
            }
          ]
        }
      ]
    },
    {
