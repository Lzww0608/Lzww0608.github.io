{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "li-shaowen",
  "events": [
    {
      "id": "li-shaowen-baixiang-defeat",
      "title": "梁军柏乡败后，与曹儒收残兵",
      "summary": "原张从楚在王景仁军，柏乡败后与曹儒收残军，退守相州。",
      "year": 911,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天祐八年柏乡败退；周德威传同役正月二日大战，收残军接叙，西历911年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p18",
          "originalRevision": 1,
          "originalSha256": "ff0518d36247e9d7d23629e90d296affaf9ef55f9b95575bc4c69f0365a3ce6b",
          "excerpt": "天祐八年，從王景仁戰，敗於柏鄉，紹文與別將曹儒收殘眾，退保相州。"
        },
        {
          "chapterId": "old-v056",
          "paragraphId": "old-v056-p7",
          "originalRevision": 1,
          "originalSha256": "7a6428b761cf83c37ec022e0f5f700e2a952b79061f6b8e2664b1d0a1912cabf",
          "excerpt": "八年正月二日，德威率騎軍致師於柏鄉，設伏於村塢間，令三百騎以壓汴營。"
        }
      ]
    },
    {
      "id": "li-shaowen-yunzhou-zhongdu",
      "title": "随李嗣源收郓，战中都",
      "summary": "李嗣源取郓州后用其为右都押衙、马步军都将，随破王彦章于中都。",
      "year": 923,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "同光元年郓州袭取及十月中都战；通鉴郓州、本纪中都同役，均可核923年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p18",
          "originalRevision": 1,
          "originalSha256": "ff0518d36247e9d7d23629e90d296affaf9ef55f9b95575bc4c69f0365a3ce6b",
          "excerpt": "明宗收鄆州，以紹文為右都押衙、馬步軍都將，從破王彥章於中都。"
        },
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p13",
          "originalRevision": 1,
          "originalSha256": "3a162019f62d4e29ba3d906b7ae410894648af0bae61bf450922eec8c922c511",
          "excerpt": "夜，渡河至城下，鄆人不知，李從珂先登，殺守卒，啟關納外兵，進攻牙城，城中大擾。"
        },
        {
          "chapterId": "old-v030",
          "paragraphId": "old-v030-p1",
          "originalRevision": 1,
          "originalSha256": "d71abe0cfc4af07b1afc1ad247ec5234a457dc79fcd44f697d561707641d8850",
          "excerpt": "同光元年冬十月辛未朔，日有食之。"
        }
      ]
    },
    {
      "id": "li-shaowen-wuxin-command",
      "title": "由夔州改遂州武信",
      "summary": "明宗本纪明确以夔州节度李绍文为遂州节度，与本传明宗初任武信互证；遂州为武信军治所的称谓在本纪次年也明确相连，不把此前洋州镇江混为夔州。",
      "year": 926,
      "sortOrder": 3,
      "precision": "day",
      "sourceDate": "天成元年五月甲子",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v036",
          "paragraphId": "old-v036-p2",
          "originalRevision": 1,
          "originalSha256": "c657cbf1a74e96c14c58230cf4836ce20ba5e74b94126c8ccef01a645c7ff6a9",
          "excerpt": "五月丙辰朔，帝不視朝，臨於西宮。"
        },
        {
          "chapterId": "old-v036",
          "paragraphId": "old-v036-p3",
          "originalRevision": 1,
          "originalSha256": "465386c52a2bd3b1e3453fba8ce770ab84d2444e6a1c507692a771659b2b2bcd",
          "excerpt": "甲子，前西都留守、京兆尹張筠加檢校太傅，充山南西道節度使；以夔州節度使李紹文為遂州節度使；"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p7",
          "originalRevision": 1,
          "originalSha256": "f92c8127d045f47cd8ba1aad4410727003b075e3ce050945e1668a27d6aa00be",
          "excerpt": "甲寅，以西川節度副使李敬周為遂州武信軍留後。"
        }
      ]
    },
    {
      "id": "li-shaowen-kuizhou",
      "title": "由洋州留后授夔州节度",
      "summary": "庄宗本纪记由洋州留后授夔州节度；本传前叙平蜀后洋州及镇江军军号，分清本纪夔州任命与主传镇江称谓，不把两地混作同一镇。",
      "year": 926,
      "sortOrder": 4,
      "precision": "day",
      "sourceDate": "同光四年二月戊申",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v034",
          "paragraphId": "old-v034-p1",
          "originalRevision": 1,
          "originalSha256": "e999d8e865c544fde75cfdd46cd5c491ffccb30c8fb9977389720c1ee72cd747",
          "excerpt": "同光四年春正月戊午朔，帝不受朝賀，契丹寇渤海。"
        },
        {
          "chapterId": "old-v034",
          "paragraphId": "old-v034-p3",
          "originalRevision": 1,
          "originalSha256": "2096b4571acb954e13d4d989be9d07606403018a68c5bb578f0f7d34b26a445b",
          "excerpt": "二月己丑，以宣徽南院使、知內侍省兼內勾、特進、右領軍衛上將軍李紹宏為驃騎大將軍、守左武衛上將軍、知內侍省，充樞密使。"
        },
        {
          "chapterId": "old-v034",
          "paragraphId": "old-v034-p6",
          "originalRevision": 1,
          "originalSha256": "0186f7e3c996ad0648dc3cef19209806c037cf216c80fce486711387bfd77df1",
          "excerpt": "戊申，以洋州留後李紹文為夔州節度使。"
        }
      ]
    },
    {
      "id": "li-shaowen-wuxin-death",
      "title": "武信在任卒",
      "summary": "本传记天成初任武信、不久在任卒；明宗本纪在天成二年三月乙卯因武信李绍文卒停朝，将原传未定年的结局与明确本纪年月合看，乙卯是记废朝日，不强定为死亡日。",
      "year": 927,
      "sortOrder": 5,
      "precision": "month",
      "sourceDate": "天成二年三月乙卯记废朝，本纪未另记具体死亡日",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p18",
          "originalRevision": 1,
          "originalSha256": "ff0518d36247e9d7d23629e90d296affaf9ef55f9b95575bc4c69f0365a3ce6b",
          "excerpt": "天成初，為武信軍節度使，尋卒於鎮。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p1",
          "originalRevision": 1,
          "originalSha256": "9d87b1c57668e7956817a8e6cda6a379c9ef48f4de24ec5889ed550184fa1fe7",
          "excerpt": "天成二年春正月癸丑朔，帝御明堂殿受朝賀，仗衛如常儀。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p7",
          "originalRevision": 1,
          "originalSha256": "f92c8127d045f47cd8ba1aad4410727003b075e3ce050945e1668a27d6aa00be",
          "excerpt": "三月壬子朔，以中書舍人馬縞為刑部侍郎。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p7",
          "originalRevision": 1,
          "originalSha256": "f92c8127d045f47cd8ba1aad4410727003b075e3ce050945e1668a27d6aa00be",
          "excerpt": "乙卯，開府儀同三司、司徒致仕趙光逢可太保致仕，仍封齊國公。以武信軍節度使李紹文卒廢朝。"
        }
      ]
    },
    {
      "id": "li-shaowen-early-zhuxuan",
      "title": "由朱瑄帐下转事朱温",
      "summary": "本姓张、名从楚，早事朱瑄，朱瑄败后归朱温，任四镇牙校。",
      "year": null,
      "sortOrder": 6,
      "precision": "undated",
      "sourceDate": "本传未记具体年次",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p18",
          "originalRevision": 1,
          "originalSha256": "ff0518d36247e9d7d23629e90d296affaf9ef55f9b95575bc4c69f0365a3ce6b",
          "excerpt": "少事朱瑄為帳下，瑄敗，歸於梁祖，為四鎮牙校，累典諸軍。"
        }
      ]
    },
    {
      "id": "li-shaowen-join-jin-name",
      "title": "魏州归晋，获赐名并掌匡霸军",
      "summary": "晋军攻魏时因渡河无舟，沿黎阳等掠物至魏州归李存勖，被赐姓名李绍文，和曹儒分掌三千人组匡霸军。",
      "year": null,
      "sortOrder": 7,
      "precision": "undated",
      "sourceDate": "柏乡战后晋军攻魏期间",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p18",
          "originalRevision": 1,
          "originalSha256": "ff0518d36247e9d7d23629e90d296affaf9ef55f9b95575bc4c69f0365a3ce6b",
          "excerpt": "莊宗嘉納之，賜姓名，分其兩將三千人為左右匡霸軍旅，仍令紹文、曹儒分將之。"
        }
      ]
    },
    {
      "id": "li-shaowen-bozhou",
      "title": "授博州，后参与元城战",
      "summary": "天祐十二年授博州刺史，此后参与故元城败刘鄩，历贝隰代州；不把后续元城胜战强定915。",
      "year": null,
      "sortOrder": 8,
      "precision": "range",
      "sourceDate": "天祐十二年授博州，未记月；随后参与故元城战，本纪同役十三年三月，两个阶段西历915—916年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p18",
          "originalRevision": 1,
          "originalSha256": "ff0518d36247e9d7d23629e90d296affaf9ef55f9b95575bc4c69f0365a3ce6b",
          "excerpt": "十二年，授博州刺史，預破劉鄩於故元城，曆貝、隰、代三郡刺史，"
        },
        {
          "chapterId": "old-v028",
          "paragraphId": "old-v028-p22",
          "originalRevision": 1,
          "originalSha256": "60e97b29104c563810870655ca9fd862ff39fba8d8185e069a0fd41f2d3de026",
          "excerpt": "天祐十三年春二月，帝知劉鄩將謀速戰，乃聲言歸晉陽以誘之，實勞軍於貝州也；令李存審守其營。"
        },
        {
          "chapterId": "old-v028",
          "paragraphId": "old-v028-p22",
          "originalRevision": 1,
          "originalSha256": "60e97b29104c563810870655ca9fd862ff39fba8d8185e069a0fd41f2d3de026",
          "excerpt": "三月，鄩遣其將楊延直自澶州率兵萬人，會於城下。"
        },
        {
          "chapterId": "old-v028",
          "paragraphId": "old-v028-p22",
          "originalRevision": 1,
          "originalSha256": "60e97b29104c563810870655ca9fd862ff39fba8d8185e069a0fd41f2d3de026",
          "excerpt": "俄而帝自貝州至，鄩卒見帝，驚曰：「晉王耶！」因引軍漸卻，至故元城西，李存審大軍已成列矣。"
        }
      ],
      "yearRange": {
        "start": 915,
        "end": 916
      }
    },
    {
      "id": "li-shaowen-yan-and-zhen",
      "title": "从周德威讨燕，后为讨镇州军虞候",
      "summary": "从周德威讨刘守光，掌匡卫军；后来从阎宝讨张文礼，任马步军都虞候。",
      "year": null,
      "sortOrder": 9,
      "precision": "undated",
      "sourceDate": "征燕及后来的征镇州期间",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p18",
          "originalRevision": 1,
          "originalSha256": "ff0518d36247e9d7d23629e90d296affaf9ef55f9b95575bc4c69f0365a3ce6b",
          "excerpt": "從閻寶討張文禮，為馬步軍都虞候。"
        }
      ]
    },
    {
      "id": "li-shaowen-shu-campaign",
      "title": "征蜀后任洋州留后",
      "summary": "同光三年从郭崇韬征西川，任洋州节度留后，领镇江军节度。",
      "year": null,
      "sortOrder": 10,
      "precision": "range",
      "sourceDate": "同光三年随征蜀，后任洋州留后，授任未记月；同光四年本纪已由洋州留后转夔州，西历925—926年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v059",
          "paragraphId": "old-v059-p18",
          "originalRevision": 1,
          "originalSha256": "ff0518d36247e9d7d23629e90d296affaf9ef55f9b95575bc4c69f0365a3ce6b",
          "excerpt": "三年，從郭崇韜討西川，為洋州節度留後，領鎮江軍節度。"
        },
        {
          "chapterId": "old-v034",
          "paragraphId": "old-v034-p6",
          "originalRevision": 1,
          "originalSha256": "0186f7e3c996ad0648dc3cef19209806c037cf216c80fce486711387bfd77df1",
          "excerpt": "戊申，以洋州留後李紹文為夔州節度使。"
        }
      ],
      "yearRange": {
        "start": 925,
        "end": 926
      }
    }
  ]
}
