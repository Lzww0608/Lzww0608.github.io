{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "li-yan-youzhou",
  "events": [
    {
      "id": "li-yan-youzhou-march-shu",
      "title": "任三川招抚，前驱劝降",
      "summary": "郭崇韬征蜀时，李严任三川招抚使，与康延孝带五千军前进，沿途以劝说和兵威促各地降。",
      "year": 925,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "同光三年征蜀起军；本纪九月十八日起军、十月李严与康延孝破三泉，同一阶段925年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p7",
          "originalRevision": 1,
          "originalSha256": "1e10392e6ae2250e91092c0900668cfc0ddf1d05f118916a95e7e8c84576afab",
          "excerpt": "郭崇韜起軍之日，以嚴為三川招撫使，嚴與先鋒使康延孝將兵五千，先驅閣道，"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p5",
          "originalRevision": 1,
          "originalSha256": "cab011cfb56bed346511ea63e5142f8445a955a847c54fad79127bdb03378baf",
          "excerpt": "客省使李嚴充西川管內招撫使，"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p5",
          "originalRevision": 1,
          "originalSha256": "cab011cfb56bed346511ea63e5142f8445a955a847c54fad79127bdb03378baf",
          "excerpt": "取九月十八日進發。"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p7",
          "originalRevision": 1,
          "originalSha256": "75c4748bf83088fb95d60eb855f5d528268444151b40fbb59978ea51e05576ab",
          "excerpt": "冬十月庚申朔，宰臣及文武三品以上官赴長壽宮，上大行皇太后諡曰貞簡皇太后。"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p8",
          "originalRevision": 1,
          "originalSha256": "05f579eae5fabdae05c1880887a6f198d67842b375ede1c317260c3f283dc801",
          "excerpt": "延孝與李嚴以勁騎三千擊之，蜀軍大敗，斬首五千級，餘眾奔潰。"
        },
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p8",
          "originalRevision": 1,
          "originalSha256": "455767cdf1721aa8b31f71f4eea5e1a58184d2d151b35283a8dc038aac9423f5",
          "excerpt": "客省使李嚴充西川管内招撫使"
        },
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p8",
          "originalRevision": 1,
          "originalSha256": "455767cdf1721aa8b31f71f4eea5e1a58184d2d151b35283a8dc038aac9423f5",
          "excerpt": "時唐排陳斬斫使李紹琛與李嚴將驍騎三千、步兵萬人爲前鋒，招討判官陳乂至寶雞稱疾乞留，學士李愚厲聲曰：“乂見利則進，懼難則止，可斬也！”由是唐軍無敢顧望者。"
        }
      ],
      "notes": [
        "本纪前锋三千骑、一万步与旧李严传将兵五千分别保源，不能相加或强认同一部队总数；凤翔李继曮/旧诏李严不归幽州客省使。"
      ]
    },
    {
      "id": "li-yan-youzhou-receive-wangyan",
      "title": "入成都受王衍托付，迎魏王",
      "summary": "王衍请他先至，众人担心被骗，他仍入益州；王衍以母妻相托，李严带蜀使欧阳彬迎魏王李继岌。",
      "year": 925,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "同光三年蜀降；本纪十一月李严先入成都同事",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p7",
          "originalRevision": 1,
          "originalSha256": "1e10392e6ae2250e91092c0900668cfc0ddf1d05f118916a95e7e8c84576afab",
          "excerpt": "嚴聞之喜，即馳騎入益州，衍見嚴於母前，以母、妻為托。即日，引蜀使歐陽彬迎謁魏王繼岌。"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p9",
          "originalRevision": 1,
          "originalSha256": "a359ba9403f75ff958178a7fd2dcf6e8ccdd11ba445ad91bde5541549028e33d",
          "excerpt": "十一月庚寅朔，帝幸壽安，號慟於坤陵。"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p9",
          "originalRevision": 1,
          "originalSha256": "a359ba9403f75ff958178a7fd2dcf6e8ccdd11ba445ad91bde5541549028e33d",
          "excerpt": "康延孝、李嚴至漢州，王衍遣人送牛酒請降，李嚴遂先入成都。"
        },
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p8",
          "originalRevision": 1,
          "originalSha256": "455767cdf1721aa8b31f71f4eea5e1a58184d2d151b35283a8dc038aac9423f5",
          "excerpt": "宗弼遣使以幣馬牛酒勞軍，且以帝手書召李嚴曰：“公來，吾卽降。”或謂嚴公：“首建伐蜀之策，至成都，禍且不測。”嚴不從，欣然馳入京城，撫諭吏民，告以大軍繼至。戊申，宣唐主勅曰：“朕以蜀部封疆，本是我唐境土，爰從兵革，遠阻江山。當僞梁篡弑之時，致宗廟震驚之難，遂滋割據，益逐便安。雖行建號之謀，乃是從權之道。況復蜀主先父，素是本朝舊臣，常懷忠孝之心，每俟興隆之運。惟期恢復，却效傾輸。朕以初殄寇讎，重興社稷，撫諭之恩既廣，憂勤之意常深，須務綏和，貴諧混一。遂令元子，兼命宰臣，遠安徯后之心，既協來王之願。遐想王師行李，已及彼地城池，遠降詔書，明行示諭。料其素志，必契夙心，當符魚水之歡，永保山河之誓。僞蜀文武官僚等，或本朝舊族，或當代英賢，或抱節于軍戎，或著名于鄉曲，久從暌隔，常軫情懷，宜知乃睠之恩，各勵輸誠之節。今以降敕命誡，約諸道兵帥，如西川果決歸降，到城不得驚擾，但思效順，勿致懷疑。”帝引嚴見太后，以母妻爲託。宗弼猶乘城爲守備，嚴悉命撤去樓櫓。己酉，魏王繼岌至綿州，帝命翰林學士李昊草降表。"
        }
      ],
      "notes": [
        "本纪引太后相见、以母妻为托和引出降分别；没有把母妻合称逐一归所有已知后妃。"
      ]
    },
    {
      "id": "li-yan-youzhou-death-chengdu",
      "title": "任西川都监后被孟知祥斩杀",
      "summary": "安重诲欲控制两川，李严自请西川都监。到成都后孟知祥责其再来监军，命王彦铢斩杀。新史明记天成二年正月，旧史写长兴初，分别保留。",
      "year": 927,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "新五代史天成二年正月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "new-v64",
          "paragraphId": "new-v64-p6",
          "originalRevision": 1,
          "originalSha256": "06387fc6ebad53f32fa6128c10709b9a9d50d9ed8e725798da4b17d8afa40550",
          "excerpt": "天成二年正月，嚴至成都，知祥置酒召嚴。"
        }
      ],
      "variants": [
        {
          "label": "旧五代史的纪年",
          "sourceDate": "长兴初",
          "summary": "旧史李严传将自请监军及被杀接叙于长兴初，与新史天成二年不同。",
          "evidence": [
            {
              "chapterId": "old-v070",
              "paragraphId": "old-v070-p7",
              "originalRevision": 1,
              "originalSha256": "1e10392e6ae2250e91092c0900668cfc0ddf1d05f118916a95e7e8c84576afab",
              "excerpt": "長興初，安重誨謀欲控製兩川，嚴乃求為西川兵馬都監，庶效方略。孟知祥覺之，既至，執而害之。"
            }
          ]
        },
        {
          "label": "新史明宗本纪记载位置",
          "sourceDate": "天成二年二月",
          "year": 927,
          "summary": "本纪二月记孟知祥杀李严，孟知祥传明确写正月抵成都；记事位置与抵达日分别保留。",
          "evidence": [
            {
              "chapterId": "new-v06",
              "paragraphId": "new-v06-p12",
              "originalRevision": 1,
              "originalSha256": "6b17ea6ee7ce937f8b1e9cc79727e6065e7dad31fbdf0241c09b803552acf880",
              "excerpt": "西川節度使孟知祥殺其兵馬都監李嚴。"
            }
          ]
        }
      ]
    },
    {
      "id": "li-yan-youzhou-early-yan",
      "title": "本名让坤，早仕燕为刺史",
      "summary": "出身幽州，本名让坤，初在燕任刺史，能骑射、读史和应对；此人与凤翔李严（李从曮）分开。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "本传未记具体年次",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p6",
          "originalRevision": 1,
          "originalSha256": "90524fb4ba83261a90a1f5cd8beae8b256c786dd1e60e18330484009198c0a67",
          "excerpt": "李嚴，幽州人，本名讓坤。初仕燕，為刺史，涉獵書傳，便弓馬，有口辯，多遊藝，以功名自許。"
        }
      ]
    },
    {
      "id": "li-yan-youzhou-envoy-to-shu",
      "title": "出使蜀，归报王衍可取",
      "summary": "同光中任客省使，出使蜀与王衍、宋光嗣辩答，观王衍失政后报告可攻取，推动征蜀谋划。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "同光中，原传以“前年”追叙皇帝即位，未单记使年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p6",
          "originalRevision": 1,
          "originalSha256": "90524fb4ba83261a90a1f5cd8beae8b256c786dd1e60e18330484009198c0a67",
          "excerpt": "時王衍失政，嚴知其可取，使還具奏，故平蜀之謀，始於嚴。"
        }
      ],
      "variants": [
        {
          "label": "本纪、引实录的使次与称名前后",
          "sourceDate": "本纪乾德六年四月来、五月还；引实录同光二年遣、三年回",
          "summary": "本纪记后唐客省使李严朝见并与宋光嗣辩答，回朝奏请取蜀；夹引实录等又有不同的使节叙年。保持客省使与凤翔节度使李严的身份区别，不据同名合并。",
          "evidence": [
            {
              "chapterId": "shiguochunqiu-v037",
              "paragraphId": "shiguochunqiu-v037-p7",
              "originalRevision": 1,
              "originalSha256": "6162c4fd88e3835fb723ba510363a122fe4c56929958a303993aee73a9b78b3d",
              "excerpt": "夏四月己巳朔，唐遣客省使李嚴來聘。"
            },
            {
              "chapterId": "shiguochunqiu-v037",
              "paragraphId": "shiguochunqiu-v037-p7",
              "originalRevision": 1,
              "originalSha256": "6162c4fd88e3835fb723ba510363a122fe4c56929958a303993aee73a9b78b3d",
              "excerpt": "五月戊申，帝遣李嚴還。〈唐莊宗實録：同光二年七月戊午，蜀遣歐陽彬朝貢。十月癸巳，遣客省使李嚴充蜀川回信使。三年戊辰，嚴自西川迴。鑑戒録云：同光初，莊宗滅梁，將行大禮，蜀遣翰林學士歐陽彬持禮入洛，顧太尉遠爲之副焉。莊宗復遣李客省嚴銜厥命以通好。又錦里耆舊傳：歐陽彬通聘洛京，莊宗遣李嚴來修好。故笏記有云“吾皇迴感於蜀王，復禮遠酬於厚禮”。是李嚴未至之前，蜀已有入洛之使。今從李昊蜀書。〉"
            }
          ],
          "notes": [
            "原话前年与王衍本纪编年不能机械相加推唯一使年；本条仍年代未定，不让外交辞令覆盖已知战况。"
          ]
        }
      ]
    },
    {
      "id": "li-yan-youzhou-sizhou",
      "title": "班师遇明宗即位，任泗州防御",
      "summary": "蜀平班师时李嗣源即位，李严调泗州防御使，仍兼客省使。",
      "year": null,
      "sortOrder": 6,
      "precision": "range",
      "sourceDate": "蜀平班师遇明宗即位后迁泗州，授任未独立记月；天成二年二月本纪已称泗州防御使，西历926—927年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p7",
          "originalRevision": 1,
          "originalSha256": "1e10392e6ae2250e91092c0900668cfc0ddf1d05f118916a95e7e8c84576afab",
          "excerpt": "蜀平班師，會明宗即位，遷泗州防禦使兼客省使。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p5",
          "originalRevision": 1,
          "originalSha256": "4e727ecaf103df9d04a15b548fbe781ce88b35de09f1e0cf02789bab3edaa765",
          "excerpt": "二月壬午朔，新羅遣使朝貢。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p5",
          "originalRevision": 1,
          "originalSha256": "4e727ecaf103df9d04a15b548fbe781ce88b35de09f1e0cf02789bab3edaa765",
          "excerpt": "壬辰，西川節度使孟知祥奏，泗州防禦使、充西川兵馬都監李嚴，扇搖軍眾，尋已處斬。"
        }
      ],
      "yearRange": {
        "start": 926,
        "end": 927
      }
    }
  ]
}
