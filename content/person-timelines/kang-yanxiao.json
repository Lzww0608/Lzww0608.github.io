{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "kang-yanxiao",
  "events": [
    {
      "id": "kang-yanxiao-defect-to-tang",
      "title": "率百骑归唐，陈梁军机",
      "summary": "为段凝先锋，同光元年八月率百骑投李存勖，获博州刺史等，报告梁军弱点及计划。",
      "year": 923,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "同光元年八月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p1",
          "originalRevision": 1,
          "originalSha256": "8b0cadd5bdccae5d44109b22612961140081dba24f752e6f87146245f653c08d",
          "excerpt": "同光元年八月，段凝率眾五萬營於王村，時延孝為右先鋒指揮使，率百騎來奔。"
        }
      ]
    },
    {
      "id": "kang-yanxiao-daliang-plan",
      "title": "献直袭汴州策，平梁获赐李姓",
      "summary": "主张利用梁军分散、京师空虚，精骑从郓突汴，庄宗最终用策灭梁，任郑州防御，赐姓名李绍琛。",
      "year": 923,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "同光元年八月来归献策，十月灭梁，十一月平梁功授及赐名；各阶段可核在923年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "new-v44",
          "paragraphId": "new-v44-p29",
          "originalRevision": 1,
          "originalSha256": "34122f53ec6fee5129e3a6bd31556ef03064fcd4f2c6082175570cf841f94598",
          "excerpt": "莊宗卒用延孝策，自鄆入汴，凡八日而滅梁。以功拜鄭州防禦使，賜姓名曰李紹琛。"
        },
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p1",
          "originalRevision": 1,
          "originalSha256": "8b0cadd5bdccae5d44109b22612961140081dba24f752e6f87146245f653c08d",
          "excerpt": "同光元年八月，段凝率眾五萬營於王村，時延孝為右先鋒指揮使，率百騎來奔。"
        },
        {
          "chapterId": "old-v030",
          "paragraphId": "old-v030-p14",
          "originalRevision": 1,
          "originalSha256": "e6303b6b5acdc01ba3e15da0ea0c2b27f7a982b064e2275a2b8133661416f8ce",
          "excerpt": "十一月辛丑朔，有司奏：「河南州縣見使偽印，望追毀改鑄。」從之。"
        },
        {
          "chapterId": "old-v030",
          "paragraphId": "old-v030-p14",
          "originalRevision": 1,
          "originalSha256": "e6303b6b5acdc01ba3e15da0ea0c2b27f7a982b064e2275a2b8133661416f8ce",
          "excerpt": "以捧日都指揮使、博州刺史康延孝為鄭州防禦使、檢校太保，賜姓，名繼琛。"
        }
      ]
    },
    {
      "id": "kang-yanxiao-baoyi",
      "title": "升保义军节度使",
      "summary": "同光二年郊礼后授保义军节度。",
      "year": 924,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "同光二年郊礼毕；本纪同事二月己丑李绍琛任陕州（保义军）",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "new-v44",
          "paragraphId": "new-v44-p29",
          "originalRevision": 1,
          "originalSha256": "34122f53ec6fee5129e3a6bd31556ef03064fcd4f2c6082175570cf841f94598",
          "excerpt": "二年，遷保義軍節度使。"
        },
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p1",
          "originalRevision": 1,
          "originalSha256": "8b0cadd5bdccae5d44109b22612961140081dba24f752e6f87146245f653c08d",
          "excerpt": "明年，郊禮畢，授保義軍節度使。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p1",
          "originalRevision": 1,
          "originalSha256": "56aeec50377f2b2ccf3e459c7bfe207e6f01c8817e3bd6c9000b7f3148a86eed",
          "excerpt": "同光二年春正月庚子朔，帝御明堂殿受朝賀，仗衛如式。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p4",
          "originalRevision": 1,
          "originalSha256": "61420c0d8dbbc98df3e1b7651e586890a749590c2f264f0e8f4a68bdc42d47a9",
          "excerpt": "二月己巳朔，親祀昊天上帝於圜丘，禮畢，宰臣率百官就次稱賀，還禦五鳳樓。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p7",
          "originalRevision": 1,
          "originalSha256": "07a70d00c64c7eea09777dfa72d1589e161e4e25701afe15d8b0da96124a15ce",
          "excerpt": "己丑，以振武軍節度使、權安義留後、檢校太傅、平章事李存霸為潞州節度使，以捧日都指揮使、鄭州防禦使李紹琛為陝州節度使，"
        }
      ]
    },
    {
      "id": "kang-yanxiao-shu-vanguard",
      "title": "征蜀为先锋，连克州城",
      "summary": "任西南行营先锋，取凤固兴，三泉败王衍，释放所俘蜀兵，昼夜进军。",
      "year": 925,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "同光三年征蜀；本纪九月起军、十月三泉等连克，均可核925年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p2",
          "originalRevision": 1,
          "originalSha256": "cde39a0da19d0b6ed643011898bde5ecf7f04ff12c72cb1c2f03919d0b3fbb0c",
          "excerpt": "三年，討蜀，以延孝為西南行營馬步軍先鋒、排陣斬斫等使。"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p5",
          "originalRevision": 1,
          "originalSha256": "cab011cfb56bed346511ea63e5142f8445a955a847c54fad79127bdb03378baf",
          "excerpt": "陝府節度使李紹琛充行營蕃漢馬步軍都排陣斬斫使，"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p5",
          "originalRevision": 1,
          "originalSha256": "cab011cfb56bed346511ea63e5142f8445a955a847c54fad79127bdb03378baf",
          "excerpt": "取九月十八日進發。"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p7",
          "originalRevision": 1,
          "originalSha256": "75c4748bf83088fb95d60eb855f5d528268444151b40fbb59978ea51e05576ab",
          "excerpt": "冬十月庚申朔，宰臣及文武三品以上官赴長壽宮，上大行皇太后諡曰貞簡皇太后。"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p8",
          "originalRevision": 1,
          "originalSha256": "05f579eae5fabdae05c1880887a6f198d67842b375ede1c317260c3f283dc801",
          "excerpt": "辛巳，偽興州刺史王承鑒、成州刺史王承樸棄城遁去，康延孝大破蜀軍於三泉。"
        }
      ]
    },
    {
      "id": "kang-yanxiao-mianjiang",
      "title": "与李严浮渡绵江，前入汉州",
      "summary": "不愿耽搁修桥，与李严骑马浮渡绵江，得渡千人而步军溺者亦千余，入鹿头、据汉州，王宗弼来归款。",
      "year": 925,
      "sortOrder": 5,
      "precision": "year",
      "sourceDate": "同光三年征蜀；本纪十一月康延孝、李严至汉州与前渡绵江同役",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p2",
          "originalRevision": 1,
          "originalSha256": "cde39a0da19d0b6ed643011898bde5ecf7f04ff12c72cb1c2f03919d0b3fbb0c",
          "excerpt": "因與李嚴乘馬浮江，於是得濟者僅千人，步軍溺死者亦千餘人。"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p9",
          "originalRevision": 1,
          "originalSha256": "a359ba9403f75ff958178a7fd2dcf6e8ccdd11ba445ad91bde5541549028e33d",
          "excerpt": "十一月庚寅朔，帝幸壽安，號慟於坤陵。"
        },
        {
          "chapterId": "old-v033",
          "paragraphId": "old-v033-p9",
          "originalRevision": 1,
          "originalSha256": "a359ba9403f75ff958178a7fd2dcf6e8ccdd11ba445ad91bde5541549028e33d",
          "excerpt": "康延孝、李嚴至漢州，王衍遣人送牛酒請降，李嚴遂先入成都。"
        }
      ]
    },
    {
      "id": "kang-yanxiao-conflict-dong",
      "title": "平蜀争功，反对董璋得东川",
      "summary": "董璋获郭崇韬信任、领东川，康延孝自恃先锋功劳，与毛璋要求改任任圜，被郭斥退。",
      "year": 926,
      "sortOrder": 6,
      "precision": "month",
      "sourceDate": "同光三年闰十二月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p3",
          "originalRevision": 1,
          "originalSha256": "09e880d0a88899926508a4d9d3998940065f4ac3b5348b67a41e51d8b139be77",
          "excerpt": "延孝怒，謂毛璋曰：「吾冒白刃，犯險阻，平定兩川，董璋何功，遽有其地！」"
        }
      ],
      "notes": [
        "该闰月整月已在西历926年；原书记年仍保留同光三年。"
      ]
    },
    {
      "id": "kang-yanxiao-rear-guard",
      "title": "蜀军返程任殿后",
      "summary": "同光四年正月，李继岌自成都班师，命康延孝带一万二千人为后军。",
      "year": 926,
      "sortOrder": 7,
      "precision": "day",
      "sourceDate": "同光四年正月甲申",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p4",
          "originalRevision": 1,
          "originalSha256": "fdb611a9c2f691938a3a6939b36a58f3ec938e060b59e930af1644861d476b11",
          "excerpt": "四年正月甲申，大軍發成都，繼岌令延孝以一萬二千人為後軍。"
        }
      ]
    },
    {
      "id": "kang-yanxiao-revolt-jianzhou",
      "title": "惧朱友谦郭氏之祸，返兵自称蜀帅",
      "summary": "闻朱友谦及朱令德被杀后，与河中旧将担忧自身，剑州回兵，自称西川节度、三川制置，招兵据汉州。",
      "year": 926,
      "sortOrder": 8,
      "precision": "day",
      "sourceDate": "同光四年二月丁酉",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p4",
          "originalRevision": 1,
          "originalSha256": "fdb611a9c2f691938a3a6939b36a58f3ec938e060b59e930af1644861d476b11",
          "excerpt": "丁酉，延孝至劍州，遂擁眾回，自稱西川節度、三川製置等使，以檄招諭蜀人，三日間，眾及五萬。"
        }
      ],
      "variants": [
        {
          "label": "任圜传记叛军劲兵八千",
          "sourceDate": "魏王班师至利州后，本段未独日",
          "summary": "任圜传称康延孝以劲兵八千回劫西川；各书军数的时点与部队不同，不与追兵或招集人数合成唯一总数。",
          "evidence": [
            {
              "chapterId": "old-v067",
              "paragraphId": "old-v067-p21",
              "originalRevision": 1,
              "originalSha256": "fdb3a8f64b81be61b981cbbe8bc6691c99cfe93803acf51854a9c7c4c05d762e",
              "excerpt": "魏王班師，行及利州，康延孝叛，以勁兵八千回劫西川。"
            }
          ]
        }
      ]
    },
    {
      "id": "kang-yanxiao-captured",
      "title": "金雁桥再败，被擒押囚车",
      "summary": "任圜与孟知祥军攻汉州，康延孝出战再败，奔绵州被何建崇擒，置囚车。",
      "year": 926,
      "sortOrder": 9,
      "precision": "day",
      "sourceDate": "同光四年三月乙丑",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p5",
          "originalRevision": 1,
          "originalSha256": "4e73a11b8bbea6d72a4bdabf781ef0ea300b92c5e6a6924899c8b386618ad2b2",
          "excerpt": "以十數騎奔綿州；何建崇追及，擒之，任圜命載以檻車。"
        }
      ],
      "variants": [
        {
          "label": "任圜传概称汉州攻擒",
          "sourceDate": "副招讨出兵后，本段无独日",
          "summary": "本传省叙任圜、梁汉颙等攻延孝于汉州而擒之，不独定擒获地点；旧康传奔绵州、何建崇追及与载囚车细节照留。",
          "evidence": [
            {
              "chapterId": "old-v067",
              "paragraphId": "old-v067-p21",
              "originalRevision": 1,
              "originalSha256": "fdb3a8f64b81be61b981cbbe8bc6691c99cfe93803acf51854a9c7c4c05d762e",
              "excerpt": "即署圜為招討副使，與都指揮使梁漢顒等率兵攻延孝於漢州，擒之。"
            }
          ]
        }
      ]
    },
    {
      "id": "kang-yanxiao-death-fengxiang",
      "title": "囚车至凤翔，奉诏被杀",
      "summary": "任圜回师带其至凤翔，向延嗣携庄宗诏书至，康延孝被杀；部下葬其首级，天成初儿子取回。",
      "year": 926,
      "sortOrder": 10,
      "precision": "year",
      "sourceDate": "同光四年汉州败后",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p5",
          "originalRevision": 1,
          "originalSha256": "4e73a11b8bbea6d72a4bdabf781ef0ea300b92c5e6a6924899c8b386618ad2b2",
          "excerpt": "及圜班師，行次鳳翔，中使向延嗣齎詔至，遂誅之。"
        }
      ]
    },
    {
      "id": "kang-yanxiao-early-liang",
      "title": "原太原军卒，获罪奔梁",
      "summary": "原属太原军，获罪亡梁，开平、乾化年间从队长积功升部校。",
      "year": null,
      "sortOrder": 11,
      "precision": "undated",
      "sourceDate": "开平、乾化期间及其前",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p1",
          "originalRevision": 1,
          "originalSha256": "8b0cadd5bdccae5d44109b22612961140081dba24f752e6f87146245f653c08d",
          "excerpt": "初隸太原，因得罪，亡命於汴梁。開平、乾化中，自隊長積勞至部校。"
        }
      ]
    }
  ]
}
