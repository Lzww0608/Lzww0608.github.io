  "scope": "current-archive",
  "events": [
    {
      "id": "liu-bin-southern-han-accession",
      "year": 942,
      "sourceDate": "天福七年四月刘龑卒后继位（旧史同事）",
      "title": "继位改名玢，改元光天",
      "summary": "父病本议改立洪昌，萧益劝止，洪度继位，改名玢，以晋王洪熙辅政。",
      "evidence": [
        {
          "chapterId": "new-v65",
          "paragraphId": "new-v65-p23",
          "originalRevision": 1,
          "originalSha256": "b716e933754efc25465f38f4ca5b25b474527021ac4708fb2bd93ac35b0cce70",
          "excerpt": "十五年，龑卒，年五十四，謚天皇大帝，廟號高祖，陵曰康陵。子玢立。"
        },
        {
          "chapterId": "new-v65",
          "paragraphId": "new-v65-p24",
          "originalRevision": 1,
          "originalSha256": "93048131d45f6fe2a7ab48aff646350c49f71094752250e2181668705656afb1",
          "excerpt": "玢，初名洪度，封秦王。龑子耀樞，龜圖皆早死，玢次當立。龑病臥寢中，召右僕射王翻與語，呼洪度、洪熙小字曰：「壽、儁雖長，然皆不足任吾事，惟洪昌類我，吾欲立之。奈何吾子孫不肖，後世如鼠入牛角，勢當漸小爾！」因泣下歔欷。翻為龑謀，出洪度以邕州，洪熙容州，然後立洪昌為太子。議已定，崇文使蕭益入問疾，龑以告之，益諫曰：「少者得立，長者爭之，禍始此矣！」由是洪度卒得立。更名玢，改元曰光天，尊母趙昭儀為皇太妃，以晉王洪熙輔政。"
        },
        {
          "chapterId": "old-v135",
          "paragraphId": "old-v135-p14",
          "originalRevision": 1,
          "originalSha256": "7e1539d643ed137f5f8bde93378a7f89c0ac03b6c747fa899dc4fc7dbaf3f6ef",
          "excerpt": "晉天福七年夏四月，陟以疾卒，"
        },
        {
          "chapterId": "old-v135",
          "paragraphId": "old-v135-p14",
          "originalRevision": 1,
          "originalSha256": "7e1539d643ed137f5f8bde93378a7f89c0ac03b6c747fa899dc4fc7dbaf3f6ef",
          "excerpt": "子玢嗣。"
        }
      ],
      "phase": "rule",
      "precision": "month",
      "sortOrder": 0
    },
    {
      "id": "liu-bin-southern-han-rebellion",
      "year": 942,
      "sourceDate": "天福七年七月（通鉴张遇贤同役）",
      "title": "岭东乱起，遣军失利",
      "summary": "召伶人饮宴，岭东乱起。张遇贤陷循州，遣洪昌、洪杲讨伐反被围，万景忻等护王突围。",
      "evidence": [
        {
          "chapterId": "new-v65",
          "paragraphId": "new-v65-p25",
          "originalRevision": 1,
          "originalSha256": "0b7e331b8b0efce518ecd144c63de002376ae808e39ea20257dc0ea25c15f90f",
          "excerpt": "玢立，果不能任事。龑在殯，召伶人作樂，飲酒宮中，裸男女以為樂，或衣墨縗與倡女夜行，出入民家。由是山海間盜賊競起。妖人張遇賢，自稱中天八國王，攻陷循州。玢遣越王洪昌、循王洪杲攻之，遇賢圍洪昌等於錢帛館，裨將萬景忻、陳道庠力戰，挾二王潰圍而走。玢莫能省，嶺東皆亂。"
        },
        {
          "chapterId": "tongjian-v283",
          "paragraphId": "tongjian-v283-p3",
          "originalRevision": 1,
          "originalSha256": "50741525f11543a087efed822d1b6e5c9c17c2cc88459e35792e35dff3f3e445",
          "excerpt": "高祖聖文章武明德孝皇帝下天福七年（壬寅，公元九四二年）"
        },
        {
          "chapterId": "tongjian-v283",
          "paragraphId": "tongjian-v283-p25",
          "originalRevision": 1,
          "originalSha256": "8f5469e0baae1c2f70ba7ffa1c120c5db1a902490195d4e1fc693c20f1daac91",
          "excerpt": "秋，七月，壬辰，"
        },
        {
          "chapterId": "tongjian-v283",
          "paragraphId": "tongjian-v283-p30",
          "originalRevision": 1,
          "originalSha256": "3c26905d98992697f646a3cc302e6e11ee126957add537939e307bbc8c6ebc85",
          "excerpt": "漢主以越王弘昌為都統，循王弘杲為副以討之，戰於錢帛館。漢兵不利，二王皆為賊所圍；指揮使陳道癢等力戰救之，得免。"
        }
      ],
      "phase": "rule",
      "precision": "month",
      "sortOrder": 1
    },
    {
      "id": "liu-bin-southern-han-assassination",
      "year": 943,
      "sourceDate": "天福八年三月丙戌（通鉴）；新史记在位二年",
      "title": "观角抵醉后，被洪熙党杀害",
      "summary": "洪熙等令陈道庠养勇士，宴中献角抵，酒醉后勇士跟至寝门杀玢及左右。洪熙继位，名晟。",
      "evidence": [
        {
          "chapterId": "new-v65",
          "paragraphId": "new-v65-p26",
          "originalRevision": 1,
          "originalSha256": "fdd2b6fa043c9e41340c240210ef0a23a9b11f88301356a462a61845ddddaabd",
          "excerpt": "洪熙日益進聲妓誘玢為荒恣。玢亦頗疑諸弟圖己，敕宦官守宮門，入者皆露索。洪熙、洪杲、洪昌陰遣陳道庠養勇士劉思潮、譚令禋、林少彊少良、何昌廷等，習為角觝以獻玢。玢宴長春宮以閱之，玢醉起，道庠與思潮等隨至寢門拉殺之，盡殺其左右。玢立二年，年二十四，謚曰殤。弟晟立。"
        },
        {
          "chapterId": "old-v135",
          "paragraphId": "old-v135-p15",
          "originalRevision": 1,
          "originalSha256": "50b08960ae2ddf575f4f8d91c3fff7e0a74fb85b7f9c78e82b659adf555f74bc",
          "excerpt": "玢，陟長子也。初封賓王，又封秦王。陟卒，遂襲位，偽號光天。玢性庸昧，僭位之後，大恣荒淫。尋為其弟晟等所弒，在位一年，偽謚為殤帝。"
        },
        {
          "chapterId": "tongjian-v283",
          "paragraphId": "tongjian-v283-p45",
          "originalRevision": 1,
          "originalSha256": "fa52591d3b78bd5924c4d5da0e99d43eb164d2beb09897f8cd1a434e694c221a",
          "excerpt": "高祖聖文章武明德孝皇帝下天福八年（癸卯，公元九四三年）"
        },
        {
          "chapterId": "tongjian-v283",
          "paragraphId": "tongjian-v283-p54",
          "originalRevision": 1,
          "originalSha256": "4b4377919e4c90e08b2fc55a75223b76f65260efff0affdbae747d5f2c842869",
          "excerpt": "三月，己卯朔，"
        },
        {
          "chapterId": "tongjian-v283",
          "paragraphId": "tongjian-v283-p58",
          "originalRevision": 1,
          "originalSha256": "9f2e57f4a818bfa2f7af25c85318d3a37f65dc727efc3bc6693ff74f002f4a32",
          "excerpt": "丙戌，與諸王宴於長春宮，觀手搏，至夕罷宴，漢主大醉。弘熙使道庠、思潮等掖漢主，因拉殺之，盡殺其左右。"
        }
      ],
      "phase": "fall",
      "precision": "day",
      "notes": [
        "新史称在位二年，旧史称一年；纪年跨942—943，年数沿各书分别保留，不虚设整两周年。"
      ],
      "sortOrder": 2
    },
    {
      "id": "liu-bin-southern-han-qin-prince",
      "year": null,
      "sourceDate": "大有五年，封秦王未独月日",
      "title": "初名洪度，封秦王",
      "summary": "父亲封诸子时，刘洪度受秦王号；耀枢、龟图早死后按序应立。",
      "evidence": [
        {
          "chapterId": "new-v65",
          "paragraphId": "new-v65-p20",
          "originalRevision": 1,
          "originalSha256": "3f5103e8cbedc2ef73016b7017d196f1b0f2b752bb77e5b79db66291abb74bd2",
          "excerpt": "五年，封子耀樞邕王，龜圖康王，洪度秦王，洪熙晉王，洪昌越王，洪弼齊王，洪雅韶王，洪澤鎮王，洪操萬王，洪杲循王，洪暐息王，洪邈高王，洪簡同王，洪建益王，洪濟辨王，洪道貴王，洪昭宣王，洪政通王，洪益定王。"
        },
        {
          "chapterId": "new-v65",
          "paragraphId": "new-v65-p24",
          "originalRevision": 1,
          "originalSha256": "93048131d45f6fe2a7ab48aff646350c49f71094752250e2181668705656afb1",
          "excerpt": "玢，初名洪度，封秦王。龑子耀樞，龜圖皆早死，玢次當立。龑病臥寢中，召右僕射王翻與語，呼洪度、洪熙小字曰：「壽、儁雖長，然皆不足任吾事，惟洪昌類我，吾欲立之。奈何吾子孫不肖，後世如鼠入牛角，勢當漸小爾！」因泣下歔欷。翻為龑謀，出洪度以邕州，洪熙容州，然後立洪昌為太子。議已定，崇文使蕭益入問疾，龑以告之，益諫曰：「少者得立，長者爭之，禍始此矣！」由是洪度卒得立。更名玢，改元曰光天，尊母趙昭儀為皇太妃，以晉王洪熙輔政。"
        }
      ],
      "phase": "uncertain",
      "precision": "range",
      "sortOrder": 3,
      "notes": [
        "原文未独载本事月日；无法核准一个西历年，保留有据范围。"
      ],
