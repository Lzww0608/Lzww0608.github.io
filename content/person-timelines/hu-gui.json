  "events": [
    {
      "id": "hu-gui-join",
      "title": "原事朱瑾，兖州平后入宣武",
      "summary": "胡规原为朱瑾中军都校，兖州平后任宣武军都虞候；康怀英传明记乾宁四年春葛从周平兖州，作为同役年锚。后役与盐务另列。",
      "year": 897,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "乾宁四年春葛从周平兖州",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p20",
          "originalRevision": 1,
          "originalSha256": "a8b8b083df16fba54057034cc158f3b9e376240ff3208c5b7a7350e8ea97561d",
          "excerpt": "初事朱瑾為中軍都校。兗州平，署為宣武軍都虞候。"
        },
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p18",
          "originalRevision": 1,
          "originalSha256": "cd6dcce3efac8421570e3a0947f308f42bf0b74d56f82a00296d187b0c96facf",
          "excerpt": "唐乾寧四年春，太祖既平鄆，命葛從周乘勝急攻兗州。"
        }
      ]
    },
    {
      "id": "hu-gui-court",
      "title": "昭宗东迁，任御营与内园庄宅使",
      "summary": "昭宗东迁时任胡规御营使，至洛阳后授内园庄宅使；此前岐下权洽州、归长安皇城使另记。",
      "year": 904,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "昭宗东迁，前述归京为此前事",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p20",
          "originalRevision": 1,
          "originalSha256": "a8b8b083df16fba54057034cc158f3b9e376240ff3208c5b7a7350e8ea97561d",
          "excerpt": "及東遷，以為御營使。駕至洛，授內園莊宅使。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p11",
          "originalRevision": 1,
          "originalSha256": "32fa7c031cb031759dde8e809fb32de857557ff9d3e39204388c1d6a85467a86",
          "excerpt": "天祐元年正月己酉，帝發自大梁，西赴河中，京師聞之，為之震懼。"
        }
      ]
    },
    {
      "id": "hu-gui-yulin",
      "title": "梁受禅后授右羽林统军",
      "summary": "朱温受禅后授胡规右羽林统军；后协刘鄩攻潼关另记。",
      "year": 907,
      "sortOrder": 3,
      "precision": "year",
      "phase": "service",
      "sourceDate": "太祖受禅后",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p20",
          "originalRevision": 1,
          "originalSha256": "a8b8b083df16fba54057034cc158f3b9e376240ff3208c5b7a7350e8ea97561d",
          "excerpt": "太祖受禪，除右羽林統軍，尋佐劉鄩統兵收潼關，擒劉知浣獻之，乃以為右龍虎統軍兼侍衛指揮使。"
        }
      ]
    },
    {
      "id": "hu-gui-tongguan",
      "title": "随刘鄩收潼关，擒刘知浣",
      "summary": "胡规协刘鄩收潼关、所部擒刘知浣，因功任右龙虎统军兼侍卫指挥。本纪同役记张温等二十二人具体擒获，不写成胡规一人亲擒。",
      "year": 909,
      "sortOrder": 4,
      "precision": "month",
      "sourceDate": "开平三年六月刘知俊反梁后",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p20",
          "originalRevision": 1,
          "originalSha256": "a8b8b083df16fba54057034cc158f3b9e376240ff3208c5b7a7350e8ea97561d",
          "excerpt": "太祖受禪，除右羽林統軍，尋佐劉鄩統兵收潼關，擒劉知浣獻之，乃以為右龍虎統軍兼侍衛指揮使。"
        },
        {
          "chapterId": "old-v004",
          "paragraphId": "old-v004-p13",
          "originalRevision": 1,
          "originalSha256": "99a30d641ae16c4a61c95023286b32411b5178bf7336ff08e8e6da4a81c4e3b9",
          "excerpt": "開平三年正月戊辰朔，帝御金祥殿，受宰臣、翰林學士稱賀，文武百官拜表於東上閣門。"
        },
        {
          "chapterId": "old-v004",
          "paragraphId": "old-v004-p18",
          "originalRevision": 1,
          "originalSha256": "1037033b53f8bb9bd2c875106ffdce4aadbb1c6afb7ce7b170c184c2dd2995ca",
          "excerpt": "六月庚戌，同州節度使劉知俊據本郡反，制令削奪劉知俊在身官爵，仍徵發諸軍，速令進討。"
        },
        {
          "chapterId": "old-v004",
          "paragraphId": "old-v004-p18",
          "originalRevision": 1,
          "originalSha256": "1037033b53f8bb9bd2c875106ffdce4aadbb1c6afb7ce7b170c184c2dd2995ca",
          "excerpt": "劉知俊弟內直右保勝指揮使知浣自洛奔至潼關，右龍虎軍十將張溫以上二十二人於潼關擒獲劉知浣，送至行在。"
        }
      ]
    },
    {
