  "events": [
    {
      "id": "an-zhongba-offer-qinzhou",
      "title": "闻明宗起兵，献秦成等州归唐",
      "summary": "旧史记王承休离秦州后，安重霸留守，听李嗣源起河北即遣使献秦、成等州；新史记为唐军破蜀后归唐。",
      "year": 926,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "明宗起河北时；新史叙唐军破蜀后",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p7",
          "originalRevision": 1,
          "originalSha256": "68f08e9f96514b7c886f02539bdb8d3cfb27434f76a37c7e0649ab25b0e8bd3c",
          "excerpt": "承休既去，重霸在秦州，聞明宗起河北，即時遣使以秦、成等州來降。"
        }
      ],
      "notes": [
        "归唐时序依两书分别保留：旧史联系明宗起兵，新史联系破蜀，不将两者拼成同一确定日。"
      ],
      "variants": [
        {
          "label": "新史记唐军破蜀后献三州",
          "sourceDate": "唐军已破蜀后，未纪明确月日",
          "summary": "新史把献秦、成、阶三州放在唐军破蜀之后；旧史联系明宗起河北，保留两书归附叙次。",
          "evidence": [
            {
              "chapterId": "new-v46",
              "paragraphId": "new-v46-p31",
              "originalRevision": 1,
              "originalSha256": "0ddd020f666b0d4ddd12dc94a7ca60b5a09ab66d446b5cc729b98c463ab12feb",
              "excerpt": "唐軍已破蜀，重霸亦以秦、成、階三州降唐，明宗以為閬州團練使。"
            }
          ]
        }
      ]
    },
    {
      "id": "an-zhongba-early-defections",
      "title": "从河东奔梁，再奔蜀",
      "summary": "先与李嗣源事奉李克用，获罪后逃梁，再因罪奔蜀，被前蜀用为亲将。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "本传未记具体年次",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p6",
          "originalRevision": 1,
          "originalSha256": "120ac84364e98517d1d6d4e40d0869fe79c415d745281d612f0ef9868a953657",
          "excerpt": "初，自代北與明宗俱事武皇，因負罪奔梁；在梁復以罪奔蜀，蜀以蕃人善騎射，因為親將。"
        }
      ]
    },
    {
      "id": "an-zhongba-longwu-deputy",
      "title": "结王承休，任秦州龙武副帅",
      "summary": "前蜀夺取秦成阶等州后，劝王承休求镇秦州，选精兵组成龙武军，自己任副帅。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "梁末及其后",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p6",
          "originalRevision": 1,
          "originalSha256": "120ac84364e98517d1d6d4e40d0869fe79c415d745281d612f0ef9868a953657",
          "excerpt": "梁末，岐下削弱，蜀人奪取秦、成、階等州，重霸說承休求鎮秦州。仍於軍中選山東驍果，得數千人，號龍武都，以承休為軍帥，重霸副焉，俱在天水。"
        }
      ],
      "variants": [
        {
          "label": "本纪分别记龙武任命与秦州赴镇",
          "sourceDate": "乾德六年冬十月置龙武军；十二月任王承休天雄，传统年跨924—925",
          "summary": "本纪先记左右龙武四十军、骁勇一万二千人，王承休为都指挥使、安重霸为副；后记十二月以王承休为天雄节度使、以龙武为牙兵。旧传所叙驻秦、副帅及数千人各保来源，不凑两次已证同一任命，也不把两种兵数合一。",
          "evidence": [
            {
              "chapterId": "shiguochunqiu-v037",
              "paragraphId": "shiguochunqiu-v037-p7",
              "originalRevision": 1,
              "originalSha256": "6162c4fd88e3835fb723ba510363a122fe4c56929958a303993aee73a9b78b3d",
              "excerpt": "冬十月，置左右龍武四十軍爲親軍，以驍勇萬二千人充之，兵械給賜皆優異他軍。命宣徽北院使王承休爲龍武軍馬步都指揮使，裨將安重霸副之，舊將無不憤恥。"
            },
            {
              "chapterId": "shiguochunqiu-v037",
              "paragraphId": "shiguochunqiu-v037-p7",
              "originalRevision": 1,
              "originalSha256": "6162c4fd88e3835fb723ba510363a122fe4c56929958a303993aee73a9b78b3d",
              "excerpt": "庚午，以宦者王承休爲天雄軍節度使，封魯國公，以龍武軍爲承休牙兵。先是，承休言秦州多美女，請擇以獻，因有是命。"
            },
            {
              "chapterId": "old-v061",
              "paragraphId": "old-v061-p6",
              "originalRevision": 1,
              "originalSha256": "120ac84364e98517d1d6d4e40d0869fe79c415d745281d612f0ef9868a953657",
              "excerpt": "梁末，岐下削弱，蜀人奪取秦、成、階等州，重霸說承休求鎮秦州。仍於軍中選山東驍果，得數千人，號龍武都，以承休為軍帥，重霸副焉，俱在天水。"
            }
          ],
          "notes": [
            "本条旧年表仍保年代未定；任龙武副职与秦州赴镇的层次分开，不拿两项先后推女方严氏经历。"
          ]
        }
      ]
    },
    {
      "id": "an-zhongba-remain-qinzhou",
      "title": "伐蜀时劝承休救援，自己留秦",
      "summary": "唐军征蜀后，先承诺陪王承休返蜀，待其出发又以守秦陇为辞留下。旧史把王衍出游与魏王来军接叙于同光二年十月，纪年疑点不暗改。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "旧史同光二年十月接叙；新史唐魏王兵伐蜀时",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p30",
          "originalRevision": 1,
          "originalSha256": "f24f0258dd11a1b2486f1bd4f473a7c4f80e8b5ab4738d003054a370dc5bcb76",
          "excerpt": "酒罷，承休上道，重霸立承休馬前，辭曰：「秦、隴不可失，願留為公守。」承休業已上道，無如之何。"
        }
      ],
      "notes": [
        "旧史同光二年与已归档同光三年伐蜀本纪存在叙时问题，事件暂不推定唯一西历年。"
      ],
      "variants": [
        {
          "label": "旧史同光二年十月叙出游与伐蜀",
          "sourceDate": "同光二年十月",
          "summary": "旧史把王衍东游、魏王来军接叙于二年十月，与所收伐蜀本纪三年纪事不同；本事件仍不指定唯一西历年。",
          "evidence": [
            {
              "chapterId": "old-v061",
              "paragraphId": "old-v061-p7",
              "originalRevision": 1,
              "originalSha256": "68f08e9f96514b7c886f02539bdb8d3cfb27434f76a37c7e0649ab25b0e8bd3c",
              "excerpt": "同光二年十月，蜀主率眾數萬，由劍閣將出興、鳳，以遊秦州；至興州，遇魏王繼岌軍至，狼狽而旋。"
            }
          ]
        }
      ]
    },
