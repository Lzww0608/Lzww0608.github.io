  "events": [
    {
      "id": "zhang-jingxun-datong",
      "title": "任大同节度，招抚室韦",
      "summary": "天成二年召还后授大同节度使，至镇招抚室韦一万余帐。",
      "year": 927,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天成二年；明宗纪四月辛丑授云州，大同任命可定927，招抚未另记月",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p11",
          "originalRevision": 1,
          "originalSha256": "ace6ff119edc5511c82dc66e80936a5d88d3ca3a58793234e104d1ffc2d68684",
          "excerpt": "天成二年，詔還京師，復授大同節度使，至鎮，招撫室韋萬餘帳。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p10",
          "originalRevision": 1,
          "originalSha256": "2f7ce985f93c6e3dda8ddc3afd2531c7522cfa311b65c270e3ddda62bd428370",
          "excerpt": "辛丑，以前利州節度使張敬詢為雲州節度使。"
        }
      ]
    },
    {
      "id": "zhang-jingxun-xiaowei",
      "title": "入朝任左骁卫上将军",
      "summary": "从大同节度任上征为左骁卫上将军。",
      "year": 929,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "天成四年；明宗纪同事十月庚子任左骁卫",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p11",
          "originalRevision": 1,
          "originalSha256": "ace6ff119edc5511c82dc66e80936a5d88d3ca3a58793234e104d1ffc2d68684",
          "excerpt": "四年，征為左驍衛上將軍。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p10",
          "originalRevision": 1,
          "originalSha256": "e5ec833eec053fcaeff6ba844fddcda843f9b1e917c75ca93802633fe3387d78",
          "excerpt": "冬十月丙申朔，並吏部三銓為一銓，宜令本司官員同商量注擬，連署申奏，仍不得於私第注官。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p10",
          "originalRevision": 1,
          "originalSha256": "e5ec833eec053fcaeff6ba844fddcda843f9b1e917c75ca93802633fe3387d78",
          "excerpt": "以雲州節度使張敬詢為左驍衛上將軍，"
        }
      ]
    },
    {
      "id": "zhang-jingxun-armour-workshop",
      "title": "为李克用掌甲坊十五年",
      "summary": "世为振武牙校之家，在李克用时掌甲坊十五年，以称职闻名，女儿嫁李存霸后更受信任。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "武皇时，起讫年未记",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p11",
          "originalRevision": 1,
          "originalSha256": "ace6ff119edc5511c82dc66e80936a5d88d3ca3a58793234e104d1ffc2d68684",
          "excerpt": "敬詢當武皇時，專掌甲坊十五年，以稱職聞。復以女為武皇子存霸妻，益見親信。"
        }
      ]
    },
    {
      "id": "zhang-jingxun-zhou-offices",
      "title": "任沁州、甲坊，随军历诸州",
      "summary": "李存勖继承之后任沁州刺史，任满复为甲坊使；随经略山东，历博泽慈隰刺史。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "庄宗即位及经略山东期间，具体任命年未记",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p11",
          "originalRevision": 1,
          "originalSha256": "ace6ff119edc5511c82dc66e80936a5d88d3ca3a58793234e104d1ffc2d68684",
          "excerpt": "莊宗即位，以為沁州刺史，秩滿，復用為甲坊使。"
        }
      ]
    },
    {
      "id": "zhang-jingxun-lizhou",
      "title": "郭崇韬表为利州留后",
      "summary": "同光末任耀州团练，因善督租赋在征蜀时由郭崇韬奏任利州留后；明宗后来正式授昭武节度。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "郭崇韬征蜀时及明宗即位后",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p11",
          "originalRevision": 1,
          "originalSha256": "ace6ff119edc5511c82dc66e80936a5d88d3ca3a58793234e104d1ffc2d68684",
          "excerpt": "郭崇韜之征蜀也，以敬詢善督租賦，乃表為利州留後。明宗即位，正授昭武軍節度使。"
        }
      ]
    },
    {
      "id": "zhang-jingxun-huazhou-dyke",
      "title": "任滑州节度，扩筑黄河堤",
      "summary": "天成四年次年授滑州节度，因河水连年溢堤，自酸枣至濮州扩堤，旧史记长二百里，民受其益。",
      "year": null,
      "sortOrder": 6,
      "precision": "range",
      "sourceDate": "天成四年之明年授滑州（长兴元年）；扩堤未另记月年，在任后至秩满归京卒的本传叙次界限930—933年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p11",
          "originalRevision": 1,
          "originalSha256": "ace6ff119edc5511c82dc66e80936a5d88d3ca3a58793234e104d1ffc2d68684",
          "excerpt": "明年，授滑州節度使。以河水連年溢堤，乃自酸棗縣界至濮州，廣堤防一丈五尺，東西二百里，民甚賴之。"
        }
      ],
      "yearRange": {
        "start": 930,
        "end": 933
      }
    },
    {
      "id": "zhang-jingxun-death",
      "title": "秩满归京而卒",
      "summary": "长兴三年任满返回京师后去世，朝廷辍视朝一日。",
      "year": null,
      "sortOrder": 7,
      "precision": "range",
      "sourceDate": "长兴三年；未记可核的具体月日，西历范围932—933年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p11",
          "originalRevision": 1,
          "originalSha256": "ace6ff119edc5511c82dc66e80936a5d88d3ca3a58793234e104d1ffc2d68684",
          "excerpt": "三年，秩滿歸京，卒。輟視朝一日。"
        }
      ],
      "yearRange": {
        "start": 932,
        "end": 933
      },
      "variants": [
        {
          "label": "本纪卒废朝记日",
          "year": 933,
          "sourceDate": "长兴四年十月丁未，本纪记卒废朝；本传三年记卒分别保存",
          "evidence": [
            {
              "chapterId": "old-v044",
              "paragraphId": "old-v044-p1",
              "originalRevision": 1,
              "originalSha256": "2bb4ed152a4d2b195339f1ecbe4fd0a1d6ed992e762560677d3199d1db9a3649",
              "excerpt": "長興四年春正月戊寅朔，帝御明堂殿受朝賀，仗衛如式。"
            },
            {
              "chapterId": "old-v044",
              "paragraphId": "old-v044-p10",
              "originalRevision": 1,
              "originalSha256": "bb242a40b3a5d4329f7b7b76b7aa865fbb2fb7e342ccac8f12c2e029a44c151e",
              "excerpt": "冬十月丙午，以前同州節度使趙在禮為襄州節度使。丁未，以前滑州節度使張敬詢卒廢朝。"
            }
          ]
        }
      ]
    }
