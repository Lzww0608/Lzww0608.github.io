  "personId": "kong-qing",
  "events": [
    {
      "id": "kong-qing-fengxiang",
      "title": "领兵取凤陇成，袭鄜州",
      "summary": "凤翔战事中孔勍奉朱温命七月取凤、陇、成三州，十一月乘李周彝外出救岐袭鄜州，破其根本。",
      "year": 902,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天复二年七月、十一月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p5",
          "originalRevision": 1,
          "originalSha256": "41a52940f8000e80ae7659667497d9e24f380dc5ae9cf5c7e6bdf290f9225214",
          "excerpt": "天復元年正月乙酉朔，唐宰相崔允潛使人以帝密旨告于侍衛軍將孫德昭已下，令誅左右中尉劉季述、王仲先等，即時迎昭宗於東內，禦樓反正。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p7",
          "originalRevision": 1,
          "originalSha256": "8d5d6e47608c0c72a6add6c193177909151c93c2b8d0dbdfa43a4b43942ff434",
          "excerpt": "二年正月，帝復次於武功，岐人堅壁不下，乃回軍於河中。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p8",
          "originalRevision": 1,
          "originalSha256": "8c68067189bcc67c423bc4bbcd6d6d145f5e2c5761e56d65fb78b03d3ac66bb8",
          "excerpt": "七月丙午，岐軍復出求戰，帝軍不利。是月，遣孔勍帥師取鳳、隴、成三州，皆下之。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p8",
          "originalRevision": 1,
          "originalSha256": "8c68067189bcc67c423bc4bbcd6d6d145f5e2c5761e56d65fb78b03d3ac66bb8",
          "excerpt": "十一月癸卯，鄜帥李周彝《新唐書》作「李茂勳」，茂勳即周彝也。統兵萬餘人屯於岐之北原，與城中舉烽以相應。翼日，帝以周彝既離本部，鄜畤必無守備，因命孔勍乘虛襲下之。甲寅，鄜州平。周彝聞之，收軍而遁。"
        }
      ]
    },
    {
      "id": "kong-qing-early",
      "title": "从小校历齐州唐邓军职",
      "summary": "孔勍年轻时善骑射，为军中小校，从朱温升郡守、齐州防御及唐邓节度。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "早年诸任，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v064",
          "paragraphId": "old-v064-p12",
          "originalRevision": 1,
          "originalSha256": "d8add0db2f12824d8bfb965a7a855a802067dbe5c01027a4f4dd5716f684bb43",
          "excerpt": "少便騎射，為軍中小校，事梁祖漸至郡守，累遷齊州防禦使、唐鄧節度使。"
        }
      ]
    },
    {
      "id": "kong-qing-xiangyang",
      "title": "讨王球叛，领山南东道",
      "summary": "王球据襄州叛，孔勍平定后授山南东道节度使。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "梁贞明中，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v064",
          "paragraphId": "old-v064-p12",
          "originalRevision": 1,
          "originalSha256": "d8add0db2f12824d8bfb965a7a855a802067dbe5c01027a4f4dd5716f684bb43",
          "excerpt": "梁貞明中，王球據襄州叛，討平之，因授山南東道節度使。"
        }
      ]
    },
    {
      "id": "kong-qing-tang",
      "title": "归唐后移昭义，诛潞州谋变者",
      "summary": "庄宗入洛后孔勍来朝获还镇，后移昭义；同光末监军杨继源和都将谋据潞州，事泄遭诛。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "庄宗至洛后及同光季年，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v064",
          "paragraphId": "old-v064-p12",
          "originalRevision": 1,
          "originalSha256": "d8add0db2f12824d8bfb965a7a855a802067dbe5c01027a4f4dd5716f684bb43",
          "excerpt": "莊宗至洛陽，自鎮來朝，復令歸鎮，尋移昭義節度使。同光季年，監軍楊繼源與都將謀據潞州，事泄，誅之。"
        }
      ]
    },
    {
      "id": "kong-qing-mingzong",
      "title": "明宗时领河阳，旋致仕",
      "summary": "明宗即位之年，孔勍被召回京城，授河阳节度使；之后致仕未独年，另列。",
      "year": null,
      "sortOrder": 5,
      "precision": "range",
      "sourceDate": "明宗即位之岁，授河阳未独月日；天成元年跨926—927年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v064",
          "paragraphId": "old-v064-p12",
          "originalRevision": 1,
          "originalSha256": "d8add0db2f12824d8bfb965a7a855a802067dbe5c01027a4f4dd5716f684bb43",
          "excerpt": "明宗即位之歲，詔還京師，授河陽節度使。"
        }
      ],
      "yearRange": {
        "start": 926,
        "end": 927
      }
    },
    {
