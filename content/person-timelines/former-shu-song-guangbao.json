  "events": [
    {
      "id": "former-shu-song-guangbao-general-and-army-command-appointment",
      "title": "列内给事，授将军及军使",
      "summary": "王衍任内给事王廷绍、欧阳晃、李周辂、宋光葆等为将军及军使；通鉴批评这些人干预政事。",
      "year": 918,
      "sortOrder": 1,
      "precision": "day",
      "sourceDate": "《通鉴》贞明四年八月乙丑",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p49",
          "originalRevision": 1,
          "originalSha256": "a909a5e211b92353aafa5d7884687d1d2dc7c72680ce279575e52d1a9b46ad8d",
          "excerpt": "乙丑，蜀主以內給事王廷紹、歐陽晃、李周輅、宋光葆、宋承蘊、田魯儔等為將軍及軍使，皆干預政事，驕縱貪暴，大為蜀患，周庠切諫，不聽。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p45",
          "originalRevision": 1,
          "originalSha256": "61543db6079d383bc7d9aa2989f7f6597d76885ab4f40712a552775acdcc4d30",
          "excerpt": "晉王謀大舉入寇，周德威將幽州步騎三萬，李存審將滄景步騎萬人，李嗣源將邢洺步騎萬人，王處直遣將將易定步騎萬人，及麟、勝、雲、蔚、新、武等州諸部落奚、契丹、室韋、吐谷渾，皆以兵會之。八月，並河東、魏博之兵，大閱於魏州。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p24",
          "originalRevision": 1,
          "originalSha256": "ee68389392dd1234dda5e5093d49b82215eeda299163aeec4d4ea53c08b44d54",
          "excerpt": "均王中貞明四年（戊寅，公元九一八年）"
        },
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p2",
          "originalRevision": 1,
          "originalSha256": "9cdbcc2d669062d71a3627011d4abb08ed7ea7a181553dcb9bc54e9c21a44b0b",
          "excerpt": "乙丑，以内給事王廷紹、歐陽晃、李周輅、宋光葆、宋承蕰、田魯儔等爲將軍及軍使，干預國政，司徒周庠切諫不聽。"
        }
      ],
      "notes": [
        "将军及军使是合列任命，不补宋个人未详的具体将军号、所领军名。后文纵火扩宅明属欧阳晃，不归宋光葆。"
      ]
    },
    {
      "id": "former-shu-song-guangbao-defense-memorial-zizhou-wude",
      "title": "请备边，任梓州观察使及武德留后",
      "summary": "唐使李严来聘后，宋光葆建议选将练兵、屯边积粮、整治战舰；王衍任其为梓州观察使、充武德节度留后。",
      "year": 924,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "乾德六年四月来使段，奏议与任命未独记日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p30",
          "originalRevision": 1,
          "originalSha256": "057082158d41d67b13f0868c261f4b33a8397312d9eb80fbc262adddc3dd2285",
          "excerpt": "宣徽北院使宋光葆上言：「晉王有憑陵我國家之志，宜選將練兵，屯戍邊鄙，積糗糧，治戰艦以待之。」蜀主乃以光葆為梓州觀察使，充武德節度留後。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p29",
          "originalRevision": 1,
          "originalSha256": "59dba76916bfd6353bab489b466f37818e08fef95c19511be8f60d00a8a77c2a",
          "excerpt": "夏，四月，己巳朔，群臣上尊號曰昭文睿武至德光孝皇帝。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p3",
          "originalRevision": 1,
          "originalSha256": "ba48b26f68f94401dc342e313de95d5056c25c9314ccba58cf4eaf3e49937d68",
          "excerpt": "莊宗光聖神閔孝皇帝中同光二年（甲申，公元九二四年）"
        },
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p7",
          "originalRevision": 1,
          "originalSha256": "6162c4fd88e3835fb723ba510363a122fe4c56929958a303993aee73a9b78b3d",
          "excerpt": "帝乃以光葆爲梓州觀察使，充武德軍節度留後。"
        }
      ],
      "notes": [
        "任命不等于建议全部已经执行；“晋王”为原书话语，未据称谓擅改该人此时实际帝号。"
      ],
      "variants": [
        {
          "label": "请斩使者与再请守备的叙法",
          "sourceDate": "本传先是唐使来聘，未独记年月",
          "summary": "宋传记宋光葆与李严谈话后请斩之，继闻图蜀再请守备，均不被采用；通鉴此段请斩李严者为王宗俦，另叙宋备御建议及任职。分源保存。",
          "evidence": [
            {
              "chapterId": "shiguochunqiu-v046",
              "paragraphId": "shiguochunqiu-v046-p12",
              "originalRevision": 1,
              "originalSha256": "c9828f224d7f884afe43bfa512cd84068bb2a825e9f2cc0a9b57f0c076828d22",
              "excerpt": "先是唐使李嚴來聘，光葆與語終日，服其機辨，料嚴東還必爲鄧艾之謀，乃白後主曰："
            },
            {
              "chapterId": "shiguochunqiu-v046",
              "paragraphId": "shiguochunqiu-v046-p12",
              "originalRevision": 1,
              "originalSha256": "c9828f224d7f884afe43bfa512cd84068bb2a825e9f2cc0a9b57f0c076828d22",
              "excerpt": "請斬嚴以威天下。”後主不從。既而光葆聞嚴還急於圖蜀，復上疏請爲守備，後主亦不能用。"
            },
            {
              "chapterId": "tongjian-v273",
              "paragraphId": "tongjian-v273-p30",
              "originalRevision": 1,
              "originalSha256": "057082158d41d67b13f0868c261f4b33a8397312d9eb80fbc262adddc3dd2285",
              "excerpt": "王宗儔以其語侵蜀，請斬之，蜀主不從。"
            }
          ]
        }
      ]
    },
    {
      "id": "former-shu-song-guangbao-conditional-letter-and-five-prefecture-submission",
      "title": "通书郭崇韬，举五州归唐",
      "summary": "宋光葆给郭崇韬写信，提出唐兵不入境则举所辖内附，若违约则背城决战；郭回书接纳。随后宋以梓、绵、剑、龙、普五州归唐。",
      "year": 925,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "同光三年十月；旧史、通鉴作己丑，春秋作乙丑；写信未独记日",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p115",
          "originalRevision": 1,
          "originalSha256": "b0baf0aee6df10986e40879e0357297830f848f1ded3226ad6ed24e2060c48f5",
          "excerpt": "蜀武德留後宋光葆遺郭崇韜書，「請唐兵不入境，當舉巡屬內附；苟不如約，則背城決戰以報本朝。」崇韜復書撫納之。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p115",
          "originalRevision": 1,
          "originalSha256": "b0baf0aee6df10986e40879e0357297830f848f1ded3226ad6ed24e2060c48f5",
          "excerpt": "己丑，魏王繼岌至興州，光葆以梓、綿、劍、龍、普五州，"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p111",
          "originalRevision": 1,
          "originalSha256": "32a4e81e23a6d82b28eae433b80fb23238cc09a3f6289ef6be302214b15a71c7",
          "excerpt": "冬，十月，排陳斬斫使李紹琛與李嚴將驍騎三千、步兵萬人為前鋒，招討判官陳乂至寶雞，稱疾乞留。李愚厲聲曰：「陳乂見利則進，懼難則止。今大軍涉險，人心易搖，宜斬以徇！」由是軍中無敢顧望者。乂，薊州人也。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p80",
          "originalRevision": 1,
          "originalSha256": "caa8fd2a1edcfd1ad786022efe47e81c7fde7d36fb94b610286b6075392ace44",
          "excerpt": "莊宗光聖神閔孝皇帝中同光三年（乙酉，公元九二五年）"
        }
      ],
      "notes": [
        "提出的决战是条件语，不另造一场宋光葆与唐军交战。",
        "宋所辖为这五州，其他降将的三州、五州、阶州分别保留，不归并为宋的领地。"
      ],
      "variants": [
        {
          "label": "官称与己丑／乙丑之别",
          "sourceDate": "旧史、通鉴十月己丑；春秋本纪十月乙丑",
          "summary": "旧史列东川节度使，通鉴列武德留后；春秋此处作武定留后、记乙丑，卷37前文任命又作武德。原字与记日分别保留，不统一为一个官名、确日。",
          "evidence": [
            {
              "chapterId": "old-v033",
              "paragraphId": "old-v033-p8",
              "originalRevision": 1,
              "originalSha256": "05f579eae5fabdae05c1880887a6f198d67842b375ede1c317260c3f283dc801",
              "excerpt": "己丑，魏王繼岌至興州，偽東川節度使宋光葆以梓、綿、劍、龍、普五州來降；"
            },
            {
              "chapterId": "shiguochunqiu-v037",
              "paragraphId": "shiguochunqiu-v037-p8",
              "originalRevision": 1,
              "originalSha256": "455767cdf1721aa8b31f71f4eea5e1a58184d2d151b35283a8dc038aac9423f5",
              "excerpt": "是時武定留後宋光葆遺郭崇韜書，"
            },
            {
              "chapterId": "shiguochunqiu-v037",
              "paragraphId": "shiguochunqiu-v037-p8",
              "originalRevision": 1,
              "originalSha256": "455767cdf1721aa8b31f71f4eea5e1a58184d2d151b35283a8dc038aac9423f5",
              "excerpt": "乙丑，魏王繼岌至興州，光葆以梓、綿、劍、龍、普五州，"
            },
            {
              "chapterId": "tongjian-v273",
              "paragraphId": "tongjian-v273-p115",
              "originalRevision": 1,
              "originalSha256": "b0baf0aee6df10986e40879e0357297830f848f1ded3226ad6ed24e2060c48f5",
              "excerpt": "己丑，魏王繼岌至興州，光葆以梓、綿、劍、龍、普五州，"
            }
          ]
        }
      ]
    },
    {
      "id": "former-shu-song-guangbao-complaint-over-guangsi-killing",
      "title": "从梓州来诉宗弼诬杀宋光嗣",
      "summary": "宋光葆从梓州前来，申诉王宗弼诬杀宋光嗣等。书中随后叙郭崇韬因多项事由收捕诛杀宗弼等。",
      "year": 925,
      "sortOrder": 4,
      "precision": "month",
      "sourceDate": "同光三年十二月段、宗弼己巳被收捕以前；宋来诉未独记日",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p16",
          "originalRevision": 1,
          "originalSha256": "4e15790b7687e02858fa308bb5f270128441527f6a9f1cad1217af06f8ae48ac",
          "excerpt": "會宋光葆自梓州來，訴王宗弼誣殺宋光嗣等。"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p16",
          "originalRevision": 1,
          "originalSha256": "4e15790b7687e02858fa308bb5f270128441527f6a9f1cad1217af06f8ae48ac",
          "excerpt": "崇韜欲誅宗弼以自明，己巳，白繼岌收宗弼及王宗勳、王宗渥，皆數其不忠之罪，族誅之，籍沒其家。"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p14",
          "originalRevision": 1,
          "originalSha256": "ddea713537f04c07905a047c0cfaf5e04245bb67b6e67e05561a7fa57efb81f6",
          "excerpt": "平蜀之功，李紹琛為多，位在董璋上。而璋素與郭崇韜善，崇韜數召璋與議軍事。紹琛心不平，謂璋曰：「吾有平蜀之功，公等樸樕相從，反呫囁於郭公之門，謀相傾害。吾為都將，獨不能以軍法斬公邪！」璋訴於崇韜。十二月，崇韜表璋為東川節度使，解其軍職。紹琛愈怒，曰：「吾冒白刃，陵險阻，定兩川，璋乃坐有之邪！」乃見崇韜言：「東川重地，任尚書有文武才。宜表為帥。」崇韜怒曰：「紹琛反邪，何敢違吾節度！」紹琛懼而退。"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p3",
          "originalRevision": 1,
          "originalSha256": "3c0fc95eb4cd1a755cd3d91b7b6dbdbaa76c4ecd9d0ac84bab8cfe1c2002d35a",
          "excerpt": "莊宗光聖神閔孝皇帝下同光三年（乙酉，公元九二五年）"
        },
        {
          "chapterId": "shiguochunqiu-v039",
          "paragraphId": "shiguochunqiu-v039-p6",
          "originalRevision": 1,
          "originalSha256": "f78da46017fec6f12e87927b04977763511f2a06f9221ea1e2c1993d7c93d15e",
          "excerpt": "居數日，宋光葆自梓州來訴宗弼誣殺光嗣等，"
        }
      ],
      "notes": [
        "此历月虽跨925—926年，来诉在宗弼被收捕之前；己巳仍属925年，故以叙事前后界核准年为925，不把己巳移给宋来诉。",
        "不补申诉的具体受理人，不把宗弼被诛简化为宋的单一报仇结果或宋亲自杀之。"
      ]
    },
    {
      "id": "former-shu-song-guangbao-palace-service-northern-office",
      "title": "随从兄为宦者，历宫职及东川节度",
      "summary": "宋光嗣传附记宋光葆字季正，为光嗣从弟；随其为宦者，给事黄门，任宣徽北院使，累迁东川节度使。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "本传未独记这些经历的年月",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p12",
          "originalRevision": 1,
          "originalSha256": "c9828f224d7f884afe43bfa512cd84068bb2a825e9f2cc0a9b57f0c076828d22",
          "excerpt": "時光嗣有從弟光葆者，字季正，隨光嗣爲閹，給事黄門，官宣徽北院使，累遷東川節度使。"
        }
      ],
      "notes": [
        "从弟按原称保存，不补具体父辈谱系、同父母或收养；宋光嗣福州籍贯不移给宋光葆。",
        "给事黄门不擅改为给事中；宋光嗣为宣徽南院使，光葆为北院使，不互换。",
        "本条保存未独纪年的任职概述；有编年的武德留后任命另见备边条，不据此凑两次同官任命。"
      ]
    },
    {
      "id": "former-shu-song-guangbao-chengbao-unadopted-strategy",
      "title": "旧史宋承葆献水陆攻守之策",
      "summary": "旧史在唐师未起时，记东川节度使宋承葆向王衍建议造舰募水军、水陆进取，并联结契丹；王衍未采纳。本页以相应职任与语境并列参看该记载。",
      "year": null,
      "sortOrder": 6,
      "precision": "range",
      "sourceDate": "旧史在李严使还、唐师未起间追叙；以所选来使至925年伐蜀前为范围",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v136",
          "paragraphId": "old-v136-p8",
          "originalRevision": 1,
          "originalSha256": "25f255a2927bac02b65d8e3084634fbc1ef0f35b2ef6081ddac373a6b6a68d6c",
          "excerpt": "唐師未起時，偽東川節度使宋承葆獻計於衍云："
        },
        {
          "chapterId": "old-v136",
          "paragraphId": "old-v136-p8",
          "originalRevision": 1,
          "originalSha256": "25f255a2927bac02b65d8e3084634fbc1ef0f35b2ef6081ddac373a6b6a68d6c",
          "excerpt": "又選三蜀驍壯三萬，急攻岐、雍，東據河、潼，北招契丹，啖以美利，見可則進，否則據散關以固吾圉，事縱不捷，亦攻敵人之心矣。」衍不從。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p30",
          "originalRevision": 1,
          "originalSha256": "057082158d41d67b13f0868c261f4b33a8397312d9eb80fbc262adddc3dd2285",
          "excerpt": "宣徽北院使宋光葆上言：「晉王有憑陵我國家之志，宜選將練兵，屯戍邊鄙，積糗糧，治戰艦以待之。」蜀主乃以光葆為梓州觀察使，充武德節度留後。"
        }
      ],
      "notes": [
        "本卷原作宋承葆；不改为宋光葆，不将裸承葆全库归人，也不与宋承蕴合并。",
        "造舰五百艘、募水军五千及选兵三万均是所献计划，不记为已出兵、已造舰或已结盟。"
      ],
      "variants": [
        {
          "label": "考异对备兵的判断",
          "sourceDate": "同光二年使行年月考辨",
          "summary": "考异说八月后屯洋、利“似用宋光葆之言”，只是编者推测；不把它写成备御建议全部被实际采用。",
          "evidence": [
