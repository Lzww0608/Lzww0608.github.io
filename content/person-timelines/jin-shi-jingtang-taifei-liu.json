  "events": [
    {
      "id": "jin-shi-jingtang-taifei-liu-requested-patent",
      "title": "有司请上宝册而未及办理",
      "summary": "新史记天福二年三月，有司以皇太妃尊号已正，请上宝册；高祖以宗庙未立，谦抑未遑。只记这一实际请求与未行，不补此前尊号日期或已成册礼。",
      "year": 937,
      "precision": "year",
      "sourceDate": "《新五代史》晋家人传：天福二年三月",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p3",
          "originalRevision": 1,
          "originalSha256": "bd03077b3f0e5b10933b3e4b175af0f0c5c300f7d21cfccccbd92d0b57a19789",
          "excerpt": "高祖即位，公主當為皇后。天福二年三月，有司言：「皇太妃尊號已正，請上寶冊。」太妃，高祖庶母劉氏也。高祖以宗廟未立，謙抑未皇。七年夏五月，高祖已病，乃詔尊太妃為皇太后，然卒不奉冊而高祖崩，故后訖高祖世亦無冊命。出帝天福八年七月，冊尊皇后為皇太后。"
        }
      ],
      "notes": [],
      "sortOrder": 1
    },
    {
      "id": "jin-shi-jingtang-taifei-liu-decree-empress-dowager",
      "title": "诏尊皇太后，未及奉册",
      "summary": "天福七年夏五月乙巳，晋高祖诏尊皇太妃刘氏为皇太后。新史家人传说明，终未奉册而高祖崩；诏尊与册礼完成分开。",
      "year": 942,
      "precision": "year",
      "sourceDate": "天福七年夏五月乙巳；仅定年，不转换确日",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v080",
          "paragraphId": "old-v080-p7",
          "originalRevision": 1,
          "originalSha256": "3db2e973447cbc0b915468c851c9c663ad8b8169c1c5062acec70233e5316fef",
          "excerpt": "天福七年春正月丙辰朔，不受朝賀，用兵故也。"
        },
        {
          "chapterId": "old-v080",
          "paragraphId": "old-v080-p12",
          "originalRevision": 1,
          "originalSha256": "98ffb4f39afe2d88c4ad84a9bf8e06eccef4001e1fe8ff0af6599ff6da5ff840",
          "excerpt": "乙巳，尊皇太妃劉氏為皇太后。"
        },
        {
          "chapterId": "new-v08",
          "paragraphId": "new-v08-p12",
          "originalRevision": 1,
          "originalSha256": "01cf955a5bd3a743e7ec1c5abb61ec88c26b44ba48660b3ebfd021c5b64bc236",
          "excerpt": "夏五月乙巳，尊皇太妃劉氏為太后。〈高祖所生母也。〉"
        },
        {
          "chapterId": "tongjian-v283",
          "paragraphId": "tongjian-v283-p17",
          "originalRevision": 1,
          "originalSha256": "8134b20a898cade94a829e2764016401924f55786b2cc4c2c2e8d9375170f969",
          "excerpt": "乙巳，尊太妃劉氏為皇太后。太后，帝之庶母也。"
        },
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p3",
          "originalRevision": 1,
          "originalSha256": "bd03077b3f0e5b10933b3e4b175af0f0c5c300f7d21cfccccbd92d0b57a19789",
          "excerpt": "高祖即位，公主當為皇后。天福二年三月，有司言：「皇太妃尊號已正，請上寶冊。」太妃，高祖庶母劉氏也。高祖以宗廟未立，謙抑未皇。七年夏五月，高祖已病，乃詔尊太妃為皇太后，然卒不奉冊而高祖崩，故后訖高祖世亦無冊命。出帝天福八年七月，冊尊皇后為皇太后。"
        }
      ],
      "notes": [],
      "sortOrder": 2
    },
    {
      "id": "jin-shi-jingtang-taifei-liu-death-and-testament",
      "title": "卒及遗诏丧礼从简",
      "summary": "旧史七月壬辰记太皇太后刘氏卒，称高祖庶母；遗诏服纪园陵不用皇后礼，皇帝不得停止军国机务。礼官随后提出服丧成例并获准，另属朝廷处置。",
      "year": 942,
      "precision": "year",
      "sourceDate": "《旧五代史》少帝纪：七月壬辰；承天福七年高祖六月崩后叙次",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "new-v08",
          "paragraphId": "new-v08-p12",
          "originalRevision": 1,
          "originalSha256": "01cf955a5bd3a743e7ec1c5abb61ec88c26b44ba48660b3ebfd021c5b64bc236",
          "excerpt": "七年春正月丁巳，克鎮州，安重榮伏誅，赦廣晉。庚午，契丹使達剌來。三月，歸德軍節度使安彥威塞決河于滑州。閏月，天興蝗食麥。夏五月乙巳，尊皇太妃劉氏為太后。〈高祖所生母也。〉六月丙辰，吐渾使念醜漢來。乙丑，皇帝崩于保昌殿。〈年五十一。〉"
        },
        {
          "chapterId": "old-v081",
          "paragraphId": "old-v081-p2",
          "originalRevision": 1,
          "originalSha256": "f4b3e0c746303a4d55d3ca98c31962618ba4410f8370a1043b628149150576bd",
          "excerpt": "是歲六月十三日乙丑，高祖崩，承遺制命柩前即皇帝位。"
        },
        {
          "chapterId": "old-v081",
          "paragraphId": "old-v081-p3",
          "originalRevision": 1,
          "originalSha256": "2eccfff3c9641e7b3c98288763e904fc462ce387ec024b1a4ade22bb40a2b210",
          "excerpt": "壬辰，太皇太后劉氏崩，高祖之庶母也。遺詔服紀園陵毋用後禮，皇帝不得廢軍國機務。"
        }
      ],
      "notes": [
        "年次以新史七年高祖崩与旧史同一六月乙丑事件互核，不将旧81p1末疑脱文字直接补回或硬承为六年。"
      ],
      "sortOrder": 3
    }
  ]
