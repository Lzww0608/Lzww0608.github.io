  "events": [
    {
      "id": "jin-princess-changan-changan-title",
      "title": "封长安公主",
      "summary": "旧史天福二年五月庚午封皇第二十一女为长安公主；会要也记二年五月初封，但称高祖长女。排行分歧并列，不自行校改底本。",
      "year": 937,
      "precision": "year",
      "sourceDate": "天福二年五月庚午；会要同年五月",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v076",
          "paragraphId": "old-v076-p4",
          "originalRevision": 1,
          "originalSha256": "d514aaf3f60002ceba4a324f1172a6cab73ffa322a09b0702c1be87473665816",
          "excerpt": "天福二年春正月甲寅朔，帝御文明殿受朝賀，仗衛如式。"
        },
        {
          "chapterId": "old-v076",
          "paragraphId": "old-v076-p9",
          "originalRevision": 1,
          "originalSha256": "7340b8aed8d8f39c1b76d2e8ad76e7136c749006c0ed8843c5dbf824e10c553a",
          "excerpt": "庚午，制封皇第二十一女為長安公主，封皇第十一妹烏氏為壽安長公主，皇第十二妹史氏為永壽長公主，皇第十三妹杜氏為樂平長公主。"
        },
        {
          "chapterId": "huiyao-v002",
          "paragraphId": "huiyao-v002-p20",
          "originalRevision": 1,
          "originalSha256": "523cbea60d095600ebbcc2e6841ce3849c4f68f8c819c446657ead8ab94f9341",
          "excerpt": "晉高祖長女長安公主，〈降楊承祚，天福二年五月封，至六年五月卒。追封秦國公主，至七年九月又追封梁國長公主。〉從長女高平縣主，第二女新平縣主，第三女千乘縣主，孫女永慶縣主。〈並天福七年五月封〉"
        }
      ],
      "notes": [],
      "sortOrder": 1
    },
    {
      "id": "jin-princess-changan-marriage-yang",
      "title": "下嫁杨承祚：记年异说",
      "summary": "旧史天福五年三月丁丑记长安公主出降杨承祚。通鉴则在天福三年五月庚申记杨承祚尚帝女长安公主。保两书938与940年的不同叙次，不解释成两次婚姻，也不将尚主降作只定婚。",
      "year": 940,
      "precision": "year",
      "sourceDate": "旧史天福五年三月丁丑；另见通鉴天福三年五月庚申",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v079",
          "paragraphId": "old-v079-p1",
          "originalRevision": 1,
          "originalSha256": "7fc145c2f4d2eb8ad3bbd4417860d39c8a487bd23f89ec16ac3a53f57809ee2c",
          "excerpt": "天福五年春正月丁卯朔，帝御崇元殿受朝賀，仗衛如式。"
        },
        {
          "chapterId": "old-v079",
          "paragraphId": "old-v079-p3",
          "originalRevision": 1,
          "originalSha256": "b82dab1ecdbd87bb7e908995df98c34ad3bca4e55d0609a85f5c6fb82058e67b",
          "excerpt": "丁丑，長安公主出降駙馬都尉楊承祚。"
        },
        {
          "chapterId": "huiyao-v002",
          "paragraphId": "huiyao-v002-p25",
          "originalRevision": 1,
          "originalSha256": "5127be45fd2a8d99af80b39030e1028134884df43df4264741813fab2e6fe1b0",
          "excerpt": "晉天福四年八月，中書門下奏：「據太常禮院定來年長安公主出降儀，太僕寺供厭翟二馬車，殿中省備團方、編扇各十六，行障三座，障三，傘一，大扇一，團大扇二。今車、障、傘、扇是同光元年皇后法物，欲備飾牙仗、厭翟車，后以四馬，今權去二馬。」從之。"
        },
        {
          "chapterId": "huiyao-v002",
          "paragraphId": "huiyao-v002-p26",
          "originalRevision": 1,
          "originalSha256": "9c18d4d5cb40356048571353aebdd56a3adda9d05e4f0097910856a25c7b9984",
          "excerpt": "五年二月，太常禮院奏：「長安公主以三月出降。按唐德宗朝禮儀使顔真卿議，婚用誕馬，在禮無文。周禮：『諸侯以璋聘女。』禮云：『玉以比德。』今請駙馬都尉加以璋，郡主之婿加玄纁，以代用馬。書函之禮，出自近代，事無正經，請廢之勿用。」詔曰：「納采之時，主人再拜，使者不答，雖開元禮具載其儀，今宜答拜。仍令鄭王重貴主其婚禮，中外不賀，餘依所奏。」"
        },
        {
          "chapterId": "new-v51",
          "paragraphId": "new-v51-p50",
          "originalRevision": 1,
          "originalSha256": "88d890fc894890cdd99ed5b72a7689df80e44edaa05f1460e0a4b2c0b389c70c",
          "excerpt": "高祖每優容之，為選其子承祚尚長安公主，其次子承信等皆超拜官爵，恩寵無比。"
        }
      ],
      "notes": [
        "会要四年八月议来年婚仪、五年二月议三月出降及郑王重贵主婚，是准备奏议，不把其日期替代实际出降。"
      ],
      "variants": [
        {
          "label": "通鉴天福三年尚主",
          "sourceDate": "天福三年五月庚申（938年）",
          "year": 938,
          "summary": "通鉴在938年记尚帝女长安公主，保婚配叙事原义与不同记年，不改成仅聘定。",
          "evidence": [
            {
              "chapterId": "tongjian-v281",
              "paragraphId": "tongjian-v281-p63",
              "originalRevision": 1,
              "originalSha256": "e4e4b5926ba067c41aef6e0dd3d0f31147e3876f729d60cb12d1bbd2ab8316c7",
              "excerpt": "高祖聖文章武明德孝皇帝上之下天福三年（戊戌，公元九三八年）"
            },
            {
              "chapterId": "tongjian-v281",
              "paragraphId": "tongjian-v281-p72",
              "originalRevision": 1,
              "originalSha256": "915c9eff04b6d419f002e963312d19f0a232bbfade494876aab39c2b716ca20c",
              "excerpt": "吳讓皇固辭舊宮，屢請徙居；李德誠等亦亟以為言。五月，戊午，唐主改潤州牙城為丹楊宮，以李建勳為迎奉讓皇使。"
            },
            {
              "chapterId": "tongjian-v281",
              "paragraphId": "tongjian-v281-p73",
              "originalRevision": 1,
              "originalSha256": "ccd44fa0064981154255f4d9100d47e966d7ed502784868f0483318a201bd86e",
              "excerpt": "楊光遠自恃擁重兵，頗干預朝政，屢有抗奏，帝常屈意從之。庚申，以其子承祚為左威衛將軍，尚帝女長安公主，次子承信亦拜美官，寵冠當時。"
            }
          ]
        }
      ],
      "sortOrder": 2
    },
    {
      "id": "jin-princess-changan-death-qin",
      "title": "薨逝并追赠秦国公主",
      "summary": "旧史天福六年二月癸丑记公主卒，称高祖长女、笄年下嫁，帝辍朝二日，追赠秦国公主；会要同年作五月卒。死亡、辍朝与追赠分明，不将笄年反推生日。",
      "year": 941,
      "precision": "year",
      "sourceDate": "旧史天福六年二月癸丑；会要作六年五月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v079",
          "paragraphId": "old-v079-p11",
          "originalRevision": 1,
          "originalSha256": "9089dc81dd93bcfcdf10c2b0e010a5ebe72d11651abb6d2b66ec15444235ad98",
          "excerpt": "天福六年春正月辛酉朔，帝御崇元殿受朝賀，仗衛如式。"
        },
        {
          "chapterId": "old-v079",
          "paragraphId": "old-v079-p12",
          "originalRevision": 1,
          "originalSha256": "3e9788c6fe4d7cd51d28cbc4e0784788ebc7053d212f9f4386bb8bf9841cb6f2",
          "excerpt": "癸丑，長安公主薨，帝之長女也，笄年降於駙馬楊承祚。帝悼惜之甚，輟視朝二日，追贈秦國公主。"
        }
      ],
      "notes": [],
