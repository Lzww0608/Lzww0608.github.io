      "title": "马令书载勤谨服侍小周",
      "summary": "马令记黄氏谦抑服勤事小周，并解释她没有受谴。只保本书叙述，不替同时遇害美女推人数或施害者。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "小周专房时期；未独记年月",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "nantangma-v006",
          "paragraphId": "nantangma-v006-p10",
          "originalRevision": 1,
          "originalSha256": "80d5335ca9f688fc5f36e50a348c770225aa8a33a38e0a0dce58754533a36d18",
          "excerpt": "黄氏服勤降體以事小周故同時美女率多遇害而黄氏獨不遭譴以其事之盡也"
        }
      ]
    },
    {
      "id": "nantang-li-yu-baoyi-huang-books-destruction",
      "title": "奉焚书之命，城陷后书籍焚毁",
      "summary": "《十国春秋》、陆游记后主预命她城不守便焚书，城陷后悉焚；马令引语作吾所宝，并只记图籍俱煬，施事口径不统一。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "城将陷至城陷；未给本条另定月日",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p10",
          "originalRevision": 1,
          "originalSha256": "04cb5df7880f538590dd2623945bae7126d4a049346db91599401a0b874ced9c",
          "excerpt": "城若不守，汝卽焚之，無爲它人所得。」及城陷，悉焚無遺者。"
        }
      ],
      "variants": [
        {
          "label": "马令引语和焚毁叙法",
          "sourceDate": "都城将陷及城陷，未独记年月",
          "summary": "引语作吾所宝惜；城陷后图籍俱煬，未另明点火者。",
          "evidence": [
            {
              "chapterId": "nantangma-v006",
              "paragraphId": "nantangma-v006-p10",
              "originalRevision": 1,
              "originalSha256": "80d5335ca9f688fc5f36e50a348c770225aa8a33a38e0a0dce58754533a36d18",
              "excerpt": "此皆吾所寳惜城若不守即焚之無使散逸及城䧟圗籍俱煬靡有遺者"
            }
          ]
        }
      ]
    },
