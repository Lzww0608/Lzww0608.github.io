      "title": "嫁王昭祚",
      "summary": "普宁公主嫁赵王王镕之子王昭祚；婚盟又见晋王议论中的朱温之女。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "婚配未记年日",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "huiyao-v002",
