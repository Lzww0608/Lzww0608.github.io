  "events": [
    {
      "id": "zhu-hanbin-succession-support",
      "title": "领兵屯滑，作为夺位外援",
      "summary": "朱友贞、杨师厚等谋诛朱友珪时，杨师厚遣招讨马步都虞候朱汉宾领兵屯滑州，作为外应；不把这次外援写成亲自入宫诛友珪。",
      "year": 913,
      "sortOrder": 1,
      "precision": "month",
      "phase": "service",
      "sourceDate": "《通鉴》乾化三年二月夺位同役",
      "evidence": [
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p89",
          "originalRevision": 1,
          "originalSha256": "7699b55dd3825075074cb4b6c7cb251762d1b58e2f40c9680cf3f0adfa5d0808",
          "excerpt": "太祖神武元聖孝皇帝下乾化三年（癸酉，公元九一三年）"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p94",
          "originalRevision": 1,
          "originalSha256": "72aeddd36bb6ef588932108e4d649c96fdd9b22d69674b3bc78c2c640947f36f",
          "excerpt": "二月，壬午，蜀大赦。"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p95",
          "originalRevision": 1,
          "originalSha256": "1b99c06404ff140406ed7b7d19ad24acbeea329ac3aebc500adace281cb03149",
          "excerpt": "郢王友珪既得志，遽為荒淫，內外憤怒，友珪雖啖以金繒，終莫之附。駙馬都尉趙巖，犨之子，太祖之婿也；左龍虎統軍、侍衛親軍都指揮使袁象先，太祖之甥也。巖奉使至大梁，均王友貞密與之謀誅友珪，巖曰：「此事成敗，在招討楊令公耳，得其一言諭禁軍，吾事立辦。」均王乃遣腹心馬慎交之魏州說楊師厚曰：「郢王篡弒，人望屬在大梁，公若因而成之，此不世之功也。」且許事成之日賜犒軍錢五十萬緡。師厚與將佐謀之，曰：「方郢王弒逆，吾不能即討；今君臣之分已定，無故改圖，可乎？」或曰：「郢王親弒君父，賊也，均王舉兵復仇，義也。奉義討賊，何君臣之有！彼若一朝破賊，公將何以自處乎？」師厚驚曰：「吾幾誤計。」乃遣其將王舜賢至洛陽，陰與袁象先謀，遣招討馬步都虞候譙人朱漢賓將兵屯滑州為外應。趙巖歸洛陽，亦與象先密定計。"
        }
      ]
    },
    {
      "id": "zhu-hanbin-zhuyouqian",
      "title": "宴上责朱友谦，两人交恶",
      "summary": "朱汉宾与朱友谦本因同养子身份相交，友谦不回信，汉宾怀恨，洛阳宴上责其坐位与不答书；元行钦劝解。",
      "year": 926,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "同光四年正月",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v064",
          "paragraphId": "old-v064-p9",
          "originalRevision": 1,
          "originalSha256": "0d191041bb6fc18b17940ae6de56a0a300bcc052cbf2ae73d932b5ebe9133e1d",
          "excerpt": "同光四年正月，冀王朱友謙入朝，明宗居洛陽，以友謙故人，置酒於第。莊宗諸弟在席，友謙坐在永王存霸之上。酒酣，漢賓以大觴奉友謙曰：「公雖名位高，坐於皇弟之上，非宜也。仆與公俱在梁朝，以宗盟相厚，自公入朝，三發單函候問，略無報復，忽餘卑位，不亦甚乎！」元行欽恐其紛然，為解之方止。不數日，友謙赤族。"
        },
        {
          "chapterId": "new-v45",
          "paragraphId": "new-v45-p35",
          "originalRevision": 1,
          "originalSha256": "1595bd8e4acdf03642775f10bfdc81ddd1f84b249a1046545c9bb6eb3ee95fba",
          "excerpt": "初，漢賓在梁也，與朱友謙俱為太祖養子，而友謙年長，漢賓以兄事之。其後梁亡，漢賓數寓書友謙，友謙不答，漢賓銜之。其後友謙見族，人皆以為漢賓有力。"
        }
      ],
      "notes": [
        "新史“人皆以为汉宾有力”是时人的归责，不能写成已有明确证据证明他直接导致族诛。"
      ]
    },
    {
      "id": "zhu-hanbin-henan",
      "title": "赵在礼据魏时，权知河南府",
      "summary": "赵在礼据魏州、元行钦统军讨伐时，朱汉宾奉诏暂管河南府事务，不把这一临时任职算作昭义节度任命。",
      "year": 926,
      "sortOrder": 3,
      "precision": "year",
      "phase": "service",
      "sourceDate": "同光四年赵在礼据魏州，元行钦进讨时",
      "evidence": [
        {
          "chapterId": "old-v064",
          "paragraphId": "old-v064-p9",
          "originalRevision": 1,
          "originalSha256": "0d191041bb6fc18b17940ae6de56a0a300bcc052cbf2ae73d932b5ebe9133e1d",
          "excerpt": "趙在禮據魏州，元行欽率軍進討，詔漢賓權知河南府事。"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p34",
          "originalRevision": 1,
          "originalSha256": "57b1fb375ddc834f27a542afed7b7f252a36a388aa35205f5c3f15671d71a29b",
          "excerpt": "莊宗光聖神閔孝皇帝下天成元年（丙戌，公元九二六年）"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p44",
          "originalRevision": 1,
          "originalSha256": "b19515a0b40cf15e2cb92829c8d37f7f48f8cb56e87851bdb5882bbc60fa5dff",
          "excerpt": "二月，己丑朔，以宣徽南院使李紹宏為樞密使。"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p49",
          "originalRevision": 1,
          "originalSha256": "9d9dda9d6753dcda26b6fb27cdf2f101b5b66d1e914bcc0012d74088db13d272",
          "excerpt": "丙申，史彥瓊至洛陽。帝問可為大將者於樞密使李紹宏，紹宏復請用李紹欽，帝許之，令條上方略。紹欽所請偏裨，皆梁舊將，己所善者，帝疑之而止。皇后曰：「此小事，不足煩大將，紹榮可辦也。」帝乃命歸德節度使李紹榮將騎三千詣鄴都招撫，亦征諸道兵，備其不服。"
        }
      ]
    },
    {
      "id": "zhu-hanbin-death",
      "title": "清泰二年卒，年六十四",
      "summary": "朱汉宾去世，旧史明记清泰二年六月、六十四岁，新史同记传统年和终年；后晋赠谥另列。",
      "year": 935,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "清泰二年六月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v064",
          "paragraphId": "old-v064-p9",
          "originalRevision": 1,
          "originalSha256": "0d191041bb6fc18b17940ae6de56a0a300bcc052cbf2ae73d932b5ebe9133e1d",
          "excerpt": "清泰二年六月卒，時年六十四。"
        },
        {
          "chapterId": "new-v45",
          "paragraphId": "new-v45-p37",
          "originalRevision": 1,
          "originalSha256": "329ed75e12aacbbbba4fceb577dca9ad384bd1ec3cdba4ff0ed97964b8fad4f9",
          "excerpt": "清泰二年卒，年六十四。"
        }
      ]
    },
    {
      "id": "zhu-hanbin-adopt",
      "title": "父战死后入朱温属籍，掌落雁都",
      "summary": "朱汉宾父朱元礼从庞师古战死淮南，朱温选汉宾入帐、属籍，后用为落雁都军使。父之死与任军的叙次按本传保留。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "父战没后及梁祖攻兖郓时，本传时序未标确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v064",
          "paragraphId": "old-v064-p9",
          "originalRevision": 1,
          "originalSha256": "0d191041bb6fc18b17940ae6de56a0a300bcc052cbf2ae73d932b5ebe9133e1d",
          "excerpt": "父元禮，始為郡將。梁太祖聞其名，擢為軍校，從龐師古渡淮，戰沒於淮南。漢賓少有膂力，形神壯偉，膽氣過人。梁祖以其父死王事，選置帳下，編入屬籍。梁祖之攻兗、鄆也，朱瑾募驍勇數百人，黥雙雁於其頰，立為「雁子都」。梁祖聞之，亦選數百人，別為一軍，號為「落雁都」。署漢賓為軍使，當時目為「朱落雁」。"
        },
        {
          "chapterId": "new-v45",
          "paragraphId": "new-v45-p32",
          "originalRevision": 1,
          "originalSha256": "1f7fa41431ca3aeda4bc9ffedbb14c76b8f2561c3ecf8ca04dcf5321eaa7692a",
          "excerpt": "朱漢賓字績臣，亳州譙人也。其父元禮為軍校，從梁軍戰，歿于清口。漢賓為人有膽力，梁太祖以其父死戰，憐之，以為養子。"
        },
        {
          "chapterId": "new-v45",
          "paragraphId": "new-v45-p33",
          "originalRevision": 1,
          "originalSha256": "a003596e9743f8110a2e21f738107f8113c7688d8b6fd127a087d772c567fb27",
          "excerpt": "是時，梁方東攻兗、鄆，鄆州朱瑾募其軍中驍勇者，黥雙鴈于其頰，號「鴈子都」。太祖聞之，乃更選勇士數百人，號「落鴈都」，以漢賓為指揮使。及漢賓貴，人猶以為「朱落鴈」。漢賓事梁為天威軍使，歷磁滑宋亳曹五州刺史、安遠軍節度使。"
        }
      ]
    },
    {
      "id": "zhu-hanbin-offices",
      "title": "历天威军及磁滑宋亳曹安州",
      "summary": "朱汉宾在梁历天威军使、羽林统军及各州刺史、留后，后为安州节度。旧史记平蔡立功，新史却说为将未有战功。",
      "year": null,
      "sortOrder": 6,
      "precision": "undated",
      "sourceDate": "天复中至梁朝诸任，未逐职记年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v064",
          "paragraphId": "old-v064-p9",
          "originalRevision": 1,
          "originalSha256": "0d191041bb6fc18b17940ae6de56a0a300bcc052cbf2ae73d932b5ebe9133e1d",
          "excerpt": "後與諸將破蔡賊有功，天復中，授右羽林統軍。入梁，曆天威軍使、左羽林統軍，出為磁州刺史、滑宋二州留後、亳曹二州刺史、安州節度使。"
        }
      ],
      "variants": [
        {
          "label": "新史对军事功绩的评价",
          "sourceDate": "梁朝诸任总结",
          "summary": "新史说未尝有战功，旧史称与诸将破蔡有功，评价不合，各源并存。",
          "evidence": [
            {
              "chapterId": "new-v45",
