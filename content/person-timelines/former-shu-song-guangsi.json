{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "former-shu-song-guangsi",
  "events": [
    {
      "id": "former-shu-song-guangsi-puci-return-gate-office",
      "title": "随公主归成都，任阁门南院使",
      "summary": "公主遣宋光嗣持绢书向王建求归；公主到成都后，王建将她留下，并任宋光嗣为阁门南院使。",
      "year": 911,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "《通鉴》乾化元年年题下正月辛亥记公主抵达；送信和任官未各独记日",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "tongjian-v267",
          "paragraphId": "tongjian-v267-p131",
          "originalRevision": 1,
          "originalSha256": "3e4daa76782a14a632579317f310c84ee2013dbb8e9cf890f7029533f400fcb4",
          "excerpt": "蜀主之女普慈公主嫁岐王從子秦州節度使繼崇，公主遣宦者宋光嗣以絹書遣蜀主，言繼崇驕矜嗜酒，求歸成都，蜀主召公主歸寧。辛亥，公主至成都，蜀主留之，以宋光嗣為閣門南院使。岐王怒，始與蜀絕。光嗣，福州人也。"
        },
        {
          "chapterId": "tongjian-v267",
          "paragraphId": "tongjian-v267-p126",
          "originalRevision": 1,
          "originalSha256": "0d94890b2943d42ce3b67096d8049f73fa0ba72e3cbbe0c7908be2cdaff410dc",
          "excerpt": "太祖神武元聖孝皇帝中乾化元年（辛未，公元九一一年）"
        },
        {
          "chapterId": "tongjian-v267",
          "paragraphId": "tongjian-v267-p127",
          "originalRevision": 1,
          "originalSha256": "839275879d0dfd0fef40f51f2d6ae257291b0a5e10ab6f4a849985aac5426673",
          "excerpt": "春，正月，丙戌朔，日有食之。"
        },
        {
          "chapterId": "shiguochunqiu-v038",
          "paragraphId": "shiguochunqiu-v038-p34",
          "originalRevision": 1,
          "originalSha256": "a75825b48973fdfc44283167246211639416dea87397857c763baac51c4daa37",
          "excerpt": "公主遣宋光嗣以帛書上高祖求還。"
        }
      ],
      "notes": [
        "911对应公主归抵的编年位置；不把送信、召归和任官全部钉在辛亥日。",
        "福州籍贯仅据宋光嗣，不据此补宋光葆籍贯；公主婚配不等于宋与其有亲属关系。"
      ],
      "variants": [
        {
          "label": "公主封号与留任主语",
          "sourceDate": "卷46未独记归蜀年月",
          "summary": "本传称普宁公主，随其到成都后王建留下宋光嗣任官；《通鉴》与公主传称普慈。留公主与留宦者分清。",
          "evidence": [
            {
              "chapterId": "shiguochunqiu-v046",
              "paragraphId": "shiguochunqiu-v046-p12",
              "originalRevision": 1,
              "originalSha256": "c9828f224d7f884afe43bfa512cd84068bb2a825e9f2cc0a9b57f0c076828d22",
              "excerpt": "故爲宦者，給事普寧公主。公主爲岐王從子繼崇妻，不見容於夫而歸，光嗣隨公主至成都，高祖留之不遣，以爲閣門南院使。"
            },
            {
              "chapterId": "tongjian-v267",
              "paragraphId": "tongjian-v267-p131",
              "originalRevision": 1,
              "originalSha256": "3e4daa76782a14a632579317f310c84ee2013dbb8e9cf890f7029533f400fcb4",
              "excerpt": "蜀主之女普慈公主嫁岐王從子秦州節度使繼崇，公主遣宦者宋光嗣以絹書遣蜀主，言繼崇驕矜嗜酒，求歸成都，蜀主召公主歸寧。辛亥，公主至成都，蜀主留之，以宋光嗣為閣門南院使。岐王怒，始與蜀絕。光嗣，福州人也。"
            }
          ]
        }
      ]
    },
    {
      "id": "former-shu-song-guangsi-capital-field-military-delegation",
      "title": "受委都城和行营军旅",
      "summary": "王建病重、宫中权力调整时，下诏将都城及行营军旅事务交宣徽南院使宋光嗣，财赋、任官与刑狱文书另委庾凝绩。",
      "year": 918,
      "sortOrder": 2,
      "precision": "day",
      "sourceDate": "《通鉴》贞明四年五月丙申",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p37",
          "originalRevision": 1,
          "originalSha256": "a9f792e120b0295d9ae8558ad743e7dae1be719fe828fd69241714b7304b3149",
          "excerpt": "丙申，蜀主詔中外財賦、中書除授、諸司刑獄案牘專委庾凝績，都城及行營軍旅之事委宣徽南院使宋光嗣。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p36",
          "originalRevision": 1,
          "originalSha256": "6b7172315c859f0f9317c24762371ce52562cd132238dd683dce14f16bed5671",
          "excerpt": "司空兼門下侍郎、同平章事趙光逢告老，己巳，以司徒致仕。蜀主自永平末得疾，昏瞀，至是增劇。以北面行營招討使兼中書令王宗弼沉靜有謀，五月，召還，以為馬步都指揮使。乙亥，召大臣入寢殿，告之曰：「太子仁弱，朕不能違諸公之請，逾次而立之。若其不堪大業，可置諸別宮，幸勿殺之。但王氏子弟，諸公擇而輔之。徐妃兄弟，止可優其祿位，慎勿使之掌兵預政，以全其宗族。」"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p24",
          "originalRevision": 1,
          "originalSha256": "ee68389392dd1234dda5e5093d49b82215eeda299163aeec4d4ea53c08b44d54",
          "excerpt": "均王中貞明四年（戊寅，公元九一八年）"
        }
      ],
      "notes": [
        "两人的受委范围分别说明，不将财政、任官和刑狱一并归宋光嗣，也不写成亲自率军出征。"
      ]
    },
    {
      "id": "former-shu-song-guangsi-privy-council-deathbed-regency",
      "title": "任内枢密使，受遗诏辅政",
      "summary": "王建任宋光嗣为内枢密使，与王宗弼、王宗瑶、王宗绾、王宗夔同受遗诏辅政；《通鉴》解释王建担心旧将不为幼主所用。",
      "year": 918,
      "sortOrder": 3,
      "precision": "day",
      "sourceDate": "《通鉴》贞明四年五月辛丑；王建病亟时",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p37",
          "originalRevision": 1,
          "originalSha256": "a9f792e120b0295d9ae8558ad743e7dae1be719fe828fd69241714b7304b3149",
          "excerpt": "辛丑，以宋光嗣為內樞密使，與兼中書令王宗弼、宗瑤、宗綰、宗夔並受遺詔輔政。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p36",
          "originalRevision": 1,
          "originalSha256": "6b7172315c859f0f9317c24762371ce52562cd132238dd683dce14f16bed5671",
          "excerpt": "司空兼門下侍郎、同平章事趙光逢告老，己巳，以司徒致仕。蜀主自永平末得疾，昏瞀，至是增劇。以北面行營招討使兼中書令王宗弼沉靜有謀，五月，召還，以為馬步都指揮使。乙亥，召大臣入寢殿，告之曰：「太子仁弱，朕不能違諸公之請，逾次而立之。若其不堪大業，可置諸別宮，幸勿殺之。但王氏子弟，諸公擇而輔之。徐妃兄弟，止可優其祿位，慎勿使之掌兵預政，以全其宗族。」"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p24",
          "originalRevision": 1,
          "originalSha256": "ee68389392dd1234dda5e5093d49b82215eeda299163aeec4d4ea53c08b44d54",
          "excerpt": "均王中貞明四年（戊寅，公元九一八年）"
        },
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p12",
          "originalRevision": 1,
          "originalSha256": "c9828f224d7f884afe43bfa512cd84068bb2a825e9f2cc0a9b57f0c076828d22",
          "excerpt": "乃以光嗣爲樞密使，與王宗弼等同受顧命輔政。"
        }
      ],
      "notes": [
        "本条为枢密及顾命任用，不替代前条军旅受委，也不据同受顾命虚构诸人私交。"
      ],
      "variants": [
        {
          "label": "六军任命的前后叙次",
          "sourceDate": "《新史》王建病亟、卒前",
          "summary": "新史在王建去世前即记宋光嗣为枢密使判六军；通鉴与十国春秋另在王衍嗣位后叙判六军诸卫。各存叙法，不凑两次初任。",
          "evidence": [
            {
              "chapterId": "new-v63",
              "paragraphId": "new-v63-p25",
              "originalRevision": 1,
              "originalSha256": "c67fe60ea90c9167acb0bf04259bf096b925de6ae6df8ca186d5e14fd0e3d146",
              "excerpt": "乃以宦者宋光嗣為樞密使判六軍而建卒。"
            },
            {
              "chapterId": "tongjian-v270",
              "paragraphId": "tongjian-v270-p37",
              "originalRevision": 1,
              "originalSha256": "a9f792e120b0295d9ae8558ad743e7dae1be719fe828fd69241714b7304b3149",
              "excerpt": "癸卯，太子即皇帝位。尊徐賢妃為太后、徐淑妃為太妃。以宋光嗣判六軍諸衛事。"
            },
            {
              "chapterId": "shiguochunqiu-v046",
              "paragraphId": "shiguochunqiu-v046-p12",
              "originalRevision": 1,
              "originalSha256": "c9828f224d7f884afe43bfa512cd84068bb2a825e9f2cc0a9b57f0c076828d22",
              "excerpt": "後主踐阼，卽以光嗣判六軍諸衛事。"
            }
          ]
        }
      ]
    },
    {
      "id": "former-shu-song-guangsi-houzhu-six-armies",
      "title": "王衍嗣位后命判六军诸卫",
      "summary": "王衍继位的记事中，任宋光嗣主管六军诸卫事务。",
      "year": 918,
      "sortOrder": 4,
      "precision": "month",
      "sourceDate": "光天元年六月嗣位段；癸卯是王衍即位日，任官未独记日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p37",
          "originalRevision": 1,
          "originalSha256": "a9f792e120b0295d9ae8558ad743e7dae1be719fe828fd69241714b7304b3149",
          "excerpt": "六月，壬寅朔，蜀主殂。癸卯，太子即皇帝位。尊徐賢妃為太后、徐淑妃為太妃。以宋光嗣判六軍諸衛事。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p24",
          "originalRevision": 1,
          "originalSha256": "ee68389392dd1234dda5e5093d49b82215eeda299163aeec4d4ea53c08b44d54",
          "excerpt": "均王中貞明四年（戊寅，公元九一八年）"
        },
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p2",
          "originalRevision": 1,
          "originalSha256": "9cdbcc2d669062d71a3627011d4abb08ed7ea7a181553dcb9bc54e9c21a44b0b",
          "excerpt": "以宋光嗣判六軍諸衞事。"
        },
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p12",
          "originalRevision": 1,
          "originalSha256": "c9828f224d7f884afe43bfa512cd84068bb2a825e9f2cc0a9b57f0c076828d22",
          "excerpt": "後主踐阼，卽以光嗣判六軍諸衛事。"
        }
      ],
      "notes": [
        "具体任命日没有单独记载；新史归在王建病亟时的叙法见受顾命条，不据两种叙次造两次任命。"
      ]
    },
    {
      "id": "former-shu-song-guangsi-yield-six-armies",
      "title": "让判六军之职于王宗弼",
      "summary": "内枢密使宋光嗣提出把判六军之职让给兼中书令王宗弼，王衍准许。",
      "year": 918,
      "sortOrder": 5,
      "precision": "day",
      "sourceDate": "《通鉴》贞明四年九月壬午",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p53",
          "originalRevision": 1,
          "originalSha256": "f58492732e618bda1ecde63900522d7106d16265bfa30bbdc38d868ceabced63",
          "excerpt": "九月，壬午，蜀內樞密使宋光嗣以判六軍讓兼中書令王宗弼，蜀主許之。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p24",
          "originalRevision": 1,
          "originalSha256": "ee68389392dd1234dda5e5093d49b82215eeda299163aeec4d4ea53c08b44d54",
          "excerpt": "均王中貞明四年（戊寅，公元九一八年）"
        },
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p2",
          "originalRevision": 1,
          "originalSha256": "9cdbcc2d669062d71a3627011d4abb08ed7ea7a181553dcb9bc54e9c21a44b0b",
