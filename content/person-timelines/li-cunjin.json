    {
      "id": "li-cunjin-weibo",
      "title": "以严法整治魏博军队",
      "summary": "李存勖取得魏博后，李存进领天雄军职，用严厉军法约束银枪效节都等新附部队。",
      "year": null,
      "sortOrder": 8,
      "precision": "range",
      "sourceDate": "天祐十二年",
