  "events": [
    {
      "id": "li-cunjin-jin-prince-service",
      "year": 908,
      "title": "李存勖初嗣晋王位，入步军右都",
      "summary": "旧史记庄宗初嗣位时入步军右都、加检校司空，此时是李存勖继晋王位，尚未称帝；庄宗本纪记李克用卒于天祐五年后李存勖承嗣。",
      "sourceDate": "庄宗初嗣晋王位；天祐五年",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p10",
          "originalRevision": 1,
          "originalSha256": "884aa2ef1ce3c43b19e819a3d8ce7dd2167ccbadd9cca1efd2aae2f63ee2d26e",
          "excerpt": "莊宗初嗣位，入為步軍右都檢校司空，"
        },
        {
          "chapterId": "old-v027",
          "paragraphId": "old-v027-p4",
          "originalRevision": 1,
          "originalSha256": "0582df9aca55fcd39edab1ce65f298c96160b0835d5aa065207420d381991525",
          "excerpt": "天祐五年春正月，武皇疾篤，召監軍張承業、大將吳珙謂曰：「吾常愛此子志氣遠大，可付後事，惟卿等所教。」及武皇厭代，帝乃嗣王位於晉陽，時年二十有四。"
        }
      ],
      "sortOrder": 1,
      "phase": "service",
      "precision": "year"
    },
    {
      "id": "li-cunjin-baixiang",
      "title": "柏乡之战后升行营军职",
      "summary": "李存进随李存勖出井陉，在柏乡一带击败梁军，论功升行营军职并领州职，后来又收复慈州。",
      "year": 911,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "柏乡战役；旧史写相乡，新史写柏乡",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p10",
          "originalRevision": 1,
          "originalSha256": "884aa2ef1ce3c43b19e819a3d8ce7dd2167ccbadd9cca1efd2aae2f63ee2d26e",
          "excerpt": "莊宗初嗣位，入為步軍右都檢校司空，師出井陘，授行營馬軍都虞候，破汴軍於相鄉，論功授邠州刺史，轉檢校司徒。俄兼西南面行營招討使，出師收慈州，授慈、沁二州刺史。十二年，定魏博，授天雄軍都巡按使。"
        },
        {
          "chapterId": "new-v36",
          "paragraphId": "new-v36-p26",
          "originalRevision": 1,
          "originalSha256": "741d04416f3506270eab878c102fdef253ac12d8880c556dce9cda01a47dc63d",
          "excerpt": "從莊宗戰柏鄉，遷行營馬步軍都虞候，歷慈、沁二州刺史。"
        },
        {
          "chapterId": "old-v027",
          "paragraphId": "old-v027-p18",
          "originalRevision": 1,
          "originalSha256": "de49e1ff063f825d97e656961116066c92a3fbf2f0457ff9963d5b2d56204ec6",
          "excerpt": "天祐八年正月丁亥，周德威、史建瑭帥三千騎致師於柏鄉，設伏於村塢間，遣三百騎直壓其營。"
        }
      ],
      "notes": [
        "相乡／柏乡按底本分别展示；不暗改旧史用字。"
      ]
    },
    {
      "id": "li-cunjin-huliu-battle",
      "year": 919,
      "title": "参加胡柳之战",
      "summary": "旧史在天祐十四年升职、攻杨刘之后接记战胡柳；通鉴给出战役的贞明四年十二月癸亥纪日，已跨西历919年，保持本传叙次而另列实际战年。",
      "sourceDate": "后梁贞明四年十二月癸亥",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p10",
          "originalRevision": 1,
          "originalSha256": "884aa2ef1ce3c43b19e819a3d8ce7dd2167ccbadd9cca1efd2aae2f63ee2d26e",
          "excerpt": "十四年，擢蕃漢馬步副總管，從攻楊劉，戰胡柳。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p24",
          "originalRevision": 1,
          "originalSha256": "ee68389392dd1234dda5e5093d49b82215eeda299163aeec4d4ea53c08b44d54",
          "excerpt": "均王中貞明四年（戊寅，公元九一八年）"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p59",
          "originalRevision": 1,
          "originalSha256": "72cef2b12b96533789bb5f7a929e62b4f9fddb2da363d0c553711eb7be1b4e5e",
          "excerpt": "十二月，庚子朔，晉王進兵，距梁軍十里而捨。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p63",
          "originalRevision": 1,
          "originalSha256": "acc070ac1933b5db8ba2c2a28ff7de08cb14149e4873242fd924d865d846be0c",
          "excerpt": "壬戌，至胡柳陂。癸亥旦，候者言梁兵自後至矣。"
        }
      ],
      "sortOrder": 3,
      "phase": "service",
      "precision": "day"
    },
    {
      "id": "li-cunjin-zhenzhou",
      "title": "接替李嗣昭攻镇州",
      "summary": "李存进接替李嗣昭为招讨使，在东垣渡营军，以木材夹板夯筑营垒以应对松散沙土。",
      "year": 922,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "天祐十九年七月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p12",
          "originalRevision": 1,
          "originalSha256": "0de0c192196e47180d1243b4a89d8186b106674867b8d3396cc685d8f4436203",
          "excerpt": "七月，存進代嗣昭為招討，進營東垣渡，夾滹□為壘，沙土散惡，垣壁難成。存進斬伐林樹，版築旬日而就，賊不能寇。九月，王處球盡率其眾，乘其無備，奄至壘門。"
        }
      ]
    },
    {
      "id": "li-cunjin-death",
      "title": "东垣渡出战，血战阵亡",
      "summary": "镇州军突至营门，李存进带少数部下出战，后援没有跟上，血战阵亡，旧史记六十六岁；新史同记阵亡于桥上。",
      "year": 922,
      "sortOrder": 5,
      "precision": "year",
      "sourceDate": "天祐十九年九月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p12",
          "originalRevision": 1,
          "originalSha256": "0de0c192196e47180d1243b4a89d8186b106674867b8d3396cc685d8f4436203",
          "excerpt": "九月，王處球盡率其眾，乘其無備，奄至壘門。存進聞之，得部下數人出鬥，驅賊於橋下。俄而賊大至，後軍不繼，血戰而歿，時年六十六。"
        },
        {
          "chapterId": "new-v36",
          "paragraphId": "new-v36-p27",
          "originalRevision": 1,
          "originalSha256": "987bae809f669471e41bc1b527824ebd2d32b4746d9acba1ff8767b8aa2ee911",
          "excerpt": "晉軍晨出芻牧，文禮子處球以兵千餘逼存進柵，存進出戰橋上，殺處球兵殆盡，而存進亦歿于陣。"
        }
      ]
    },
    {
