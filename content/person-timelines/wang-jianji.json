  "events": [
    {
      "id": "wang-jianji-baixiang-bridge",
      "title": "柏乡以二百兵守桥退梁",
      "summary": "镇、定兵即将失守野河桥时，奉李存勖问策，选二百人挺枪大呼，击退梁兵。",
      "year": 911,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "柏乡之役；周德威传同役天祐八年正月二日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v065",
          "paragraphId": "old-v065-p1",
          "originalRevision": 1,
          "originalSha256": "e7f58d32a875f128dea732dae26f7f36aa455440e31ed49720fe2249dd4ab9fa",
          "excerpt": "建及於部選士二百，挺槍大噪，禦汴軍，卻之於橋下。"
        },
        {
          "chapterId": "old-v056",
          "paragraphId": "old-v056-p7",
          "originalRevision": 1,
          "originalSha256": "7a6428b761cf83c37ec022e0f5f700e2a952b79061f6b8e2664b1d0a1912cabf",
          "excerpt": "八年正月二日，德威率騎軍致師於柏鄉，設伏於村塢間，令三百騎以壓汴營。"
        }
      ]
    },
    {
      "id": "wang-jianji-yangliu",
      "title": "攻杨刘时亲负芦苇填壕",
      "summary": "攻杨刘时梁军坚守，王建及亲自背芦苇填沟，率先登梯，攻克城池。",
      "year": 918,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "天祐十四年十二月（同期后梁贞明三年十二月）",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v065",
          "paragraphId": "old-v065-p1",
          "originalRevision": 1,
          "originalSha256": "e7f58d32a875f128dea732dae26f7f36aa455440e31ed49720fe2249dd4ab9fa",
          "excerpt": "十二月，從攻楊劉，自寅至午，汴軍嬰城拒守，建及自負葭葦堙塹，率先登梯，遂拔之。"
        }
      ],
      "notes": [
        "该农历月整月在西历918年。"
      ]
    },
    {
      "id": "wang-jianji-huliu-hill",
      "title": "胡柳夺土山，率银枪军反击",
      "summary": "胡柳晋军初败，王建及率银枪军争取土山，力主乘势再击，促成晋军重振，获魏博内外衙都将。",
      "year": 919,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "天祐十五年十二月胡柳之役",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v065",
          "paragraphId": "old-v065-p1",
          "originalRevision": 1,
          "originalSha256": "e7f58d32a875f128dea732dae26f7f36aa455440e31ed49720fe2249dd4ab9fa",
          "excerpt": "即引銀槍效節大呼奮擊，三軍增氣，由是王師復振，以功授檢校司空、魏博內外衙都將。"
        },
        {
          "chapterId": "old-v056",
          "paragraphId": "old-v056-p10",
          "originalRevision": 1,
          "originalSha256": "94127ab33233f87c5b54975c6c852cbd696734d37b62c59740fcb3a7bfd1a4ac",
          "excerpt": "十二月二十三日，軍次胡柳陂。"
        }
      ],
      "notes": [
        "战年按原书记年的农历十二月跨西历919年。"
      ]
    },
    {
      "id": "wang-jianji-desheng-naval",
      "title": "斩船索、火攻，救德胜南城",
      "summary": "贺瑰以战舰阻晋军渡河，王建及用载甲士的船斧断竹索，顺流纵火烧舰，进入南城使梁军解围。",
      "year": 919,
      "sortOrder": 4,
      "precision": "month",
      "sourceDate": "天祐十六年；通鉴同役梁贞明五年四月，斩竹索救德胜南城",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v065",
          "paragraphId": "old-v065-p2",
          "originalRevision": 1,
          "originalSha256": "7fc418ae02bd336edbcbc5505ead09e75bcb0be7ef43e35020427913c9d15ae0",
          "excerpt": "建及乃入南城，賀瑰解圍而去。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p69",
          "originalRevision": 1,
          "originalSha256": "652c79c587ff849dbb50264bd666219a04ec8276403f6635b09e3471183f6793",
          "excerpt": "均王中貞明五年（己卯，公元九一九年）"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p76",
          "originalRevision": 1,
          "originalSha256": "56692684589f766ba41db129e857c7eb0d0c0f064471b68193581d73cb7985d9",
          "excerpt": "夏，四月，戊戌朔，即吳國王位。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p78",
          "originalRevision": 1,
          "originalSha256": "65c337bc5a7499530eee1a2327f71cecfe7902ad1d864fcc55c9a4638f36bfe8",
          "excerpt": "賀瑰攻德勝南城，百道俱進，以竹笮聯艨艟十餘艘，蒙以牛革，設睥睨、戰格如城狀，橫於河流，以斷晉之救兵，使不得渡。"
        }
      ]
    },
    {
