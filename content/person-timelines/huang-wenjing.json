    {
      "id": "huang-wenjing-huainan",
      "title": "随杨师厚入淮，在大独山战",
      "summary": "天祐二年春，黄文靖协杨师厚越寿春、侵庐江，至大独山杀淮军五千余人而还；后任蔡、颍州另记。",
      "year": 905,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天祐二年春",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p18",
          "originalRevision": 1,
          "originalSha256": "1410a6c25acbf6eee3ffaad2c98d277a6a42cc7c48ebac1d8b034aa90dccf77b",
          "excerpt": "天祐二年春，命佐楊師厚深入淮甸，越壽春，侵廬江，軍至大獨山，遇淮夷，殺五千餘眾，振旅而還。"
        }
      ]
    },
    {
      "id": "huang-wenjing-cai907",
      "title": "梁受禅后复蔡州刺史",
      "summary": "朱温受禅后，黄文靖再任蔡州刺史。",
      "year": 907,
      "sortOrder": 2,
      "precision": "year",
      "phase": "service",
      "sourceDate": "太祖受禅后",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p18",
          "originalRevision": 1,
          "originalSha256": "1410a6c25acbf6eee3ffaad2c98d277a6a42cc7c48ebac1d8b034aa90dccf77b",
          "excerpt": "太祖受禪，復為蔡州刺史，入為左神武統軍，又改左龍驤使。"
        }
      ]
    },
    {
      "id": "huang-wenjing-death",
      "title": "掌禁军后因阅马获罪被杀",
      "summary": "黄文靖乾化元年随朱温北征，因阅马获罪被斩。本纪同年十月丙辰在魏县记先锋将黄文靖伏诛。",
      "year": 911,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "乾化元年",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p18",
          "originalRevision": 1,
          "originalSha256": "1410a6c25acbf6eee3ffaad2c98d277a6a42cc7c48ebac1d8b034aa90dccf77b",
          "excerpt": "乾化元年，從太祖北征，因閱馬得罪，命斬之。"
        },
        {
          "chapterId": "old-v006",
          "paragraphId": "old-v006-p5",
          "originalRevision": 1,
          "originalSha256": "5b8aeda95b4c0025bbb688d6de1bd68d71e958a230c683a3e8ecaa8b036e22a0",
