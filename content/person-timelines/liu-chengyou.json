            },
            {
              "chapterId": "kaoyi-v030",
              "paragraphId": "kaoyi-v030-p47",
              "originalRevision": 1,
              "originalSha256": "3889b9302ef8fe6f4ec76fd7b7bc64c04cf20164a92460acfd55cd57b70eedfb",
              "excerpt": "按漢隱帝周太祖實録七月加平章事制詞無西征之言至八月壬午方受命出征蓋薛史之誤"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-chengyou-li-song",
      "title": "李崧一家遭诛",
      "summary": "太子太傅李崧及弟弟们被杀并灭族，旧史明确说因部下诬告；保留朝廷诏书的罪名与史家的判断，不能把诬告改写成坐实谋反。",
      "year": 948,
      "sortOrder": 9,
      "precision": "day",
      "sourceDate": "乾祐元年十一月甲寅",
      "phase": "rule",
      "evidence": [
