  "personId": "liu-chengyou",
  "events": [
    {
      "id": "liu-chengyou-birth",
      "title": "生于邺都",
      "summary": "刘承祐为刘知远第二子，母李氏，生于邺都旧宅。",
      "year": 931,
      "sortOrder": 1,
      "precision": "day",
      "sourceDate": "后唐长兴二年三月七日",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p1",
          "originalRevision": 1,
          "originalSha256": "9ac3c6a052c9c292fe2d4609e2a91b8095bb9f2204ea4365ea95001ae064f70b",
          "excerpt": "隱皇帝，諱承祐，高祖第二子也。母曰李太后，以唐長興二年，歲在辛卯，三月七日，生帝於鄴都之舊第。"
        }
      ],
      "variants": [
        {
          "label": "生日节名纪日差别",
          "year": 931,
          "sourceDate": "生日三月九日；乾祐元年十二月奏定嘉庆节",
          "summary": "同一本纪后文称生日三月九日，与开篇出生三月七日不同；九日是节名所据，未替换开篇纪日。",
          "evidence": [
            {
              "chapterId": "old-v101",
              "paragraphId": "old-v101-p12",
              "originalRevision": 1,
              "originalSha256": "098a917af8132e23e9e8cb8b1211fc8cd3df071215d3bee0cecef655cb75f04c",
              "excerpt": "辛卯，群臣上表，請以三月九日誕聖日為嘉慶節。從之。"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-chengyou-accession",
      "title": "封周王并柩前即位",
      "summary": "高祖死后秘不发丧，二月先封周王，随即奉遗制在父亲灵柩前即位，当天举哀成服。",
      "year": 948,
      "sortOrder": 2,
      "precision": "day",
      "sourceDate": "乾祐元年二月辛巳",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p2",
          "originalRevision": 1,
          "originalSha256": "ff5ec46e78c794f1a2657280c137b7132701b2701d6f7f89b72231174fa33d71",
          "excerpt": "二月辛巳，授特進、檢校太尉、同平章事，封周王。宣制畢，有頃，召文武百僚赴萬歲殿內，降大行皇帝遺制，云：「周王承祐，可於柩前即皇帝位。服紀日月，一依舊制。」是日，內外發哀成服。"
        }
      ]
    },
    {
      "id": "liu-chengyou-listen-government",
      "title": "听政并尊母为太后",
      "summary": "群臣四次表请后同意听政，在万岁殿东廊会见群臣，尊母李氏为皇太后。",
      "year": 948,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "乾祐元年二月甲申至丁亥",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p2",
          "originalRevision": 1,
          "originalSha256": "ff5ec46e78c794f1a2657280c137b7132701b2701d6f7f89b72231174fa33d71",
          "excerpt": "甲申，群臣上表請聽政，詔答不允，凡四上表，從之。丁亥，帝於萬歲殿門東廡下見群臣，尊母後為皇太后。"
        }
      ]
    },
    {
      "id": "liu-chengyou-amnesty-prisoners",
      "title": "大赦并放蜀俘",
      "summary": "二月大赦、给军赏、访求唐晋后裔；王景崇送来的四百三十八名蜀军将士获释并获衣服。",
      "year": 948,
      "sortOrder": 4,
      "precision": "month",
      "sourceDate": "乾祐元年二月癸巳、丙午",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p2",
          "originalRevision": 1,
          "originalSha256": "ff5ec46e78c794f1a2657280c137b7132701b2701d6f7f89b72231174fa33d71",
          "excerpt": "唐、晉兩朝求訪子孫，立為二王後"
        },
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p2",
          "originalRevision": 1,
          "originalSha256": "ff5ec46e78c794f1a2657280c137b7132701b2701d6f7f89b72231174fa33d71",
          "excerpt": "丙午，鳳翔巡檢使王景崇，遣人送所獲偽蜀將校軍士四百三十八人至闕下，詔釋之，仍各賜衣服。"
        }
      ]
    },
    {
      "id": "liu-chengyou-li-tao-dismissal",
      "title": "李涛议出枢密重臣而罢相",
      "summary": "李涛不满杨邠、郭威压制中书任命，建议外放他们并交苏氏掌枢密；杨邠等向太后申诉，李涛被罢归私宅。",
      "year": 948,
      "sortOrder": 5,
      "precision": "day",
      "sourceDate": "乾祐元年三月丁丑",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p3",
          "originalRevision": 1,
          "originalSha256": "72b993520a4e0697612d89e2d43efefd1795951db24ea6159510a2bff0b33be5",
          "excerpt": "丁丑，中書侍郎兼戶部尚書、平章事李濤罷免，勒歸私第。"
        }
      ],
      "notes": [
        "因果和太后参与见同一完整原段；不是隐帝亲自提出外放方案。"
      ]
    },
    {
      "id": "liu-chengyou-western-rebellions",
      "title": "部署镇压关西叛乱",
      "summary": "李守贞据河中反叛，赵思绾据永兴，朝廷任郭从义讨永兴、白文珂讨河中，并削李守贞官爵。",
      "year": 948,
      "sortOrder": 6,
      "precision": "month",
      "sourceDate": "乾祐元年三月至四月",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p3",
          "originalRevision": 1,
          "originalSha256": "72b993520a4e0697612d89e2d43efefd1795951db24ea6159510a2bff0b33be5",
          "excerpt": "西道諸州奏，河中李守貞謀叛，發兵據潼關。"
        },
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p4",
          "originalRevision": 1,
          "originalSha256": "47519cacf50950b9a6df92b7650d8132da51ed92e0a61dc15bc6fddf3cf1e9dc",
          "excerpt": "是日，以澶州節度使郭從義為永興軍一行兵馬都部署。"
        },
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p4",
          "originalRevision": 1,
          "originalSha256": "47519cacf50950b9a6df92b7650d8132da51ed92e0a61dc15bc6fddf3cf1e9dc",
          "excerpt": "以陜州節度使白文珂為河中府城下一行都部署。"
        },
        {
          "chapterId": "old-v101",
          "paragraphId": "old-v101-p4",
          "originalRevision": 1,
          "originalSha256": "47519cacf50950b9a6df92b7650d8132da51ed92e0a61dc15bc6fddf3cf1e9dc",
          "excerpt": "辛卯，削奪李守貞在身官爵。"
        }
      ]
    },
    {
      "id": "liu-chengyou-four-classics",
      "title": "准许雕印四经",
      "summary": "应国子监请求，召集学官校订并雕印尚无印版的《周礼》《仪礼》《公羊》《谷梁》。",
      "year": 948,
      "sortOrder": 7,
      "precision": "day",
      "sourceDate": "乾祐元年五月己酉朔",
      "phase": "rule",
      "evidence": [
        {
