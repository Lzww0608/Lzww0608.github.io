  "events": [
    {
      "id": "former-shu-pan-zaiying-discloses-tang-wenyi-plot",
      "title": "受派侦察外事，转告唐文扆之谋",
      "summary": "唐文扆派潘在迎侦察外间，潘把计谋告知王宗弼等；宗弼等入宫陈罪。",
      "sourceDate": "《通鉴》贞明四年五月叙次，潘告谋未独记日",
      "year": 918,
      "precision": "month",
      "phase": "service",
      "sortOrder": 1,
      "evidence": [
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p37",
          "originalRevision": 1,
          "originalSha256": "a9f792e120b0295d9ae8558ad743e7dae1be719fe828fd69241714b7304b3149",
          "excerpt": "遣其黨內皇城使潘在迎偵察外事，在迎以其謀告宗弼等。宗弼等排闥入，言文扆之罪，以天冊府掌書記崔延昌權判六軍事，召太子入侍疾。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p24",
          "originalRevision": 1,
          "originalSha256": "ee68389392dd1234dda5e5093d49b82215eeda299163aeec4d4ea53c08b44d54",
          "excerpt": "均王中貞明四年（戊寅，公元九一八年）"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p36",
          "originalRevision": 1,
          "originalSha256": "6b7172315c859f0f9317c24762371ce52562cd132238dd683dce14f16bed5671",
          "excerpt": "以北面行營招討使兼中書令王宗弼沉靜有謀，五月，召還，以為馬步都指揮使。"
        }
      ],
      "notes": [
        "五月依据前段承接；不把唐文扆丙子贬官或王建卒日移作潘告谋日。",
        "潘后来声称有诛唐安社稷功是本人言辞，不等于他亲自行刑。"
      ]
    },
    {
      "id": "former-shu-pan-zaiying-chongyang-wine-sorrow",
      "title": "重阳宴上以酒悲搪塞王宗寿",
      "summary": "王宗寿在宴上流泪陈说国家危急，潘在迎与韩昭以酒悲之说和谐笑搪塞。",
      "sourceDate": "《通鉴》同光元年九月庚戌、重阳宴",
      "year": 923,
      "precision": "month",
      "phase": "service",
      "sortOrder": 2,
      "evidence": [
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p28",
          "originalRevision": 1,
          "originalSha256": "dcc455e02f1d3a2c0599a5a824e1b40efd25ca2c1efb6df87b15e3b59a4e1d01",
          "excerpt": "九月，庚戌，蜀主以重陽宴近臣於宣華宛，酒酣，嘉王宗壽乘間極言社稷將危，流涕不已。韓昭、潘在迎曰：「嘉王好酒悲。」因諧笑而罷。"
        },
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p3",
          "originalRevision": 1,
          "originalSha256": "4527593f9618b65fbfb910c66a48b0cec246e59d73308125ee87e7f5e7f8d782",
          "excerpt": "莊宗光聖神閔孝皇帝上同光元年（癸未，公元九二三年）"
        }
      ],
      "notes": [
        "保原书记日，不补西历确日；宗寿流泪不写成潘流泪。",
        "宗寿传未独记年月的宴饮及赐宫人请求不强并入这场重阳宴，另按年代未定保存。"
      ]
    },
    {
      "id": "former-shu-pan-zaiying-bribes-wang-zongbi",
      "title": "国变时倾财贿宗弼而免死",
      "summary": "徐延琼、潘在迎、顾在珣与诸贵戚惶恐，倾家财及妓妾贿赂王宗弼，才免于一死。",
      "sourceDate": "《通鉴》同光三年十一月，未独记贿赂日",
      "year": 925,
      "precision": "month",
      "phase": "fall",
      "sortOrder": 3,
      "evidence": [
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p10",
          "originalRevision": 1,
          "originalSha256": "021a2331861d53aee35863a475a0a0f7081030360ec7dc938e920aab0e01f949",
          "excerpt": "內外馬步都指揮使兼中書令徐延瓊、果州團練使潘在迎、嘉州刺史顧在珣及諸貴戚皆惶恐，傾其家金帛妓妾以賂宗弼，僅得免死。"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p3",
          "originalRevision": 1,
          "originalSha256": "3c0fc95eb4cd1a755cd3d91b7b6dbdbaa76c4ecd9d0ac84bab8cfe1c2002d35a",
          "excerpt": "莊宗光聖神閔孝皇帝下同光三年（乙酉，公元九二五年）"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p4",
          "originalRevision": 1,
          "originalSha256": "f8d6d20ab12ee38e160822b42cbe609fcec9fa8bec65bb726d3d0b2ecc104015",
          "excerpt": "十一月，丙申，蜀主至成都，百官及後宮迎於七里亭。"
        }
      ],
      "notes": [
        "十一月叙次只适用这一明确行动，不把其后降唐全部官职定为同日。",
        "群体妓妾未具名，不指认为潘妻徐氏，也不因此新增无名个人。"
      ]
    },
    {
      "id": "former-shu-pan-zaiying-early-military-service",
      "title": "天复中初任节度押衙",
      "summary": "本传记潘在迎天复年间起家节度押衙。",
      "sourceDate": "《九国志》天复中，未独记年、月、日",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 4,
      "evidence": [
        {
          "chapterId": "jiuguozhi-v006",
          "paragraphId": "jiuguozhi-v006-p42",
          "originalRevision": 1,
          "originalSha256": "60b508d5bd8b9a3929dcd6097fd9c21bf4f418f4480734b9880465f2313750db",
          "excerpt": "天復中，起家節度押衙。"
        }
      ],
      "notes": [
        "保天复原记，不凭年号范围强定一个西历年。"
      ]
    },
    {
      "id": "former-shu-pan-zaiying-wang-jian-appointments",
      "title": "王建开国后任内皇城使等",
      "summary": "王建开国后，潘获任扈跸军使、检校司徒、守羽林大将军、内皇城使。",
      "sourceDate": "《九国志》王建开国后接叙，未独记各次授官年月",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 5,
      "evidence": [
        {
          "chapterId": "jiuguozhi-v006",
          "paragraphId": "jiuguozhi-v006-p42",
          "originalRevision": 1,
          "originalSha256": "60b508d5bd8b9a3929dcd6097fd9c21bf4f418f4480734b9880465f2313750db",
          "excerpt": "王建開國，以爲扈蹕軍使、檢校司徒、守羽林大將軍、內皇城使。"
        }
      ],
      "notes": [
        "检校加官与实际职事分开列述；不把整组任官都定为开国当日。"
      ]
    },
    {
      "id": "former-shu-pan-zaiying-demotion-and-restoration",
      "title": "贬雅州后，北巡时复充马步使",
      "summary": "《十国春秋》记潘先任内皇城使，后贬雅州，王衍北巡时又充马步使。",
      "sourceDate": "本传未记贬官及本次北巡年日；《考异》并记今不知何官",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 6,
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v046",
          "paragraphId": "shiguochunqiu-v046-p5",
          "originalRevision": 1,
          "originalSha256": "979f7e8ad029cbbfdca4a432e7b3df0c04a38f2d4aedb733c88b7c24bd3fc613",
          "excerpt": "歷官内皇城使，已而貶雅州。及後主北巡，復充馬步使。"
        },
        {
          "chapterId": "kaoyi-v029",
          "paragraphId": "kaoyi-v029-p34",
          "originalRevision": 1,
          "originalSha256": "758442a3b298bef885141dfb8e97d08fb984840e6e98c8e96fdba74731b26b99",
          "excerpt": "蜀内皇城使潘在迎〈在迎先為内皇城使貶雅州蜀主北廵為馬歩使今不知何官故且稱其舊官〉"
        }
      ],
      "notes": [
        "不以考异沿用旧衔推定编年当时仍任内皇城使；亦不按北巡二字择定某次巡幸年。",
        "唐文扆被贬眉州、流雅州另属唐本人，不能并入潘的贬官。"
      ]
    },
    {
      "id": "former-shu-pan-zaiying-court-entertainment-and-advice",
      "title": "陪侍游宴，并劝诛谏者",
      "summary": "王衍以潘在迎等为狎客，潘常参与宫中通宵宴饮，并劝诛谏者。",
      "sourceDate": "本传、通鉴后主时期合叙，未独记初始年月",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 7,
      "evidence": [
        {
          "chapterId": "jiuguozhi-v006",
          "paragraphId": "jiuguozhi-v006-p42",
          "originalRevision": 1,
          "originalSha256": "60b508d5bd8b9a3929dcd6097fd9c21bf4f418f4480734b9880465f2313750db",
          "excerpt": "衍荒于酒色，在迎與韓昭輩多預宴宮中，自昏達旦。"
        },
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p28",
          "originalRevision": 1,
          "originalSha256": "dcc455e02f1d3a2c0599a5a824e1b40efd25ca2c1efb6df87b15e3b59a4e1d01",
          "excerpt": "蜀主以文思殿大學士韓昭、內皇城使潘在迎、武勇軍使顧在珣為狎客，陪侍游宴，與宮女雜坐，或為艷歌相唱和，或談嘲謔浪，鄙俚褻慢，無所不至，蜀主樂之。"
        },
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p28",
          "originalRevision": 1,
          "originalSha256": "dcc455e02f1d3a2c0599a5a824e1b40efd25ca2c1efb6df87b15e3b59a4e1d01",
          "excerpt": "潘在迎每勸蜀主誅諫者，無使謗國。"
        }
      ],
      "notes": [
        "陪宴为持续性合叙，不把全段都定为923年九月。劝诛不等于各项建议已经实行，不补被害者。"
      ]
    },
    {
      "id": "former-shu-pan-zaiying-palace-woman-request-refused",
      "title": "请赐宫人给宗寿，未获准",
      "summary": "潘在迎请求把席间宫人赐给王宗寿，王衍以宗寿不会接受为由拒绝，于是作罢。",
      "sourceDate": "《十国春秋》宗寿传宴饮后接叙，未独记本次请求年月",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 8,
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v038",
          "paragraphId": "shiguochunqiu-v038-p27",
          "originalRevision": 1,
          "originalSha256": "f8157efed9f97a63582f99f84fae19e6712a24955133f5977609b3355d481b38",
          "excerpt": "後主不能省，復命宫人李氏歌己所撰新詞侑宗壽酒，宗壽一飲而盡，蓋懼禍也。在迎請卽以宫人賜宗壽，後主曰：“王必不納，無多溷耳。”遂止。"
        }
      ],
      "notes": [
        "本传未独记请求年月，不将宗寿传各段自动合并为同一场重阳宴。",
        "未实行的请求不作婚配关系，不把该宫人自动与其他李姓宫人合并。"
      ]
    },
    {
