          "originalRevision": 1,
          "originalSha256": "c217cbea150665bd9e99bca0ec2a4ff204555da2f36f3c36636294888ee62abb",
          "excerpt": "少事梁為宣武軍卒，以善射知名。"
        }
      ]
    },
    {
      "id": "lu-siduo-named-arrow",
      "title": "河上以刻名箭射晋，箭中晋王鞍",
      "summary": "梁晋对垒时刻姓名在箭尾射晋军，一箭中李存勖马鞍，被晋王收藏。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "梁晋河上对峙时",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v45",
          "paragraphId": "new-v45-p54",
          "originalRevision": 1,
          "originalSha256": "b3e1f41b54dc075487c97315cba0af4570a7bf1ce31405f01b08c1b206378dc2",
          "excerpt": "而矢中莊宗馬鞍，莊宗拔矢，見思鐸姓名，奇之。"
        }
      ]
    },
    {
      "id": "lu-siduo-after-liang",
      "title": "灭梁后拜见庄宗，获龙武军职",
      "summary": "庄宗出示当年中马鞍的刻名箭，陆思铎伏地请死，获慰免，授龙武右厢都指挥。",
      "year": null,
      "sortOrder": 3,
      "precision": "range",
      "sourceDate": "庄宗灭梁后，陆思铎谒见获龙武右厢军职，未记任命月年；在庄宗同光在位期间，西历923—926年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v45",
          "paragraphId": "new-v45-p54",
          "originalRevision": 1,
          "originalSha256": "b3e1f41b54dc075487c97315cba0af4570a7bf1ce31405f01b08c1b206378dc2",
          "excerpt": "莊宗慰而起之，拜龍武右廂都指揮使。"
        }
      ],
      "yearRange": {
        "start": 923,
        "end": 926
      }
    },
    {
      "id": "lu-siduo-chen-cai",
      "title": "晋高祖时历陈蔡刺史",
      "summary": "在后晋石敬瑭时先后任陈州、蔡州刺史，陈州治理获当地人爱戴。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "晋高祖时",
      "phase": "uncertain",
      "evidence": [
