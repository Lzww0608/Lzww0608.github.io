{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "zhu-shouyin",
  "events": [
    {
      "id": "zhu-shouyin-loss-desheng",
      "title": "疏备德胜南寨，失守后不被问罪",
      "summary": "王彦章攻德胜时守备未备，南寨失陷，庄宗撤北寨固杨刘；李嗣源请惩覆军罪，庄宗未追究。",
      "year": 923,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "同光元年德胜南寨陷；通鉴同役五月辛酉",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p6",
          "originalRevision": 1,
          "originalSha256": "467e46127706bebb3224466961621738d294ceb0f6ddb2ff74033b62b3b910f4",
          "excerpt": "守殷守德勝寨，為梁將王彥章所攻，守殷無備，遂陷南寨。"
        },
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p3",
          "originalRevision": 1,
          "originalSha256": "4527593f9618b65fbfb910c66a48b0cec246e59d73308125ee87e7f5e7f8d782",
          "excerpt": "莊宗光聖神閔孝皇帝上同光元年（癸未，公元九二三年）"
        },
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p15",
          "originalRevision": 1,
          "originalSha256": "155787b65b9677fb63d5b3c96fd3b573b7d7c50856ced609eb608600bb3376d2",
          "excerpt": "帝聞之，自將親軍屯澶州，命蕃漢馬步都虞候朱守殷守德勝，戒之曰：「王鐵槍勇決，乘憤激之氣，必來唐突，宜謹備之。」"
        },
        {
          "chapterId": "tongjian-v272",
          "paragraphId": "tongjian-v272-p16",
          "originalRevision": 1,
          "originalSha256": "a1979eb28613a8e81b8808babc669ad5a826b87c88b9f964a3ea8db037ca364f",
          "excerpt": "天微雨，朱安殷不為備，舟中兵舉鎖燒斷之，因以巨斧斬浮橋，而彥章引兵急擊南城。浮橋斷，南城遂破，斬首數千級。時受命適三日矣。守殷以小舟載甲士濟河救之，不及。"
        }
      ]
    },
    {
      "id": "zhu-shouyin-zhenwu",
      "title": "任振武而不赴，仍掌兵",
      "summary": "授振武节度使但未赴镇，仍兼蕃汉马步军，并负责初定京城内外警巡。",
      "year": 924,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "同光二年；本纪同事二月丁亥任振武",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p6",
          "originalRevision": 1,
          "originalSha256": "467e46127706bebb3224466961621738d294ceb0f6ddb2ff74033b62b3b910f4",
          "excerpt": "同光二年，為振武節度使，不之任，仍兼領蕃漢馬步軍。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p1",
          "originalRevision": 1,
          "originalSha256": "56aeec50377f2b2ccf3e459c7bfe207e6f01c8817e3bd6c9000b7f3148a86eed",
          "excerpt": "同光二年春正月庚子朔，帝御明堂殿受朝賀，仗衛如式。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p4",
          "originalRevision": 1,
          "originalSha256": "61420c0d8dbbc98df3e1b7651e586890a749590c2f264f0e8f4a68bdc42d47a9",
          "excerpt": "二月己巳朔，親祀昊天上帝於圜丘，禮畢，宰臣率百官就次稱賀，還禦五鳳樓。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p7",
          "originalRevision": 1,
          "originalSha256": "07a70d00c64c7eea09777dfa72d1589e161e4e25701afe15d8b0da96124a15ce",
          "excerpt": "以蕃漢馬步都虞候兼東京馬步軍都指揮使、檢校太保朱守殷為振武節度使，加檢校太傅。"
        }
      ]
    },
    {
      "id": "zhu-shouyin-hold-back",
      "title": "兴教门兵变时按甲不救",
      "summary": "宦官急召骑兵援宫，朱守殷按兵不进，庄宗以近卫独战，骑兵始终不至。",
      "year": 926,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "同光四年四月兴教门兵变",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p6",
          "originalRevision": 1,
          "originalSha256": "467e46127706bebb3224466961621738d294ceb0f6ddb2ff74033b62b3b910f4",
          "excerpt": "守殷按甲不進，莊宗獨領宦官斫射，屢退，而騎軍終不至。"
        }
      ]
    },
    {
      "id": "zhu-shouyin-loot-palace",
      "title": "庄宗死后取宫人财物，纵军劫京",
      "summary": "得庄宗死讯才入宫，选宫人珍宝带走，纵军劫京，随后迎李嗣源。",
      "year": 926,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "庄宗崩后",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p6",
          "originalRevision": 1,
          "originalSha256": "467e46127706bebb3224466961621738d294ceb0f6ddb2ff74033b62b3b910f4",
          "excerpt": "迨聞凶問，乃入內，選嬪御及珍寶以歸，恣軍士劫掠京都，翌日方定，率諸校迎明宗於東郊。"
        }
      ]
    },
    {
      "id": "zhu-shouyin-rebellion-bian",
      "title": "疑帝东巡，将汴州据城反",
      "summary": "因惧皇帝巡幸意在控制自己，杀马彦超、宋敬，驱市人闭城叛；明宗亲兵赶赴。",
      "year": 927,
      "sortOrder": 5,
      "precision": "month",
      "sourceDate": "天成二年十月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p6",
          "originalRevision": 1,
          "originalSha256": "467e46127706bebb3224466961621738d294ceb0f6ddb2ff74033b62b3b910f4",
          "excerpt": "守殷驅市人閉壁以叛，"
        },
        {
          "chapterId": "new-v06",
          "paragraphId": "new-v06-p12",
          "originalRevision": 1,
          "originalSha256": "6b17ea6ee7ce937f8b1e9cc79727e6065e7dad31fbdf0241c09b803552acf880",
          "excerpt": "宣武軍節度使朱守殷反，馬步軍都指揮使馬彥超死之。"
        }
      ]
    },
    {
      "id": "zhu-shouyin-death",
      "title": "力穷杀族，命左右杀己",
      "summary": "兵围汴州后形势穷困，杀家族后引颈令左右杀自己；朝廷鞭尸枭首。新史记天成二年十月己丑自杀。",
      "year": 927,
      "sortOrder": 6,
      "precision": "day",
      "sourceDate": "天成二年十月己丑",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p6",
          "originalRevision": 1,
          "originalSha256": "467e46127706bebb3224466961621738d294ceb0f6ddb2ff74033b62b3b910f4",
          "excerpt": "守殷力屈，盡殺其族，引頸令左右盡其命。"
        },
        {
          "chapterId": "new-v06",
          "paragraphId": "new-v06-p12",
          "originalRevision": 1,
          "originalSha256": "6b17ea6ee7ce937f8b1e9cc79727e6065e7dad31fbdf0241c09b803552acf880",
          "excerpt": "己丑，守殷自殺。"
        }
      ]
    },
    {
      "id": "zhu-shouyin-early-attendant",
      "title": "庄宗幼时随侍，渐为心腹",
      "summary": "自李存勖就学时以仆役侍左右，后任长直军使，军中未闻战功，凭近侍成为心腹。",
      "year": null,
      "sortOrder": 7,
      "precision": "undated",
      "sourceDate": "庄宗就学及即位后",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p6",
          "originalRevision": 1,
          "originalSha256": "467e46127706bebb3224466961621738d294ceb0f6ddb2ff74033b62b3b910f4",
          "excerpt": "莊宗就學，以廝養之役給事左右。"
        }
      ]
    },
    {
      "id": "zhu-shouyin-henan-bian",
      "title": "明宗朝任河南尹、转汴州",
      "summary": "天成初授河南尹、判六军诸卫，加侍中，移汴州节度。",
      "year": null,
      "sortOrder": 8,
      "precision": "undated",
      "sourceDate": "天成初",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v074",
          "paragraphId": "old-v074-p6",
          "originalRevision": 1,
          "originalSha256": "467e46127706bebb3224466961621738d294ceb0f6ddb2ff74033b62b3b910f4",
          "excerpt": "天成初，授河南尹，判六軍諸衛事，加侍中，移汴州節度使。"
        }
      ]
    }
  ]
}
