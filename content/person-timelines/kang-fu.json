    {
      "id": "kang-fu-horses-mingzong",
      "title": "向李嗣源归小坊马，增强军势",
      "summary": "李嗣源自魏过相州，康福以小马坊二千马归之，其军势得以加强。",
      "year": 926,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "同光四年明宗过相州时",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p43",
          "originalRevision": 1,
          "originalSha256": "38064d5812a7cdb2f22f3146d1419545b365dee6186a2d9e82c45975ec5b78db",
          "excerpt": "福以小坊馬二千匹歸命，明宗軍勢由是益盛。"
        }
      ]
    },
    {
      "id": "kang-fu-early-horses",
      "title": "以骑射事晋，掌相州牧马",
      "summary": "世为蔚州军校之家，为晋王偏将，庄宗用其为相州小马坊使，一年多马群繁滋。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "本传未记具体年次",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p43",
          "originalRevision": 1,
          "originalSha256": "38064d5812a7cdb2f22f3146d1419545b365dee6186a2d9e82c45975ec5b78db",
          "excerpt": "乃令福牧馬于相州，為小馬坊使，逾年馬大蕃滋。"
        }
      ]
    },
    {
      "id": "kang-fu-feilong",
      "title": "明宗授飞龙使、磁州军职",
      "summary": "明宗即位后，任飞龙使、领磁州刺史、襄州兵马都监；随后从刘训讨荆南，无功归。",
      "year": null,
      "sortOrder": 3,
      "precision": "range",
      "sourceDate": "明宗入立后拜飞龙、领磁州及襄州军职，任命未记月；下文从刘训天成二年二月讨荆南之前，西历926—927年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p43",
          "originalRevision": 1,
          "originalSha256": "38064d5812a7cdb2f22f3146d1419545b365dee6186a2d9e82c45975ec5b78db",
          "excerpt": "明宗入立，拜飛龍使，領磁州刺史、襄州兵馬都監。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p5",
          "originalRevision": 1,
          "originalSha256": "4e727ecaf103df9d04a15b548fbe781ce88b35de09f1e0cf02789bab3edaa765",
          "excerpt": "二月壬午朔，新羅遣使朝貢。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p5",
          "originalRevision": 1,
          "originalSha256": "4e727ecaf103df9d04a15b548fbe781ce88b35de09f1e0cf02789bab3edaa765",
          "excerpt": "仍令襄州節度使劉訓充南面招討使、知荊南行府事，許州節度使夏魯奇為副招討使，統蕃漢馬步四萬人進討，以其叛故也。"
        }
      ],
      "yearRange": {
        "start": 926,
        "end": 927
      }
    },
    {
      "id": "kang-fu-lingwu-command",
      "title": "受安重诲排挤，出镇灵武",
      "summary": "因善蕃语常受明宗访外事，安重诲厌恶，康福求外任；被置凉州刺史、朔方河西节度，明宗派兵护送。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "韩洙死、韩澄立后",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p45",
          "originalRevision": 1,
          "originalSha256": "e636978facf7c071e1653ab8181d3c751e2a4c9e5d6b6c114b57461ef734d7d7",
          "excerpt": "乃拜福涼州刺史，朔方、河西軍節度使。"
        },
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p44",
          "originalRevision": 1,
          "originalSha256": "39a2670d0c4f281d3a1bf90f4ef5d374ef232bf6803e5a43eb5b4e09c7523030",
          "excerpt": "福為將無佗能，善諸戎語，明宗嘗召入便殿，訪以外事，福輒為蕃語以對。樞密使安重誨惡之，常戒福曰：「無妄奏事，當斬汝！」福懼，求外任。"
        }
      ]
    },
    {
      "id": "kang-fu-qinggang-fight",
      "title": "赴任路破羌阻兵，袭青冈吐蕃帐",
      "summary": "至方渠击退拦截部众，青冈峡分三路突袭未戒备吐蕃营，获羊马财物，威声大振；不以夸张杀数当独立统计。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "赴灵武途中",
      "phase": "uncertain",
      "evidence": [
        {
