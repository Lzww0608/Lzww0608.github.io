    {
      "id": "zhao-zaili-retain-ye",
      "title": "明宗即位后拒义成，仍留魏",
      "summary": "元行钦讨未克、李嗣源兵变入魏后，赵留魏；明宗即位授义成而不受，改邺都留守、兴唐尹。",
      "year": null,
      "sortOrder": 5,
      "precision": "range",
      "sourceDate": "明宗即位后授义成而拒命，遂留魏；授义成本纪五月，改留未另纪月，天成元年西历926—927年范围",
      "phase": "uncertain",
      "evidence": [
        {
