    {
      "id": "zhao-zaili-death",
      "title": "晋亡后受契丹辱，郑州自缢",
      "summary": "从宋州至洛阳遭契丹兵索财侮辱，至郑州闻晋臣被锁，恐惧自缢，年六十二；后汉赠中书令。",
      "year": 947,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "晋亡契丹入汴后；通鉴丁未年正月乙卯到郑州自缢，西历947年（同期合法会同十年正月核历）",
      "phase": "fall",
      "evidence": [
        {
