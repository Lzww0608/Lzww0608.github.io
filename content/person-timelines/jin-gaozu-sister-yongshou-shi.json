          "excerpt": "皇第十二妹史氏為永壽長公主"
        },
        {
          "chapterId": "old-v076",
          "paragraphId": "old-v076-p4",
          "originalRevision": 1,
          "originalSha256": "d514aaf3f60002ceba4a324f1172a6cab73ffa322a09b0702c1be87473665816",
          "excerpt": "天福二年春正月甲寅朔"
        }
      ],
      "notes": [
