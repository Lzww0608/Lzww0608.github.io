  "personId": "guo-yan",
  "events": [
    {
      "id": "guo-yan-early",
      "title": "被黄巢俘获，后从朱温赴汴",
      "summary": "郭言早在新野务农养亲，广明间被黄巢军俘获，后来随朱温到汴，从骑兵升裨校。",
      "year": null,
      "sortOrder": 1,
      "precision": "undated",
      "sourceDate": "广明中及以后，未记归附确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p12",
          "originalRevision": 1,
          "originalSha256": "742b1800f2a65cabdd5170f8ddfb88eceb8a1b0ca1c96edf96b7fc9314ba8780",
          "excerpt": "郭言，太原人也。家於南陽新野，少以力穡養親，鄉里稱之。唐廣明中，黃巢擁眾西犯秦、雍，言為巢黨所執。後從太祖赴汴，初為騎軍，繼有戰功，後擢為裨校。"
        }
      ]
    },
    {
      "id": "guo-yan-recruit",
      "title": "赴陕虢募军，冬还得锐士",
      "summary": "郭言奉命带数千越河洛至陕虢招募，夏出冬还得一万余精兵，升步军都将。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "募军之夏冬，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p12",
          "originalRevision": 1,
          "originalSha256": "742b1800f2a65cabdd5170f8ddfb88eceb8a1b0ca1c96edf96b7fc9314ba8780",
          "excerpt": "一日，命言董數千人，越河、洛，趨陝、虢，招召丁壯，以實部伍。言夏往冬旋，得銳士萬餘，遂遷步軍都將。"
        }
      ]
    },
    {
      "id": "guo-yan-postal",
      "title": "平蔡后率军保护贡路",
      "summary": "蔡军败后郭言奉命导护贡奉、安定汴郑至潼关驿道，除奸恤弱。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "秦宗权失地后，未记本传确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p12",
          "originalRevision": 1,
          "originalSha256": "742b1800f2a65cabdd5170f8ddfb88eceb8a1b0ca1c96edf96b7fc9314ba8780",
          "excerpt": "宗權以茲敗北，太祖盡收其地。因命言將兵導達貢奉，以安郵傳，自汴、鄭迄於潼關，去奸恤弱，甚得其所。"
        }
      ]
    },
    {
      "id": "guo-yan-huai",
      "title": "为李璠先锋，攻盱眙",
      "summary": "朱温兼扬州时遣李璠南行，郭言为先锋深入淮南，破盱眙而回；后又参加徐郓诸役，升宿州刺史。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "光启中及随后，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p12",
          "originalRevision": 1,
          "originalSha256": "742b1800f2a65cabdd5170f8ddfb88eceb8a1b0ca1c96edf96b7fc9314ba8780",
          "excerpt": "光啟中，唐天子以太祖兵威日振，命兼揚州節度使。太祖遣幕吏李璠領兵赴維揚以製置為名，時言為李璠前鋒，深入淮甸，破盱眙而還。梁祖東伐徐、鄆，言將偏師，略地千里；頻逢寇敵，言出奇決戰，所向皆捷，大挫東人之銳。太祖錄其績，以「排陣斬斫」之號委之，尋表為宿州刺史、檢校右僕射。"
        }
      ]
    },
    {
      "id": "guo-yan-death",
      "title": "宿州野战退时溥，中箭卒",
      "summary": "时溥大举攻宿州，郭言率精兵野战杀伤敌军并使其退，自身中流箭，当晚去世。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "景福初，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p12",
          "originalRevision": 1,
          "originalSha256": "742b1800f2a65cabdd5170f8ddfb88eceb8a1b0ca1c96edf96b7fc9314ba8780",
          "excerpt": "景福初，時溥大舉來攻宿州，言勇於野戰，喜逢大敵，自引銳兵擊溥，殺傷甚眾，徐戎乃退。言為流矢所中，一夕而卒。"
        }
      ]
    }
  ]
}
