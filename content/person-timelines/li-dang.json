  "events": [
    {
      "id": "li-dang-death",
      "title": "攻泽州违部署，被戮河桥",
      "summary": "李谠越太行攻泽，违朱温调度且久无功，被追还责罪，与李重胤同被杀。",
      "year": 890,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "大顺元年秋；李重胤本传记同役",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p22",
          "originalRevision": 1,
          "originalSha256": "f782b65ab6f88007b221becf93b39ab80faf0967ee2d1e9fc187095c079ecd4c",
          "excerpt": "郴王友裕領兵攻澤州，時太祖駐大軍於盟津，乃令讜將兵越太行，授以籌謀。讜頗違節度，久而無功。太祖遣追還，廷責其罪，戮之於河橋。"
        },
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p24",
          "originalRevision": 1,
          "originalSha256": "0d68bcce70a33a8ab10681d87d14e4270377210cbc0e1398b15bac6ad81ee8ec",
          "excerpt": "大順元年秋，從郴王友裕收澤州，與晉軍戰於馬牢川，王師敗績，回守河陽。太祖謂諸將曰：「李讜、重胤違我節度，不能立功，頗辜任使。」於是與李讜並戮於河橋。"
        }
      ]
    },
    {
      "id": "li-dang-early",
      "title": "黄巢长安政权内枢密使",
      "summary": "李谠早游秦雍，黄巢占长安后入仕，因先前出入宫禁的经历任内枢密使。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "广明初黄巢陷长安时，未在本段标月",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p22",
          "originalRevision": 1,
          "originalSha256": "f782b65ab6f88007b221becf93b39ab80faf0967ee2d1e9fc187095c079ecd4c",
          "excerpt": "唐廣明初，黃巢陷長安，讜遂得仕於其間。巢以讜為內樞密使，蓋讜曾委質於宦者，出入於宮禁間，巢以此用焉。"
        }
      ]
    },
    {
      "id": "li-dang-join",
      "title": "由巢军归朱温，掌德胜骑军",
      "summary": "黄巢军败后李谠归朱温，为左德胜骑军都将，讨蔡立军功。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "巢軍敗後，未記確年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p22",
          "originalRevision": 1,
          "originalSha256": "f782b65ab6f88007b221becf93b39ab80faf0967ee2d1e9fc187095c079ecd4c",
          "excerpt": "其後巢軍既敗，讜乃束身歸於太祖，署為左德勝騎軍都將。從太祖討蔡賊，頗立軍功。"
        }
      ]
    },
    {
      "id": "li-dang-campaign",
      "title": "攻兖郓，升元从骑将",
      "summary": "李谠率骑军东攻兖郓多所俘获，任元从骑将、检校右仆射。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "东伐兖郓时，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p22",
          "originalRevision": 1,
          "originalSha256": "f782b65ab6f88007b221becf93b39ab80faf0967ee2d1e9fc187095c079ecd4c",
          "excerpt": "及東伐兗、鄆，以所部士伍俘獲甚眾，改元從騎將，表授檢校右僕射。"
        }
      ]
    }
  ]
