  "personId": "jin-shi-chonggui-empress-feng",
  "events": [
    {
      "id": "jin-shi-chonggui-empress-feng-empress-943",
      "title": "制立皇后",
      "summary": "少帝天福八年十月制立吴国夫人冯氏为皇后，并令所司择日备礼册命。",
      "year": 943,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天福八年十月戊申",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v082",
          "paragraphId": "old-v082-p4",
          "originalRevision": 1,
          "originalSha256": "9941dc021fc1a464800fc53b71597649f043e695a1d17f9366dbb64a73287f49",
          "excerpt": "冬十月戊申，制以吳國夫人馮氏為皇后，仍令所司擇日備禮冊命。"
        },
        {
          "chapterId": "new-v09",
          "paragraphId": "new-v09-p5",
          "originalRevision": 1,
          "originalSha256": "34fbfe1acc826f9359668fe0181ffbe6eda2a14d23d33579d44eb8b2678154c7",
          "excerpt": "冬十月戊申，立馮氏為皇后。〈馮氏於帝為叔母。〉"
        }
      ],
      "notes": [
        "制立与后来的册后记载分开。"
      ],
      "variants": [
        {
          "label": "家人传回叙居丧纳后",
          "sourceDate": "高祖崩、梓宫在殡、出帝居丧中；未独载月日",
          "summary": "家人传记出帝居丧中纳她为后，命至西御庄影殿，随后帝与后酣饮歌舞。所谓皇太后命是帝所称，不据此确认太后下达命婚。",
          "evidence": [
            {
              "chapterId": "new-v17",
              "paragraphId": "new-v17-p22",
              "originalRevision": 1,
              "originalSha256": "0cad9b95a8be0d8e29b6f02a3dfe84035b701bff8805d81d08d41cb264d5dd08",
              "excerpt": "高祖崩，梓宮在殯，出帝居喪中，納之以為后。"
            },
            {
              "chapterId": "tongjian-v283",
              "paragraphId": "tongjian-v283-p75",
              "originalRevision": 1,
              "originalSha256": "e41e3521e33cb925db7ef1ed66f101e2d350b9b672d33749be7d57dc15a0a81b",
              "excerpt": "皇太后之命"
            }
          ]
        }
      ]
    },
    {
      "id": "jin-shi-chonggui-empress-feng-canon-946",
      "title": "册皇后",
      "summary": "开运三年十月，本纪记册吴国夫人冯氏为皇后，会要亦记该月册。",
      "year": 946,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "开运三年十月癸酉",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v085",
          "paragraphId": "old-v085-p1",
          "originalRevision": 1,
          "originalSha256": "f1fa0c9a85e43251361679f2aa63fdf37b2cc9399c13d645381c960e1d3b6238",
          "excerpt": "癸酉，冊吳國夫人馮氏為皇后。"
        },
        {
          "chapterId": "huiyao-v001",
          "paragraphId": "huiyao-v001-p40",
          "originalRevision": 1,
          "originalSha256": "94fb315ae3f20dfe304d96234943efddcd006305cb678f2335bb1ebf9788f1e2",
          "excerpt": "皇后馮氏。〈開運三年十月冊。〉"
        }
      ],
      "notes": [
        "不以946年的册后记录抹去943年制立或居丧纳后的叙法。"
      ]
    },
    {
      "id": "jin-shi-chonggui-empress-feng-detained-kaifeng-947",
      "title": "随帝迁开封府",
      "summary": "张彦泽迁少帝于开封府，帝与太后、皇后乘肩舆，少数宫人宦者步行跟随。",
      "year": 947,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "契丹入京前，甲戌",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "tongjian-v285",
          "paragraphId": "tongjian-v285-p75",
          "originalRevision": 1,
          "originalSha256": "4735f08557b29f72a72816c8aed0c467499969d6f1d5ef7e546f22f6be13370e",
          "excerpt": "甲戌，張彥澤遷帝於開封府，頃刻不得留，宮中慟哭。帝與太后、皇后乘肩輿，宮人、宦者十餘人步從，見者流涕。"
        }
      ],
      "notes": [
        "同段乌氏公主诀别自经仍另留来源待考，不作冯后经历。"
      ]
    },
    {
      "id": "jin-shi-chonggui-empress-feng-northward-947",
      "title": "随帝北迁",
      "summary": "冯后与李太后、安太妃及帝家人北行，随行群体受供给阻绝。",
      "year": 947,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "旧史明年正月癸卯；新史辛卯后叙",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v085",
          "paragraphId": "old-v085-p8",
          "originalRevision": 1,
          "originalSha256": "85c002418e6f4513f882947fa090313e6cc003a99f16db46f0044eb21465c9a1",
          "excerpt": "癸卯，帝與皇太后李氏、皇太妃安氏、皇后馮氏、皇弟重睿、皇子延煦延寶俱北行"
        },
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p12",
          "originalRevision": 1,
          "originalSha256": "0b2c066b675fc8476c6552c7b4cd9b6e3735f27ffb7e371f04b98d5c507278a8",
          "excerpt": "於是太后與馮皇后、皇弟重睿、皇子延煦、延寶等舉族從帝而北"
        },
        {
          "chapterId": "tongjian-v286",
          "paragraphId": "tongjian-v286-p16",
          "originalRevision": 1,
          "originalSha256": "530e4f89f4865573e9c68f759e8d115760947bfd9b9c942e2bcafc7fc9be7ee3",
          "excerpt": "癸卯，晉主與李太后、安太妃、馮后及弟睿、子延煦、延寶俱北遷"
        }
      ],
      "notes": [
        "宫女、从官采食及泛称后妃拜像不自动逐人归给冯后。"
      ]
    },
    {
      "id": "jin-shi-chonggui-empress-feng-poison-unfulfilled-947",
      "title": "求毒欲与帝俱死，未成",
      "summary": "北迁受辱期间，冯后暗中命人求毒，想与少帝同死，因未得毒药而没有实现。",
      "year": 947,
      "sortOrder": 5,
      "precision": "year",
      "sourceDate": "北迁后；旧史记六月辽阳，通鉴接锦州叙事",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p23",
          "originalRevision": 1,
          "originalSha256": "47a049d01644a98251a5064c6831bcaef79887d4f7b2a2bd6ff91c7e124d8b2d",
          "excerpt": "后隨帝北遷，哀帝之辱，數求毒藥，欲與帝俱飲以死，而藥不可得。"
        }
      ],
      "notes": [
        "这是同一求毒未成事的分源叙法，不拼成一个确定地点，也不据数求毒药另造多次自杀。"
      ],
      "variants": [
        {
          "label": "旧史系辽阳六月",
          "year": 947,
          "sourceDate": "明年六月，行至辽阳",
          "summary": "旧史接国母召赴怀密州，在行至辽阳时记她命内官求毒，不果。",
          "evidence": [
            {
              "chapterId": "old-v085",
              "paragraphId": "old-v085-p9",
              "originalRevision": 1,
              "originalSha256": "a208137c996d8aa63bec1f4dca7e6b6adb15af513ccc7b6946922c2221a0fb6a",
              "excerpt": "行至遼陽，皇后馮氏以帝陷蕃，過受艱苦，令內官潛求毒藥，將自飲之，並以進帝，不果而止。"
            }
          ]
        },
        {
          "label": "通鉴接锦州叙事",
          "year": 947,
          "sourceDate": "出寨至锦州，未另记日",
          "summary": "通鉴接锦州被令拜阿保机墓及少帝悲泣，记冯后阴求毒未果。旧史叙遗像、通鉴叙墓，保留对象与地点差异。",
          "evidence": [
            {
              "chapterId": "tongjian-v286",
              "paragraphId": "tongjian-v286-p40",
              "originalRevision": 1,
              "originalSha256": "2aa556ec7005e56d8a199968a71be2d496863391106bf68570509b875020f3dc",
              "excerpt": "至錦州，契丹令晉主及后妃拜契丹主阿保機墓。晉主不勝屈辱，泣曰：「薛超誤我！」馮后陰令左右求毒藥，欲與晉主俱自殺，不果。"
            }
          ]
        }
      ]
    },
    {
      "id": "jin-shi-chonggui-empress-feng-liaoyang-audience-948",
      "title": "与帝、太后同谒永康王",
      "summary": "永康王到辽阳时，冯后与少帝、李太后一同入帐谒见。帝伏地陈过、永康王扶起饮酒等动作各属原来的主语。",
      "year": 948,
      "sortOrder": 6,
      "precision": "year",
      "sourceDate": "乾祐元年四月；新史明年四月",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p14",
          "originalRevision": 1,
          "originalSha256": "951587c5ad03c45273567be09ac6bc65d385ea7229dc90df7d0d7e8e1c2de173",
          "excerpt": "明年四月，永康王至遼陽，帝白衣紗帽，與太后、皇后詣帳中上謁"
        },
        {
          "chapterId": "tongjian-v288",
          "paragraphId": "tongjian-v288-p23",
          "originalRevision": 1,
          "originalSha256": "abbb58708ac910606af3211dc3249e46fd7b7d2b478ff14252d1ec75f248319a",
          "excerpt": "契丹主如遼陽，故晉主與太后、皇后皆謁見。"
        }
      ],
      "notes": [
        "同段失名幼女被取另属女儿角色，不倒推她为冯后所生。"
      ]
    },
    {
      "id": "jin-shi-chonggui-empress-feng-li-taifang-funeral-950",
      "title": "参与李太后丧葬",
      "summary": "李太后病卒后，冯后与少帝、宫人及其他从人披发徒跣，扶抬棺柩至所赐土地，焚骨掘地而葬。",
      "year": 950,
      "sortOrder": 7,
      "precision": "year",
      "sourceDate": "汉乾祐三年八月，李太后卒后",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p17",
          "originalRevision": 1,
          "originalSha256": "cccea67a15951192ad965390941427b3bf251e1ba7acd2fe7f82c5cc6595537f",
          "excerpt": "帝與皇后、宮人、宦者、東西班，皆被髮徒跣，扶舁其柩至賜地，焚其骨，穿地而葬焉。"
        },
        {
          "chapterId": "old-v085",
          "paragraphId": "old-v085-p12",
          "originalRevision": 1,
          "originalSha256": "5f2737bb55905d346893abd6274a849b2230236c6fdad40964a69a89ada910da",
          "excerpt": "漢乾祐三年八月，太后薨。"
        }
      ],
      "notes": [
        "此处去世者为李太后，冯后是参与丧事者；不移作安太妃或冯后之死。",
        "“焚骨送范阳佛寺”是李太后遗愿，实际记载止于所赐土地的埋葬。"
      ]
    },
    {
      "id": "jin-shi-chonggui-empress-feng-marriage-chongyin-widow",
      "title": "先嫁重胤，后寡居",
      "summary": "高祖为石重胤娶冯濛之女；重胤早卒，冯氏寡居。",
      "year": null,
      "sortOrder": 8,
      "precision": "undated",
      "sourceDate": "高祖留守邺都时及重胤早卒后，未详婚年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p22",
          "originalRevision": 1,
          "originalSha256": "0cad9b95a8be0d8e29b6f02a3dfe84035b701bff8805d81d08d41cb264d5dd08",
          "excerpt": "高祖留守鄴都，得濛驩甚，乃為重胤娶濛女，後封吳國夫人。重胤早卒，后寡居"
        },
        {
          "chapterId": "old-v086",
          "paragraphId": "old-v086-p6",
          "originalRevision": 1,
          "originalSha256": "40a52e1743f15bddbcfcc4cdbe312fc3d540fee5dbeb52b3daceacd71075f427",
          "excerpt": "初，高祖愛少弟重胤，養以為子。及留守鄴都，娶副留守馮濛女為其婦，重胤早卒，馮夫人寡居"
        }
      ],
      "notes": [
        "不把石氏重胤与李重胤合并；不据丈夫早卒倒推冯氏年龄。"
      ]
    },
    {
      "id": "jin-shi-chonggui-empress-feng-palace-appointments",
      "title": "封拜宫官并用李彦弼",
      "summary": "新史记冯后立后，封拜尚宫、知客等宫官为郡夫人，又用男子李彦弼为皇后宫都押衙。",
      "year": null,
      "sortOrder": 9,
      "precision": "undated",
      "sourceDate": "立后之后，未独载年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p23",
          "originalRevision": 1,
          "originalSha256": "47a049d01644a98251a5064c6831bcaef79887d4f7b2a2bd6ff91c7e124d8b2d",
          "excerpt": "后既立，專內寵，封拜宮官尚宮、知客等皆為郡夫人，又用男子李彥弼為皇后宮都押衙。"
        }
      ],
      "notes": [
        "宫官群体及旧史另列具名内职女官按各自来源保存，不能把本句泛称逐一套到所有名号。",
        "其兄冯玉的外朝活动与帝对他的擢用不全部改为冯后的命令；史家由此论亡国是评论层次。"
      ]
    },
    {
      "id": "jin-shi-chonggui-empress-feng-reported-alive-xiande",
      "title": "北归者报告显德时仍无恙",
      "summary": "有从契丹返回的人报告，冯后与少帝等仍平安。原书未给唯一报告年，后续结局未明。",
      "year": null,
      "sortOrder": 10,
      "precision": "range",
      "sourceDate": "周显德初／显德中，未详报告年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v085",
          "paragraphId": "old-v085-p12",
          "originalRevision": 1,
          "originalSha256": "5f2737bb55905d346893abd6274a849b2230236c6fdad40964a69a89ada910da",
          "excerpt": "周顯德初，有漢人自塞北而至者，言帝與後及諸子俱無恙，猶在建州"
        },
        {
          "chapterId": "new-v17",
          "paragraphId": "new-v17-p18",
          "originalRevision": 1,
          "originalSha256": "bf00a2242da80153e75be30a4997dfb9c2f78b3316337353b6ad2bec1e19a848",
          "excerpt": "周顯德中，有中國人自契丹亡歸者，言見帝與皇后諸子皆無恙。後不知其所終。"
        },
        {
          "chapterId": "tongjian-v289",
          "paragraphId": "tongjian-v289-p36",
          "originalRevision": 1,
          "originalSha256": "8718079d8eea37e1ec50e03e9d968505ffc1a4d76a948f9bdb52a3f28b513c94",
          "excerpt": "周顯德中，有自契丹來者云：「晉主及馮後尚無恙，其從者亡歸及物故則過半矣。」"
        }
      ],
      "notes": [
        "旧史显德初、新史和通鉴显德中的字样分别保留；这属于归来者报告，不据此填写卒年。",
        "954—960是显德年号跨太祖、世宗与恭帝的有据报告时间范围；显德初、中字样分源保存，不把这个范围当卒年。"
      ],
      "yearRange": {
        "start": 954,
        "end": 960
      }
    }
  ]
