  "events": [
    {
      "id": "zhou-dewei-wang-xingyu",
      "title": "从讨王行瑜并进军职",
      "summary": "由铁林军使从李克用讨王行瑜，因功加检校左仆射、转内衙军副；新史职名为衙内指挥使，另列。",
      "year": 895,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "乾宁中从讨王行瑜；李罕之传明确同役乾宁二年；武皇纪同役在乾宁二年十一月平定，保留征讨年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v056",
          "paragraphId": "old-v056-p2",
          "originalRevision": 1,
          "originalSha256": "f75d59da881f291e5f5e21f604c9d6a91635e298f95c1bc44a35a7373f9d9ac4",
          "excerpt": "乾寧中，為鐵林軍使，武皇討王行瑜，以功加檢校左僕射，移內衙軍副。"
        },
        {
          "chapterId": "old-v015",
          "paragraphId": "old-v015-p10",
          "originalRevision": 1,
          "originalSha256": "e7e696dd1dc4c451b9d0a98d04d5a36d17ca21dc8287963e4ce5bd88c3371ee7",
          "excerpt": "乾寧二年，李克用出師以拒邠、鳳，營於渭北，天子以克用為邠州行營四面都統，克用乃表罕之為副。及誅王行瑜，罕之以功授檢校太尉，食邑千戶。"
        },
        {
          "chapterId": "old-v026",
          "paragraphId": "old-v026-p8",
          "originalRevision": 1,
          "originalSha256": "723cb3fa0580ee269c1e1b5a6d9d010c775b432a25d916d51cae0b72b8a5a955",
          "excerpt": "乾寧二年正月，武皇在幽州，命李存審、劉仁恭徇諸屬郡。"
        },
        {
          "chapterId": "old-v026",
          "paragraphId": "old-v026-p13",
          "originalRevision": 1,
          "originalSha256": "a87b98936cd688a76360d8143f35e9931416e34addeeab0052f67fb6b51b6760",
          "excerpt": "十一月丁巳，收龍泉寨。"
        },
        {
          "chapterId": "old-v026",
          "paragraphId": "old-v026-p13",
          "originalRevision": 1,
          "originalSha256": "a87b98936cd688a76360d8143f35e9931416e34addeeab0052f67fb6b51b6760",
          "excerpt": "行瑜懼，棄城而遁。武皇收其城，封府庫，遽以捷聞。既而慶州奏，王行瑜將家屬五百人到州界，為部下所殺，傳首闕下。武皇既平行瑜，還軍渭北。"
        }
      ],
      "variants": [
        {
          "label": "新史军职",
          "year": 895,
          "sourceDate": "从破王行瑜",
          "summary": "新史因功迁衙内指挥使，与旧史内衙军副职称分别保留。",
          "evidence": [
            {
              "chapterId": "new-v25",
              "paragraphId": "new-v25-p2",
              "originalRevision": 1,
              "originalSha256": "8d8d07dd752bafb9d2336d6e34b978b5f85ffae628c56c6d024c7a92ba728a7d",
              "excerpt": "稍遷鐵林軍使，從破王行瑜，以功遷衙內指揮使。"
            }
          ]
        }
      ]
    },
    {
      "id": "zhou-dewei-capture-chenzhang",
      "title": "太原战中生擒陈章",
      "summary": "氏叔琮进逼太原时，周德威让部下佯退，自己乘陈章追击挥铁挝将其击落，生擒献给李克用。",
      "year": 899,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "光化二年三月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v056",
          "paragraphId": "old-v056-p3",
          "originalRevision": 1,
          "originalSha256": "8b3ef5471407ca4295cb2093323acf85de96777b54f1540b71614541f6bf6866",
          "excerpt": "光化二年三月，汴將氏叔琮率眾逼太原。"
        }
      ]
    },
    {
      "id": "zhou-dewei-xing-ming-relief",
      "title": "将五千骑攻邢洺以援幽沧",
      "summary": "李克用应刘仁恭之请，命周德威率五千骑兵出黄泽，攻邢州、洺州以牵制汴军。",
      "year": 900,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "光化三年五月幽沧求援后叙次",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v262",
          "paragraphId": "tongjian-v262-p10",
          "originalRevision": 1,
          "originalSha256": "04783a52cb107121e368937c3b41ec86ebd455c27cad34bec28ac8766626d8ce",
          "excerpt": "朱全忠遣葛從周帥兗、鄆、滑、魏四鎮兵十萬擊劉仁恭，五月，庚寅，拔德州，斬刺史傅公和。己亥，圍劉守文於滄州。仁恭復遣使卑辭厚禮求救於河東，李克用遣周德威將五千騎出黃澤，攻邢、洺以救之。"
        }
      ]
    },
    {
      "id": "zhou-dewei-pursue-bian-901",
      "title": "与嗣昭领五千骑追撤军",
      "summary": "氏叔琮等军从石会关退走，周德威与李嗣昭率精骑五千追击，杀获甚多。",
      "year": 901,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天复元年五月汴军撤退时",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "tongjian-v262",
          "paragraphId": "tongjian-v262-p56",
          "originalRevision": 1,
          "originalSha256": "16d8e34ab49b4d7d525441b9aa899f931fea4885c9328711087a516142a64f09",
          "excerpt": "氏叔琮等引兵抵晉陽城下，數挑戰，城中大恐。李克用登城備御，不遑飲食。時大雨積旬，城多頹壞，隨加完補。河東將李嗣昭、李嗣源鑿暗門，夜出攻汴壘，屢有殺獲。李存進敗汴軍於洞渦。時汴軍既眾，芻糧不給，久雨，士卒瘧利，全忠乃召兵還。五月，叔琮等自石會關歸，諸道軍亦退。河東將周德威、李嗣昭以精騎五千躡之，殺獲甚眾。先是，汾州刺史李瑭舉州附於汴軍，克用遣其將李存審攻之，三日而拔，執瑭，斬之。氏叔琮過上黨，孟遷挈族隨之南徙。朱全忠遣丁會代守潞州。"
        }
      ],
      "notes": [
        "本段是元年撤军的追击，不把含朱友宁的另一围城叙事自动并成同一役。"
      ]
    },
    {
      "id": "zhou-dewei-ci-xi-recovery",
      "title": "与嗣昭出阴地取隰慈",
      "summary": "李克用遣李嗣昭、周德威出阴地关，攻隰州、慈州，两州刺史唐礼、张瑰先后投降。",
      "year": 901,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "天复元年六月后、闰月前相关叙次",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "tongjian-v262",
          "paragraphId": "tongjian-v262-p62",
          "originalRevision": 1,
          "originalSha256": "5944f4b7f340b0a22e08d5792ac14ebd70f5aabb39e95392546c80d94aa28d3d",
          "excerpt": "李克用遣其將李嗣昭、周德威將兵出陰地關，攻隰州，刺史唐禮降之。進攻慈州，刺史張瑰降之。"
        }
      ]
    },
    {
      "id": "zhou-dewei-return-mourning",
      "title": "回太原吊祭，消解新主疑虑",
      "summary": "李存勖初承晋王，周德威奉命回师，向李克用灵柩痛哭，使内外对在外握兵的疑虑消解。",
      "year": 908,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "天祐五年四月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v056",
