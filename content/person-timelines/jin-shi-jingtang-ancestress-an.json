  "events": [
    {
      "id": "jin-shi-jingtang-ancestress-an-posthumous-honour",
      "title": "受追谥为孝简恭皇后",
      "summary": "天福二年，安氏受追谥为孝简恭皇后。新史将四代祖考妣的同次追尊系于五月丁丑；旧史保存相应祖位和后号。",
      "year": 937,
      "precision": "year",
      "sourceDate": "《旧五代史》：天福二年；《新五代史》：天福二年五月丁丑",
      "phase": "posthumous",
      "sortOrder": 1,
      "evidence": [
        {
          "chapterId": "old-v075",
          "paragraphId": "old-v075-p1",
          "originalRevision": 1,
          "originalSha256": "aa680450e2b47992122f3e8205d4cffdbb61dce4002f42412e4aea8b8d08762a",
          "excerpt": "祖妣安氏，追謚孝簡恭皇后。"
        },
        {
          "chapterId": "new-v08",
          "paragraphId": "new-v08-p7",
          "originalRevision": 1,
          "originalSha256": "ac2f151d321ea26755e246dbd146b5d7b841eec5ca89920a45df8231e8ea7a4c",
          "excerpt": "丁丑，追尊祖考為皇帝，妣為皇后：高祖璟謚曰孝安，廟號靖祖，祖妣秦氏謚曰孝安元；曾祖郴謚曰孝簡，廟號肅祖，祖妣安氏謚曰孝簡恭；祖昱謚曰孝平，廟號睿祖，祖妣來氏謚曰孝平獻；考紹雍謚曰孝元，廟號獻祖，妣何氏謚曰孝元懿。"
        }
      ],
      "notes": [
        "仅记身后尊号，不据追谥反推生年、卒年或生前册立。"
      ]
    }
  ]
}
