  "events": [
    {
      "id": "li-congke-birth",
      "title": "生于平山",
      "summary": "本姓王，母魏氏在平山生下他；旧史所用光启元年是回称，当年正月仍在中和五年历内。",
      "year": 885,
      "sortOrder": 1,
      "precision": "day",
      "sourceDate": "光启元年正月二十三日；同年中和五年正月",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p1",
          "originalRevision": 1,
          "originalSha256": "8c5f29a059360098c3aaa74a187499ebd6d78b4849a286e1d9a70cd374d91585",
          "excerpt": "末帝，諱從珂，本姓王氏，鎮州人也。母宣憲皇后魏氏，以光啟元年歲在乙巳正月二十三日，生帝於平山。"
        }
      ]
    },
    {
      "id": "li-congke-huliu",
      "title": "胡柳陂护晋王夺土山",
      "summary": "晋军受挫时护卫李存勖夺取土山，击破梁军阵列，使军势复振；原段虽未纪年，相关编年证据另引。",
      "year": 919,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "天祐十五年十二月；实际西历919年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p1",
          "originalRevision": 1,
          "originalSha256": "8c5f29a059360098c3aaa74a187499ebd6d78b4849a286e1d9a70cd374d91585",
          "excerpt": "莊宗與梁軍戰於胡柳陂，兩軍俱撓，帝衛莊宗奪土山，摧驍陣，其軍復振。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p63",
          "originalRevision": 1,
          "originalSha256": "acc070ac1933b5db8ba2c2a28ff7de08cb14149e4873242fd924d865d846be0c",
          "excerpt": "壬戌，至胡柳陂。癸亥旦，候者言梁兵自後至矣。"
        },
        {
          "chapterId": "tongjian-v270",
          "paragraphId": "tongjian-v270-p64",
          "originalRevision": 1,
          "originalSha256": "728de2aba34526aaf9f2422a1d6faffb9d709063d87cd5c52f02932ecdc8b5f8",
          "excerpt": "即引騎兵先登，李從珂與銀槍大將王建及以步卒繼之，梁兵紛紛而下，遂奪其山。"
        }
      ]
    },
    {
      "id": "li-congke-yuncheng",
      "title": "随李嗣源袭破郓州",
      "summary": "跟随李嗣源突袭郓州，参与庄宗灭梁前的关键进军。",
      "year": 923,
      "sortOrder": 3,
      "precision": "month",
      "sourceDate": "同光元年四月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p3",
          "originalRevision": 1,
          "originalSha256": "72a53f11cba3324bea67da0000ea2bb73b8fde471a900969f726f1cef45f3508",
          "excerpt": "同光元年四月，從明宗襲破鄆州。"
        }
      ]
    },
    {
      "id": "li-congke-kaifeng-campaign",
      "title": "率劲骑先下汴州",
      "summary": "灭梁进军中，随李嗣源前军昼夜兼行，率劲骑先到汴州，庄宗称其父子有恢复社稷之功。",
      "year": 923,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "同光元年；旧传叙九月中都后趋汴",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p3",
          "originalRevision": 1,
          "originalSha256": "72a53f11cba3324bea67da0000ea2bb73b8fde471a900969f726f1cef45f3508",
          "excerpt": "明宗將前軍，帝率勁騎以從，晝夜兼行，率先下汴城。莊宗勞明宗曰：「復唐社稷，卿父子之功也。」"
        }
      ]
    },
    {
      "id": "li-congke-join-siyuan",
      "title": "率戍军南下追随李嗣源",
      "summary": "魏州兵变后，与王建立会合，倍道南行加入李嗣源，使其军声大振。",
      "year": 926,
      "sortOrder": 5,
      "precision": "year",
      "sourceDate": "同光四年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p6",
          "originalRevision": 1,
          "originalSha256": "5cc165e2a2da4a5f9ba0f414f28e966ddbd531f2a0ee8c4b1966c18b102e2703",
          "excerpt": "時帝在橫水，率部下軍士由曲陽、孟縣趨常山，與王建立會，倍道兼行，渡河而南，由是明宗軍聲大振。"
        }
      ]
    },
    {
      "id": "li-congke-yang-yanwen",
      "title": "杨彦温闭城拒纳被召闲居",
      "summary": "安重诲指使杨彦温趁其阅马时闭城，李从珂止于虞乡，奉召回京；明宗拒绝安重诲要求治罪，让他归清化里闲居。",
      "year": 930,
      "sortOrder": 6,
      "precision": "day",
      "sourceDate": "长兴元年四月五日及后续",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p7",
          "originalRevision": 1,
          "originalSha256": "ae6781a2b859236853f66d0e4f06e023409efa5ea836e81f6f596226d9958505",
          "excerpt": "是歲四月五日，帝閱馬於黃龍莊，彥溫閉城拒帝，帝聞難遽還，遣問其故，彥溫曰：「但請相公入朝，此城不可入也。」帝止虞鄉以聞，明宗詔帝歸闕。"
        }
      ],
      "notes": [
        "旧传将收城记为十一月，保留底本，不从此推断闭城历时。"
      ]
    },
    {
      "id": "li-congke-lu-prince",
      "title": "封潞王",
      "summary": "旧史明确记长兴四年五月封潞王；新史在明宗入立授河中一处先记封王，两书不合。",
      "year": 933,
      "sortOrder": 7,
      "precision": "month",
      "sourceDate": "长兴四年五月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p8",
          "originalRevision": 1,
          "originalSha256": "e32e90e5b0103bc612348200865bd0037f7818f8af08df2ca58d2d23c379350b",
          "excerpt": "四年五月，封潞王。"
        }
      ],
      "variants": [
        {
          "label": "新史封王叙次",
          "year": 926,
          "sourceDate": "明宗入立后",
          "summary": "新史称明宗入立拜河中并封潞王，旧史明记长兴四年五月。",
          "evidence": [
            {
              "chapterId": "new-v07",
              "paragraphId": "new-v07-p5",
              "originalRevision": 1,
              "originalSha256": "fb119c5e9c8705fc92723e5f31c7a7212473e335077699229adf0a8a8dfa9097",
              "excerpt": "明宗入立，拜從珂河中節度使，封潞王。"
            }
          ]
        }
      ]
    },
    {
      "id": "li-congke-refuse-transfer",
      "title": "拒河东调令在凤翔起兵",
      "summary": "儿子重吉被外放、女尼入宫后又被宣命调镇太原，因恐惧朱宏昭等不能保全而起兵，命李专美草檄求援。",
      "year": 934,
      "sortOrder": 8,
      "precision": "month",
      "sourceDate": "应顺元年二月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p9",
          "originalRevision": 1,
          "originalSha256": "f12ed31f962382362df4792d2b508dc63c75ae21fe6cf7ee942877d7c730d9f1",
          "excerpt": "應順元年二月，移帝鎮太原，是時不降制書，唯以宣授而已。"
        }
      ],
      "notes": [
        "调令不是已到河东任职；其后仍据凤翔对抗讨军。"
      ]
    },
    {
      "id": "li-congke-fengxiang-defections",
      "title": "登城哭诉招降讨军",
      "summary": "王思同军攻城时，向将士哭述自身战功和被疑处境，杨思权、尹晖率军入城归附，外军尽溃。",
      "year": 934,
      "sortOrder": 9,
      "precision": "day",
      "sourceDate": "应顺元年三月十六日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p9",
          "originalRevision": 1,
          "originalSha256": "f12ed31f962382362df4792d2b508dc63c75ae21fe6cf7ee942877d7c730d9f1",
          "excerpt": "遂引軍自西門入，嚴衛都指揮使尹暉亦引軍自東門而入，外軍悉潰。"
        }
      ]
    },
    {
      "id": "li-congke-eastward",
      "title": "征民财犒军并东进",
      "summary": "在凤翔被拥戴后征取居民家财赏军，十七日整军东进；到长安又征京兆民财犒军。",
      "year": 934,
      "sortOrder": 10,
      "precision": "month",
      "sourceDate": "应顺元年三月十七日至二十日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p9",
          "originalRevision": 1,
          "originalSha256": "f12ed31f962382362df4792d2b508dc63c75ae21fe6cf7ee942877d7c730d9f1",
          "excerpt": "十七日，率居民家財以賞軍士。是日，帝整眾而東。二十日，次長安，副留守劉遂雍以城降，率京兆居民家財犒軍。"
        }
      ]
    },
    {
      "id": "li-congke-kill-sitong",
      "title": "东进杀王思同、王仲皋",
      "summary": "东進在灵口杀王思同，至华州拘药彦稠；翌日至阌乡，虽王仲皋父子迎见，仍命诛杀；随后受河中、陕州诸将归降。",
      "year": 934,
      "sortOrder": 11,
      "precision": "month",
      "sourceDate": "应顺元年三月二十三日至二十六日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p9",
          "originalRevision": 1,
          "originalSha256": "f12ed31f962382362df4792d2b508dc63c75ae21fe6cf7ee942877d7c730d9f1",
          "excerpt": "二十三日，次靈口，誅王思同。二十四日，次華州，收藥彥稠繫獄。二十五日，次閿鄉，王仲皋父子迎謁，命誅之。二十六日，次靈寶，河中節度使安彥威來降，待罪，宥之，遣歸鎮。"
        }
      ]
    },
    {
      "id": "li-congke-kang-defection",
      "title": "受康义诚降并杀孟汉琼",
      "summary": "康义诚军瓦解，本人到军门请罪获赦，李从珂随即杀宣徽使孟汉琼；闵帝同夜离京。",
      "year": 934,
      "sortOrder": 12,
      "precision": "day",
      "sourceDate": "应顺元年三月二十八日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p9",
          "originalRevision": 1,
          "originalSha256": "f12ed31f962382362df4792d2b508dc63c75ae21fe6cf7ee942877d7c730d9f1",
          "excerpt": "二十八日，康義誠軍前兵士相繼來降，義誠詣軍門請罪，帝宥之。駕下諸軍畢至，誅宣徽南院使孟漢瓊於路左。"
        }
      ]
    },
    {
      "id": "li-congke-regency",
      "title": "入洛受太后命监国",
      "summary": "进入洛阳哭祭明宗后，太后降李从厚为鄂王，命李从珂主管军国事务、用书诏印监国。",
      "year": 934,
      "sortOrder": 13,
      "precision": "month",
      "sourceDate": "应顺元年四月壬申、癸酉",
      "phase": "rule",
      "evidence": [
        {
