  "personId": "zhang-guiba",
  "events": [
    {
      "id": "zhang-guiba-caizhou",
      "title": "破蔡军，赤冈反击受奖",
      "summary": "光启三年张归霸在双丘、万胜与蔡军战；赤冈身受飞戈后射敌夺马、获奖，新史写中箭拔箭反射，另正式保留。未定年五百伏兵另列。",
      "year": 887,
      "sortOrder": 0,
      "precision": "year",
      "sourceDate": "光启三年夏；此前卢氏为二年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p14",
          "originalRevision": 1,
          "originalSha256": "872deb4abcb97e3ed97294db82dc2a4d3195a2bc8edcf4ad87932b9cc00c67bd",
          "excerpt": "光啟二年，與蔡將張存戰於盧氏。三年夏，又與蔡將盧瑭戰於雙丘，復與秦宗賢戰於萬勝，皆敗而殲之。翌日，宗權遣將張郅來寇，列寨於赤堈。一日，出騎將較勝，歸霸為飛戈所中。即拔馬卻逸，控弦一發，賊洞頸而墜，遂兼騎而還。太祖時於高丘下瞰，備見其狀，面加賞激，厚以金帛及所獲馬錫之。"
        }
      ],
      "variants": [
        {
          "label": "新史赤冈受伤兵器",
          "sourceDate": "秦宗权攻汴时，未独标年",
          "summary": "旧史中飞戈、回马控弦，新史中箭、拔箭反射，分别保留原叙，不合成一种伤。",
          "evidence": [
            {
              "chapterId": "new-v22",
              "paragraphId": "new-v22-p29",
              "originalRevision": 1,
              "originalSha256": "f00d477c925d662691ea32d868746de0b6ff5dd6653da6b6cbe6f9d5c9e13a29",
              "excerpt": "秦宗權攻汴，歸霸戰數有功。張晊軍赤岡，以騎兵挑戰，矢中歸霸，歸霸拔之，反以射賊，一發而斃，奪其馬而歸。太祖從高丘望見，甚壯之，賞以金帛，并以其馬賜之。"
            }
          ]
        }
      ]
    },
    {
      "id": "zhang-guiba-luoluo",
      "title": "随葛从周战洹水，擒落落",
      "summary": "张归霸随葛从周在洹水击晋军，擒李克用之子落落。",
      "year": 896,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "乾宁三年五月同一洹水之战",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p14",
          "originalRevision": 1,
          "originalSha256": "872deb4abcb97e3ed97294db82dc2a4d3195a2bc8edcf4ad87932b9cc00c67bd",
          "excerpt": "又佐葛從周與晉軍戰於洹水，生獲克用愛子落落。"
        },
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p5",
          "originalRevision": 1,
          "originalSha256": "e6ded9f2bcf5abde299f1610c3cfae73ad7107ab33864688cde06a084799cf45",
          "excerpt": "三年五月，并帥以大軍侵魏，遣其子落落率二千騎屯洹水，從周以馬步二千人擊之，殺戮殆盡，擒落落於陣，并帥號泣而去。"
        }
      ]
    },
    {
      "id": "zhang-guiba-xing-defence",
      "title": "坚守邢州，复洺后袭晋退军",
      "summary": "张归霸光化三年春坚守邢，李嗣昭改攻洺；葛复洺后他出兵袭晋退军，获赏加司空。",
      "year": 900,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "光化二年后的明年春及复洺后",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p15",
          "originalRevision": 1,
          "originalSha256": "35ea60ea6e2b9e9e04c5917321880fa78a77286c379e5c1d63427710ab709bcd",
          "excerpt": "光化二年，權知邢州事。明年春，李嗣昭以蕃漢五萬來寇，歸霸堅壁設備，晉軍不敢顧其城，遂移軍攻洺州，陷焉。時太祖在滑，頗慮邢之失守。及葛從周復洺，嗣昭北遁，歸霸出兵襲之，殺二萬餘眾。捷至，賞錫殊等，旋以功奏加檢校司空。"
        }
      ]
    },
    {
      "id": "zhang-guiba-guards",
      "title": "梁建国后掌河阳诸军",
      "summary": "朱温称帝后张归霸任龙虎统军、骁卫上将军、河阳诸军都指挥使。",
      "year": 907,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "太祖受禅",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p15",
          "originalRevision": 1,
          "originalSha256": "35ea60ea6e2b9e9e04c5917321880fa78a77286c379e5c1d63427710ab709bcd",
          "excerpt": "太祖受禪，拜右龍虎統軍，改左驍衛上將軍，充河陽諸軍都指揮使。"
        }
      ]
    },
    {
      "id": "zhang-guiba-death",
      "title": "河阳节度使任上病卒",
      "summary": "张归霸六月就授河阳节度使，随后加平章事，七月在任上去世，赠太傅。",
      "year": 908,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "开平二年六月、七月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p15",
          "originalRevision": 1,
          "originalSha256": "35ea60ea6e2b9e9e04c5917321880fa78a77286c379e5c1d63427710ab709bcd",
          "excerpt": "明年夏六月，就除河陽節度使、檢校太保，尋加同平章事。二年秋七月，卒於位。詔贈太傅。"
        }
      ]
    },
    {
      "id": "zhang-guiba-join",
      "title": "与弟归厚、归弁由黄巢军归朱温",
      "summary": "张归霸原率兄弟投黄巢，黄巢败退后与兄弟及葛从周等归朱温，获宣武军职。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "乾符中投巢、中和中来降，未记本传确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p14",
          "originalRevision": 1,
          "originalSha256": "872deb4abcb97e3ed97294db82dc2a4d3195a2bc8edcf4ad87932b9cc00c67bd",
          "excerpt": "唐乾符中，寇盜蜂起，歸霸率昆弟三人棄家投黃巢，頗以勇略聞。巢陷長安，遂署為左番功臣。中和中，巢領徒走宛丘。時太祖在汴，奉詔南討，巢黨日窘，歸霸昆仲與葛從周、李讜等相率來降，尋補宣武軍劇職。"
        }
      ]
    },
    {
      "id": "zhang-guiba-lushi",
      "title": "卢氏与蔡将张存交战",
      "summary": "张归霸光启二年与蔡将张存在卢氏作战；与后一年双丘、赤冈战分列。",
      "year": null,
      "sortOrder": 6,
      "precision": "range",
      "sourceDate": "光启二年，合法全年886年2月8日至887年1月27日，卢氏役未独月",
      "phase": "uncertain",
      "evidence": [
