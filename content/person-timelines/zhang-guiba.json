    {
      "id": "zhang-guiba-lai-cao",
      "title": "历莱曹军职，副刘知俊御邠凤",
      "summary": "张归霸天祐初迁莱州，任满授左卫上将军、后任曹州；又副刘知俊击败邠凤军，加司徒，本传未独记这组迁转的日期。",
      "year": null,
      "sortOrder": 12,
      "precision": "undated",
      "sourceDate": "天祐初至受禅前的多次任职与其秋御寇，未独纪年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p15",
          "originalRevision": 1,
          "originalSha256": "35ea60ea6e2b9e9e04c5917321880fa78a77286c379e5c1d63427710ab709bcd",
          "excerpt": "天祐初，遷萊州刺史，秩滿授左衛上將軍，又除曹州刺史。其秋，加檢校司徒，副劉知俊禦邠、鳳之寇，敗之。"
        }
      ]
    }
  ]
