      ]
    },
    {
      "id": "liu-shao-song-kill-yigong-sons",
      "title": "派刘濬杀义恭诸子",
      "summary": "刘义恭单骑南奔后，刘劭遣刘濬杀其诸子；刘劭被擒后，义恭以十二子遇害责问，刘劭承认负于叔父。",
      "year": 453,
      "precision": "year",
      "phase": "fall",
      "sortOrder": 23,
      "sourceDate": "四月二十五日义恭南奔后；杀子未另记日",
      "evidence": [
        {
          "chapterId": "songshu-v099",
