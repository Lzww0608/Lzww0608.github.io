              "originalSha256": "a5b9505413fbd8ec5d554e11b4e51c59dc7726d8f756114a0d5b05325c7e55e3",
              "excerpt": "其月二十一日夜，"
            },
            {
              "chapterId": "nanshi-v014",
              "paragraphId": "nanshi-v014-p11",
              "originalRevision": 1,
              "originalSha256": "a5b9505413fbd8ec5d554e11b4e51c59dc7726d8f756114a0d5b05325c7e55e3",
              "excerpt": "明旦，劭以朱服加戎服上，"
            }
          ]
        },
        {
          "label": "尹弘附记二十一日平旦",
          "sourceDate": "二月二十一日平旦",
          "summary": "同卷尹弘附记在二十一日平旦入直时已闻宫变，与主传夜后明旦的叙次分别保留。",
          "evidence": [
            {
              "chapterId": "songshu-v099",
              "paragraphId": "songshu-v099-p37",
              "originalRevision": 1,
              "originalSha256": "6f3e51613a81a31c5f27f788d9f81dd19bbd8d740327107060aa6470e7131196",
              "excerpt": "弘二月二十一日平旦入直，至西掖門，聞宮中有變，"
            },
            {
              "chapterId": "nanshi-v002",
              "paragraphId": "nanshi-v002-p166",
              "originalRevision": 1,
              "originalSha256": "43f7f0ba1bff35d49b6926d35f02eb813b3fbd65ce5cc650a3a1bf32440af31c",
              "excerpt": "二月甲子，元凶劭構逆，帝崩於合殿，時年四十七。"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-shao-song-usurpation",
      "title": "仓促即位，改元太初",
      "summary": "刘劭发布文书，反称徐湛之、江湛弑逆，宣布大赦、改元太初。百官前来的仅数十人，便仓促即位；年号为他先前与严道育所定。",
      "year": 453,
      "precision": "year",
      "phase": "rule",
      "sortOrder": 10,
      "sourceDate": "元嘉三十年宫变后，改称太初元年",
      "evidence": [
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p12",
          "originalRevision": 1,
          "originalSha256": "458d9d4a9d1f518c14f144d59e60f4902380329f15028096ca81e5260c9c9898",
          "excerpt": "改元嘉三十年為太初元年。"
        },
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p12",
          "originalRevision": 1,
          "originalSha256": "458d9d4a9d1f518c14f144d59e60f4902380329f15028096ca81e5260c9c9898",
          "excerpt": "使改元為太初，劭素與道育所定。"
        },
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p12",
          "originalRevision": 1,
          "originalSha256": "458d9d4a9d1f518c14f144d59e60f4902380329f15028096ca81e5260c9c9898",
          "excerpt": "百僚至者裁數十人，劭便遽即位。"
        },
        {
          "chapterId": "nanshi-v014",
          "paragraphId": "nanshi-v014-p12",
          "originalRevision": 1,
          "originalSha256": "00d0310338fc10aa5aee67b11625e87a928538cd1f8c21357b33e6a94cf6a6c3",
          "excerpt": "劭即偽位，百僚至者裁數十人，"
        }
      ],
      "notes": [
        "属短期篡立，非正常受禅或身后追尊；本条未独定即位仪式的确日。"
      ]
    },
    {
      "id": "liu-shao-song-appointments-and-policy",
      "title": "收还兵仗，授官并减省赋役",
      "summary": "刘劭收还发给诸王各处的兵器，授萧斌、何尚之等官职，委鲁秀、庞秀之掌军，又访问公卿，减轻赋役、削减游费，弛放部分田苑山泽供贫民使用。",
      "year": 453,
      "precision": "year",
      "phase": "rule",
      "sortOrder": 11,
      "sourceDate": "太初元年即位后，未逐事另记月日",
      "evidence": [
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p12",
          "originalRevision": 1,
          "originalSha256": "458d9d4a9d1f518c14f144d59e60f4902380329f15028096ca81e5260c9c9898",
          "excerpt": "先給諸王及諸處兵仗，悉收還武庫。"
        },
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p12",
          "originalRevision": 1,
          "originalSha256": "458d9d4a9d1f518c14f144d59e60f4902380329f15028096ca81e5260c9c9898",
          "excerpt": "使秀與屯騎校尉龐秀之對掌軍隊。"
        },
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p12",
          "originalRevision": 1,
          "originalSha256": "458d9d4a9d1f518c14f144d59e60f4902380329f15028096ca81e5260c9c9898",
          "excerpt": "博訪公卿，詢求治道，薄賦輕繇，損諸遊費。田苑山澤，有可弛者，假與貧民。"
        },
        {
          "chapterId": "songshu-v006",
          "paragraphId": "songshu-v006-p4",
          "originalRevision": 1,
          "originalSha256": "adbdabb2e526b7826a6c81f115e877d316bf7bc081e8058b56fd30b52a220345",
          "excerpt": "會元凶弒逆，以上為征南將軍，加散騎常侍。"
        }
      ],
      "notes": [
        "所记为即位后措施，不据同段是日把全部后续措施固定为同一天。"
      ]
    },
    {
      "id": "liu-shao-song-administration",
      "title": "分会州，改置司隶并授诸王官",
      "summary": "刘劭遣使分行四方，分浙江以东五郡为会州，省扬州、立司隶校尉，以殷冲任之；又授刘义恭太保、刘义宣太尉等职。",
      "year": 453,
      "precision": "month",
      "phase": "rule",
      "sortOrder": 12,
      "sourceDate": "太初元年三月",
      "evidence": [
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p13",
          "originalRevision": 1,
          "originalSha256": "c7eed1ed24c56bece508d5617c9990d28773d77672acd7996b71faa2d1c25e11",
          "excerpt": "三月，遣大使分行四方，分浙以東五郡為會州，省揚州立司隸校尉，以殷沖補之。以大將軍江夏王義恭為太保，司徒南譙王義宣為太尉，"
        }
      ],
      "variants": [
        {
          "label": "孝武朝拟设司隶而止的追述",
          "sourceDate": "大明三年二月段，未另记拟设日",
          "year": 459,
          "summary": "孝武朝拟设司隶校尉，因为刘劭已设过而作罢；是身后制度参读，不是刘劭在459年仍施行新令。",
          "evidence": [
            {
              "chapterId": "songshu-v006",
              "paragraphId": "songshu-v006-p81",
              "originalRevision": 1,
              "originalSha256": "f18cb5fa907a5252f73b8400860c58059a9e9624d6218495ff37eb03af4ef3eb",
              "excerpt": "時欲立司隸校尉，以元凶已立乃止。"
            }
          ]
        }
      ]
    },
    {
      "id": "liu-shao-song-executions-and-title",
      "title": "杀王僧绰等，为文帝上庙谥",
      "summary": "王僧绰因先前参与废立谋议被杀，宗室数人亦因旧怨死于狱中。礼官迎合刘劭，给文帝上中宗景皇帝之称。",
      "year": 453,
      "precision": "month",
      "phase": "rule",
      "sortOrder": 13,
      "sourceDate": "太初元年三月",
      "evidence": [
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p13",
          "originalRevision": 1,
          "originalSha256": "c7eed1ed24c56bece508d5617c9990d28773d77672acd7996b71faa2d1c25e11",
          "excerpt": "王僧綽以先預廢立，見誅。長沙王瑾、瑾弟楷、臨川王燁、桂陽侯覬、新渝侯玠，[5]並以宿恨下獄死。禮官希旨，諡太祖不敢盡美稱，上諡曰中宗景皇帝。"
        }
      ],
      "notes": [
        "中宗为庙号，景皇帝为谥号；不将全部称号写成单一谥号。"
      ]
    },
    {
      "id": "liu-shao-song-gather-princes",
      "title": "集中诸王大臣并拘守宗室",
      "summary": "刘骏、刘义宣、刘诞等举兵后，刘劭把诸王及大臣集中在城中，将刘义恭及其诸子分别安置在尚书下舍和侍中下省。",
      "year": 453,
      "precision": "year",
      "phase": "rule",
      "sortOrder": 14,
      "sourceDate": "太初元年诸方镇起兵后，未另记月日",
      "evidence": [
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p14",
          "originalRevision": 1,
          "originalSha256": "85a7aa8560521bf16edd349ef3d256147265ac8bc31c2fa3bafc5f6627d91c9e",
          "excerpt": "世祖及南譙王義宣、隨王誕諸方鎮並舉義兵。劭聞義師大起，悉聚諸王及大臣於城禸，移江夏王義恭住尚書下舍，義恭諸子住侍中下省。"
        }
      ]
    },
    {
      "id": "liu-shao-song-empress",
      "title": "立殷氏为皇后",
      "summary": "刘劭立妻殷氏为皇后。",
      "year": 453,
      "precision": "month",
      "phase": "rule",
      "sortOrder": 15,
      "sourceDate": "太初元年四月",
      "evidence": [
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p14",
          "originalRevision": 1,
          "originalSha256": "85a7aa8560521bf16edd349ef3d256147265ac8bc31c2fa3bafc5f6627d91c9e",
          "excerpt": "四月，立妻殷氏為皇后。"
        },
        {
          "chapterId": "nanshi-v014",
          "paragraphId": "nanshi-v014-p15",
          "originalRevision": 1,
          "originalSha256": "249fa5219325a23f1c5e182940d8327de371b9123535ef8ca77f7d9daf2c48af",
          "excerpt": "四月，立妻殷為皇后。"
        }
      ],
      "notes": [
