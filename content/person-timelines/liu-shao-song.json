    {
      "id": "liu-shao-song-announced-birth",
      "title": "传记记对外宣布出生",
      "summary": "两传记述刘劭实际生于文帝即位后的居丧期间，先隐瞒，到元嘉三年闰正月才对外宣称出生。",
      "year": 426,
      "precision": "month",
      "phase": "early",
      "sortOrder": 1,
      "sourceDate": "元嘉三年闰正月（传记所记对外宣称）",
      "evidence": [
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p2",
