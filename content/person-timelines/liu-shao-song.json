          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p4",
          "originalRevision": 1,
          "originalSha256": "2126ab521ebcc7b44ef2f09922448ad060be4b5f131c6f943311da57429ce08c",
          "excerpt": "索虜至瓜步，京邑震駭，劭出鎮石頭，總統水軍，善於撫御。"
        },
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p4",
          "originalRevision": 1,
          "originalSha256": "2126ab521ebcc7b44ef2f09922448ad060be4b5f131c6f943311da57429ce08c",
          "excerpt": "劭曰：「不斬江湛、徐湛之，無以謝天下。」上曰：「北伐自我意，不關二人也。」"
        }
      ],
      "notes": [
        "本段只给年与事势，不把魏主抵达、文帝登城或刘劭授统的动作合成同一确日。"
      ],
      "yearRange": {
        "start": 450,
        "end": 451
      }
    },
    {
      "id": "liu-shao-song-witchcraft",
      "title": "信奉严道育，共为巫蛊",
      "summary": "刘劭与东阳公主信奉严道育；刘劭、刘濬担忧过失为文帝得知，请其祈禳，并刻玉为文帝形像埋于含章殿前。",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 106,
      "sourceDate": "巫蛊败露前，未明年月",
      "evidence": [
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p5",
          "originalRevision": 1,
          "originalSha256": "b1e0c1fe0a0edf49f708f829ecfb2f7102289b439e5790a17caab878c2f6b99c",
          "excerpt": "劭等敬事，號曰天師。後遂為巫蠱，以玉人為上形像，埋於含章殿前。"
        },
        {
          "chapterId": "nanshi-v014",
          "paragraphId": "nanshi-v014-p7",
          "originalRevision": 1,
          "originalSha256": "df17b9abf27374893cc8759109949bdc9f1e9c194fd8760a20941bfdaace0b9b",
          "excerpt": "始興王濬素佞事劭，並多過失，慮上知，使道育祈請，欲令過不上聞。"
        }
      ],
      "notes": [
        "记信奉和诅咒行为，不把上天陈请、流光化珠等当作已证神异事实。"
      ]
    },
    {
      "id": "liu-shao-song-chen-tianxing",
      "title": "任用并密使害陈天兴",
      "summary": "刘劭任陈天兴为队主；后来王鹦鹉担心私通事泄，请杀天兴，刘劭秘密派人将他杀害。",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 107,
      "sourceDate": "首次巫蛊败露前，未明年月",
      "evidence": [
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p6",
          "originalRevision": 1,
          "originalSha256": "7772ae98a8323b5691b1829cde5221d17bd3ae2cfc5e61a7e0787cccefd8619b",
          "excerpt": "劭以天興補隊主。"
        },
        {
          "chapterId": "songshu-v099",
          "paragraphId": "songshu-v099-p7",
          "originalRevision": 1,
          "originalSha256": "12ab7fc81431c2cbfe5c307b654e38be442079c6cd116dcdc2c1383165840f4f",
          "excerpt": "鸚鵡既適懷遠，慮與天興私通事泄，請劭殺之。劭密使人害天興。"
        }
      ],
      "notes": [
        "任命、私通关系和杀害的主体分别核对；刘劭为命令者，不补亲手杀害。"
      ]
    },
    {
      "id": "liu-shao-song-shelter-daoyu",
      "title": "东宫藏匿严道育",
      "summary": "巫蛊败露后，严道育改装为尼姑，逃藏在东宫；刘濬出镇京口又带她同行，有时住在张旿家。",
      "year": null,
      "precision": "range",
