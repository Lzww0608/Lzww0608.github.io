  "personId": "li-conghou",
  "events": [
    {
      "id": "li-conghou-birth",
      "year": 914,
      "title": "出生于晋阳",
      "summary": "李从厚小名菩萨奴，母夏氏。旧史称明宗第三子，新史称第五子，排行分歧分别保留。幼年喜读《春秋》，受明宗钟爱。",
      "sourceDate": "天祐十一年十一月二十八日庚申",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p2",
          "originalRevision": 1,
          "originalSha256": "ed0445aef542cfcf46cb0e7e426c62801de7e8af95d005ccc790163d9b93cfe0",
          "excerpt": "閔帝，諱從厚，小字菩薩奴，明宗第三子也。母昭懿皇后夏氏，以天祐十一年歲在甲戌，十一月二十八日庚申，生帝於晉陽舊第。帝髫齔好讀《春秋》，略通大義，貌類明宗，尤鍾愛。"
        }
      ],
      "phase": "early",
      "precision": "day",
      "sortOrder": 1,
      "variants": [
        {
          "label": "《新史》记明宗第五子",
          "sourceDate": "家世记载，未独记出生日期",
          "summary": "新史作第五子，与旧史第三子的记法不同。",
          "evidence": [
            {
              "chapterId": "new-v07",
              "paragraphId": "new-v07-p1",
              "originalRevision": 1,
              "originalSha256": "108f72768406e878360b6b7f61c815a449a8dbca874f09735fea00424174cee4",
              "excerpt": "愍皇帝，明宗第五子從厚也。為人形質豐厚，寡言好禮，明宗以其貌類己，特愛之。"
            }
          ]
        }
      ],
      "notes": [
        "出生日期按当时通行的天祐纪年保存，历算以合法同历的梁乾化四年核对，不使用超出唐哀帝在位范围的回退。"
      ]
    },
    {
      "id": "li-conghou-henan-yin",
      "year": 927,
      "title": "任河南尹，掌六军诸卫事",
      "summary": "加检校太保、同平章事，任河南尹并主管六军诸卫，十一月又加检校太傅。",
      "sourceDate": "天成二年四月、十一月",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p3",
          "originalRevision": 1,
          "originalSha256": "34a7904a223560e673599a14b7be0bf5461b4a10d241213ea10d832266ab5452",
          "excerpt": "二年四月，加檢校太保、同平章事、河南尹，判六軍諸衛事。十一月，加檢校太傅。"
        },
        {
          "chapterId": "new-v07",
          "paragraphId": "new-v07-p1",
          "originalRevision": 1,
          "originalSha256": "108f72768406e878360b6b7f61c815a449a8dbca874f09735fea00424174cee4",
          "excerpt": "天成二年，以檢校司徒拜河南尹、判六軍諸衞事，加檢校太保、同中書門下平章事。"
        }
      ],
      "phase": "service",
      "precision": "month",
      "sortOrder": 2
    },
    {
      "id": "li-conghou-bianzhou",
      "year": 928,
      "title": "出任汴州节度使",
      "summary": "由京职出镇汴州。新史将此事与安重诲因孔循嫁女而发怒、孔循罢枢密使并叙，保留其叙述归属。",
      "sourceDate": "天成三年三月",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p3",
          "originalRevision": 1,
          "originalSha256": "34a7904a223560e673599a14b7be0bf5461b4a10d241213ea10d832266ab5452",
          "excerpt": "三年三月，授汴州節度使。"
        },
        {
          "chapterId": "new-v07",
          "paragraphId": "new-v07-p1",
          "originalRevision": 1,
          "originalSha256": "108f72768406e878360b6b7f61c815a449a8dbca874f09735fea00424174cee4",
          "excerpt": "從厚妃，孔循女也，安重誨怒循以女妻從厚，三年，罷循樞密使，出從厚為宣武軍節度使。"
        }
      ],
      "phase": "service",
      "precision": "month",
      "sortOrder": 3
    },
    {
      "id": "li-conghou-song-prince",
      "year": 930,
      "title": "移镇成德，封宋王",
      "summary": "改任镇州节度使，获封宋王；会要明确记封王在八月。",
      "sourceDate": "长兴元年；《会要》八月",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p3",
          "originalRevision": 1,
          "originalSha256": "34a7904a223560e673599a14b7be0bf5461b4a10d241213ea10d832266ab5452",
          "excerpt": "長興元年，改授鎮州節度使，尋封宋王。"
        },
        {
          "chapterId": "new-v07",
          "paragraphId": "new-v07-p1",
          "originalRevision": 1,
          "originalSha256": "108f72768406e878360b6b7f61c815a449a8dbca874f09735fea00424174cee4",
          "excerpt": "長興元年，封從厚宋王，徙鎮成德。"
        },
        {
          "chapterId": "huiyao-v001",
          "paragraphId": "huiyao-v001-p6",
          "originalRevision": 1,
          "originalSha256": "3a48047a9fdbec5510aac359043b9ae510351085f9bd1063153b8386db2560c7",
          "excerpt": "長興元年八月，封宋王。"
        }
      ],
      "phase": "service",
      "precision": "month",
      "sortOrder": 4
    },
    {
      "id": "li-conghou-summoned",
      "year": 933,
      "title": "秦王被诛后，从邺都被召回",
      "summary": "秦王李从荣被诛次日，明宗派孟汉琼召李从厚。明宗去世后，李从厚于十一月二十九日抵京；新史另记隐丧六日。",
      "sourceDate": "长兴四年十一月二十一日至二十九日",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p4",
          "originalRevision": 1,
          "originalSha256": "c5683c79f5a74b9d21f65f089d72c8956b92113ea0843089728b3b069498cf96",
          "excerpt": "四年十一月二十日，秦王誅。翌日，明宗遣宣徽使孟漢瓊馳驛召帝，二十六日，明宗崩，二十九日，帝至自鄴。"
        },
        {
          "chapterId": "new-v07",
          "paragraphId": "new-v07-p2",
          "originalRevision": 1,
          "originalSha256": "bc649556f22e280f30589cc3f7e74888580b2d719440446895e9fb97002fc3d6",
          "excerpt": "四年十一月，秦王從榮伏誅。明宗病甚，遣宦者孟漢瓊召王于鄴，而明宗崩，祕其喪六日。"
        }
      ],
      "phase": "early",
      "precision": "day",
      "sortOrder": 5
    },
    {
      "id": "li-conghou-accession",
      "year": 933,
      "title": "在明宗灵柩前即位",
      "summary": "十二月初一公布明宗丧事，李从厚在灵柩前继承帝位。不同史书对初一干支的写法分别列出。",
      "sourceDate": "长兴四年十二月癸卯朔",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p4",
          "originalRevision": 1,
          "originalSha256": "c5683c79f5a74b9d21f65f089d72c8956b92113ea0843089728b3b069498cf96",
          "excerpt": "十二月癸卯朔，發喪於西宮，帝於柩前即位。"
        },
        {
          "chapterId": "new-v07",
          "paragraphId": "new-v07-p2",
          "originalRevision": 1,
          "originalSha256": "bc649556f22e280f30589cc3f7e74888580b2d719440446895e9fb97002fc3d6",
          "excerpt": "十二月癸卯朔，發喪于西宮，皇帝即位于柩前，羣臣見於東階，復于喪位。"
        },
        {
          "chapterId": "tongjian-v278",
          "paragraphId": "tongjian-v278-p81",
          "originalRevision": 1,
          "originalSha256": "379c2a7e27cbe57fb397e43c6c0bbf682fff7c6f0e65c0cc21eec3a226e70aba",
          "excerpt": "十二月，癸卯朔，始發明宗喪，宋王即皇帝位。"
        }
      ],
      "phase": "rule",
      "precision": "day",
      "sortOrder": 6,
      "variants": [
        {
          "label": "《五代春秋》作癸亥朔",
          "sourceDate": "长兴四年十二月癸亥朔",
          "summary": "同样记十二月初一即位，干支作癸亥，不改写底本为其他干支。",
          "evidence": [
            {
              "chapterId": "chunqiu-v001",
              "paragraphId": "chunqiu-v001-p34",
              "originalRevision": 1,
              "originalSha256": "b8ba39da9d9acaa245de0af26eba987af0a09de821d45e666af7bf31dcabef12",
              "excerpt": "長興四年十二月癸亥朔，帝卽位。"
            }
          ]
        }
      ]
    },
    {
      "id": "li-conghou-government-request",
      "year": 933,
      "title": "在丧中接受听政请求",
      "summary": "旧史记群臣丁未再表请听政，皇帝允许；新史把正式始听政记为癸丑。请求获允与正式开始的记法分别展示。",
      "sourceDate": "长兴四年十二月丁未",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p4",
          "originalRevision": 1,
          "originalSha256": "c5683c79f5a74b9d21f65f089d72c8956b92113ea0843089728b3b069498cf96",
          "excerpt": "丁未，群臣上表請聽政，表再上，詔允。"
        }
      ],
      "phase": "rule",
      "precision": "day",
      "sortOrder": 7,
      "variants": [
        {
          "label": "《新史》始听政在癸丑",
          "sourceDate": "长兴四年十二月癸丑",
          "summary": "新史明确记癸丑始听政。",
          "evidence": [
            {
              "chapterId": "new-v07",
              "paragraphId": "new-v07-p2",
              "originalRevision": 1,
              "originalSha256": "bc649556f22e280f30589cc3f7e74888580b2d719440446895e9fb97002fc3d6",
              "excerpt": "辛亥，殺司衣王氏。癸丑，始聽政。乙卯，殺司儀康氏。"
            }
          ]
        }
      ]
    },
    {
      "id": "li-conghou-old-confidant-sent-away",
      "year": 934,
      "title": "亲信宋令询被调出京",
      "summary": "宋令询长期侍从李从厚。朱弘昭想专掌朝政，不愿旧人在皇帝身边，将其调任磁州刺史；李从厚不悦而无可奈何。",
      "sourceDate": "长兴四年十二月丙辰",
      "evidence": [
        {
          "chapterId": "tongjian-v278",
          "paragraphId": "tongjian-v278-p83",
          "originalRevision": 1,
          "originalSha256": "2c34c654eb6af74f281180f689f5bcc137ebd700eb04861eb44e7fdbcf12418b",
          "excerpt": "丙辰，以天雄左都押牙宋令詢為磁州刺史。朱弘昭以誅秦王立帝為己功，欲專朝政；令詢侍帝左右最久，雅為帝所親信，弘昭不欲舊人在帝側，故出之。帝不悅而無如之何。"
        },
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p4",
          "originalRevision": 1,
          "originalSha256": "c5683c79f5a74b9d21f65f089d72c8956b92113ea0843089728b3b069498cf96",
          "excerpt": "丙辰，以天雄軍節度判官唐汭為諫議大夫，掌書記趙彖為起居郎，元從都押衙宋令詢為磁州刺史。"
        }
      ],
      "phase": "rule",
      "precision": "day",
      "sortOrder": 8,
      "notes": [
        "该日已跨西历934年，原书长兴四年记法保留。"
      ]
    },
    {
      "id": "li-conghou-reading-and-mourning",
      "year": 934,
      "title": "服丧后召学士读政要，拒绝进酒",
      "summary": "通鉴记易月服丧结束后，召学士读《贞观政要》《太宗实录》，有治国之志；旧史记十二月辛未御中兴殿时，仍以深痛居丧拒绝冯道进酒。",
      "sourceDate": "长兴四年十二月，易月服丧结束后；辛未",
      "evidence": [
        {
          "chapterId": "tongjian-v278",
          "paragraphId": "tongjian-v278-p85",
          "originalRevision": 1,
          "originalSha256": "7bd2fe3665e777476d7b22b2b70ba892ed3e281a038c4e785ebe46c2c2913858",
          "excerpt": "辛未，帝始御中興殿。帝自終易月之制，即召學士讀《貞觀政要》、《太宗實錄》，有致治之志；然不知其要，寬柔少斷。李愚私謂同列曰：「吾君延訪，鮮及吾輩，位高責重，事亦堪憂。」眾惕息不敢應。"
        },
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p4",
          "originalRevision": 1,
          "originalSha256": "c5683c79f5a74b9d21f65f089d72c8956b92113ea0843089728b3b069498cf96",
          "excerpt": "辛未，帝御中興殿，群臣列位，馮道升階進酒。帝曰：「比於此物無愛，除賓友之會，不近樽斝。況在沉痛之中，安事飲啖！」命徹之。"
        }
      ],
      "phase": "rule",
      "precision": "month",
      "sortOrder": 9,
      "notes": [
        "十二月末辛未及易月期满已在西历934年，不按长兴四年的起算年直接排入933年。"
      ]
    },
    {
      "id": "li-conghou-era-amnesty",
      "year": 934,
      "title": "大赦，改元应顺",
      "summary": "正月戊寅大赦，将长兴五年改为应顺元年；因明宗灵柩尚在殡而奏乐，两史都保留当时对礼仪的批评。",
      "sourceDate": "应顺元年正月戊寅",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p5",
          "originalRevision": 1,
          "originalSha256": "16281deb9cba8b3150e2b8e2ccbae85d0960c3a6b0dace61ab51f0b89393fb21",
          "excerpt": "戊寅，禦明堂殿，仗衛如儀，宮懸樂作，群臣朝服就位，宣製大赦天下，改長興五年為應順元年。時議者以梓宮在殯，宮縣樂作，非禮也，懸而不作可也。"
        },
        {
          "chapterId": "new-v07",
          "paragraphId": "new-v07-p3",
          "originalRevision": 1,
          "originalSha256": "e8010cb5b2e79a20633c9db0ebf4accdb898763ce84b31a36fd5fab3811675d4",
          "excerpt": "應順元年春正月壬申朔，視朝于廣壽殿。〈著非禮也。〉乙亥，契丹使都督沒辣于來。戊寅，大赦，改元，用樂。"
        },
        {
          "chapterId": "tongjian-v278",
          "paragraphId": "tongjian-v278-p91",
          "originalRevision": 1,
          "originalSha256": "40e94f4953d0a6f831eeabde7dfaf137aaf3bb799a40dbaa01d20dd467fd05ac",
          "excerpt": "春，正月，戊寅，閔帝大赦，改元應順。壬午，加河陽節度使兼侍衛都指揮使康義誠兼侍中，判六軍諸衛事。"
        }
      ],
      "phase": "rule",
      "precision": "day",
      "sortOrder": 10
    },
    {
      "id": "li-conghou-royal-grants",
      "year": 934,
      "title": "封南平、楚及吴越王",
      "summary": "在正月封高从诲为南平王、马希范为楚王，进封钱元瓘为吴越王；给孟知祥加官的命令遭其辞拒。不把封王写作本人或受封者称帝。",
      "sourceDate": "应顺元年正月壬辰、甲午",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p6",
          "originalRevision": 1,
          "originalSha256": "754e355538091b2dd790ff8f043c6d94cd757885cf2841c566da204b3251701c",
          "excerpt": "壬辰，荊南節度使、檢校太尉、兼中書令高從誨封南平王；湖南節度使、檢校太尉、兼中書令馬希範封楚王。甲午，兩浙節度使、檢校太師、守中書令、吳王錢元瓘進封吳越王；前洺州團練使皇甫立加檢校太保，充鄜州節度使；前彰義軍節度使康福加檢校太傅，充邠州節度使；劍南東、西兩川節度使、檢校太尉、兼中書令、蜀王孟知祥加檢校太師。製下，知祥辭不受命。"
        }
      ],
      "phase": "rule",
      "precision": "day",
      "sortOrder": 11
    },
    {
      "id": "li-conghou-empress-dowagers",
      "year": 934,
      "title": "册曹氏为皇太后，王氏为皇太妃",
      "summary": "闰正月分别册曹氏为皇太后、王氏为皇太妃，继续办理明宗丧礼。",
      "sourceDate": "应顺元年闰正月丙午、甲寅",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p7",
          "originalRevision": 1,
          "originalSha256": "8508cf75dab93231c112641a3d756d5b726367eff8e24842c49e37ddb35875f1",
          "excerpt": "丙午，正衙命使冊皇太后曹氏。"
        },
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p7",
          "originalRevision": 1,
          "originalSha256": "8508cf75dab93231c112641a3d756d5b726367eff8e24842c49e37ddb35875f1",
          "excerpt": "甲寅，正衙命使冊皇太妃王氏。"
        },
        {
          "chapterId": "new-v07",
          "paragraphId": "new-v07-p3",
          "originalRevision": 1,
          "originalSha256": "e8010cb5b2e79a20633c9db0ebf4accdb898763ce84b31a36fd5fab3811675d4",
          "excerpt": "閏月丙午，冊皇太后。〈不書姓氏，不曰冊某人為太后者，母尊不可斥，其事自見於傳也。〉甲寅，冊太妃王氏。"
        }
      ],
      "phase": "rule",
      "precision": "day",
      "sortOrder": 12
    },
    {
      "id": "li-conghou-lingyan",
      "year": 934,
      "title": "筹建凌烟阁，恢复画像官",
      "summary": "依集贤院建议筹建凌烟阁，命预定开国功臣人数及画像底本，恢复写真官、画真官各一员。这里是修建安排，不说工程已经完成。",
      "sourceDate": "应顺元年闰正月",
      "evidence": [
        {
          "chapterId": "old-v045",
          "paragraphId": "old-v045-p7",
          "originalRevision": 1,
          "originalSha256": "8508cf75dab93231c112641a3d756d5b726367eff8e24842c49e37ddb35875f1",
