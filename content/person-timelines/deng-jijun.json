  "events": [
    {
      "id": "deng-jijun-captured",
      "title": "高平败而被李克用俘用",
      "summary": "张浚伐太原时邓季筠随汴军西进，高平战败被擒，李克用释缚、宾礼待之并委军务。",
      "year": 890,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "本传大顺初高平；武皇纪大顺元年六月泽州救援同役，存孝传明确生擒",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p16",
          "originalRevision": 1,
          "originalSha256": "17f473ddf7f649bb309f0f202ee1c715549964c472f9b8e6a03da4232307c8aa",
          "excerpt": "唐大順初，唐帝命丞相張浚伐太原，太祖奉詔出師，西至高平，與晉人接戰，軍既不利，季筠為晉人所擒。克用見之甚喜，釋縛，待以賓禮，俄典戎事。季筠在並門凡四稔。"
        },
        {
          "chapterId": "old-v025",
          "paragraphId": "old-v025-p22",
          "originalRevision": 1,
          "originalSha256": "760f0b4b9c3b8dad25f77994aac3503f82b59f98c8df0f729ef2bf0a4cd287b8",
          "excerpt": "大順元年，遣李存孝攻邢州，孟遷以邢、洺、磁三州降，執汴將王虔裕三百人以獻。武皇徙孟遷於太原，以安金俊為邢洺團練使。"
        },
        {
          "chapterId": "old-v025",
          "paragraphId": "old-v025-p23",
          "originalRevision": 1,
          "originalSha256": "48f0e88125b39dabf8ae23058fd1277f5ef3533bae9e6b799760b5d01a697f16",
          "excerpt": "六月，天子削奪武皇官爵，以張浚為招討使，以京兆尹孫揆為副，華州韓建為行營都虞候，以汴帥為河東南面招討使，幽州李匡威為河東北面招討使，雲州赫連鐸為副。汴將朱友裕將兵屯晉、絳，時汴軍已據潞州，又遣大將李讜等率軍數萬，急攻澤州，武皇遣李存孝自潞州將三千騎以援之。汴將鄧季筠以一軍犯陣，存孝追擊，擒其都將十數人，獲馬千餘匹。是夜，李讜收軍而退，大軍掩擊至馬牢關，斬首萬餘級，追襲至懷州而還。存孝復引軍攻潞州。"
        },
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p6",
          "originalRevision": 1,
          "originalSha256": "595ac0edd52f911d20e5f1a9ab6e1f2e006359d2bb551b5dcde137a34e71de0d",
          "excerpt": "張浚之加兵於太原也，潞州小校馮霸殺其帥李克恭以城叛。時汴將硃崇節入潞州，梁祖令張全義攻澤州。李罕之告急於武皇，武皇遣存孝率騎五千援之。初，汴人攻澤州，呼罕之曰：「相公常恃太原，輕絕大國，今張相公圍太原，葛司空已入潞府，旬日之內，沙陀無穴自處，相公何路求生耶！」存孝聞其言不遜，選精騎五百，繞汴營呼曰：「我，沙陀求穴者，俟爾肉饌軍，可令肥者出鬥！」汴將有鄧季筠者，亦以驍勇聞，乃引軍出戰。存孝激勵部眾，舞槊先登，一戰敗之，獲馬千匹，生擒季筠於軍中。是夜，汴將李讜收軍而遁，存孝追擊至馬牢山，俘斬萬計，遂退攻潞州。"
        }
      ]
    },
    {
      "id": "deng-jijun-hongdong",
      "title": "梁受禅后改郑州刺史",
      "summary": "朱温受禅后改邓季筠为郑州刺史；后来的河中掌军及洪洞战另列，不统系907。",
      "year": 907,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "太祖受禅后改郑州",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p16",
          "originalRevision": 1,
          "originalSha256": "17f473ddf7f649bb309f0f202ee1c715549964c472f9b8e6a03da4232307c8aa",
          "excerpt": "太祖受禪，改鄭州刺史，尋主兵於河中，為都指揮使。"
        }
      ]
    },
    {
      "id": "deng-jijun-death",
      "title": "因战马瘦，被斩军旗下",
      "summary": "本传记柏乡退却未获罪，乾化二年春阅马时因所管战马瘦，与何令稠、陈令勋同斩；太祖本纪却把三人腰斩记乾化元年十月，年份分列。",
      "year": 912,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "乾化二年春",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p16",
          "originalRevision": 1,
          "originalSha256": "17f473ddf7f649bb309f0f202ee1c715549964c472f9b8e6a03da4232307c8aa",
          "excerpt": "柏鄉之役，季筠臨陣前卻，太祖亦未之罪。乾化二年春，太祖親伐鎮、定，駐於相州，因閱馬，怒其馬瘦，與魏博軍校何令稠、陳令勳同斬於纛下。"
        }
      ],
      "variants": [
        {
          "label": "本纪乾化元年十月腰斩",
          "sourceDate": "乾化元年十月癸丑",
          "year": 911,
          "summary": "本传记乾化二年春，太祖本纪记乾化元年十月癸丑三人以马瘦腰斩，年份和刑罚记法各依来源。",
          "evidence": [
            {
              "chapterId": "old-v006",
              "paragraphId": "old-v006-p5",
              "originalRevision": 1,
              "originalSha256": "5b8aeda95b4c0025bbb688d6de1bd68d71e958a230c683a3e8ecaa8b036e22a0",
              "excerpt": "乾化元年"
            },
            {
              "chapterId": "old-v006",
              "paragraphId": "old-v006-p15",
              "originalRevision": 1,
              "originalSha256": "279292049e0b02db611fe0d6cf53763fe880596ab1710b87e0fd075b16efffe6",
              "excerpt": "十月辛亥朔，駐蹕於相州，宰臣洎文武從官並詣行宮起居。"
            },
            {
              "chapterId": "old-v006",
              "paragraphId": "old-v006-p15",
              "originalRevision": 1,
              "originalSha256": "279292049e0b02db611fe0d6cf53763fe880596ab1710b87e0fd075b16efffe6",
              "excerpt": "癸丑，閱武於州闉之南樓。左龍驤都教練使鄧季筠、魏博馬軍都指揮使何令稠、右廂馬軍都指揮使陳令勳，以部下馬瘦，並腰斬於軍門。"
            }
          ]
        }
      ]
    },
    {
      "id": "deng-jijun-early",
      "title": "掌骑军，伐郓立功",
      "summary": "邓季筠从黄巢军随朱温，朱温镇汴后为牙将掌骑军，伐郓擒刘矫。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "少入巢军至太祖镇汴后，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p16",
          "originalRevision": 1,
          "originalSha256": "17f473ddf7f649bb309f0f202ee1c715549964c472f9b8e6a03da4232307c8aa",
          "excerpt": "少入黃巢軍，隸於太祖麾下。及太祖鎮汴，首署為牙將，主騎軍。伐鄆之役，生擒排陣將劉矯以獻。"
        }
      ]
    },
    {
      "id": "deng-jijun-return",
      "title": "邢台阵中返朱温，统亲军",
      "summary": "邓季筠在晋军四稔，随攻邢台时阵中策马归朱温，获赏，掌新置厅子都及亲骑、中军。",
      "year": null,
      "sortOrder": 5,
      "precision": "range",
      "sourceDate": "景福二年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v019",
          "paragraphId": "old-v019-p16",
          "originalRevision": 1,
          "originalSha256": "17f473ddf7f649bb309f0f202ee1c715549964c472f9b8e6a03da4232307c8aa",
          "excerpt": "季筠在並門凡四稔。景福二年，晉軍攻邢臺，季筠領偏師預其役，將及邢，邢人陣於郊，兩軍酣戰之際，季筠出陣，飛馬來歸；太祖大加獎歎，賞賚甚厚。時初置廳子都，最為親軍，命季筠主之，旋改統親騎，又遷將中軍。天祐三年，奏授登州刺史，下車稱理。"
        }
      ],
      "yearRange": {
