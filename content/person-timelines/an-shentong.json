    {
      "id": "an-shentong-death-zhongshan",
      "title": "围王都时中飞石而卒",
      "summary": "围中山王都，亲冒矢石，遭飞石击中身亡，赠太尉；本段未写具体卒日年。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "围王都中山期间",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
