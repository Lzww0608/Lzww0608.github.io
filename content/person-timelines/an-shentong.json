  "events": [
    {
      "id": "an-shentong-mingzong-vanguard",
      "title": "赴明宗急召，军趋夷臒为先锋",
      "summary": "同光四年春接明宗急召，率军趋夷臒，任前锋。",
      "year": 926,
      "sortOrder": 0,
      "precision": "year",
      "sourceDate": "同光四年春",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p3",
          "originalRevision": 1,
          "originalSha256": "21450cc0e901893e4485b32d99c3d8aa44b55d05c41bbe2ad2abecbfed628d3a",
          "excerpt": "四年春，赴明宗急詔，軍趨夷臒，為前鋒。"
        }
      ]
    },
    {
      "id": "an-shentong-lutai-rebellion",
      "title": "卢台兵变脱身，率骑平乱",
      "summary": "从房知温驻卢台时遇龙晊部军乱，脱酒席夺船渡河，整顿骑兵，乱军南行后将其击破，升沧州节度。",
      "year": 927,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天成二年卢台军乱",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p3",
          "originalRevision": 1,
          "originalSha256": "21450cc0e901893e4485b32d99c3d8aa44b55d05c41bbe2ad2abecbfed628d3a",
          "excerpt": "審通脫身酒筵，奪般以濟，促騎士介馬，及亂兵南行，盡戮之，以功授檢校太傅、滄州節度使。"
        },
        {
          "chapterId": "new-v06",
          "paragraphId": "new-v06-p12",
          "originalRevision": 1,
          "originalSha256": "6b17ea6ee7ce937f8b1e9cc79727e6065e7dad31fbdf0241c09b803552acf880",
          "excerpt": "二年春正月癸丑朔，更名亶。"
        },
        {
          "chapterId": "new-v06",
          "paragraphId": "new-v06-p12",
          "originalRevision": 1,
          "originalSha256": "6b17ea6ee7ce937f8b1e9cc79727e6065e7dad31fbdf0241c09b803552acf880",
          "excerpt": "三月壬子朔，幸會節園，羣臣買宴。〈遊幸若不過度，則小事也，皆不書。惟莊宗及晉出帝之世則書者，著其過度耳。明宗於五代為勤儉之君，遊幸無過度，此書以著買宴，見君臣之失矣。〉盧臺亂，殺其將烏震。"
        },
        {
          "chapterId": "tongjian-v275",
          "paragraphId": "tongjian-v275-p87",
          "originalRevision": 1,
          "originalSha256": "026182a0b376074fcfd72edcedd6dfde9883a2afe13ebee0c28090756a7fd02c",
          "excerpt": "壬申，震召知溫及諸道先鋒馬軍都指揮使、齊州防禦使安神博於東寨，知溫誘龍晊所部兵殺震於席上，其眾噪於營外，安審通脫身走，奪舟濟河，將騎兵按甲不動。知溫恐事不濟，亦上馬出門，軍士攬其轡曰：「公當為士卒主，去欲何之？」知溫給之曰：「騎兵皆在河西，不收取之，獨有步兵，何能集事！」遂躍馬登舟濟河，與審通合謀擊亂兵，亂兵遂南行。"
        }
      ]
    },
    {
      "id": "an-shentong-early-service",
      "title": "事庄宗立功，升先锋指挥",
      "summary": "安金全侄子，年轻时事李存勖，多有战功，升先锋指挥使。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "本传未记具体年次",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p3",
          "originalRevision": 1,
          "originalSha256": "21450cc0e901893e4485b32d99c3d8aa44b55d05c41bbe2ad2abecbfed628d3a",
          "excerpt": "審通，金全之猶子也。幼事莊宗，累有戰功，轉先鋒指揮使。"
        }
      ]
    },
    {
