    {
      "id": "nantang-li-bian-consort-shiguang-entry-birth",
      "title": "十六岁入宫",
      "summary": "种氏十六岁入宫，隶属乐部；马令另记久未得幸、宋后多次推荐。",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 1,
      "sourceDate": "年十六入宫，未独记历年",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p4",
          "originalRevision": 1,
          "originalSha256": "04d89e60a36713fd5eea06ea4feb19731eec9a388289080c1fc7e91570200e6a",
          "excerpt": "年十六，入宮，隸樂部。"
        }
      ],
      "variants": [
        {
          "label": "马令久不得幸",
          "sourceDate": "十六入宫后，未独记年月",
          "summary": "马令记久未得幸，宋后多次推荐。",
          "evidence": [
            {
              "chapterId": "nantangma-v006",
              "paragraphId": "nantangma-v006-p7",
              "originalRevision": 1,
              "originalSha256": "81f9659d2a944963d4414f296f0fdda017522e96e6a6041670896659f174606d",
              "excerpt": "初進入宫年甫十六久不得幸宋后數數薦引"
            }
          ]
        }
      ],
      "notes": [
        "十六入宫未记历年；受禅后生子为另一时间层，出生外范围不能移用于入宫。"
      ]
    },
    {
      "id": "nantang-li-bian-consort-shiguang-birth-jingti",
      "title": "生景逿，烈祖宠爱",
      "summary": "种氏生景逿，烈祖因这是受禅后所得之子而特别喜爱；未由生日或入宫年龄倒定唯一出生年。",
      "year": null,
      "yearRange": {
        "start": 937,
        "end": 943
      },
      "precision": "range",
      "phase": "uncertain",
      "sortOrder": 2,
      "sourceDate": "烈祖受禅后所得子，未独记出生年",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p4",
          "originalRevision": 1,
          "originalSha256": "04d89e60a36713fd5eea06ea4feb19731eec9a388289080c1fc7e91570200e6a",
          "excerpt": "俄得幸，生景逿。"
        },
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p4",
          "originalRevision": 1,
          "originalSha256": "04d89e60a36713fd5eea06ea4feb19731eec9a388289080c1fc7e91570200e6a",
          "excerpt": "烈祖以受禪後所得子， 甚愛之。"
        }
      ],
      "notes": [
        "937—943为受禅后、烈祖在世的外范围，不用于种氏十六岁入宫的时间。"
      ]
    },
