    {
      "id": "nantang-li-bian-consort-shiguang-reprimand-and-nun",
      "title": "进言受谴、幽居为尼",
      "summary": "种氏借宠称儿子才胜齐王，被烈祖叱退、去簪珥、幽别宫，数月后度为尼。",
      "year": null,
      "precision": "range",
      "phase": "uncertain",
      "yearRange": {
        "start": 937,
        "end": 943
      },
      "sortOrder": 5,
      "sourceDate": "齐王受责后数日；又数月度尼，未独记年号月日",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p4",
          "originalRevision": 1,
          "originalSha256": "04d89e60a36713fd5eea06ea4feb19731eec9a388289080c1fc7e91570200e6a",
          "excerpt": "數日，种氏負寵，輒乘間言景逷才過齊王"
        },
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p4",
          "originalRevision": 1,
          "originalSha256": "04d89e60a36713fd5eea06ea4feb19731eec9a388289080c1fc7e91570200e6a",
          "excerpt": "叱下殿，去簪珥，幽于別官。數月，命度爲尼。"
        }
      ],
      "variants": [
        {
          "label": "通鉴命嫁",
          "sourceDate": "烈祖在世时，未独记年月",
          "summary": "《通鉴》记种氏建议以景逷为嗣，唐主怒而命其改嫁；与《十国春秋》及陆游、马令《南唐书》种氏本传所记幽别宫、度尼分源保留，不拼成确定的两次处分。",
          "evidence": [
            {
              "chapterId": "tongjian-v283",
              "paragraphId": "tongjian-v283-p48",
              "originalRevision": 1,
              "originalSha256": "1a98637064a97302a683bbaa539eb7a68dfcb7e4c0214b3b548d33769725cad2",
              "excerpt": "种氏乘間言，景逷雖幼而慧，可以為嗣。唐主怒曰：「子有過，父訓之，常事也。國家大計，女子何得預知！」即命嫁之。"
            }
          ]
        }
      ],
      "notes": [
        "马令未标点数日句不借另一书静订，受谴不是已被处死。"
      ]
    },
