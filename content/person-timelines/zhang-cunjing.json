  "events": [
    {
      "id": "zhang-cunjing-suzhou",
      "title": "任都虞候，协攻宿州",
      "summary": "张存敬为诸军都虞候，协霍存统军收宿州，获检校兵部尚书；后来的徐兖行营军职另列。",
      "year": 891,
      "sortOrder": 0,
      "precision": "year",
      "sourceDate": "大顺二年，葛传同次丁会攻宿十月，合法891年11月6日至12月4日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p16",
          "originalRevision": 1,
          "originalSha256": "df05f523e990cbaebf4a4128eb4136cac2810a102ed72d34e66af96f3a8fb39a",
          "excerpt": "大順二年，為諸軍都虞候，佐霍存董大軍收宿州，以功奏加檢校兵部尚書。"
        },
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p5",
          "originalRevision": 1,
          "originalSha256": "e6ded9f2bcf5abde299f1610c3cfae73ad7107ab33864688cde06a084799cf45",
          "excerpt": "明年正月，大破魏軍於永定橋，魏軍五敗，斬首萬餘級。十月，佐丁會攻宿州，從周壅水灌其城，刺史張筠以郡降。"
        }
      ]
    },
    {
      "id": "zhang-cunjing-wei",
      "title": "魏郡受幽滄进犯，再统军",
      "summary": "幽、沧军进犯魏郡，朱温再次任张存敬为都指挥使。",
      "year": 899,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "光化二年夏四月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p16",
          "originalRevision": 1,
          "originalSha256": "df05f523e990cbaebf4a4128eb4136cac2810a102ed72d34e66af96f3a8fb39a",
          "excerpt": "光化二年夏四月，幽、滄侵淩魏郡，復以存敬為都指揮使。"
        }
      ]
    },
    {
      "id": "zhang-cunjing-laoyadi",
      "title": "围浮阳，老鸦堤击燕军",
      "summary": "张存敬与葛从周统军围刘守文，刘仁恭来援，他在老鸦堤潜军击之，大败燕军。",
      "year": 900,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "光化三年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p16",
          "originalRevision": 1,
          "originalSha256": "df05f523e990cbaebf4a4128eb4136cac2810a102ed72d34e66af96f3a8fb39a",
          "excerpt": "三年，大舉，與葛從周連統諸軍攻浮陽，樹數十柵，圍劉守文累月。時幽州劉仁恭舉兵來援，存敬潛軍擊之於乾寧軍南老鴉堤。是日，燕人大敗，斬首五萬級，生擒馬慎交已下一百餘人，獲馬萬餘蹄。"
        }
      ],
      "variants": [
        {
          "label": "葛旧新传及梁本纪老鸦战数与指挥",
          "sourceDate": "光化三年对应役；新史未独纪年",
          "summary": "张传潜击、五万；葛旧传命张氏守寨、葛迎战、三万与马三千匹；新葛三万余；梁本纪万余。各书主将叙法和人数分别保留，不合成唯一潜击主将。",
          "evidence": [
            {
              "chapterId": "old-v016",
              "paragraphId": "old-v016-p6",
              "originalRevision": 1,
              "originalSha256": "6886fee2a4b1e57485c139990f0f6e7eba1efbbbb464680af75fd6c77a1753db",
              "excerpt": "三年四月，領軍討滄州，先攻德州，下之。及進攻浮陽，幽州劉仁恭大舉來援。時都監蔣元暉謂諸將曰：「吾王命我護軍，志在攻取，今燕帥來赴，不可外戰，當縱其入壁，聚食囷廩，力屈糧盡，必可取也。」從周對曰：「兵在機，機在上將，非督護所言也。」乃令張存敬、氏叔琮守其寨。從周逆戰於乾寧軍老鴉堤，大破燕軍，斬首三萬，獲將佐馬慎交已下百餘人，奪馬三千匹。"
            },
            {
              "chapterId": "new-v21",
              "paragraphId": "new-v21-p34",
              "originalRevision": 1,
              "originalSha256": "64ee6cb7cef6b39fe9e9c907bdef3e5f89728f97929d680bdd8310b37b9fbc52",
              "excerpt": "乃勒兵逆仁恭于乾寧，戰于老鵶堤，仁恭大敗，斬首三萬餘級，獲其將馬慎交等百餘人，馬三千匹。"
            },
            {
              "chapterId": "old-v002",
              "paragraphId": "old-v002-p3",
              "originalRevision": 1,
              "originalSha256": "c8b02a9a0e69664da94ea536a636cd138c7243c0f19f89ba087fe21361bf33bc",
              "excerpt": "三年四月，遣葛從周以兗、鄆、滑、魏之師伐滄州。五月庚寅，攻德州，拔之，梟刺史傅公和於城上。己亥，進攻浮陽。六月，燕帥劉仁恭大舉來援，從周與諸將逆戰于乾寧軍老鴉堤，大破之，殺萬餘眾，俘其將佐馬慎交已下百餘人。既而以連雨，遂班師。"
            }
          ],
          "year": 900
        }
      ]
    },
    {
      "id": "zhang-cunjing-zhenzhou",
      "title": "渡滹沱直入镇州壅门",
      "summary": "张存敬率军追逐镇州游兵，进入壅门夺取马牛驼，次日镇州纳质后回军。",
      "year": 900,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "光化三年秋九月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p16",
          "originalRevision": 1,
          "originalSha256": "df05f523e990cbaebf4a4128eb4136cac2810a102ed72d34e66af96f3a8fb39a",
          "excerpt": "其年秋九月，引軍收鎮州，存敬勒眾涉滹沲河，師人鼓行而進，逢鎮之遊兵數千，因逐之，直入鎮之壅門，收鞍馬牛駝萬計。翌日，鎮人納質而旋。"
        }
      ]
    },
    {
      "id": "zhang-cunjing-north",
      "title": "攻下瀛莫祁景，怀德驿胜中山",
      "summary": "张存敬再次攻燕，连取瀛、莫、祁、景四州；在怀德驿与中山军交战，迫中山请降。",
      "year": 900,
      "sortOrder": 4,
      "precision": "month",
      "sourceDate": "光化三年十一月，本纪明确；旧本传宋州任逾年后的叙次",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p16",
          "originalRevision": 1,
          "originalSha256": "df05f523e990cbaebf4a4128eb4136cac2810a102ed72d34e66af96f3a8fb39a",
          "excerpt": "復擁眾伐薊門，數旬間連下瀛、莫、祁、景四州，擒俘不可勝紀。自懷德驛與中山兵接戰，枕屍數十里，中山開壁請降。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p1",
          "originalRevision": 1,
          "originalSha256": "3ef9b4f63e4478b48cbd8e24b752b5d28897dbbbb1f0a5c792608b551eb15d22",
          "excerpt": "光化元年正月，帝遣葛從周統諸將略地于山東"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p3",
          "originalRevision": 1,
          "originalSha256": "c8b02a9a0e69664da94ea536a636cd138c7243c0f19f89ba087fe21361bf33bc",
          "excerpt": "三年四月，遣葛從周以兗、鄆、滑、魏之師伐滄州。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p3",
          "originalRevision": 1,
          "originalSha256": "c8b02a9a0e69664da94ea536a636cd138c7243c0f19f89ba087fe21361bf33bc",
          "excerpt": "十一月，以張存敬為上將，自甘陵發軍，北侵幽、薊，連拔瀛、莫二郡，遂移軍以攻中山。定帥王郜以精甲二萬戰於懷德亭，盡殪之。郜懼，奔於太原。遲明，大軍集於城下，郜季父處直持印鑰乞降，亦以繒帛三十萬為獻，帝即以處直代郜領其鎮焉。是月，燕人劉守光赴援中山，寨于易水之上，繼為康懷英、張存敬等所敗，斬獲甚眾。由是河朔知懼，皆弭伏焉。"
        }
      ],
