    {
      "id": "li-siben-early",
      "title": "早年事李克用，获赐姓名",
      "summary": "李嗣本本姓张，雁门人，早年任李克用帐中亲随，渐补军校；新史明确记收为养子。",
      "year": null,
      "sortOrder": 10,
      "precision": "undated",
      "sourceDate": "少事太祖，未记具体年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v052",
          "paragraphId": "old-v052-p21",
          "originalRevision": 1,
          "originalSha256": "663d19137926b0e29083a3935741ac091186cadc9e447db7be1fd0a1eb7e1c90",
          "excerpt": "李嗣本，雁門人，本姓張。父準，銅冶鎮將。嗣本少事武皇，為帳中紀綱，漸立戰功，得補軍校。"
        },
        {
          "chapterId": "new-v36",
          "paragraphId": "new-v36-p13",
          "originalRevision": 1,
          "originalSha256": "434d0ecc73b124f94613d9904385ed2256799d3a297df7a86e548fa36e61c28d",
          "excerpt": "嗣本少事太祖，太祖愛之，賜以姓名，養為子。"
        }
      ]
    },
    {
      "id": "li-siben-juyong",
      "title": "攻居庸关后任义儿军使",
      "summary": "随军讨李匡俦为先锋，取得居庸关，因功任义儿军使，获赐姓名；后来又随征王行瑜。",
      "year": null,
      "sortOrder": 11,
      "precision": "undated",
      "sourceDate": "乾宁中；旧史未在本传标各役确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v052",
          "paragraphId": "old-v052-p21",
          "originalRevision": 1,
          "originalSha256": "663d19137926b0e29083a3935741ac091186cadc9e447db7be1fd0a1eb7e1c90",
          "excerpt": "乾寧中，從征李匡儔為前鋒，與燕人戰，得居庸關，以功為義兒軍使，因賜姓名。從討王行瑜，授檢校刑部尚書，改威遠、寧塞等軍使。"
        }
      ]
