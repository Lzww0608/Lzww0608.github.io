  "personId": "former-shu-wang-chengxiu-yan",
  "events": [
    {
      "id": "former-shu-wang-chengxiu-yan-recorded-affair",
      "title": "史书记与后主有私",
      "summary": "《新五代史》和《资治通鉴》记王衍与王承休妻严氏有私，并将此列作后主执意欲赴秦州的一层原因。",
      "year": null,
      "precision": "undated",
      "sortOrder": 1,
      "sourceDate": "私通起始未独载年月；巡秦时序不作为本人出行或交往起始日",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v63",
          "paragraphId": "new-v63-p34",
          "originalRevision": 1,
          "originalSha256": "de42365053bde337e186dcc0e1a5172d2e08868c3f5cb86bfdf1aa766a77b67d",
          "excerpt": "承休以宦者得幸，為宣徽使，承休妻嚴氏，有絕色，衍通之。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p110",
          "originalRevision": 1,
          "originalSha256": "175556dc3f169fee51206fcae73a24eaef7be18b49b5ac48e1dd0f65d771a586",
          "excerpt": "王承休妻嚴氏美，蜀主私焉，故銳意欲行。"
        },
        {
          "chapterId": "new-v63",
          "paragraphId": "new-v63-p34",
          "originalRevision": 1,
          "originalSha256": "de42365053bde337e186dcc0e1a5172d2e08868c3f5cb86bfdf1aa766a77b67d",
          "excerpt": "以王承休妻嚴氏故，十月，幸秦州，羣臣切諫，衍不聽。"
        }
      ],
      "notes": [
        "两书婚家称谓和具体交往记载共同支持本条，未补本名、后妃封号或生卒。",
        "新史同段跨任官、李严出使与亡蜀等多项记事，不能把开头六年或后文十月统用于私通起始。",
        "后主赴秦是王衍的行动，未据此写严氏本人到秦、随行或入宫。",
        "丈夫及其同行者遇诛的记载不包含严氏，不据此补她死亡或子女。",
        "保留史书的因果叙述归属，不作独立目击复证。"
      ]
    }
  ]
}
