  "events": [
    {
      "id": "li-hanzhi-lose-heyang",
      "title": "张言袭河阳，李罕之归河东",
      "summary": "兵出平阳时张言夜袭河阳，全族被俘，李罕之逃太原，李克用表为泽州刺史、仍领河阳节度。",
      "year": 888,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "文德元年春",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v015",
          "paragraphId": "old-v015-p9",
          "originalRevision": 1,
          "originalSha256": "829bfc52ec26f82e2f379e808c0715894a112184268b248c0d3881d975b62d78",
          "excerpt": "文德元年春，會罕之盡出其眾攻平陽，言夜出師掩擊河陽，罕之無備，單步僅免，舉族為言所俘。"
        }
      ]
    },
    {
      "id": "li-hanzhi-heyang-aid-failed",
      "title": "河东援怀孟，因军变撤退",
      "summary": "李克用派李存孝助攻怀孟，梁军来救，安休休离军后晋军退，李罕之守泽州。",
      "year": 888,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "文德元年三月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v015",
          "paragraphId": "old-v015-p9",
          "originalRevision": 1,
          "originalSha256": "829bfc52ec26f82e2f379e808c0715894a112184268b248c0d3881d975b62d78",
          "excerpt": "三月，克用遣其將李存孝率師三萬助之，來攻懷、孟。"
        }
      ],
      "notes": [
        "安休休去向旧史本段说奔蔡，旧55说叛入汴，新史说被执，异说另留。"
      ],
      "variants": [
        {
          "label": "旧史康君立传援河阳",
          "year": 888,
          "sourceDate": "文德初、三月",
          "summary": "康君立为南面招讨使、李存孝副之，率二万；安休休临阵叛入汴，君立退，与罕之传存孝三万及安奔蔡有别。",
          "evidence": [
            {
              "chapterId": "old-v055",
              "paragraphId": "old-v055-p2",
              "originalRevision": 1,
              "originalSha256": "14283d678548b78007ca8aa97adcc11f4e1a330717da925223cad55a5180db44",
              "excerpt": "文德初，李罕之既失河陽，來歸於武皇，且求援焉，乃以君立充南面招討使，李存孝副之，帥師二萬，助罕之攻取河陽。三月，與汴將丁會、牛存節戰於沇河。臨陣之次，騎將安休休叛入汴軍，君立引退。"
            }
          ]
        },
        {
          "label": "新史存孝传兵数与安休休结局",
          "year": 888,
          "sourceDate": "文德元年",
          "summary": "新史记存孝、薛阿檀、安休休七千援军，在温县受梁军断太行，存孝大败、安休休被执，不并成一个确定兵数或去向。",
          "evidence": [
            {
              "chapterId": "new-v36",
              "paragraphId": "new-v36-p20",
              "originalRevision": 1,
              "originalSha256": "0762a33c7079ca57be7c47878a8373ca4d2fe3b450a79d8da17d084bb3976d37",
              "excerpt": "文德元年，河南張言襲破河陽，李罕之來歸晉，晉處罕之于澤州，遣存孝與薛阿檀、安休休等以兵七千助罕之還擊河陽。梁亦遣丁會、牛存節等助言。戰于溫縣，梁軍先扼太行，存孝大敗，安休休被執。"
            }
          ]
        }
      ]
    },
    {
