  "personId": "kang-junli",
  "events": [
    {
      "id": "kang-junli-dingzhou-relief",
      "year": 885,
      "title": "奉命率军赴定州援王处存",
      "summary": "李可举、王景崇联兵攻定州，王处存求援，李克用派康君立与安老、薛可、郭啜率兵赴援。随后五月亲领援军的是李克用，不把其斩获全归康君立。",
      "sourceDate": "光启元年三月",
      "evidence": [
        {
          "chapterId": "old-v025",
          "paragraphId": "old-v025-p16",
          "originalRevision": 1,
          "originalSha256": "473cf1e5490746fcb632c9c1b291a5bb78d98e1a2ee9ac89cadf5df210c95ca6",
          "excerpt": "光啟元年三月，幽州李可舉、鎮州王景崇連兵寇定州，節度使王處存求援於武皇；武皇遣大將康君立、安老、薛可、郭啜率兵赴之。"
        }
      ],
      "sortOrder": 1,
      "phase": "service",
      "precision": "month"
    },
    {
      "id": "kang-junli-heyang",
      "title": "援李罕之攻河阳，沇河败退",
      "summary": "康君立任南面招讨使，李存孝为副，援李罕之攻河阳；三月与丁会、牛存节交战，安休休转入汴军后退兵，八月任汾州刺史。",
      "year": 888,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "文德元年三月、八月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p2",
          "originalRevision": 1,
          "originalSha256": "14283d678548b78007ca8aa97adcc11f4e1a330717da925223cad55a5180db44",
          "excerpt": "文德初，李罕之既失河陽，來歸於武皇，且求援焉，乃以君立充南面招討使，李存孝副之，帥師二萬，助罕之攻取河陽。三月，與汴將丁會、牛存節戰於沇河。臨陣之次，騎將安休休叛入汴軍，君立引退。八月，授汾州刺史。"
        }
      ]
    },
    {
      "id": "kang-junli-zhaoyi",
      "title": "平潞州之乱，领昭义节度使",
      "summary": "潞州军将安居受作乱，康君立奉命讨平，任昭义节度使，此后以泽、潞军策应邢、洺战事。",
      "year": 890,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "大顺元年五月起潞州军乱、九月授节度（据武皇纪）",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p2",
          "originalRevision": 1,
          "originalSha256": "14283d678548b78007ca8aa97adcc11f4e1a330717da925223cad55a5180db44",
          "excerpt": "大順元年，潞州小校安居受反，武皇遣君立討平之，授檢校左僕射、昭義節度使。自武皇之師連歲略地於邢、洺，攻孟方立，君立常率澤潞之師以為掎角。"
        },
        {
          "chapterId": "old-v025",
          "paragraphId": "old-v025-p22",
          "originalRevision": 1,
          "originalSha256": "760f0b4b9c3b8dad25f77994aac3503f82b59f98c8df0f729ef2bf0a4cd287b8",
          "excerpt": "大順元年，遣李存孝攻邢州，孟遷以邢、洺、磁三州降，執汴將王虔裕三百人以獻。武皇徙孟遷於太原，以安金俊為邢洺團練使。"
        },
        {
          "chapterId": "old-v025",
          "paragraphId": "old-v025-p23",
          "originalRevision": 1,
          "originalSha256": "48f0e88125b39dabf8ae23058fd1277f5ef3533bae9e6b799760b5d01a697f16",
          "excerpt": "五月，潞州軍亂，殺節度使李克恭，州人推牙將安居受為留後，南結汴將。時潞之小將馮霸擁叛徒三千騎駐於沁水，居受使人召之，馮霸不至。居受懼，出奔至長子，為村胥所殺，傳首於霸；霸遂入潞州，自為留後。武皇遣大將康君立、李存孝等攻之，汴將朱崇節、葛從周率兵入潞州以固之。"
        },
        {
          "chapterId": "old-v025",
          "paragraphId": "old-v025-p25",
          "originalRevision": 1,
          "originalSha256": "68028190c4287dd2fcd25998e55cc284b97ccda43e5ec48e9063fe892103c9cb",
          "excerpt": "九月，汴將葛從周棄潞州而遁，武皇以康君立為潞州節度使，以李存孝為汾州刺史。"
        }
      ]
    },
    {
      "id": "kang-junli-death",
      "title": "宴饮中忤李克用，被赐毒酒",
      "summary": "李存孝死后李克用深惜其才，宴饮谈及此事时康君立言语触怒李克用，遭赐毒酒而死，终年四十八。",
      "year": 894,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "乾宁初、九月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p3",
          "originalRevision": 1,
          "originalSha256": "66e5bb15e62fb76adbdc33e9337ece45a456fc375fb7466b26299f5b0023474c",
          "excerpt": "九月，君立至太原，武皇會諸將酒博，因語及存孝事，流涕不已。時君立以一言忤旨，武皇賜鴆而殂，時年四十八。"
        },
        {
          "chapterId": "new-v36",
          "paragraphId": "new-v36-p23",
          "originalRevision": 1,
          "originalSha256": "287f335f65aaaf90077678f8899cb643c11b7952e94d240832cc6a08aecce37c",
          "excerpt": "存孝已死，太祖與諸將博，語及存孝，流涕不已，君立以為不然，太祖怒，酖殺君立。"
        },
        {
          "chapterId": "old-v026",
          "paragraphId": "old-v026-p4",
          "originalRevision": 1,
          "originalSha256": "1f1007e2c1f1706c8cda4a62c8dd896fb210dab217391869d4bc1793b14d920b",
          "excerpt": "乾寧元年三月，邢州李存孝出城首罪，縶歸太原，轘於市。邢、洺、磁三州平。武皇表馬師素為邢州節度使。"
        },
        {
          "chapterId": "old-v026",
          "paragraphId": "old-v026-p5",
          "originalRevision": 1,
          "originalSha256": "662cfe6c397975d7c59672a94a49d05d113e1ec0d3a575d37602f7a1ee7407bb",
          "excerpt": "九月，潞州節度使康君立以鴆死。"
        }
      ]
    },
    {
      "id": "kang-junli-honor",
      "title": "明宗追赠太傅",
      "summary": "李嗣源即皇帝位后，因念旧诏赠康君立太傅。",
      "year": 926,
      "sortOrder": 5,
      "precision": "year",
      "sourceDate": "明宗即位后，未记具体月日",
      "phase": "posthumous",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p3",
          "originalRevision": 1,
          "originalSha256": "66e5bb15e62fb76adbdc33e9337ece45a456fc375fb7466b26299f5b0023474c",
          "excerpt": "明宗即位，以念舊之故，詔贈太傅。"
        }
      ]
    },
    {
      "id": "kang-junli-xingzhou",
      "title": "奉命讨李存孝",
      "summary": "李存孝据邢州叛，康君立奉李克用命讨伐，因功加检校太保；李存孝败后回师。",
      "year": null,
      "sortOrder": 6,
      "precision": "range",
      "sourceDate": "景福二年；乾宁初平定后回师",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p3",
          "originalRevision": 1,
          "originalSha256": "66e5bb15e62fb76adbdc33e9337ece45a456fc375fb7466b26299f5b0023474c",
          "excerpt": "二年，李存孝據邢州叛，武皇命君立討之，以功加檢校太保。乾寧初，存孝平，班師。"
        }
      ],
      "notes": [
        "原传记景福二年起讨，乾宁初平定后回师；景福二年跨西历893—894年，后事仍按原书先后保留。"
      ],
      "yearRange": {
        "start": 893,
        "end": 894
      }
    },
    {
      "id": "kang-junli-yunzhou",
      "title": "参与云州起事，推李克用为主",
      "summary": "代北军饥饷减，康君立与同僚谋逐段文楚，拥李克用入云州，推为大同防御留后；朝廷随后征兵讨伐。",
      "year": null,
      "sortOrder": 7,
      "precision": "undated",
      "sourceDate": "乾符中，本传未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p1",
          "originalRevision": 1,
          "originalSha256": "ca4dee94435e9e7ab753d0e634fe612334295dbe9903c126af16170ffc42068b",
          "excerpt": "」君立等乃夜謁武皇言曰：「方今天下大亂，天子付將臣以邊事，歲偶饑荒，便削儲給，我等邊人，焉能守死！公家父子，素以威惠及五部，當共除虐帥，以謝邊人，孰敢異議者！」武皇曰：「明天子在上，舉事當有朝典，公等勿輕議。予家尊遠在振武，萬一相迫，俟予稟命。」君立等曰：「事機已泄，遲則變生，曷俟千里谘稟！」眾因聚噪，擁武皇。比及雲州，眾且萬人，師營鬥雞台，城中械文楚以應武皇之軍。既收城，推武皇為大同軍防禦留後。眾狀以聞，朝廷不悅，詔征兵來討。"
        }
      ],
      "notes": [
        "本传只记乾符中，不将其他本纪有分歧的具体年反推成本传无疑日期。"
      ]
    },
    {
      "id": "kang-junli-military",
      "title": "从征代北，入关收复长安",
      "summary": "康君立随李克用抵御李可举之师；李国昌进入达靼后守感义军，后任左都押牙，随入关驱黄巢，回太原任先锋军使。",
      "year": null,
      "sortOrder": 8,
      "precision": "undated",
      "sourceDate": "云州失守至入关，未记本传确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p1",
          "originalRevision": 1,
          "originalSha256": "ca4dee94435e9e7ab753d0e634fe612334295dbe9903c126af16170ffc42068b",
          "excerpt": "俄而獻祖失振武，武皇失雲州。朝廷命招討使李鈞、幽州李可舉加兵於武皇，攻武皇於蔚州。君立從擊可舉之師屢捷，及獻祖入達靼，君立保感義軍，武皇授雁門節度，以君立為左都押牙，從入關，逐黃孽，收長安。武皇還鎮太原，授檢校工部尚書、先鋒軍使，"
        }
      ]
    }
  ]
}
