  "events": [
    {
      "id": "xu-huaiyu-qingkou",
      "title": "清口败后保全本军",
      "summary": "庞师古清口败，徐怀玉保全本军撤退，新史还记他沿途收散卒万余。",
      "year": 897,
      "sortOrder": 0,
      "precision": "year",
      "sourceDate": "乾宁四年，庞师古同役十一月锁897；徐完军返未独日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
          "originalRevision": 1,
          "originalSha256": "e2b2ccf36fbe628e79d5526cc1fdf9f214e3f5a8c770b55063209bb430831da2",
          "excerpt": "乾寧四年，龐師古失利於清口，懷玉獨完軍以退。"
        },
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p42",
          "originalRevision": 1,
          "originalSha256": "6d185ad9c7fee4c8bb59fd3897668fefed2ea0327fedd2ba20da1dcb673a317c",
          "excerpt": "又從龐師古攻楊行密，師古敗清口，懷玉獨完一軍，行收散卒萬餘人以歸。"
        },
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p2",
          "originalRevision": 1,
          "originalSha256": "38e95f58720e1f7f6427d4c16c7920ee5ef9611ff9e3a5515bd32c68cc9df6a3",
          "excerpt": "乾寧四年八月，與葛從周分統大軍，渡淮以伐楊行密。十一月，師古寨於清口，寨地卑下，〈（《玉堂閑話》云：龐從會軍五萬於清口，所屯之地，蓋兵書謂之絕地，人不駕肩，行一舍方至夷坦之處。）〉或請遷移，弗聽。俄有告淮人決上流者，曰：「水至矣。」師古怒其惑眾，斬之。〈（《九國誌·侯讚傳》：時兵起倉卒，加以陰寒，士皆飲冰餐雪而行。甫及梁營，則豎戈植足，鬥志未決。朱瑾與瓚率五十騎潛濟淮，入自壘北，舞槊而馳，囂聲雷沸，梁兵皆殞眩不能舉，遂斬龐從，大將繼之，死者大半。）〉須臾，我軍在淖中，莫能戰，而吳人襲焉，故及於敗，師古沒於陣。"
        }
      ]
    },
    {
      "id": "xu-huaiyu-jinzhou",
      "title": "镇晋州，拒攻洪洞",
      "summary": "开平二年徐怀玉任晋州刺史，选亲兵将登城晋军逐下，又在洪洞击晋军，出私财赏军。",
      "year": 908,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "开平二年秋",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
          "originalRevision": 1,
          "originalSha256": "e2b2ccf36fbe628e79d5526cc1fdf9f214e3f5a8c770b55063209bb430831da2",
          "excerpt": "開平元年，授曹州刺史，加檢校司徒。明年，除晉州刺史。其秋，晉軍大至，已乘其墉，懷玉選親兵五十餘人，擁殺下城。晉軍既退，出家財以賞戰士。歲中，晉軍又至，懷玉領兵敗之於洪洞。"
        }
      ]
    },
    {
      "id": "xu-huaiyu-death",
      "title": "被朱友谦捕获，后遭杀害",
      "summary": "朱友珪即位后朱友谦拒梁，派兵袭鄜州，徐怀玉被俘；康怀英围河中时，朱友谦担忧内变，杀害他。",
      "year": 912,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "乾化二年，友珪篡立后、康怀英围河中时害徐；康本传同役乾化二年秋白径败为事件界，锁912",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
          "originalRevision": 1,
          "originalSha256": "e2b2ccf36fbe628e79d5526cc1fdf9f214e3f5a8c770b55063209bb430831da2",
          "excerpt": "乾化二年，庶人友珪既篡立，河中朱友謙拒命，遣兵襲鄜州，懷玉無備，尋為河中所擄，囚於公館。及友珪遣康懷英率師圍河中，友謙慮懷玉有變，遂害之。"
        },
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p43",
          "originalRevision": 1,
          "originalSha256": "f290c2d6c03a36edccb9df97d9d861d83de09a287786f1376798f147ccf90b76",
          "excerpt": "太祖崩，友珪自立，朱友謙附于晉，以襲鄜州，執懷玉殺之。"
        },
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p21",
          "originalRevision": 1,
          "originalSha256": "3a86faa63844a98e0b52cd509ab56272b35fd04ccfc76f353532d3bdaefc72f0",
          "excerpt": "乾化二年秋，命為河中行營都招討使，與晉軍戰於白徑嶺，敗歸於陝。"
        }
      ]
    },
    {
      "id": "xu-huaiyu-early",
      "title": "从朱温起兵，轻骑连破蔡军",
      "summary": "徐怀玉原名徐琮，随朱温至汴，光启初以轻骑连破金堤蔡军，升亲从副将及长剑都虞候。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "中和末至光启初，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
          "originalRevision": 1,
          "originalSha256": "e2b2ccf36fbe628e79d5526cc1fdf9f214e3f5a8c770b55063209bb430831da2",
          "excerpt": "徐懷玉，本名琮，亳州焦夷縣人。少以雄傑自任，隨太祖起軍。唐中和末，從至大梁。光啟初，蔡寇屯金堤驛，懷玉將輕騎連破之，由是累遷親從副將，改左長劍都虞候。又從破蔡賊於板橋，收秦宗權八寨，奏加檢校右散騎常侍。"
        },
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p40",
          "originalRevision": 1,
          "originalSha256": "92af99ca8405038cad2681f3eefb9c53eff6b95c4b9d3f87825eacb546c23fa1",
          "excerpt": "徐懷玉，亳州焦夷人也。少事梁太祖，與太祖俱起微賤。懷玉為將，以雄豪自任，而勇於戰陣。從太祖鎮宣武，為永城鎮將。"
        }
      ]
    },
    {
      "id": "xu-huaiyu-xusu-campaigns",
      "title": "参与徐宿军役、黎阳败魏",
      "summary": "徐怀玉随军参与徐州宿州诸战，又跟朱温攻魏，在黎阳败魏军；这一组未独纪年月，不全部挂在888河阳之围。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "文德初河阳战后及攻魏的接续，未独役年",
