  "events": [
    {
      "id": "xu-huaiyu-qingkou",
      "title": "清口败后保全本军",
      "summary": "庞师古清口败，徐怀玉保全本军撤退，新史还记他沿途收散卒万余。",
      "year": 897,
      "sortOrder": 0,
      "precision": "year",
      "sourceDate": "乾宁四年；庞师古传将清口同役系于十一月，徐怀玉保军返回未独记日期。",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
          "originalRevision": 1,
          "originalSha256": "e2b2ccf36fbe628e79d5526cc1fdf9f214e3f5a8c770b55063209bb430831da2",
          "excerpt": "乾寧四年，龐師古失利於清口，懷玉獨完軍以退。"
        },
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p42",
          "originalRevision": 1,
          "originalSha256": "6d185ad9c7fee4c8bb59fd3897668fefed2ea0327fedd2ba20da1dcb673a317c",
          "excerpt": "又從龐師古攻楊行密，師古敗清口，懷玉獨完一軍，行收散卒萬餘人以歸。"
        },
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p2",
          "originalRevision": 1,
          "originalSha256": "38e95f58720e1f7f6427d4c16c7920ee5ef9611ff9e3a5515bd32c68cc9df6a3",
          "excerpt": "乾寧四年八月，與葛從周分統大軍，渡淮以伐楊行密。十一月，師古寨於清口，寨地卑下，〈（《玉堂閑話》云：龐從會軍五萬於清口，所屯之地，蓋兵書謂之絕地，人不駕肩，行一舍方至夷坦之處。）〉或請遷移，弗聽。俄有告淮人決上流者，曰：「水至矣。」師古怒其惑眾，斬之。〈（《九國誌·侯讚傳》：時兵起倉卒，加以陰寒，士皆飲冰餐雪而行。甫及梁營，則豎戈植足，鬥志未決。朱瑾與瓚率五十騎潛濟淮，入自壘北，舞槊而馳，囂聲雷沸，梁兵皆殞眩不能舉，遂斬龐從，大將繼之，死者大半。）〉須臾，我軍在淖中，莫能戰，而吳人襲焉，故及於敗，師古沒於陣。"
        }
      ],
      "notes": [
        "本页西历年份沿历史历制，1582年前采用儒略历；史书记年照录，不能核准单一西历年时保留来源支持的范围。"
      ]
    },
    {
      "id": "xu-huaiyu-jinzhou",
      "title": "镇晋州，登城退敌",
      "summary": "开平二年任晋州刺史。其秋晋军登城，徐怀玉选出五十余亲兵将其逐下；晋军退后，他出家财奖赏战士。",
      "year": 908,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "开平二年，其秋登城反击；通鉴同年九月记晋州拒攻。本条908据秋役，退敌后赏军未独记日。洪洞另列有据年代范围。",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
          "originalRevision": 1,
          "originalSha256": "e2b2ccf36fbe628e79d5526cc1fdf9f214e3f5a8c770b55063209bb430831da2",
          "excerpt": "開平元年，授曹州刺史，加檢校司徒。明年，除晉州刺史。其秋，晉軍大至，已乘其墉，懷玉選親兵五十餘人，擁殺下城。晉軍既退，出家財以賞戰士。"
        }
      ],
      "variants": [
        {
          "label": "通鉴同年晋州围攻记载",
          "sourceDate": "开平二年，承九月叙次；西历908年。",
          "summary": "周德威、李嗣昭率三万人攻晋州，徐怀玉拒守；梁主亲自率军来援，周等闻讯退至隰州。",
          "notes": [
            "三万人是来攻晋军数。丁丑、乙酉为梁主行程，乙未为周等撤退之日，不据此给徐守城、登城反击或洪洞之战补确日，也不强定两书每次进退完全对应。"
          ],
          "evidence": [
            {
              "chapterId": "tongjian-v267",
              "paragraphId": "tongjian-v267-p7",
              "originalRevision": 1,
              "originalSha256": "b37a22ddd64fa4173888ded4b1931c57cea2957f3362eef264110ba097bb3de2",
              "excerpt": "晉周德威、李嗣昭將兵三萬出陰地關，攻晉州，刺史徐懷玉拒守。帝自將救之，丁丑，發大梁，乙酉，至陝州。"
            },
            {
              "chapterId": "tongjian-v267",
              "paragraphId": "tongjian-v267-p7",
              "originalRevision": 1,
              "originalSha256": "b37a22ddd64fa4173888ded4b1931c57cea2957f3362eef264110ba097bb3de2",
              "excerpt": "周德威等聞帝將至，乙未，退保隰州。"
            }
          ]
        }
      ],
      "notes": [
        "旧传把登城反击与晋军退后出家财赏军连叙；此处保留两项事迹，不给赏军补具体日期。另记的洪洞一役未独月，另条保存开平二年所跨908—909年范围，不以本条908年概括它。"
      ]
    },
    {
      "id": "xu-huaiyu-death",
      "title": "被朱友谦捕获，后遭杀害",
      "summary": "朱友珪即位后朱友谦拒梁，派兵袭鄜州，徐怀玉被俘；康怀英围河中时，朱友谦担忧内变，杀害他。",
      "year": 912,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "乾化二年，友珪篡立后、康怀英围河中时；康本传同役系于当年秋，保西历912，徐遇害未独记日。",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
          "originalRevision": 1,
          "originalSha256": "e2b2ccf36fbe628e79d5526cc1fdf9f214e3f5a8c770b55063209bb430831da2",
          "excerpt": "乾化二年，庶人友珪既篡立，河中朱友謙拒命，遣兵襲鄜州，懷玉無備，尋為河中所擄，囚於公館。及友珪遣康懷英率師圍河中，友謙慮懷玉有變，遂害之。"
        },
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p43",
          "originalRevision": 1,
          "originalSha256": "f290c2d6c03a36edccb9df97d9d861d83de09a287786f1376798f147ccf90b76",
          "excerpt": "太祖崩，友珪自立，朱友謙附于晉，以襲鄜州，執懷玉殺之。"
        },
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p21",
          "originalRevision": 1,
          "originalSha256": "3a86faa63844a98e0b52cd509ab56272b35fd04ccfc76f353532d3bdaefc72f0",
          "excerpt": "乾化二年秋，命為河中行營都招討使，與晉軍戰於白徑嶺，敗歸於陝。"
        }
      ],
      "notes": [
        "友谦虑怀玉有变是加害者的忧惧，不表示徐已发动变乱；旧传先俘囚后被害，新传压缩作执杀，不写阵亡或友谦亲手杀害。"
      ]
    },
    {
      "id": "xu-huaiyu-early",
      "title": "从朱温起兵，轻骑连破蔡军",
      "summary": "徐怀玉本名琮，少随朱温起军，中和末随至大梁。光启初以轻骑连破蔡军营，累迁亲从副将、左长剑都虞候；新史记此类破营俘杀五千余人。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "中和末至光启初；从军、至大梁和各次破营未独记年月。",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
          "originalRevision": 1,
          "originalSha256": "e2b2ccf36fbe628e79d5526cc1fdf9f214e3f5a8c770b55063209bb430831da2",
          "excerpt": "徐懷玉，本名琮，亳州焦夷縣人。少以雄傑自任，隨太祖起軍。唐中和末，從至大梁。光啟初，蔡寇屯金堤驛，懷玉將輕騎連破之，由是累遷親從副將，改左長劍都虞候。"
        },
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p40",
          "originalRevision": 1,
          "originalSha256": "92af99ca8405038cad2681f3eefb9c53eff6b95c4b9d3f87825eacb546c23fa1",
          "excerpt": "徐懷玉，亳州焦夷人也。少事梁太祖，與太祖俱起微賤。懷玉為將，以雄豪自任，而勇於戰陣。"
        },
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p41",
          "originalRevision": 1,
          "originalSha256": "7f95ede668640a45d17533ee9028084330a378b41805c9f3796668236c24cd23",
          "excerpt": "秦宗權攻梁，壁金隄、靈昌、酸棗，懷玉以輕騎連擊破之，俘殺五千餘人，遷左長劍都虞候。"
        }
      ],
      "notes": [
        "新史的五千余为军队俘虏、杀敌合计，不是徐怀玉个人亲杀人数；旧史未记这一数字。"
      ]
    },
    {
      "id": "xu-huaiyu-yongcheng-town-command",
      "title": "随镇宣武，任永城镇将",
      "summary": "新史记徐怀玉随朱温镇宣武，任永城镇将；旧传未单独列这一军职。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "新史列在少事朱温之后，未独记授任年月。",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p40",
          "originalRevision": 1,
          "originalSha256": "92af99ca8405038cad2681f3eefb9c53eff6b95c4b9d3f87825eacb546c23fa1",
          "excerpt": "從太祖鎮宣武，為永城鎮將。"
        }
      ]
    },
    {
      "id": "xu-huaiyu-banqiao-stockades",
      "title": "随军破蔡，拔八处营寨",
      "summary": "旧史记随军在板桥破蔡军、收秦宗权八寨，并奏加检校右散骑常侍；新史另列赤冈，称拔八栅。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "旧传承光启初破营后接叙，板桥等役未独记年月。",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
          "originalRevision": 1,
          "originalSha256": "e2b2ccf36fbe628e79d5526cc1fdf9f214e3f5a8c770b55063209bb430831da2",
          "excerpt": "又從破蔡賊於板橋，收秦宗權八寨，奏加檢校右散騎常侍。"
        },
        {
          "chapterId": "new-v22",
          "paragraphId": "new-v22-p41",
          "originalRevision": 1,
          "originalSha256": "7f95ede668640a45d17533ee9028084330a378b41805c9f3796668236c24cd23",
          "excerpt": "又破宗權於板橋、赤岡，拔其八柵。"
        }
      ],
      "notes": [
        "八寨与八栅按两书口径保存，不累加为十六处，也不将诸军共同战功改为徐一人独占。"
      ]
    },
    {
