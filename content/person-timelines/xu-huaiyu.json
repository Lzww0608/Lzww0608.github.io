    {
      "id": "xu-huaiyu-qilu",
      "title": "镇沂州，拒王师范攻东境",
      "summary": "徐怀玉光化初转滑州军职、任沂州，修兵营壁；王师范叛后，多次率州兵击败东境来敌，后转齐防御另见904条。",
      "year": null,
      "sortOrder": 10,
      "precision": "undated",
      "sourceDate": "光化初任职至王师范叛时的接叙；各次转任、修备和击退来敌未独记年月。",
      "phase": "uncertain",
      "evidence": [
