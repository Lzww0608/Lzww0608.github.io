    {
      "id": "xu-huaiyu-rename",
      "title": "获赐名怀玉，在金乡败朱瑾",
      "summary": "徐琮获朱温赐名怀玉，乾宁间在金乡南败朱瑾、擒宗江，获检校右仆射等官。",
      "year": null,
      "sortOrder": 6,
      "precision": "undated",
      "sourceDate": "乾宁中，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p10",
