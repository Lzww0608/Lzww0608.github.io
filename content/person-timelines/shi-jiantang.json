  "events": [
    {
      "id": "shi-jiantang-baixiang",
      "title": "柏乡冲阵，升检校左仆射",
      "summary": "作为先锋出井陉，与周德威分别攻击梁军左右部，晚间追击入柏乡，因功加检校左仆射。",
      "year": 911,
      "sortOrder": 1,
      "precision": "day",
      "sourceDate": "柏乡之战，天祐八年正月二日（周德威传同役）",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "new-v25",
          "paragraphId": "new-v25-p25",
          "originalRevision": 1,
          "originalSha256": "43d75ccedafba455d1218a7f48d1dfc0f684ac4d3ed34deaed43114b4b22b2ec",
          "excerpt": "周德威擊其左，建瑭擊其右，梁軍皆走，遂大敗之。以功加檢校左僕射。"
        },
        {
          "chapterId": "old-v056",
          "paragraphId": "old-v056-p7",
          "originalRevision": 1,
          "originalSha256": "7a6428b761cf83c37ec022e0f5f700e2a952b79061f6b8e2664b1d0a1912cabf",
          "excerpt": "八年正月二日，德威率騎軍致師於柏鄉，"
        }
      ]
    },
    {
      "id": "shi-jiantang-rao-ying",
      "title": "蓨县伪装袭营迫梁军退",
      "summary": "与符存审守赵，分骑兵袭扰梁军樵采，伪装梁兵突袭营门、纵火，使朱温军夜间撤退。",
      "year": 912,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "天祐九年；庄宗纪同役三月蓨县袭梁营",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "new-v25",
          "paragraphId": "new-v25-p26",
          "originalRevision": 1,
          "originalSha256": "e15ad44c8d6c6bcf5e394acd2c3b2fad7a2250f9d1f704f9ccc4ca450a0d7870",
          "excerpt": "天祐九年，晉攻燕，燕王劉守光乞師于梁，梁太祖自將擊趙，圍棗彊、蓨縣。是時晉精兵皆北攻燕，獨符存審與建瑭以三千騎屯趙州。梁軍已破棗彊，存審扼下博橋。建瑭分其麾下五百騎為五隊：一之衡水，一之南宮，一之信都，一之阜城，而自將其一，約各取梁芻牧者十人會下博。至暮，擒梁兵數十，皆殺之，各留其一人，縱使逸去，告之曰：「晉王軍且大至。」明日，建瑭率百騎為梁旗幟，雜其芻牧者，暮叩梁營，殺其守門卒，縱火大呼，斬擊數十百人。而梁芻牧者所出，各遇晉兵，有所亡失，其縱而不殺者，歸而皆言晉軍且至。梁太祖夜拔營去，蓨縣人追擊之，梁軍棄其輜重鎧甲不可勝計。梁太祖方病，由是增劇。而晉軍以故得并力以收燕者，二人之力也。"
        },
        {
          "chapterId": "old-v028",
          "paragraphId": "old-v028-p3",
          "originalRevision": 1,
          "originalSha256": "f9422791518f0b9916f40ae367d59bb9df85d27bafe74b9c71f9031376729a3d",
          "excerpt": "三月壬午，梁祖自督軍攻棗強。"
        },
        {
          "chapterId": "old-v028",
          "paragraphId": "old-v028-p3",
          "originalRevision": 1,
          "originalSha256": "f9422791518f0b9916f40ae367d59bb9df85d27bafe74b9c71f9031376729a3d",
          "excerpt": "建瑭與李都督各領百餘騎，旗幟軍號類梁軍，與芻牧者雜行，暮及賀德倫營門，殺守門者，縱火大呼，俘斬而旋。"
        }
      ],
      "notes": [
        "旧史与新史对分队骑兵数量和同袭将领的记载分别见原文，不据此推造统一兵数。"
      ],
      "variants": [
        {
          "label": "《旧史》的分队兵数及同袭将领",
          "sourceDate": "天祐九年",
          "year": 912,
          "summary": "旧史记先选精骑八百趋信都，建瑭与李嗣肱分道擒生；建瑭再分麾下三百骑为五军，随后与嗣肱共同伪装梁军袭贺德伦营。新史记建瑭麾下五百骑分五队，翌日率百骑袭营；不把不同环节、不同史书兵数合为一数。",
          "evidence": [
            {
              "chapterId": "old-v055",
              "paragraphId": "old-v055-p7",
              "originalRevision": 1,
              "originalSha256": "e4c088788d2024c5d879a22e3e1430c67549974ba3351368376b18749be17d44",
              "excerpt": "九年，梁祖親攻蓚縣。時王師並攻幽州，聲言汴軍五十萬，將寇鎮、定。都將符存審謂建瑭曰：「梁軍倘以五十萬來，我等何以待之？」裨將趙行實曰：「走入土門為上策。 」存審曰：「事未可知，但老賊在東，別將西來，尚可徐圖。」不旬日，楊師厚圍棗強，賀德倫圍蓚縣，梁祖自至，攻城甚急。存審曰：「吾王方事北面，南鄙之事，付我等數人。今西道無兵，坐滋賊勢。何以為謀。老賊若不下蓚、阜，必西攻深、冀，與公等料閱騎軍，偵視賊勢。」乃選精騎八百趨信都，存審扼下博橋，建瑭與李嗣肱分道擒生。建瑭乃分麾下三百騎為五軍，自將一軍深入，各命俘掠梁軍之芻牧者還，會下博橋。翌日，諸軍皆至，獲芻牧者數百人，聚而殺之，緩數十人，令其逸去，各曰：「沙陀軍大至矣！」梁軍震恐。明日，建瑭、嗣肱為梁軍服色，與芻牧者相雜，晡晚，及賀德倫寨門，殺守門者，縱火大噪，俘斬而去。是夜，梁祖燒營而遁，比至貝州，迷失道咯，委棄兵仗，不可勝計。"
            }
          ]
        }
      ]
    },
    {
      "id": "shi-jiantang-wei-garrison",
      "title": "魏博归晋后前军屯魏县",
      "summary": "魏博归附晋国后，与符存审率前军驻扎魏县。",
      "year": 915,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "天祐十二年魏博归晋；庄宗纪三月叙同役前军至魏县",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p8",
          "originalRevision": 1,
          "originalSha256": "16266b9ede20fb46abe2b4190675fa37664e8db1f770256e7905dc0eaacf7554",
          "excerpt": "十二年，魏博歸款，建瑭與符存審前軍屯魏縣。"
        },
        {
          "chapterId": "old-v028",
          "paragraphId": "old-v028-p17",
          "originalRevision": 1,
          "originalSha256": "517c52273a74a7c4a68a1dec87ffe0b04d8c2edc1604a69e69273c8bf1e42e2b",
          "excerpt": "天祐十二年三月，梁魏博節度使賀德倫遣使奉幣乞盟。"
        },
        {
          "chapterId": "old-v028",
          "paragraphId": "old-v028-p17",
          "originalRevision": 1,
          "originalSha256": "517c52273a74a7c4a68a1dec87ffe0b04d8c2edc1604a69e69273c8bf1e42e2b",
          "excerpt": "梁將鄩聞帝至，以精兵萬人自洹水趣魏縣，帝命李存審帥師禦之，帝率親軍於魏縣西北，夾河為柵。"
        }
      ]
    },
    {
      "id": "shi-jiantang-yuancheng",
      "title": "元城败刘鄩，任澶州刺史",
      "summary": "在元城击败刘鄩，收取澶州，授澶州刺史、检校司空和外衙骑军都将，此后历贝、相州。",
      "year": 916,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "天祐十三年；庄宗纪同役三月元城败刘鄩，任澶州未另记日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p8",
          "originalRevision": 1,
          "originalSha256": "16266b9ede20fb46abe2b4190675fa37664e8db1f770256e7905dc0eaacf7554",
          "excerpt": "十三年，敗劉鄩於元城，收澶州，以建瑭為刺史、檢校司空、外衙騎軍都將。"
        },
        {
          "chapterId": "old-v028",
          "paragraphId": "old-v028-p22",
          "originalRevision": 1,
          "originalSha256": "60e97b29104c563810870655ca9fd862ff39fba8d8185e069a0fd41f2d3de026",
          "excerpt": "三月，鄩遣其將楊延直自澶州率兵萬人，會於城下。"
        },
        {
          "chapterId": "old-v028",
          "paragraphId": "old-v028-p22",
          "originalRevision": 1,
          "originalSha256": "60e97b29104c563810870655ca9fd862ff39fba8d8185e069a0fd41f2d3de026",
          "excerpt": "因引軍漸卻，至故元城西，李存審大軍已成列矣。"
        }
      ]
    },
