      ]
    },
    {
      "id": "shi-jiantang-luzhou-vanguard",
      "title": "为援潞州先锋，夜袭梁营",
      "summary": "与周德威救援潞州，作为先锋以精骑设伏擒人、夜犯梁营，扰断敌军樵采。",
      "year": null,
      "sortOrder": 7,
      "precision": "undated",
      "sourceDate": "李思安围上党时，本传未单列年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v055",
          "paragraphId": "old-v055-p6",
          "originalRevision": 1,
          "originalSha256": "eb1d14dacab6ee0e3819ac2bc531cfba6314481d582448bcf777239ba98392d9",
          "excerpt": "李思安之圍上黨也，建瑭為前鋒，與總管周德威赴援。時汴人夾城深固，援路斷絕，建瑭日引精騎，設伏擒生，夜犯汴營，驅斬千計，敵人不敢芻牧。"
        }
      ]
    }
