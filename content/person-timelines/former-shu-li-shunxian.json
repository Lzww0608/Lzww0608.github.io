      "title": "著有宫中应制等诗",
      "summary": "本传列其所作蜀宫应制诗、随驾诗、钓鱼不得诗等。",
      "year": null,
      "precision": "undated",
      "sortOrder": 2,
      "sourceDate": "本传列作品，未记各篇作年",
      "phase": "uncertain",
