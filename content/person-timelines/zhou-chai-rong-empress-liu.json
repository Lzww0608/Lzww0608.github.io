        {
          "chapterId": "new-v20",
          "paragraphId": "new-v20-p6",
          "originalRevision": 1,
          "originalSha256": "0e3d83d25e5424c07b539a666fa724ce7e5be37d342829176c8e7cafb0c24b26",
