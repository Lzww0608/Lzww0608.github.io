    {
      "id": "nantang-li-yu-empress-zhaohui-queen",
      "title": "后主嗣位后立为国后",
      "summary": "李煜嗣位，立妃周氏为国后；其国后称谓与马令所述臣民称皇后分别保存。",
      "year": 961,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "建隆二年后主承位叙次；未独记册日",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "new-v62",
          "paragraphId": "new-v62-p40",
          "originalRevision": 1,
          "originalSha256": "815fb8e60aafb37089294bd55e8e3339d17fe4a46ffa0f6924ddfe44fbfa8419",
          "excerpt": "建隆二年，景遷南都，立煜為太子，留監國。景卒，煜嗣立於金陵。母鍾氏，父名泰章。煜尊母曰聖尊后；立妃周氏為國后；"
        },
        {
          "chapterId": "nantangma-v005",
          "paragraphId": "nantangma-v005-p6",
          "originalRevision": 1,
          "originalSha256": "c3389d7f808b454b76d79d29c3282278a362d262a9243e408b03e8e7f4d5151b",
          "excerpt": "妃周氏為國后"
        },
        {
          "chapterId": "nantanglu-v003",
          "paragraphId": "nantanglu-v003-p3",
          "originalRevision": 1,
          "originalSha256": "856ce7841f370734d02f20cce0efaaf2ec1316c6ed59bccffbd1c90e0a06499c",
          "excerpt": "立妃周氏為國后"
        },
        {
          "chapterId": "shiguochunqiu-v017",
          "paragraphId": "shiguochunqiu-v017-p3",
          "originalRevision": 1,
          "originalSha256": "e70de9713716323017593c055b2dc69097d1d459a0c486b6ff91ef6168358de5",
          "excerpt": "立妃周氏爲國后，"
        }
      ]
    },
    {
      "id": "nantang-li-yu-empress-zhaohui-death",
      "title": "乾德二年十一月甲戌去世",
      "summary": "病重时她将琵琶、玉环交后主并书请薄葬，越三日去世于瑶光殿西室，享年二十九。确日只用于去世，临终各行为未另立同日。",
      "year": 964,
      "sortOrder": 2,
      "precision": "day",
      "sourceDate": "乾德二年十一月甲戌；儒略964年12月8日",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v018",
          "paragraphId": "shiguochunqiu-v018-p8",
          "originalRevision": 1,
          "originalSha256": "df748c38a0aaf62fdf057d7c7af565a9b0ea2d253f7bef526675c9a13425d7f9",
          "excerpt": "又作書請薄葬。越三日，沐浴糚澤，自內含玉，殂于瑤光殿之西室，時乾德二年十一月甲戌也。年二十有九。"
        },
        {
          "chapterId": "nantangma-v006",
          "paragraphId": "nantangma-v006-p9",
          "originalRevision": 1,
          "originalSha256": "82b039bce5c27658fda87123e2654d072ad3e5f3a48c623f87707673f851114f",
          "excerpt": "時乾徳二年十一月甲戌也享年二十九"
        }
      ],
      "notes": [
        "月本身跨965年，但甲戌实际仍在964；不用月首或别书日替换。",
        "末或谓小周入宫、后主掩迹是说法，不定为死因。"
      ],
      "variants": [
        {
          "label": "两本纪十月、十一月分源",
          "sourceDate": "马令乾德二年十一月；陆游十月子亡后周后亦卒",
          "summary": "马令本纪只记十一月周后殂，未给甲戌日；陆游本纪在十月甲辰仲㝢卒后记周后悲伤病重而亦卒。甲辰用于所载子卒，不移作母后独日，亦不据十一月月首替甲戌。",
          "evidence": [
            {
              "chapterId": "nantangma-v005",
