      "title": "随周德威赴援上党",
      "summary": "李存贤随周德威援救上党，驻军交口。",
      "year": null,
      "sortOrder": 3,
      "precision": "range",
      "sourceDate": "天祐三年",
      "phase": "uncertain",
      "evidence": [
