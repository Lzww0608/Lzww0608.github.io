    {
      "id": "li-cunxian-weizhou",
      "title": "权蔚州刺史",
      "summary": "李存贤暂任蔚州刺史以抵御吐浑。旧史另记他角抵胜李存勖后得到蔚州刺史，保留任职缘由的记法。",
      "year": null,
      "sortOrder": 4,
      "precision": "range",
      "sourceDate": "天祐五年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p19",
          "originalRevision": 1,
          "originalSha256": "f5134fbf1f2a141bf4ca9c9d75d527eec1133c5e660e1ea378149e4a42c8659f",
          "excerpt": "五年，權知蔚州刺史，以御吐渾。"
        }
      ],
      "variants": [
        {
          "label": "旧史附记角抵授职",
          "sourceDate": "庄宗在藩邸，未记确月日",
          "summary": "旧史附记角抵胜李存勖后得到蔚州刺史，未单标年份。",
          "evidence": [
            {
              "chapterId": "old-v053",
              "paragraphId": "old-v053-p20",
              "originalRevision": 1,
              "originalSha256": "b73c69c5d96bd58f4fb0c31657cfa0693636480d334c227b956699a5a92a13d7",
              "excerpt": "存賢少有材力，善角牴。初，莊宗在籓邸，每宴，私與王郁角牴鬥勝，郁頻不勝。莊宗自矜其能，謂存賢曰：「與爾一博，如勝，賞爾一郡。」即時角牴，存賢勝，得蔚州刺史。"
            }
          ]
        }
      ],
      "yearRange": {
