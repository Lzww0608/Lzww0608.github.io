    {
      "id": "dong-zhang-rebellion-langzhou",
      "title": "与孟知祥结援，陷阆州杀使",
      "summary": "朝廷割属郡置李仁矩节镇引其猜忌，联孟知祥起兵，攻陷阆州杀李仁矩、姚洪。",
      "year": 930,
      "sortOrder": 5,
      "precision": "month",
      "sourceDate": "长兴元年五月及其后",
      "phase": "fall",
      "evidence": [
        {
