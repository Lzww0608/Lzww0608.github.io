        }
      ]
    },
    {
      "id": "dong-zhang-death",
      "title": "败返东川遭王晖杀，首送西川",
      "summary": "在东川寄居的王晖乘董璋败军率人杀之，将首送孟知祥。",
      "year": 932,
      "sortOrder": 8,
      "precision": "year",
      "sourceDate": "长兴三年四月出兵、弥牟败返被杀；本纪六月已报同事，限定西历932年",
