    {
      "id": "shi-chonggui-birth",
      "title": "生于太原汾阳里",
      "summary": "石敬儒、安氏之子，石敬瑭的侄子；亲父早卒后由石敬瑭收养。",
      "year": 914,
      "sortOrder": 1,
      "precision": "day",
      "sourceDate": "天祐十一年六月二十七日；同历梁乾化四年",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v081",
          "paragraphId": "old-v081-p1",
          "originalRevision": 1,
          "originalSha256": "8ea5ff301c4db8112aa63a9d1dd21a21ff34d67c0544d1279acea52b9d4fd054",
          "excerpt": "考諱敬儒，母安氏，以唐天祐十一年六月二十七日生帝於太原汾陽裏。敬儒嘗為後唐莊宗騎將，早薨，高祖以帝為子。"
        }
      ]
    },
    {
      "id": "shi-chonggui-taiyuan-defense",
      "title": "太原受围时助石敬瑭",
      "summary": "后唐围太原时亲冒矢石，并向石敬瑭进言，受到更深信任。",
      "year": 936,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "石敬瑭受围于太原时",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v081",
          "paragraphId": "old-v081-p1",
          "originalRevision": 1,
          "originalSha256": "8ea5ff301c4db8112aa63a9d1dd21a21ff34d67c0544d1279acea52b9d4fd054",
          "excerpt": "及高祖受圍於太原，親冒矢石，數獻可於左右，高祖愈重焉。"
        }
      ]
    },
    {
      "id": "shi-chonggui-beijing-regency",
      "title": "晋初留守太原",
      "summary": "石敬瑭受册欲南下时，契丹主从诸子中选石重贵留晋阳，任北京留守、太原尹，知河东节度观察。",
      "year": 936,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "高祖受契丹册将入洛时",
      "phase": "service",
      "evidence": [
