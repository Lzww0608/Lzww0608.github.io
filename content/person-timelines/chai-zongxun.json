{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "chai-zongxun",
  "events": [
    {
      "id": "chai-zongxun-birth",
      "title": "广顺三年生于澶州",
      "summary": "世宗之子，广顺三年八月四日出生澶州府第；新史明确为世宗第四子。",
      "year": 953,
      "sortOrder": 1,
      "precision": "day",
      "sourceDate": "广顺三年八月四日",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p2",
          "originalRevision": 1,
          "originalSha256": "df319960483f515921b482202b6373c7b08292e3b1acc30a398bb3352b9ccb22",
          "excerpt": "廣順三年，歲在癸丑，八月四日，生於澶州之府第。"
        },
        {
          "chapterId": "new-v12",
          "paragraphId": "new-v12-p9",
          "originalRevision": 1,
          "originalSha256": "9ac0cb698e32b6bf03eb543b70fb97235887144a14b48823aab0a5573d847212",
          "excerpt": "恭皇帝，世宗第四子宗訓也。"
        }
      ]
    },
    {
      "id": "chai-zongxun-liang-king",
      "title": "父病返京后封梁王",
      "summary": "柴荣北征因病回京后封宗训梁王，授特进、左卫上将军，时七岁。",
      "year": 959,
      "sortOrder": 2,
      "precision": "day",
      "sourceDate": "显德六年六月癸未",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p2",
          "originalRevision": 1,
          "originalSha256": "df319960483f515921b482202b6373c7b08292e3b1acc30a398bb3352b9ccb22",
          "excerpt": "顯德六年六月癸未，制授特進左衛上將軍，封梁王，食邑三千戶，實封五百戶。"
        },
        {
          "chapterId": "new-v12",
          "paragraphId": "new-v12-p9",
          "originalRevision": 1,
          "originalSha256": "9ac0cb698e32b6bf03eb543b70fb97235887144a14b48823aab0a5573d847212",
          "excerpt": "及北取三關，遇疾還京師，始封宗訓梁王，時年七歲。"
        }
      ]
    },
    {
      "id": "chai-zongxun-accession",
      "title": "父崩后奉遗制柩前即位",
      "summary": "柴荣崩后，群臣奉遗制立年幼宗训，在灵柩前即皇位，沿用显德年号。",
      "year": 959,
      "sortOrder": 3,
      "precision": "day",
      "sourceDate": "显德六年六月甲午",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p2",
          "originalRevision": 1,
          "originalSha256": "df319960483f515921b482202b6373c7b08292e3b1acc30a398bb3352b9ccb22",
          "excerpt": "甲午，內出遺制，命帝柩前即皇帝位。是日，群臣奉帝即位而退。"
        }
      ]
    },
    {
      "id": "chai-zongxun-court-administration",
      "title": "范质等三表请听政",
      "summary": "范质等文武百僚三次上表请听政，获允。相关政令按恭帝朝记载，不把幼帝写成独自主持具体军谋。",
      "year": 959,
      "sortOrder": 4,
      "precision": "day",
      "sourceDate": "显德六年六月戊戌",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p2",
          "originalRevision": 1,
          "originalSha256": "df319960483f515921b482202b6373c7b08292e3b1acc30a398bb3352b9ccb22",
          "excerpt": "戊戌，文武百僚、宰臣範質等上表請聽政，表三上，允之。"
        }
      ]
    },
    {
      "id": "chai-zongxun-guards-reshuffle",
      "title": "恭帝朝调整藩镇与宿卫军职",
      "summary": "七月朝廷调李重进至淮南、韩通至郓州，赵匡胤领宋州而仍殿前都点检，慕容延钊、石守信等也保留宿卫要职。",
      "year": 959,
      "sortOrder": 5,
      "precision": "day",
      "sourceDate": "显德六年七月壬戌",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p3",
          "originalRevision": 1,
          "originalSha256": "e1ff4a7d9b7c37e9c32bcf5036038008474ba16f8f8e70a5c780d2e39a7e1d04",
          "excerpt": "以今上為宋州節度使，依前檢校太尉、殿前都點檢，進封開國侯；"
        }
      ],
      "notes": [
        "原书“今上”是宋太祖赵匡胤，不能误作年幼恭帝。"
      ]
    },
    {
      "id": "chai-zongxun-amnesty",
      "title": "颁大赦",
      "summary": "显德六年七月朝廷制大赦。",
      "year": 959,
      "sortOrder": 6,
      "precision": "day",
      "sourceDate": "显德六年七月丙寅",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p3",
          "originalRevision": 1,
          "originalSha256": "e1ff4a7d9b7c37e9c32bcf5036038008474ba16f8f8e70a5c780d2e39a7e1d04",
          "excerpt": "丙寅，制大赦天下。"
        }
      ]
    },
    {
      "id": "chai-zongxun-brothers",
      "title": "封弟熙让等三王",
      "summary": "恭帝朝八月封弟熙让曹王、熙谨纪王、熙诲蕲王。",
      "year": 959,
      "sortOrder": 7,
      "precision": "day",
      "sourceDate": "显德六年八月庚寅",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "new-v12",
          "paragraphId": "new-v12-p10",
          "originalRevision": 1,
          "originalSha256": "536a27ec8784f30019c3f571e18fd088c495e7c9c58477a89dc3b3d5ee9280a9",
          "excerpt": "八月庚寅，封弟熙讓為曹王，熙謹紀王，熙誨蘄王。"
        }
      ]
    },
    {
      "id": "chai-zongxun-father-burial",
      "title": "葬世宗于庆陵",
      "summary": "显德六年十一月葬父柴荣于庆陵，贞惠皇后刘氏祔葬。",
      "year": 959,
      "sortOrder": 8,
      "precision": "day",
      "sourceDate": "显德六年十一月壬寅朔",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p7",
          "originalRevision": 1,
          "originalSha256": "d7f2658c135a3f18ec539c345e8ee8ce209a84f521a1f1d0f7ab82819f818ab1",
          "excerpt": "十一月壬寅朔，葬世宗皇帝於慶陵，以貞惠皇后劉氏祔焉。"
        }
      ]
    },
    {
      "id": "chai-zongxun-flood-relief",
      "title": "派使赈济水灾",
      "summary": "年底大霖昼昏后，朝廷分派使者赈济各州受水灾的人户。",
      "year": 960,
      "sortOrder": 9,
      "precision": "day",
      "sourceDate": "显德六年十二月乙未（实际已在西历960年）",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p8",
          "originalRevision": 1,
          "originalSha256": "6c2bf6023a6dc7eb2f68a811730fbf517070583300a9e3463218d3d8bfaf1202",
          "excerpt": "乙未，大霖，晝昏，凡四日而止，分命使臣賑給諸州遭水人戶。"
        }
      ]
    },
    {
      "id": "chai-zongxun-north-command",
      "title": "闻契丹河东军来，诏赵匡胤北征",
      "summary": "镇定二州报契丹与河东军合势，朝廷命赵匡胤北征，军于陈桥发生兵变。",
      "year": 960,
      "sortOrder": 10,
      "precision": "day",
      "sourceDate": "显德七年正月辛丑朔至癸卯",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p9",
          "originalRevision": 1,
          "originalSha256": "90a1d05e6c900f5449613a64d5575fc9c38f1d7775891416580caec4704bc5dc",
          "excerpt": "鎮、定二州馳奏，契丹入寇，河東賊軍自土門東下與蕃寇合勢。詔今上率兵北征。"
        }
      ]
    },
    {
      "id": "chai-zongxun-abdication",
      "title": "陈桥兵变后逊位，降封郑王",
      "summary": "赵匡胤军变南返，恭帝退位，后周结束；宋封郑王以奉周祀，周太后保留名号。",
      "year": 960,
      "sortOrder": 11,
      "precision": "day",
      "sourceDate": "显德七年正月甲辰",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "new-v12",
          "paragraphId": "new-v12-p11",
          "originalRevision": 1,
          "originalSha256": "fe949ca13a82fe3f068e72631152eda6bbb498bb2c28eb25ffe957fc937f02f2",
          "excerpt": "七年春正月甲辰，遜于位。宋興。"
        }
      ]
    },
    {
      "id": "chai-zongxun-death",
      "title": "开宝六年卒房陵",
      "summary": "退位后于宋开宝六年春卒房陵，宋帝举哀、派使护丧；本纪所附长编记三月乙卯为房州上报之日，不当精确卒日。",
      "year": 973,
      "sortOrder": 12,
      "precision": "year",
      "sourceDate": "开宝六年春；三月乙卯房州奏报",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p9",
          "originalRevision": 1,
          "originalSha256": "90a1d05e6c900f5449613a64d5575fc9c38f1d7775891416580caec4704bc5dc",
          "excerpt": "皇朝開寶六年春，崩於房陵。"
        }
      ],
      "notes": [
        "奏报死讯与死亡发生时间分开。"
      ]
    },
    {
      "id": "chai-zongxun-burial-posthumous",
      "title": "归葬庆陵旁，谥恭皇帝",
      "summary": "当年十月归葬柴荣庆陵旁，谥恭皇帝、陵名顺陵。",
      "year": 973,
      "sortOrder": 13,
      "precision": "month",
      "sourceDate": "开宝六年十月",
      "phase": "posthumous",
      "evidence": [
        {
          "chapterId": "old-v120",
          "paragraphId": "old-v120-p9",
          "originalRevision": 1,
          "originalSha256": "90a1d05e6c900f5449613a64d5575fc9c38f1d7775891416580caec4704bc5dc",
          "excerpt": "以其年十月，歸葬於世宗慶陵之側。詔有司定謚曰恭皇帝，陵曰順陵。"
        }
      ]
    },
    {
      "id": "chai-zongxun-fangzhou",
      "title": "宋建隆三年出居房州",
      "summary": "旧史注引《续通鉴长编》记郑王出居房州，属于退位后的本人生活，不恢复宋朝人物入口。",
