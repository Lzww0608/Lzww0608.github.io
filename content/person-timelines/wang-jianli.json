{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "wang-jianli",
  "events": [
    {
      "id": "wang-jianli-protect-family",
      "title": "杀常山监军，保护李嗣源家属",
      "summary": "李嗣源自魏南下时，王建立在常山杀监军及守兵，使曹氏、王氏免遭祸患，李嗣源更爱之。",
      "year": 926,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "明宗自魏南下时",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p33",
          "originalRevision": 1,
          "originalSha256": "280af912e9fbdf2157fd9f6f337164b71a96b9deec4749328915f9eae7099b95",
          "excerpt": "建立殺常山監軍并其守兵，明宗家屬因得無患，由是明宗益愛之。"
        }
      ]
    },
    {
      "id": "wang-jianli-restart-tianping",
      "title": "废帝即位后起任天平节度",
      "summary": "李从珂即位，重新起用已退休的王建立为天平节度使。",
      "year": 934,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "废帝即位后复起；本纪清泰元年六月壬午同事任郓州（天平军）",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p35",
          "originalRevision": 1,
          "originalSha256": "33eac64c05757fe18c2ac137fa761b57000e8199990277c05147649462e4ec77",
          "excerpt": "廢帝立，復起為天平軍節度使。"
        },
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p21",
          "originalRevision": 1,
          "originalSha256": "2e31601ae238c4e42712ffbcbb56027a730c2608dcf4b45802d01adfefec862b",
          "excerpt": "六月庚午朔，改侍衛捧聖軍為彰聖，改嚴衛軍為寧衛。"
        },
        {
          "chapterId": "old-v046",
          "paragraphId": "old-v046-p21",
          "originalRevision": 1,
          "originalSha256": "2e31601ae238c4e42712ffbcbb56027a730c2608dcf4b45802d01adfefec862b",
          "excerpt": "壬午，以檢校太子太傅致仕王建立為檢校太尉、兼侍中、鄆州節度使；"
        }
      ]
    },
    {
      "id": "wang-jianli-jin-audience",
      "title": "天福五年入朝，获肩舆搀扶",
      "summary": "石敬瑭念三十年前旧交，免拜、赐肩舆、使两宦搀扶升殿，待遇优渥；后来移昭义、封韩王。",
      "year": 940,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "天福五年入朝；本纪二月丁巳来朝、三月任昭义及饯归前，入朝受礼可核940年",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p36",
          "originalRevision": 1,
          "originalSha256": "b3ef3ead4ae4b60b1912454671cc412e93debf2c85b221725444eda0abf6f194",
          "excerpt": "天福五年來朝，高祖勞之曰：「三十年前老兄，可毋拜！」"
        },
        {
          "chapterId": "old-v079",
          "paragraphId": "old-v079-p1",
          "originalRevision": 1,
          "originalSha256": "7fc145c2f4d2eb8ad3bbd4417860d39c8a487bd23f89ec16ac3a53f57809ee2c",
          "excerpt": "天福五年春正月丁卯朔，帝御崇元殿受朝賀，仗衛如式。"
        },
        {
          "chapterId": "old-v079",
          "paragraphId": "old-v079-p2",
          "originalRevision": 1,
          "originalSha256": "91bf15846f9bc166a770264be708c339934f3b6713f79f26e793e2c390d43c24",
          "excerpt": "二月丁酉朔，沙州歸義軍節度使曹義金卒，贈太師，以其子元德襲其位。"
        },
        {
          "chapterId": "old-v079",
          "paragraphId": "old-v079-p2",
          "originalRevision": 1,
          "originalSha256": "91bf15846f9bc166a770264be708c339934f3b6713f79f26e793e2c390d43c24",
          "excerpt": "丁巳，青州節度使、東平王王建立來朝。"
        },
        {
          "chapterId": "old-v079",
          "paragraphId": "old-v079-p3",
          "originalRevision": 1,
          "originalSha256": "b82dab1ecdbd87bb7e908995df98c34ad3bca4e55d0609a85f5c6fb82058e67b",
          "excerpt": "三月丁卯朔，右散騎常侍張允改禮部侍郎。"
        },
        {
          "chapterId": "old-v079",
          "paragraphId": "old-v079-p3",
          "originalRevision": 1,
          "originalSha256": "b82dab1ecdbd87bb7e908995df98c34ad3bca4e55d0609a85f5c6fb82058e67b",
          "excerpt": "庚寅，御明德樓，餞送昭義軍節度使王建立，賜玉斧、蜀馬。"
        }
      ]
    },
    {
      "id": "wang-jianli-early-guard",
      "title": "代州虞候，笞侵民宫人免祸",
      "summary": "李嗣源任代州刺史时用为虞候；王建立笞扰民女奴，李存勖欲杀，获李嗣源保护。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "明宗为代州刺史时",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p33",
          "originalRevision": 1,
          "originalSha256": "280af912e9fbdf2157fd9f6f337164b71a96b9deec4749328915f9eae7099b95",
          "excerpt": "莊宗怒，欲殺之，明宗為庇護之以免。"
        }
      ]
    },
    {
      "id": "wang-jianli-chengde",
      "title": "明宗朝任成德副使、节度",
      "summary": "明宗即位后任成德节度副使，不久正式授节度使、检校太尉、同平章事。",
      "year": null,
      "sortOrder": 5,
      "precision": "range",
      "sourceDate": "明宗即位后任成德副使、留后，随后拜节度并加平章；本纪元年六月留后、二年正月节度及九月平章，西历926—927年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p33",
          "originalRevision": 1,
          "originalSha256": "280af912e9fbdf2157fd9f6f337164b71a96b9deec4749328915f9eae7099b95",
          "excerpt": "明宗即位，以為成德軍節度副使，已而拜節度使、檢校太尉、同中書門下平章事。"
        },
        {
          "chapterId": "old-v036",
          "paragraphId": "old-v036-p8",
          "originalRevision": 1,
          "originalSha256": "67f2d2d5846175f032334a134a0a8644d847fbecc8a50ec7e59e98941804dbe3",
          "excerpt": "甲寅，以晉州留後符彥超為北京留守，以鎮州副使王建立為鎮州留後，以右龍武統軍安崇阮為晉州留後。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p1",
          "originalRevision": 1,
          "originalSha256": "9d87b1c57668e7956817a8e6cda6a379c9ef48f4de24ec5889ed550184fa1fe7",
          "excerpt": "天成二年春正月癸丑朔，帝御明堂殿受朝賀，仗衛如常儀。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p3",
          "originalRevision": 1,
          "originalSha256": "71c86644a4e6716fcbfef962cb1e2fdbf5d6ac2f529c4cb4ab23bdf44b415ef2",
          "excerpt": "以鎮州留後、檢校司徒王建立為鎮州節度使、檢校太傅。"
        },
        {
          "chapterId": "old-v038",
          "paragraphId": "old-v038-p15",
          "originalRevision": 1,
          "originalSha256": "d5b7e1f3b2716296e14cfbf856609dab432b47ed7e79b74a34d6b67fe93b6971",
          "excerpt": "九月辛亥，義武軍節度使、檢校太尉、兼中書令王都加食邑實封。幽州節度使趙德鈞加檢校太尉，鎮州節度使王建立加同平章事。"
        }
      ],
      "yearRange": {
        "start": 926,
        "end": 927
      }
    },
    {
      "id": "wang-jianli-chancellor",
      "title": "王都书信被报后召京，任右仆射",
      "summary": "王都与其通信约兄弟被安重诲报告，召京后王建立亦指重诲过；最终任右仆射、同平章事、判三司。",
      "year": null,
      "sortOrder": 6,
      "precision": "undated",
      "sourceDate": "王都有异志时",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p34",
          "originalRevision": 1,
          "originalSha256": "ccea16fcc468e744c04815b76ce80dba245b0c7e594bd3435b016eb38180c2b5",
          "excerpt": "然卒以建立為右僕射、同中書門下平章事、判三司事。"
        }
      ]
    },
    {
      "id": "wang-jianli-retirement",
      "title": "以不识字求罢三司，出镇后退休",
      "summary": "请罢三司未允，称病后出平卢、再上党，郁郁求解职，太子少保致仕。",
      "year": null,
      "sortOrder": 7,
      "precision": "undated",
      "sourceDate": "入三司岁余及其后",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p34",
          "originalRevision": 1,
          "originalSha256": "ccea16fcc468e744c04815b76ce80dba245b0c7e594bd3435b016eb38180c2b5",
          "excerpt": "建立怏怏不得志，遂求解職，乃以太子少保致仕。"
        }
      ]
    },
    {
      "id": "wang-jianli-death",
      "title": "晚年戒杀，七十岁卒",
      "summary": "本传记早好杀人，晚信佛戒杀，百姓稍安；七十岁卒，赠尚书令。王守恩独立后事不继承为父亲事件。",
      "year": null,
      "sortOrder": 8,
      "precision": "undated",
      "sourceDate": "晋朝任官之后，卒年未记",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v46",
          "paragraphId": "new-v46-p37",
          "originalRevision": 1,
          "originalSha256": "c35ead6b946c7fd8275c1eb891244dcb71ed21f96bb0b14d33edd8856258e53d",
          "excerpt": "卒年七十，贈尚書令。"
        }
      ]
    }
  ]
}
