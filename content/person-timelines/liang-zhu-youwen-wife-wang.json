  "events": [
    {
      "id": "liang-zhu-youwen-wife-wang-summon-husband",
      "year": 912,
      "sourceDate": "乾化二年弑君前宫廷交接叙事；召命未独给日",
      "title": "侍疾并奉命召朱友文",
      "summary": "王氏在朱温病中侍疾，朱温命她到东都召朱友文，准备诀别并托付后事。",
      "evidence": [
        {
          "chapterId": "new-v13",
          "paragraphId": "new-v13-p45",
          "originalRevision": 1,
          "originalSha256": "cc889a04d0fff0014a3433a58d564d9e45971bb60d5d664a3ccb77ea23225d93",
          "excerpt": "太祖病久，王氏與友珪妻張氏，常專房侍疾。太祖病少間，謂王氏曰：「吾知終不起，汝之東都，召友文來，吾與之決。」蓋心欲以後事屬之。"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p65",
          "originalRevision": 1,
          "originalSha256": "87ff8c957e5fda21ce939d9aea5ad677c998713c90fb86496ba8333d1c63c71b",
          "excerpt": "帝疾甚，命王氏召友文於東都，欲與之訣，且付以後事。"
        }
      ],
      "precision": "year",
      "phase": "later",
      "notes": [
        "传国宝由朱友珪妻话语记出，不写王氏已经成功迎回朱友文，也不据丈夫后来死推其本人死。"
      ],
      "sortOrder": 1
    },
    {
      "id": "liang-zhu-youwen-wife-wang-entry-and-favor",
      "year": null,
      "sourceDate": "原书未独记年月",
      "title": "以朱友文妻身份入侍",
      "summary": "新史和通鉴记朱温在张氏死后召诸子之妇入侍，尤其宠爱朱友文之妻王氏。",
      "evidence": [
        {
          "chapterId": "new-v13",
          "paragraphId": "new-v13-p45",
          "originalRevision": 1,
          "originalSha256": "cc889a04d0fff0014a3433a58d564d9e45971bb60d5d664a3ccb77ea23225d93",
          "excerpt": "太祖自張皇后崩，無繼室，諸子在鎮，皆邀其婦入侍。友文妻王氏有色，尤寵之。"
        },
        {
          "chapterId": "tongjian-v268",
          "paragraphId": "tongjian-v268-p65",
          "originalRevision": 1,
          "originalSha256": "87ff8c957e5fda21ce939d9aea5ad677c998713c90fb86496ba8333d1c63c71b",
          "excerpt": "後殂，帝縱意聲色，諸子雖在外，常征其婦入侍，帝往往亂之。友文婦王氏色美，帝尤寵之，雖未以友文為太子，帝意常屬之。"
        }
      ],
      "precision": "undated",
      "phase": "uncertain",
      "notes": [
        "只是本书所述入侍及受宠，身份仍为养子之妻，无册后妃证据。"
      ],
      "sortOrder": 2
    }
  ]
}
