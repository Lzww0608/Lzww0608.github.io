  "events": [
    {
      "id": "ge-congzhou-join",
      "title": "从黄巢军降朱温",
      "summary": "王满渡黄巢军败后，葛从周与霍存、张归霸兄弟归朱温。",
      "year": 884,
      "sortOrder": 0,
      "precision": "year",
      "sourceDate": "中和四年三月",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p2",
          "originalRevision": 1,
          "originalSha256": "023329fe734da158fa695151d8934f4f9f71257fca3164ed9c59a9e53765b275",
          "excerpt": "唐中和四年三月，太祖大破巢軍於王滿渡，從周與霍存、張歸霸昆弟相率來降。"
        }
      ],
      "variants": [
        {
          "label": "李克用旧本纪王满渡月份",
          "sourceDate": "中和四年五月",
          "summary": "葛旧传三月王满败后归，李克用旧本纪五月记破王满，保留同役月份差，不改原年。",
          "evidence": [
            {
              "chapterId": "old-v025",
              "paragraphId": "old-v025-p14",
              "originalRevision": 1,
              "originalSha256": "9ee5aa494e94bacbf7be823c6943f8048a0a0d6c4f7739d9b0791cae0ffe3351",
              "excerpt": "中和四年春，武皇率蕃漢之師五萬，自澤、潞將下天井關；河陽節度使諸葛爽辭以河橋不完，乃屯兵於萬善。數日。移軍自河中南渡，趨汝、洛。四月，武皇合徐、汴之師破尚讓於太康，斬獲萬計，進攻賊於西華，賊將黃鄴棄營而遁。是夜大雨，巢營中驚亂，乃棄西華之壘，退營陳州北故陽裏。五月癸亥，大雨震電，平地水深數尺，賊營為水所漂而潰。戊辰，武皇引軍營於中牟，大破賊於王滿渡。"
            }
          ],
          "year": 884
        }
      ]
    },
    {
      "id": "ge-congzhou-save-zhu",
      "title": "救落马朱温，负伤脱围",
      "summary": "西华战事中朱温落马，葛从周扶其上马并与敌格斗，多处负伤，张延寿回马相救，两人都升为大校。",
      "year": 884,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "中和四年七月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p2",
          "originalRevision": 1,
          "originalSha256": "023329fe734da158fa695151d8934f4f9f71257fca3164ed9c59a9e53765b275",
          "excerpt": "七月，從太祖屯兵於西華，破蔡賊王夏寨。太祖臨陣馬踣，賊眾來追甚急，從周扶太祖上馬，與賊軍格鬥，傷面，矢中於肱，身被數槍，奮命以衛太祖。賴張延壽回馬轉鬥，從周與太祖俱免，退軍溵水。諸將並削職，惟擢從周、延壽為大校。"
        }
      ]
    },
    {
      "id": "ge-congzhou-heyang",
      "title": "救魏博与河阳",
      "summary": "文德元年随朱温渡河破魏军；又与丁会、张存敬、牛存节援张全义，击退河东军，解除河阳之围。",
      "year": 888,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "文德元年，本纪四月明列葛从周同援河阳，锁888；康本传同役三月异说另保",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p4",
          "originalRevision": 1,
          "originalSha256": "b03c3f8987b5276eaea8bd0ce11b987f70c2db73cdf7fd094bacaf3c87d157d2",
          "excerpt": "文德元年，魏博軍亂，樂從訓來告急，從太祖渡河，拔黎陽、李固、臨河等鎮，至內黃，破魏軍萬餘眾，獲其將周儒等十人。李罕之引并人圍張全義於河陽，從周與丁會、張存敬、牛存節率兵赴援，大破并軍，殺蕃漢二萬人，解河陽之圍，以功表授檢校工部尚書。"
        },
        {
          "chapterId": "old-v001",
          "paragraphId": "old-v001-p24",
          "originalRevision": 1,
          "originalSha256": "f95c898c4e1f606730fef54ca3db04b1d61e4c84ea7a373d6ff2cc5193b894b1",
          "excerpt": "文德元年正月"
        },
        {
          "chapterId": "old-v001",
          "paragraphId": "old-v001-p27",
          "originalRevision": 1,
          "originalSha256": "745048082d31f2163299df8bc3011cb9f27fc17443c6248dcca4c54d3157bb24",
          "excerpt": "是月，河南尹張全義襲李罕之于河陽，克之。罕之單騎出奔，因乞師于太原，李克用為發萬騎以援之。罕之遂收其眾，偕晉軍合勢，急攻河陽。全義危急，遣使求救于汴，帝遣丁會、牛存節、葛從周領兵赴之，大戰于溫縣，晉人與罕之俱敗。于是河橋解圍，全義歸于河陽，因以丁會為河陽留後。"
        }
      ]
    },
    {
      "id": "ge-congzhou-luzhou",
      "title": "夜入潞州后弃城",
      "summary": "葛从周率敢死士夜入被围潞州，随后马牢川失利，弃上党退回。",
      "year": 890,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "大顺元年八月夜入潞；弃城本纪与李存孝传记九月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p5",
          "originalRevision": 1,
          "originalSha256": "e6ded9f2bcf5abde299f1610c3cfae73ad7107ab33864688cde06a084799cf45",
          "excerpt": "大順元年八月，并帥圍潞州，太祖遣從周率敢死之士，夜銜枚犯圍而入，會王師不利於馬牢川，即棄上黨而歸。"
        }
      ],
      "variants": [
        {
          "label": "李克用旧本纪与存孝传",
          "sourceDate": "大顺元年九月",
          "summary": "本传八月入城续叙弃守，本纪与存孝传把葛弃城记九月，不把夜入与撤退强为同月。",
          "evidence": [
            {
              "chapterId": "old-v025",
              "paragraphId": "old-v025-p22",
              "originalRevision": 1,
              "originalSha256": "760f0b4b9c3b8dad25f77994aac3503f82b59f98c8df0f729ef2bf0a4cd287b8",
              "excerpt": "大順元年，遣李存孝攻邢州，孟遷以邢、洺、磁三州降，執汴將王虔裕三百人以獻。武皇徙孟遷於太原，以安金俊為邢洺團練使。"
            },
            {
              "chapterId": "old-v025",
              "paragraphId": "old-v025-p25",
              "originalRevision": 1,
              "originalSha256": "68028190c4287dd2fcd25998e55cc284b97ccda43e5ec48e9063fe892103c9cb",
              "excerpt": "九月，汴將葛從周棄潞州而遁，武皇以康君立為潞州節度使，以李存孝為汾州刺史。"
            },
            {
              "chapterId": "old-v053",
              "paragraphId": "old-v053-p7",
              "originalRevision": 1,
              "originalSha256": "ad0cedf5cf88bdb8e4461581acecff39c929c1e83e8866e68c563a4d3dc5d414",
              "excerpt": "九月，葛從周棄城夜遁，存孝收城，武皇乃表康君立為潞帥。存孝怒，不食者累日。"
            }
          ],
          "year": 890
        }
      ]
    },
    {
      "id": "ge-congzhou-weisu",
      "title": "永定桥败魏军，十月下宿州",
      "summary": "葛从周与丁会在永定桥败魏军，后辅攻宿州，引水灌城，使张筠献郡。",
      "year": 891,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "大顺二年正月、十月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v016",
          "paragraphId": "old-v016-p5",
