  "scope": "current-archive",
  "events": [
    {
      "id": "former-shu-xu-yanqiong-command-capital-forces",
      "title": "受任京城内外马步都指挥使",
      "summary": "王衍任徐延琼掌京城内外马步军；他以外戚代王宗弼而居旧将之上，众将不平。",
      "sourceDate": "《十国春秋》乾德六年十二月乙亥；《通鉴》同光二年十二月乙亥，均已跨西历925年",
      "year": 925,
      "precision": "month",
      "phase": "service",
      "sortOrder": 1,
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v037",
          "paragraphId": "shiguochunqiu-v037-p7",
          "originalRevision": 1,
          "originalSha256": "6162c4fd88e3835fb723ba510363a122fe4c56929958a303993aee73a9b78b3d",
          "excerpt": "乙亥，以前武德節度使兼中書令徐延瓊爲京城内外馬步都指揮使。延瓊以外戚代王宗弼居舊將之右，衆多不平。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p76",
          "originalRevision": 1,
          "originalSha256": "82a9541c9fb40640ab9c8e065ca7c621d0e82e167f476eea8ff77acfcb74ba35",
          "excerpt": "乙亥，蜀主以前武德節度使兼中書令徐延瓊為京城內外馬步都指揮使。延瓊以外戚代王宗弼居舊將之右，眾皆不平。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p71",
          "originalRevision": 1,
          "originalSha256": "b42c221b9f1c508ae11fde8cd5116f20ed6597b712e72c576f13a2f43f740ba9",
          "excerpt": "十二月，乙丑朔，蜀主以右僕射張格兼中書侍郎、同平章事。"
        },
        {
          "chapterId": "tongjian-v273",
          "paragraphId": "tongjian-v273-p3",
          "originalRevision": 1,
          "originalSha256": "ba48b26f68f94401dc342e313de95d5056c25c9314ccba58cf4eaf3e49937d68",
          "excerpt": "莊宗光聖神閔孝皇帝中同光二年（甲申，公元九二四年）"
        }
      ],
      "notes": [
        "保留原书记日乙亥，只核西历年份，不发布推算的西历确日。",
        "本传乾德末的简称与编年互见，不把其余未独记年月的经历也定925年。"
      ],
      "variants": [
        {
          "label": "本传的纪时及官名",
          "sourceDate": "本传称乾德末，官名少都字",
          "summary": "徐延琼本传作京城内外马步指挥使，代王宗弼握兵；沿原书保留，不改写官名。",
          "evidence": [
            {
              "chapterId": "shiguochunqiu-v046",
              "paragraphId": "shiguochunqiu-v046-p6",
              "originalRevision": 1,
              "originalSha256": "4b380afe3c080e48b85df1ed223c6afba0b955c9e48a0b0028f3eb1dd12e266c",
              "excerpt": "乾德末，充京城内外馬步指揮使，代王宗弼握兵，怙權倚勢，衆將爲之不平。"
            }
          ]
        }
      ]
    },
    {
      "id": "former-shu-xu-yanqiong-ten-zai-critique",
      "title": "《十在文》以元舅保傅身份论及",
      "summary": "林罕受顾在珣嘱作《十在文》，文中称徐延琼为君王元舅、受保傅尊官，并讥其奢华。",
      "sourceDate": "林罕传叙咸康元年进献《十在文》，只定文章记载的年份",
      "year": 925,
      "precision": "year",
      "phase": "service",
      "sortOrder": 2,
      "evidence": [
        {
          "chapterId": "shiguochunqiu-v043",
          "paragraphId": "shiguochunqiu-v043-p11",
          "originalRevision": 1,
          "originalSha256": "c21a79857f1e9f45a0ef63ae4a415cd69687fdcfc4d983d7fc43585f2fea4859",
          "excerpt": "咸康元年，後主忽舉觴不悦曰：“北有後唐，南有蠻詔，朕既不能弔伐，是所憂也。”"
        },
        {
          "chapterId": "shiguochunqiu-v043",
          "paragraphId": "shiguochunqiu-v043-p11",
          "originalRevision": 1,
          "originalSha256": "c21a79857f1e9f45a0ef63ae4a415cd69687fdcfc4d983d7fc43585f2fea4859",
          "excerpt": "爲君王之元舅，受保傅之尊官；但務奢華，不思輔弼；第宅逈同於上苑，金珠求滿於貪心，有徐延瓊在。"
        }
      ],
      "notes": [
        "文中评价保其讽刺文章的层次，不把每项指责都当作独立证实的事实。",
        "受保傅尊官是文章中的称谓，不据此把加太师或营宅定在925年；同段顾在珣受赐授官不归给徐。"
      ]
    },
    {
      "id": "former-shu-xu-yanqiong-bribes-wang-zongbi",
      "title": "国变时倾财贿宗弼而免死",
      "summary": "徐延琼与潘在迎、顾在珣及诸贵戚惊惧，倾家财及妓妾贿赂王宗弼，才免于一死。",
      "sourceDate": "《通鉴》同光三年十一月叙次，贿赂未独记日",
      "year": 925,
      "precision": "month",
      "phase": "fall",
      "sortOrder": 3,
      "evidence": [
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p10",
          "originalRevision": 1,
          "originalSha256": "021a2331861d53aee35863a475a0a0f7081030360ec7dc938e920aab0e01f949",
          "excerpt": "內外馬步都指揮使兼中書令徐延瓊、果州團練使潘在迎、嘉州刺史顧在珣及諸貴戚皆惶恐，傾其家金帛妓妾以賂宗弼，僅得免死。"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p3",
          "originalRevision": 1,
          "originalSha256": "3c0fc95eb4cd1a755cd3d91b7b6dbdbaa76c4ecd9d0ac84bab8cfe1c2002d35a",
          "excerpt": "莊宗光聖神閔孝皇帝下同光三年（乙酉，公元九二五年）"
        },
        {
          "chapterId": "tongjian-v274",
          "paragraphId": "tongjian-v274-p4",
          "originalRevision": 1,
          "originalSha256": "f8d6d20ab12ee38e160822b42cbe609fcec9fa8bec65bb726d3d0b2ecc104015",
          "excerpt": "十一月，丙申，蜀主至成都，百官及後宮迎於七里亭。"
        }
      ],
      "notes": [
        "前段己酉只用于魏王至绵州、草降表，不作为这次贿赂日。",
        "妓妾为群体，未具名，不指认为潘在迎妻徐氏或其他已有女性。"
      ],
      "variants": [
        {
          "label": "徐延琼本传与前蜀本纪的互见",
          "sourceDate": "唐师入境、国变叙次，未独记贿赂月日",
          "summary": "本传与前蜀本纪同记以家资贿宗弼免死；近似或同源叙述不算独立复证。",
          "evidence": [
            {
              "chapterId": "shiguochunqiu-v046",
              "paragraphId": "shiguochunqiu-v046-p6",
              "originalRevision": 1,
              "originalSha256": "4b380afe3c080e48b85df1ed223c6afba0b955c9e48a0b0028f3eb1dd12e266c",
              "excerpt": "唐師入境，宗弼徧殺後主諸幸臣，延瓊與潘在迎等用家貲賂宗弼，得免死。"
            },
            {
              "chapterId": "shiguochunqiu-v037",
              "paragraphId": "shiguochunqiu-v037-p8",
              "originalRevision": 1,
              "originalSha256": "455767cdf1721aa8b31f71f4eea5e1a58184d2d151b35283a8dc038aac9423f5",
              "excerpt": "而内外馬步指揮使徐延瓊、果州團練使潘在迎、嘉州刺史顧在珣及諸貴戚多惶懼，傾家貲伎妾以賂宗弼，得免死。"
            }
          ]
        }
      ]
    },
