      "title": "从秦州僧院取牡丹植园",
      "summary": "本传记徐延琼闻秦州董成村僧院有牡丹，厚持金帛，远取移植新苑。",
      "sourceDate": "承营宅追叙，未独记取花年月",
      "year": null,
      "precision": "undated",
      "phase": "uncertain",
      "sortOrder": 7,
