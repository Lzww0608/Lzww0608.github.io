  "personId": "liang-zhang-quanyi-wife-chu",
  "events": [
    {
      "id": "liang-zhang-quanyi-wife-chu-intercede",
      "title": "入见朱温，为丈夫申辩",
      "summary": "旧史记柏乡失律后，朱温怀疑张全义，储氏多次入宫申辩；一次急召时，她直言丈夫三十余年开荒聚赋、帮助创业，朱温答称没有恶意。",
      "year": null,
      "sortOrder": 1,
      "precision": "range",
      "sourceDate": "旧史：柏乡失律后、梁祖在世时；取911—912年有据范围",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v063",
          "paragraphId": "old-v063-p6",
          "originalRevision": 1,
          "originalSha256": "a1894641c56b6efd24c182ad562f2fb33cb7c340d62db348bdbb583f11cb4aaa",
          "excerpt": "梁祖自柏鄉失律後，連年親征河朔，心疑全義，或左右讒間，儲氏每入宮，委曲伸理。"
        },
        {
          "chapterId": "old-v063",
          "paragraphId": "old-v063-p6",
          "originalRevision": 1,
          "originalSha256": "a1894641c56b6efd24c182ad562f2fb33cb7c340d62db348bdbb583f11cb4aaa",
          "excerpt": "有時怒不可測，急召全義，儲氏謁見梁祖，厲聲言曰：「宗奭種田叟耳，三十餘年，洛城四面，開荒劚棘，招聚軍賦，資陛下創業。今年齒衰朽，指景待盡，而大家疑之，何也？」 梁祖遽笑而謂曰：「我無惡心，嫗勿多言。」"
        },
        {
          "chapterId": "new-v45",
          "paragraphId": "new-v45-p8",
          "originalRevision": 1,
          "originalSha256": "68a47bc774b71c7ca14547b5d4b20c8666a3b7b6c3415bc0b67d002cff8abdf5",
          "excerpt": "嘗有言全義於太祖者，太祖召全義，其意不測。全義妻儲氏明敏有口辯，遽入見，厲聲曰：「宗奭，種田叟爾！守河南三十年，開荒斸土，捃拾財賦，助陛下創業，今年齒衰朽，已無能為，而陛下疑之，何也？」太祖笑曰：「我無惡心，嫗勿多言。」"
        },
        {
          "chapterId": "new-v02",
          "paragraphId": "new-v02-p42",
          "originalRevision": 1,
          "originalSha256": "2ed09077e1e9a6a105d15765660f4a051068478518e06cdffad2b03e387879de",
          "excerpt": "乾化元年春正月丁亥，王景仁及晉人戰于柏鄉，敗績。"
        },
        {
          "chapterId": "new-v02",
          "paragraphId": "new-v02-p49",
          "originalRevision": 1,
          "originalSha256": "7bc8352c9cc9b535dcdc167c45fb0a40a4c135052ecd0df2cc711b9e9391f1ba",
          "excerpt": "乾化二年"
        },
        {
          "chapterId": "new-v02",
          "paragraphId": "new-v02-p54",
          "originalRevision": 1,
          "originalSha256": "c69a9d5e401b6dd54a2bcb237cd689174a29c47d782d5e03ffafcd6ebc020b2f",
          "excerpt": "戊寅，皇帝崩。"
        }
      ],
      "notes": [
        "范围取旧史明确的柏乡败后与梁祖死前；段首末帝晚期任官是另一叙事，不是她的日期。",
        "新史一次压缩对话与旧史多次申辩分别保留，不把她的话当作全部家中妇女群体遭遇的自述。",
        "新史回溯称乾化元年正月，保原文；同历按当时有效开平五年核为911年。"
      ],
      "yearRange": {
        "start": 911,
        "end": 912
      }
    },
    {
      "id": "liang-zhang-quanyi-wife-chu-xianyi",
      "title": "获赐贤懿夫人之号",
      "summary": "会要引梁朝先例，明确张全义妻储氏曾获赐贤懿夫人之号；旧史礼制议论也记张宗奭妻号贤懿。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "梁朝；未记储氏获号年月",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "huiyao-v011",
          "paragraphId": "huiyao-v011-p99",
          "originalRevision": 1,
          "originalSha256": "e17dfd13167ecee9b1914b4a3baa6a02abd1d1b3893e8300c2e3ec05a285055e",
          "excerpt": "近梁朝賜張全義妻儲氏為賢懿夫人，又改莊惠，蓋當時特恩，非舊典也。"
        },
        {
          "chapterId": "old-v102",
          "paragraphId": "old-v102-p15",
          "originalRevision": 1,
          "originalSha256": "1bb25d176b87052c3084dac62e247de4406218d0764cdf8d16ee96f914953677",
          "excerpt": "近代梁氏賜張宗奭妻號曰賢懿，又改為莊惠"
        }
      ],
      "notes": [
        "这是储氏实际名号经历；不是皇后或妃号。",
        "主条的乾祐二年十一月属于吴氏封顺德，不能挪作储氏赐号年月；未记此次赐号为身后追赠。"
      ]
    },
