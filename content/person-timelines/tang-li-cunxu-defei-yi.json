        }
      ]
    },
    {
      "id": "tang-li-cunxu-defei-yi-envoys",
      "title": "命册使行册",
      "summary": "本纪冬十月记正衙命宰臣豆卢革、韦说为韩淑妃、伊德妃的册使。",
      "year": 924,
      "sortOrder": 2,
      "precision": "day",
      "sourceDate": "同光二年冬十月庚午",
      "phase": "later",
      "evidence": [
