  "personId": "zhou-guo-wei-consort-yang",
  "events": [
    {
      "id": "zhou-guo-wei-consort-yang-posthumous-shufei",
      "title": "身后追册淑妃",
      "summary": "故夫人杨氏获追赠淑妃，所司择日备礼。",
      "year": 951,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "广顺元年九月辛酉",
      "phase": "posthumous",
      "evidence": [
        {
          "chapterId": "old-v111",
          "paragraphId": "old-v111-p7",
          "originalRevision": 1,
          "originalSha256": "0ed2ac2f61e7f23aa6612f4935d7d0558d61b79dbd068ddfbb217a32cfff322c",
          "excerpt": "辛酉，故夫人楊氏追贈淑妃，仍令所司擇日備禮冊命。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-yang-reinterment",
      "title": "从太原迁葬",
      "summary": "因灵柩在太原未能及时陪葬，嵩陵侧先营虚墓；世宗征河东时迁柩安葬，不写已攻克太原。",
      "year": 954,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "显德元年，世宗攻太原时",
      "phase": "posthumous",
      "evidence": [
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p6",
          "originalRevision": 1,
          "originalSha256": "eff32c71dfaf72b70709f78af19e50aa0d8339aaf32b1002e4c48423a94bc1c3",
          "excerpt": "顯德元年，世宗已敗劉旻於高平，遂攻太原，太原閉壁被圍，乃遷妃喪而葬之。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-yang-zhao-palace-and-displacement",
      "title": "入赵王宫及乱后流寓",
      "summary": "杨氏年幼时被选入王镕宫，镇州乱后流落民间；不补正式王妃名分。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "王镕在世及镇州乱前后",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p4",
          "originalRevision": 1,
          "originalSha256": "2da64a23d152233ff476456c55e1c479dc94817830e2bba6190646795a8aefed",
          "excerpt": "妃幼以色選入趙王宮，事王鎔。"
        },
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p4",
          "originalRevision": 1,
          "originalSha256": "2da64a23d152233ff476456c55e1c479dc94817830e2bba6190646795a8aefed",
          "excerpt": "鎔為張文禮所殺，鎮州亂，妃亦流寓民間，後嫁里人石光輔，居數年，光輔死。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-yang-first-marriage",
      "title": "嫁石光辅后守寡",
      "summary": "父母将杨氏嫁同乡石光辅，数年后夫亡。",
      "year": null,
      "sortOrder": 4,
      "precision": "undated",
      "sourceDate": "年月未详",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v121",
          "paragraphId": "old-v121-p3",
          "originalRevision": 1,
          "originalSha256": "9718d5cd22a32348d204edbbe5d81daacf6077b0ba1af6536598ff529208c175",
          "excerpt": "父母即以妃嫁於鄉人石光輔，不數年嫠居。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-yang-guo-marriage-and-household",
      "title": "为郭威继室并内助",
      "summary": "柴氏去世后，郭威礼聘杨氏为继室；旧史另有夹引婚聘说，并记其睦族抚孤、内助。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "太祖佐汉之初；年月未详",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v121",
          "paragraphId": "old-v121-p3",
          "originalRevision": 1,
          "originalSha256": "9718d5cd22a32348d204edbbe5d81daacf6077b0ba1af6536598ff529208c175",
          "excerpt": "太祖佐漢之初，屬聖穆皇后棄世，聞妃之賢，遂以禮聘之。"
        },
        {
          "chapterId": "old-v121",
          "paragraphId": "old-v121-p3",
          "originalRevision": 1,
          "originalSha256": "9718d5cd22a32348d204edbbe5d81daacf6077b0ba1af6536598ff529208c175",
          "excerpt": "妃睦族撫孤，宜家內助，甚有力焉。"
        }
      ]
    },
    {
      "id": "zhou-guo-wei-consort-yang-death-taiyuan",
      "title": "卒葬太原",
      "summary": "两史均记杨氏卒于太原及留葬，天福中与天福末的年次范围分源保留。",
      "year": null,
      "sortOrder": 6,
      "precision": "undated",
      "sourceDate": "晋天福末（旧史）；天福中（新史）",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v121",
          "paragraphId": "old-v121-p3",
          "originalRevision": 1,
          "originalSha256": "9718d5cd22a32348d204edbbe5d81daacf6077b0ba1af6536598ff529208c175",
          "excerpt": "晉天福末，卒於太原，因留葬於晉郊。"
        },
        {
          "chapterId": "new-v19",
          "paragraphId": "new-v19-p4",
          "originalRevision": 1,
          "originalSha256": "2da64a23d152233ff476456c55e1c479dc94817830e2bba6190646795a8aefed",
          "excerpt": "太祖方事漢高祖於太原，天福中妃卒，遂葬太原之近郊。"
        }
      ]
    }
  ]
}
