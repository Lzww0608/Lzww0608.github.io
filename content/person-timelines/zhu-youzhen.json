    {
      "id": "zhu-youzhen-head-reburial",
      "title": "晋朝归葬首级",
      "summary": "后晋准亲属旧僚收葬太社所藏首级，娄继英请领而获罪，最后命安崇阮收葬。",
      "year": 937,
      "sortOrder": 47,
      "precision": "month",
      "sourceDate": "后晋天福二年五月",
      "phase": "posthumous",
      "evidence": [
