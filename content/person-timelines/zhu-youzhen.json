          "originalSha256": "9496e4c8b80ac10834cee621a3051808a289eac86754323b7fb20ad87fcbcde4",
          "excerpt": "其貞明七年，宜改為龍德元年，應天下見禁罪人，除大辟罪外，遞減一等。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-youneng-amnesty",
      "title": "赦友能降房陵侯",
      "summary": "朱友能投降后援引议亲律予以宽免，只降为房陵侯，未处死。",
      "year": 921,
      "sortOrder": 35,
      "precision": "day",
      "sourceDate": "龙德元年七月庚子",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p19",
          "originalRevision": 1,
          "originalSha256": "0abe34dd890a30e1f3dd34f014633184c62a1f48b41ff9a8ea7bf8d6062f03b1",
          "excerpt": "特施貸法之恩，蓋舉議親之律。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-qicheng",
      "title": "戴思远戚城战败",
      "summary": "命北面招讨使戴思远攻德胜北城，晋军来援，梁军败于戚城。",
      "year": 921,
      "sortOrder": 36,
      "precision": "month",
      "sourceDate": "龙德元年十月",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p20",
          "originalRevision": 1,
          "originalSha256": "bdd8d3bebc670bf184c33a201a8e96f679702f9e47ac96fd5b3cd985fdb658c0",
          "excerpt": "冬十月，北面招討使戴思遠攻德勝寨之北城，晉人來援，思遠敗於戚城。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-weicheng",
      "title": "袭魏州再攻德胜",
      "summary": "趁晋王攻镇州，戴思远袭魏州取成安，攻德胜北城；晋王二月救援后梁军退回杨村。",
      "year": 922,
      "sortOrder": 37,
      "precision": "month",
      "sourceDate": "龙德二年正月至二月",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p22",
          "originalRevision": 1,
          "originalSha256": "0c5e2f0399b348eec035d2974663b8f91eb5c482a7688fa0057398e6154eb609",
          "excerpt": "龍德二年春正月，戴思遠率師襲魏州。"
        },
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p23",
          "originalRevision": 1,
          "originalSha256": "991145d26df846b770cf05c96579c7a9fd6b3c9b720a7386b37fbd87666a8e85",
          "excerpt": "二月，晉王以兵至，思遠收軍而退，復保楊村。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-weisupply",
      "title": "收卫州并夺晋军储",
      "summary": "段凝、张朗攻下卫州，戴思远连取淇门、共城、新乡，旧史称晋军失三分之一军储。",
      "year": 922,
      "sortOrder": 38,
      "precision": "month",
      "sourceDate": "龙德二年八月",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p24",
          "originalRevision": 1,
          "originalSha256": "bb7bbfcc557d1c83a5796d41f31646d9872bdcf73c686ec554b2d7d493e52064",
          "excerpt": "八月，段凝、張朗攻衛州，下之，獲刺史李存儒以獻。戴思遠又下淇門、共城、新鄉等三縣。自是澶州之西、相州之南，皆為梁有，晉人失軍儲三分之一焉。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-jitao",
      "title": "接受李继韬潞州归附",
      "summary": "李继韬囚兄后献潞州并送幼子为质，裴约不从，朱友贞任董璋攻泽州。",
      "year": 923,
      "sortOrder": 39,
      "precision": "month",
      "sourceDate": "龙德三年三月",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p26",
          "originalRevision": 1,
          "originalSha256": "56bf41ff08e952cf2ed43597a76ec670e65b370d60364694b9ce106e108732e9",
          "excerpt": "澤州刺史裴約不從繼韜之謀，帝命董璋為澤州刺史，令將兵攻之。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-yuncheng-loss",
      "title": "郓州失守诛逃将",
      "summary": "唐军袭下郓州，逃回京师的刘遂严、燕颙被处死。",
      "year": 923,
      "sortOrder": 40,
      "precision": "day",
      "sourceDate": "龙德三年闰四月壬寅",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p28",
          "originalRevision": 1,
          "originalSha256": "c4ed5043715ca831b50d710fd8e37576a254c3371f4c9da68e3603de0dc7c813",
          "excerpt": "閏月壬寅，唐軍襲鄆州，陷之。巡檢使前陳州刺史劉遂嚴，本州都指揮使燕顒奔歸京師，皆斬於都市。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-wang-yanzhang",
      "title": "任王彦章招讨取德胜南城",
      "summary": "任王彦章为北面行营招讨使，水军断浮桥、取德胜南城，促使唐军合兵杨刘，但后续攻新垒失败。",
      "year": 923,
      "sortOrder": 41,
      "precision": "month",
      "sourceDate": "龙德三年五月至六月",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p29",
          "originalRevision": 1,
          "originalSha256": "78655d0581486d41c184a4399caf9b3bd1932fb960403bad0423d601f74df31e",
          "excerpt": "五月，以滑州節度使王彥章為北面行營招討使。"
        },
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p29",
          "originalRevision": 1,
          "originalSha256": "78655d0581486d41c184a4399caf9b3bd1932fb960403bad0423d601f74df31e",
          "excerpt": "辛酉，王彥章率舟師自楊村寨浮河而下，斷德勝之浮梁。攻南城，下之，殺數十人。"
        },
        {
          "chapterId": "old-v010",
          "paragraphId": "old-v010-p30",
          "originalRevision": 1,
          "originalSha256": "8c23b1020198658139c025e5130181933fbc7bf798203aa1a967c410d15084ec",
          "excerpt": "戊子，王彥章、杜晏球率兵急攻博州之新壘，不克，遂退保於鄒口。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-duan-command",
      "title": "段凝代主帅康延孝泄军机",
      "summary": "八月以段凝代王彦章；康延孝率百骑投唐并泄军机，梁另命王彦章屯郓州东境。",
      "year": 923,
      "sortOrder": 42,
      "precision": "month",
      "sourceDate": "龙德三年八月",
      "phase": "rule",
      "evidence": [
