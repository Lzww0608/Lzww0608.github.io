  "events": [
    {
      "id": "zhu-youzhen-birth",
      "title": "生于东京",
      "summary": "母张氏生下朱友贞；两史对他是朱温第三子还是第四子不同。",
      "year": 888,
      "sortOrder": 1,
      "precision": "day",
      "sourceDate": "唐文德元年九月十二日",
      "phase": "early",
      "evidence": [
        {
          "chapterId": "old-v008",
          "paragraphId": "old-v008-p1",
          "originalRevision": 1,
          "originalSha256": "fb211b10a76a3d1bcf9fa3566ff3f1462eeab3181804a8920a6dd372f175a3f9",
          "excerpt": "太祖第四子也。母曰元貞皇后張氏。以唐文德元年戊申歲九月十二日生於東京。"
        }
      ],
      "variants": [
        {
          "label": "新史第三子",
          "year": 888,
          "sourceDate": "本纪开篇未另记生年月",
          "summary": "新史称太祖第三子，旧史第四子；不改写两书。",
          "evidence": [
            {
              "chapterId": "new-v03",
              "paragraphId": "new-v03-p1",
              "originalRevision": 1,
              "originalSha256": "9ef65d3255c9f11f871943d877388817906e5d7a6a978aa10312121b6e94c7ca",
              "excerpt": "末帝，太祖第三子友貞也。"
            }
          ]
        }
      ]
    },
    {
      "id": "zhu-youzhen-jun-prince",
      "title": "封均王掌天兴亲军",
      "summary": "朱温建立后梁后，封均王，授左天兴军使，掌最亲近的卫军。",
      "year": 907,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "太祖受禅时",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v008",
          "paragraphId": "old-v008-p1",
          "originalRevision": 1,
          "originalSha256": "fb211b10a76a3d1bcf9fa3566ff3f1462eeab3181804a8920a6dd372f175a3f9",
          "excerpt": "太祖受禪，封均王。時太祖初置天興軍，最為親衛，以帝為左天興軍使。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-tokyo-command",
      "title": "统东京马步军",
      "summary": "进检校司空，保留天兴军使，并任东京马步军都指挥使。",
      "year": 910,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "开平四年夏",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v008",
          "paragraphId": "old-v008-p1",
          "originalRevision": 1,
          "originalSha256": "fb211b10a76a3d1bcf9fa3566ff3f1462eeab3181804a8920a6dd372f175a3f9",
          "excerpt": "開平四年夏，進位檢校司空，依前天興軍使，充東京馬步軍都指揮使。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-friend-death",
      "title": "父遇弑后任东京留守",
      "summary": "朱友珪弑父后假传诏书命其害朱友文，继而授其东京留守、开封府尹；本条记所受命令，不额外推定杀害的执行细节。",
      "year": 912,
      "sortOrder": 4,
      "precision": "month",
      "sourceDate": "乾化二年六月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v008",
          "paragraphId": "old-v008-p3",
          "originalRevision": 1,
          "originalSha256": "15ddf9d9b521c86d7a0f383d4a90bbe38c3c1e907639d09536abbafedb396c30",
          "excerpt": "乾化二年六月二日，庶人友珪弑逆，矯太祖詔，遣供奉官丁昭溥馳至東京，密令帝害博王友文。友珪即位，以帝為東京留守，行開封府尹，檢校司徒。"
        }
      ]
    },
    {
      "id": "zhu-youzhen-overthrow-yougui",
      "title": "联赵岩杨师厚策动禁军",
      "summary": "与赵岩密谋，遣马慎交说服杨师厚，再由袁象先发动洛阳禁军；通过展示朱温画像及坑杀传言激怒东京龙骧军。",
      "year": 913,
      "sortOrder": 5,
      "precision": "month",
      "sourceDate": "凤历元年二月十五日至十七日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v008",
          "paragraphId": "old-v008-p3",
          "originalRevision": 1,
          "originalSha256": "15ddf9d9b521c86d7a0f383d4a90bbe38c3c1e907639d09536abbafedb396c30",
          "excerpt": "帝令腹心馬慎交之魏州見師厚，且言成事之日，賜勞軍錢五十萬緡，仍許兼鎮。"
        }
      ],
      "notes": [
        "旧史正文与考异夹注对是否伪作征军诏有分歧，正式异说另列。"
      ],
      "variants": [
        {
          "label": "考异认为征军诏是真的",
          "year": 913,
          "sourceDate": "凤历元年二月政变前",
          "summary": "旧史正文、新史称朱友贞伪作诏，考异引实录认为征军诏确为友珪发出，友贞只是用坑杀传言激怒兵众。",
          "evidence": [
            {
              "chapterId": "old-v008",
              "paragraphId": "old-v008-p3",
              "originalRevision": 1,
              "originalSha256": "15ddf9d9b521c86d7a0f383d4a90bbe38c3c1e907639d09536abbafedb396c30",
              "excerpt": "實友珪征之，非友貞偽作，但激怒言坑之耳。"
            },
            {
              "chapterId": "new-v03",
              "paragraphId": "new-v03-p6",
              "originalRevision": 1,
              "originalSha256": "284da97e4e53dc6846016de362b330d38e7dca8cd77db4850725c54833d58134",
              "excerpt": "王乃偽為友珪詔書，發左右龍驤在東都者皆還洛陽"
            }
          ]
        }
      ]
    },
    {
      "id": "zhu-youzhen-accession",
      "title": "即位东京复乾化年号",
      "summary": "袁象先杀朱友珪后奉传国宝请至洛阳即位，朱友贞坚持在东京受册，复称乾化三年并恢复朱友文官爵。",
      "year": 913,
      "sortOrder": 6,
      "precision": "month",
      "sourceDate": "乾化三年二月；两史均未记唯一即位日",
      "phase": "rule",
      "evidence": [
        {
          "chapterId": "old-v008",
          "paragraphId": "old-v008-p5",
          "originalRevision": 1,
          "originalSha256": "b28554c659a7781b48ed4be89e59c3f91405d652c23e0b0633541d6d00faf922",
          "excerpt": "是月，帝即位於東京，乃去珪曆之號，稱乾化三年。"
        },
        {
          "chapterId": "new-v03",
          "paragraphId": "new-v03-p6",
          "originalRevision": 1,
          "originalSha256": "284da97e4e53dc6846016de362b330d38e7dca8cd77db4850725c54833d58134",
          "excerpt": "象先遣趙巖持傳國寶至東都，請王入洛陽，王報曰：「夷門，太祖所以興王業也，北拒并汾，東至淮海，國家藩鎮，多在東方，命將出師，利於便近。」是月，皇帝即位於東都，〈即位大事，失其日而書「是月」，見亂之甚。「於東都」，終上文也。〉復稱乾化三年，復博王友文官爵。"
        }
      ]
    },
