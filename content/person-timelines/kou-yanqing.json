    {
      "id": "kou-yanqing-bridge",
      "title": "天津桥害民，被降官",
      "summary": "寇彦卿行经天津桥时其出行队伍害死未避道者，御史弹劾，朱温不得已降其官；后来重新任相州、河阳。",
      "year": null,
      "sortOrder": 8,
      "precision": "undated",
      "sourceDate": "入金吾后，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
