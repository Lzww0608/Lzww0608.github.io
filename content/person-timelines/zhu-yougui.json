    },
    {
      "id": "zhu-yougui-birth",
      "title": "生于亳州，幼名遥喜",
      "summary": "父朱温与亳州女子生下他，幼名遥喜，后来迎至汴。两书分别称母为营妓、逆旅妇，不虚造母姓或确切生年。",
      "year": null,
      "sortOrder": 13,
      "precision": "undated",
      "sourceDate": "唐光启中及其后，出生确年未记",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v012",
          "paragraphId": "old-v012-p11",
          "originalRevision": 1,
          "originalSha256": "02471d1f936f4e6f34494af69e0910043cf7f1fd96b20665a1ae8f2a7a373f19",
          "excerpt": "及期，妓以生男來告，帝喜，故字之曰遙喜。後迎歸汴。"
        },
        {
          "chapterId": "new-v13",
          "paragraphId": "new-v13-p45",
          "originalRevision": 1,
          "originalSha256": "cc889a04d0fff0014a3433a58d564d9e45971bb60d5d664a3ccb77ea23225d93",
          "excerpt": "庶人友珪者，太祖初鎮宣武，略地宋，亳間，與逆旅婦人野合而生也。"
        }
      ]
    }
  ]
