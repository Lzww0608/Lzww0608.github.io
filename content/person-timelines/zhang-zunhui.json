{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "zhang-zunhui",
  "events": [
    {
      "id": "zhang-zunhui-court-ceremony",
      "title": "任客省使并筹备南郊仪仗",
      "summary": "天成四年入朝为客省使、守卫尉卿，朝廷将举行南郊祭礼时任修仪仗法物使。",
      "year": 929,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天成四年；本纪六月癸卯入客省、行卫尉，八月甲辰授修装法物",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p16",
          "originalRevision": 1,
          "originalSha256": "2860a5eb2e81be8b6f0cc429cdd1fe4215303fe3e3e2f74382d1f38e89b93325",
          "excerpt": "天成四年，入為客省使、守衛尉卿。及將有事於南郊，為修儀仗法物使。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p1",
          "originalRevision": 1,
          "originalSha256": "0054c469431a207098a81b3c128a9e1e96f104c5218a747d057984453e900925",
          "excerpt": "天成四年春正月壬申朔，帝御崇元殿受朝賀，仗衛如儀。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p6",
          "originalRevision": 1,
          "originalSha256": "17090de0c22a11bb5b5639c3f3967470883ce476d868e66204102be1dd990661",
          "excerpt": "六月辛丑，以左散騎常侍姚顗為兵部侍郎。壬寅，夔州節度使楊漢章移鎮雲州，以北京馬步軍都指揮使兼欽州刺史張敬達為鳳州節度使。癸卯，以前西京副留守事張遵誨行衛尉事，充客省使。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p8",
          "originalRevision": 1,
          "originalSha256": "eec7f52552a5eef0b3235e7baa01dc4de0ba99c09f4d8fb6322b5ec9e2d97aaa",
          "excerpt": "八月丁酉朔，大理正路阮奏：「切見春秋釋奠於文宣王，而武成王廟久曠時祭，請復常祀。」從之。"
        },
        {
          "chapterId": "old-v040",
          "paragraphId": "old-v040-p8",
          "originalRevision": 1,
          "originalSha256": "eec7f52552a5eef0b3235e7baa01dc4de0ba99c09f4d8fb6322b5ec9e2d97aaa",
          "excerpt": "甲辰，以宰臣馮道為南郊大禮使，兵部尚書盧質為禮儀使，御史中丞許光義為儀仗使，兵部侍郎姚顗為鹵簿使，河南尹從榮為橋道頓遞使，客省使、衛尉卿張遵誨為修裝法物使。"
        }
      ]
    },
    {
      "id": "zhang-zunhui-join-hedong",
      "title": "父遇害后奔太原为牙门将",
      "summary": "父任宗城县令，在罗绍威杀牙军之年为梁军所害，张遵诲逃太原，被李克用用为牙门将。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "罗绍威杀牙军之岁，传中未写年号",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p16",
          "originalRevision": 1,
          "originalSha256": "2860a5eb2e81be8b6f0cc429cdd1fe4215303fe3e3e2f74382d1f38e89b93325",
          "excerpt": "父為宗城令，羅紹威殺牙軍之歲，為梁軍所害。遵誨奔太原，武皇以為牙門將。"
        }
      ]
    },
    {
      "id": "zhang-zunhui-guest-service",
      "title": "以典客从军，历幽镇军职",
      "summary": "随李存勖定山东，以典客身份从军，历幽镇两府马步都虞候，同光中任金吾大将军。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "庄宗定山东至同光中",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p16",
          "originalRevision": 1,
          "originalSha256": "2860a5eb2e81be8b6f0cc429cdd1fe4215303fe3e3e2f74382d1f38e89b93325",
          "excerpt": "莊宗定山東，遵誨以典客從，曆幽、鎮二府馬步都虞候。同光中，為金吾大將軍。"
        }
      ]
    },
    {
      "id": "zhang-zunhui-xijing",
      "title": "任圜保荐，任西都副留守",
      "summary": "李嗣源即位后经任圜保荐，授西都副留守，知留守事、京兆尹。",
      "year": null,
      "sortOrder": 4,
      "precision": "range",
      "sourceDate": "明宗即位后任圜保荐；本纪天成三年六月戊戌已称西京副留守、知留守事并行京兆尹，授职不晚于928年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p16",
          "originalRevision": 1,
          "originalSha256": "2860a5eb2e81be8b6f0cc429cdd1fe4215303fe3e3e2f74382d1f38e89b93325",
          "excerpt": "明宗即位，任圜保薦，授西都副留守，知留守事、京兆尹。"
        },
        {
          "chapterId": "old-v039",
          "paragraphId": "old-v039-p7",
          "originalRevision": 1,
          "originalSha256": "ce614b42bb9f919c2c0410ada5ad559938065845a7cf1374433abd1516926b0f",
          "excerpt": "戊戌，以西京副留守、知留守事張遵誨行京兆尹。"
        }
      ],
      "yearRange": {
        "start": 926,
        "end": 928
      }
    },
    {
      "id": "zhang-zunhui-death-jiangzhou",
      "title": "只授绛州刺史，到任后去世",
      "summary": "原盼节度使，郊祀后只获绛州刺史，郁郁不乐；白衣离京，到郡次日去世。本传未记具体卒年。",
      "year": null,
      "sortOrder": 5,
      "precision": "undated",
      "sourceDate": "郊禋毕后",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v061",
          "paragraphId": "old-v061-p16",
          "originalRevision": 1,
          "originalSha256": "2860a5eb2e81be8b6f0cc429cdd1fe4215303fe3e3e2f74382d1f38e89b93325",
          "excerpt": "及郊禋畢，止為絳州刺史，鬱鬱不樂。離京之日，白衣乘馬於隼之下，至郡無疾，翌日而卒。"
        }
      ]
    }
  ]
}
