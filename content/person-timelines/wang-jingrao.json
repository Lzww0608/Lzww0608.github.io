      ]
    },
    {
      "id": "wang-jingrao-death",
      "title": "病退后卒于家",
      "summary": "病退后在家中去世，新旧本传均未单独记死亡年日。",
      "year": null,
      "sortOrder": 9,
      "precision": "undated",
      "phase": "uncertain",
      "sourceDate": "开平元年致仕后，死期未独记",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p9",
          "originalRevision": 1,
          "originalSha256": "26c1ce131a5ac68f49693a615f89876b16cea2558074092fa921016a69432c52",
          "excerpt": "開平元年八月，以疾致仕，尋卒於其第。"
        },
        {
          "chapterId": "new-v43",
          "paragraphId": "new-v43-p45",
          "originalRevision": 1,
          "originalSha256": "cf43446297ecb8656164c2434b719eb48daeebbe072aedc9ff100bfa067b82af",
