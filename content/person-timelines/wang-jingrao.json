    },
    {
      "id": "wang-jingrao-left-guard",
      "title": "转左卫上将军",
      "summary": "天祐三年转左卫上将军，新旧本传同记。",
      "year": null,
      "sortOrder": 8,
      "precision": "range",
      "phase": "uncertain",
      "sourceDate": "天祐三年",
      "evidence": [
