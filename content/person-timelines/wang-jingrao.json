  "personId": "wang-jingrao",
  "events": [
    {
      "id": "wang-jingrao-retire",
      "title": "因病致仕",
      "summary": "开平元年八月因病退休；其后在家去世另记，不把死年定在907。",
      "year": 907,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "开平元年八月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p9",
          "originalRevision": 1,
          "originalSha256": "26c1ce131a5ac68f49693a615f89876b16cea2558074092fa921016a69432c52",
          "excerpt": "開平元年八月，以疾致仕，尋卒於其第。"
        }
      ],
      "notes": [
        "907年是明记退休时间，死期只记“寻卒”，不据此编造卒月日。"
      ]
    },
    {
      "id": "wang-jingrao-early",
      "title": "代郡守抗乱，任颍州刺史",
      "summary": "王敬荛早在颍州军中，战乱加剧而郡守不能自固，他代守州事、获刺史。旧史记中和初，新史从王仙芝等起乱叙起。",
      "year": null,
      "sortOrder": 2,
      "precision": "undated",
      "sourceDate": "旧史中和初、新史唐末叙事，未记确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p9",
          "originalRevision": 1,
          "originalSha256": "26c1ce131a5ac68f49693a615f89876b16cea2558074092fa921016a69432c52",
          "excerpt": "唐乾符初，敬蕘為本州都知兵馬使。中和初，寇難益熾，郡守庸怯，不能自固，敬蕘遂代之監郡，俄真拜刺史，加檢校右散騎常侍。"
        },
        {
          "chapterId": "new-v43",
          "paragraphId": "new-v43-p42",
          "originalRevision": 1,
          "originalSha256": "ec6e42236fd18987011f33bcf4c49696b9007e0f2acc20b049a8518d94cd6fb5",
          "excerpt": "王敬蕘，潁州汝陰人也。事州為牙將。唐末，王仙芝等攻劫汝、潁間，刺史不能拒，敬蕘遂代之，即拜刺史。敬蕘為人狀貌魁傑，而沈勇有力，善用鐵槍，重三十斤。"
        }
      ]
    },
    {
      "id": "wang-jingrao-defense",
      "title": "守颍州，拒黄巢及秦宗权军",
      "summary": "王敬荛先后拒黄巢、秦宗权及刁君务军，保住颍州，邻近百姓投避兵乱。",
      "year": null,
      "sortOrder": 3,
      "precision": "undated",
      "sourceDate": "颍州刺史期间，未逐役记年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p9",
          "originalRevision": 1,
          "originalSha256": "26c1ce131a5ac68f49693a615f89876b16cea2558074092fa921016a69432c52",
          "excerpt": "時州境荒饉，大寇繼至，黃巢數十萬眾寨於州南，敬蕘極力抗禦，逾旬而退。俄又宗權之眾，淩暴益甚，合圍攻壁，皆力屈而去。蔡賊復遣將刁君務以萬眾來逼，敬蕘列陣當之，身先馳突，殺敵甚多，由是竟全郡壘，遠近歸附。及淮人不恭，太祖屢以軍南渡，路由州境，敬蕘悉心供億，太祖甚嘉之。"
        },
        {
          "chapterId": "new-v43",
          "paragraphId": "new-v43-p43",
          "originalRevision": 1,
          "originalSha256": "27490d6cb4b09085f60b0e6d314f95a28dd46ad9a47686050bd7d79cbd571f23",
          "excerpt": "潁州與淮西為鄰境，數為秦宗權所攻，力戰拒之，宗權悉陷河南諸州，獨敬蕘不可下，由是潁旁諸州民，皆保敬蕘避賊。是時，所在殘破，獨潁州戶二萬。"
        }
      ]
    },
    {
      "id": "wang-jingrao-huai-command",
      "title": "供朱温军，任沿淮指挥使",
      "summary": "朱温南渡经颍州，王敬荛尽供军需，任沿淮上下都指挥使。",
      "year": null,
      "sortOrder": 4,
      "precision": "range",
      "sourceDate": "乾宁二年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p9",
          "originalRevision": 1,
          "originalSha256": "26c1ce131a5ac68f49693a615f89876b16cea2558074092fa921016a69432c52",
          "excerpt": "及淮人不恭，太祖屢以軍南渡，路由州境，敬蕘悉心供億，太祖甚嘉之。乾寧二年，署為沿淮上下都指揮使。"
        }
      ],
      "yearRange": {
        "start": 895,
        "end": 896
      },
      "notes": [
        "原书记年未载本事月日，传统年份可能跨至下一西历年，按有据范围保留。"
      ]
    },
    {
      "id": "wang-jingrao-qingkou",
      "title": "接济清口败军，获武宁留后",
      "summary": "乾宁四年冬，庞师古清口败后逃军饥寒过颍，王敬荛沿路点柴、备粥饼接济，全活者多，获武宁节度徐宿观察留后。冬季跨897–898，数月后的正任另列。",
      "year": null,
      "sortOrder": 5,
      "precision": "range",
      "sourceDate": "乾宁四年冬，清口败后；冬季跨西历897–898",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p9",
          "originalRevision": 1,
          "originalSha256": "26c1ce131a5ac68f49693a615f89876b16cea2558074092fa921016a69432c52",
          "excerpt": "四年冬，龐師古敗於清口，敗軍逃歸者甚眾，路出於潁。時雨雪連旬，軍士凍餒，敬蕘自淮燎薪，相屬於道，郡中設糜糗餅餌以待之，全活者甚眾，由是表知武寧軍節度、徐宿觀察留後。"
        }
      ],
      "notes": [
        "受正任在数月之后，不能由冬季起点强定授职同年。"
      ],
      "yearRange": {
        "start": 897,
        "end": 898
      }
    },
    {
      "id": "wang-jingrao-wuning",
      "title": "数月后正式授武宁节度",
      "summary": "接济清口败军获留后数月后，正式任武宁军节度使；旧传至天复二年入朝前未再列独年，不压为897年。",
      "year": null,
      "sortOrder": 6,
      "precision": "range",
      "phase": "uncertain",
      "sourceDate": "乾宁四年冬留后数月后、天复二年入朝之前；上界传统年跨902—903年",
      "evidence": [
        {
          "chapterId": "old-v020",
          "paragraphId": "old-v020-p9",
          "originalRevision": 1,
          "originalSha256": "26c1ce131a5ac68f49693a615f89876b16cea2558074092fa921016a69432c52",
          "excerpt": "由是表知武寧軍節度、徐宿觀察留後。數月，真拜武寧軍節度使。天復二年，入為右龍武統軍。"
        },
        {
          "chapterId": "new-v43",
          "paragraphId": "new-v43-p44",
          "originalRevision": 1,
          "originalSha256": "563069c8713262bf6bdbf2b7debc2db76272c2872a94b31308ebcb46c29ddc84",
          "excerpt": "梁太祖攻淮南，道過潁州，敬蕘供饋梁兵甚厚，太祖大喜，表敬蕘沿淮指揮使。其後梁兵攻吳，龐師古死清口，敗兵亡歸，過潁，大雪，士卒飢凍，敬蕘乃沿淮積薪為作糜粥餔之，亡卒多賴以全活，太祖表敬蕘武寧軍留後，遂拜節度使。"
        }
      ],
      "yearRange": {
        "start": 897,
        "end": 903
      }
    },
    {
      "id": "wang-jingrao-guards",
      "title": "入朝任右龙武统军",
      "summary": "天复二年由武宁节度入朝任右龙武统军。",
      "year": null,
      "sortOrder": 7,
      "precision": "range",
