{
  "schemaVersion": 1,
  "scope": "current-archive",
  "personId": "li-cunzhang",
  "events": [
    {
      "id": "li-cunzhang-succession",
      "title": "受遗命辅立李存勖",
      "summary": "李克用临终托付张承业、李存璋；李存璋参与拥立李存勖为晋王及平定内难，改河东马步都虞候，兼管盐铁。",
      "year": 908,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天祐五年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p16",
          "originalRevision": 1,
          "originalSha256": "1d81d0834b136dc1ccfe7b8eb039de158060e8d7fa9bf7022d9608530dda2c0d",
          "excerpt": "五年，武皇疾篤，召張承業與存璋授遺顧。存璋爰立莊宗，夷內難，頗有力焉。改河東馬步都虞候，兼領鹽鐵。"
        }
      ]
    },
    {
      "id": "li-cunzhang-discipline",
      "title": "整顿军纪，抑强扶弱",
      "summary": "李存勖嗣晋王后，李存璋惩处侵扰街市、豪夺财物的军中头目，整顿治安并劝耕，军府纲纪得到恢复。",
      "year": 908,
      "sortOrder": 2,
      "precision": "year",
      "sourceDate": "庄宗初嗣晋王位之后",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p16",
          "originalRevision": 1,
          "originalSha256": "1d81d0834b136dc1ccfe7b8eb039de158060e8d7fa9bf7022d9608530dda2c0d",
          "excerpt": "初，武皇稍寵軍士，籓部人多干擾廛市，肆其豪奪，法司不能禁。莊宗初嗣位，銳於求理。存璋得行其志，抑強撫弱，誅其豪首，期月之間，紀綱大振，弭群盜，務耕稼，去奸宄，息幸門，當時稱其材干。從破汴軍於夾城，轉檢校司徒。"
        }
      ]
    },
    {
      "id": "li-cunzhang-baixiang",
      "title": "柏乡之役任排阵使",
      "summary": "柏乡之役，李存璋任三镇排阵使；庄宗本纪记晋军未成列时，他引诸军在野河上列阵。此前已参加潞州夹城战事，不把那一役也放在911年。",
      "year": 911,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "柏乡之役",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p16",
          "originalRevision": 1,
          "originalSha256": "1d81d0834b136dc1ccfe7b8eb039de158060e8d7fa9bf7022d9608530dda2c0d",
          "excerpt": "從破汴軍於夾城，轉檢校司徒。柏鄉之役，為三鎮排陣使。"
        },
        {
          "chapterId": "old-v027",
          "paragraphId": "old-v027-p18",
          "originalRevision": 1,
          "originalSha256": "de49e1ff063f825d97e656961116066c92a3fbf2f0457ff9963d5b2d56204ec6",
          "excerpt": "天祐八年正月丁亥，周德威、史建瑭帥三千騎致師於柏鄉，設伏於村塢間，遣三百騎直壓其營。"
        },
        {
          "chapterId": "old-v027",
          "paragraphId": "old-v027-p18",
          "originalRevision": 1,
          "originalSha256": "de49e1ff063f825d97e656961116066c92a3fbf2f0457ff9963d5b2d56204ec6",
          "excerpt": "時帝軍未成列，李存璋引諸軍陣於野河之上，"
        }
      ],
      "notes": [
        "夹城之役为此前908年，911年排序对应柏乡之役。"
      ]
    },
    {
      "id": "li-cunzhang-taiyuan",
      "title": "率汾州兵入太原固守",
      "summary": "王檀袭太原时，李存璋率汾州军入城防守，获授大同防御使及应、蔚、朔等州军职。",
      "year": 916,
      "sortOrder": 4,
      "precision": "year",
      "sourceDate": "晋天祐十三年；《通鉴》同役接于贞明二年二月记事",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p16",
          "originalRevision": 1,
          "originalSha256": "1d81d0834b136dc1ccfe7b8eb039de158060e8d7fa9bf7022d9608530dda2c0d",
          "excerpt": "十三年，王檀逼太原，存璋率汾州之軍入城固守，授大同防禦使、應蔚朔等州都知兵馬使。"
        },
        {
          "chapterId": "tongjian-v269",
          "paragraphId": "tongjian-v269-p59",
          "originalRevision": 1,
          "originalSha256": "1a6a99fb2f132d1a3f5a6db5429a0e31317c62dbde6f246265ef190b633f6985",
          "excerpt": "均王上貞明二年（丙子，公元九一六年）"
        },
        {
          "chapterId": "tongjian-v269",
          "paragraphId": "tongjian-v269-p62",
          "originalRevision": 1,
          "originalSha256": "51bfa445846adc9c17a51a8b7111a4ee383b98438afabe950175dbd18ce94725",
          "excerpt": "二月，辛丑夜，吳宿衛將馬謙、李球劫吳王登樓，發庫兵討徐知訓。知訓將出走，嚴可求曰：「軍城有變，公先棄眾自去，眾將何依！」知訓乃止。眾猶疑懼，可求闔戶而寢，鼾息聞於外，府中稍安。壬寅，謙等陳於天興門外，諸道副都統朱瑾自潤州至，視之，曰：「不足畏也。」返顧外眾，舉手大呼，亂兵皆潰，擒謙、球，斬之。"
        }
      ]
    },
    {
      "id": "li-cunzhang-datong",
      "title": "拒契丹，熔铁车制造兵器",
      "summary": "契丹进攻蔚州、云州，李存璋斩拒索财的使者，并把城中古铁车熔铸成兵器供军士使用，敌退后升大同军节度使。",
      "year": 916,
      "sortOrder": 5,
      "precision": "year",
      "sourceDate": "天祐十三年秋",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p16",
          "originalRevision": 1,
          "originalSha256": "1d81d0834b136dc1ccfe7b8eb039de158060e8d7fa9bf7022d9608530dda2c0d",
          "excerpt": "秋，契丹攻蔚州，安巴堅遣使馳木書求賂，存璋斬其使。契丹逼雲州，存璋拒守，城中有古鐵車，乃熔為兵仗，以給軍士。敵退，以功加檢校太傅、大同軍節度使、應蔚等州觀察使。十九年四月，以疾卒於雲州府第。"
        }
      ]
    },
    {
      "id": "li-cunzhang-death",
      "title": "病逝云州，身后赠官有异",
      "summary": "李存璋病逝于云州府第。旧史记同光初赠太保、平章事及后晋天福初赠太师；新史则记追赠太尉。",
      "year": 922,
      "sortOrder": 6,
      "precision": "year",
      "sourceDate": "天祐十九年四月",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p16",
          "originalRevision": 1,
          "originalSha256": "1d81d0834b136dc1ccfe7b8eb039de158060e8d7fa9bf7022d9608530dda2c0d",
          "excerpt": "十九年四月，以疾卒於雲州府第。同光初，追贈太保、平章事。晉天福初，追贈太師。"
        }
      ],
      "variants": [
        {
          "label": "新史所记追赠",
          "sourceDate": "天祐十九年卒后",
          "summary": "新史记追赠太尉，未详同光、天福两次追赠。",
          "evidence": [
            {
              "chapterId": "new-v36",
              "paragraphId": "new-v36-p30",
              "originalRevision": 1,
              "originalSha256": "67c2f448e8d6ffa8e987dd379bd457ffbee962022f6857a26f2b2b3a8cf108d7",
              "excerpt": "天祐十九年以疾卒。追贈太尉。"
            }
          ]
        }
      ]
    },
    {
      "id": "li-cunzhang-zezhou",
      "title": "任泽州刺史",
      "summary": "李存璋在光化二年获授泽州刺史，随后入任牢城使。原传接记他随李嗣昭平云州王晖之乱，升教练使、检校司空，但这项后续事迹未另记年月。",
      "year": null,
      "sortOrder": 7,
      "precision": "range",
      "sourceDate": "光化二年任泽州；后续讨云州另属接叙",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p16",
          "originalRevision": 1,
          "originalSha256": "1d81d0834b136dc1ccfe7b8eb039de158060e8d7fa9bf7022d9608530dda2c0d",
          "excerpt": "光化二年，授澤州刺史，入為牢城使。從李嗣昭討雲州叛將王暉，平之，改教練使、檢校司空。"
        }
      ],
      "yearRange": {
        "start": 899,
        "end": 900
      },
      "notes": [
        "原书记年未记本事月日；该传统年份跨两个西历年份，以范围显示，不把年号起算年当作唯一发生年。",
        "所列西历范围依据授泽州的光化二年；后续讨云州、升教练使等的具体年月未定。"
      ]
    },
    {
      "id": "li-cunzhang-fenzhou",
      "title": "盟朱友谦后领汾州",
      "summary": "李存璋随李存勖在猗氏与朱友谦结盟，领汾州刺史；梁将尹皓攻慈州时，他迎击并获胜。",
      "year": null,
      "sortOrder": 8,
      "precision": "range",
      "sourceDate": "天祐十一年；击尹皓未记另年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p16",
          "originalRevision": 1,
          "originalSha256": "1d81d0834b136dc1ccfe7b8eb039de158060e8d7fa9bf7022d9608530dda2c0d",
          "excerpt": "十一年，從盟硃友謙於猗氏，授汾州刺史。汴將尹皓攻慈州，逆戰敗之。"
        }
      ],
      "yearRange": {
        "start": 914,
        "end": 915
      },
      "notes": [
        "原书记年未记本事月日；该传统年份跨两个西历年份，以范围显示，不把年号起算年当作唯一发生年。"
      ]
    },
    {
      "id": "li-cunzhang-early",
      "title": "从云中起兵，随军入关",
      "summary": "李存璋与康君立、薛志勤等早年为李克用奔走，随军入关，先后管万胜、雄威等军，后任义儿军使。",
      "year": null,
      "sortOrder": 9,
      "precision": "undated",
      "sourceDate": "武皇初起云中至入关，未记本传确年",
      "phase": "uncertain",
      "evidence": [
        {
          "chapterId": "old-v053",
          "paragraphId": "old-v053-p16",
          "originalRevision": 1,
          "originalSha256": "1d81d0834b136dc1ccfe7b8eb039de158060e8d7fa9bf7022d9608530dda2c0d",
          "excerpt": "武皇初起雲中，存璋與康君立、薛志勤等為奔走交，從入關，以功授國子祭酒，累管萬勝、雄威等軍。從討李匡儔，改義兒軍使。光化二年，授澤州刺史，入為牢城使。"
        }
      ]
    }
  ]
}
