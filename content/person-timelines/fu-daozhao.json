  "events": [
    {
      "id": "fu-daozhao-wugong-battle",
      "title": "屯武功拒朱温，被康怀英击败",
      "summary": "李茂贞遣符道昭率军屯武功，抵御朱温。朱温以康怀英为前锋击破其军；《通鉴》称康怀贞。此战未记符道昭随即归降。",
      "year": 901,
      "sortOrder": 0,
      "precision": "day",
      "sourceDate": "天复元年十一月癸亥；旧史康怀英传记天复元年冬",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p18",
          "originalRevision": 1,
          "originalSha256": "cd6dcce3efac8421570e3a0947f308f42bf0b74d56f82a00296d187b0c96facf",
          "excerpt": "天復元年冬，太祖率師迎昭宗於鳳翔。時李茂貞遣大將符道昭領兵萬餘屯武功以拒，太祖命諸軍擊之，以懷英為前鋒，領眾先登，一鼓而大破之，擄甲士六千餘人，奪馬二千匹。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p6",
          "originalRevision": 1,
          "originalSha256": "5f3e9d2afac293589b386daebe1e03c7d62fc54d5ed5917e93a18cf3aea7db1c",
          "excerpt": "是時，岐人遣大將符道昭領兵萬人屯於武功以拒帝，帝遣康懷英敗之，擄甲士六千餘眾。"
        },
        {
          "chapterId": "tongjian-v262",
          "paragraphId": "tongjian-v262-p80",
          "originalRevision": 1,
          "originalSha256": "fd39d0156e8db318985ba236fd85938a2c7b41e4344554a63cf2f6f142ac76d4",
          "excerpt": "茂貞遣其將符道昭屯武功以拒全忠，癸亥，全忠將康懷貞擊破之。"
        },
        {
          "chapterId": "tongjian-v262",
          "paragraphId": "tongjian-v262-p36",
          "originalRevision": 1,
          "originalSha256": "604c4b75b92250bf685cdce4f3a1e264627ce6a9a632ad86b04a72fbc8edddfb",
          "excerpt": "昭宗聖穆景文孝皇帝中之中天復元年（辛酉，公元九零一年）"
        },
        {
          "chapterId": "tongjian-v262",
          "paragraphId": "tongjian-v262-p73",
          "originalRevision": 1,
          "originalSha256": "a97e31e84e0f3bf8a5b98f7e1c70d649338a4ca4ff0bb5dedbbeb41179e37a52",
          "excerpt": "十一月，己酉朔，李繼筠等勒兵闕下，禁人出入，諸軍大掠。"
        }
      ],
      "notes": [
        "康怀英本名怀贞，旧传明言因避末帝名而改名；各书原称分别保留。",
        "本页西历年份沿历史历制，1582年前采用儒略历；《通鉴》此日对应儒略历901年12月28日。"
      ]
    },
    {
      "id": "fu-daozhao-guoxian-hangu-battle",
      "title": "驻虢县汉谷，越涧挑战后败于伏兵",
      "summary": "符道昭率军驻虢县汉谷，营地前临大涧、后倚高地。康怀英率骑进攻，符道昭轻其兵少，率甲士越涧挑战；康先以千骑夜战，再发伏兵，岐军大败。",
      "year": 902,
      "sortOrder": 0,
      "precision": "month",
      "sourceDate": "天复二年四月，未独记战日",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p19",
          "originalRevision": 1,
          "originalSha256": "78f34fe5092f40b215d826e478514cc3fab27b9db94872a6eaa2263d4e31b86b",
          "excerpt": "二年四月，符道昭復領大軍屯於虢縣之漢穀。其建寨之所，前臨巨澗，後倚峻阜，險不可升，太祖遣懷英提騎數千急擊之。道昭以懷英兵寡，有俯視之意，乃率甲士萬人，絕澗以挑戰。懷英始以千騎夜鬥，戰酣，發伏以擊之，岐軍大敗。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p7",
          "originalRevision": 1,
          "originalSha256": "8d5d6e47608c0c72a6add6c193177909151c93c2b8d0dbdfa43a4b43942ff434",
          "excerpt": "四月，岐人遣符道昭領大軍屯於虢縣，康懷英帥驍騎敗之。"
        },
        {
          "chapterId": "old-v023",
          "paragraphId": "old-v023-p18",
          "originalRevision": 1,
          "originalSha256": "cd6dcce3efac8421570e3a0947f308f42bf0b74d56f82a00296d187b0c96facf",
          "excerpt": "天復元年冬，太祖率師迎昭宗於鳳翔。"
        }
      ],
      "notes": [
        "与此前武功之战分列；旧本纪随后丁酉记崔允来见朱温，不作符道昭此战日期。其后未具名的奉天夜攻不归为符道昭行动。"
      ]
    },
    {
      "id": "fu-daozhao-join",
      "title": "昭宗返京后授秦州，赴任未成",
      "summary": "唐昭宗返回长安后，朱温奏授符道昭秦州节度使、同平章事，并遣兵护送，未能到镇；此前凤翔归附另列。",
      "year": 903,
      "sortOrder": 0,
      "precision": "year",
      "sourceDate": "昭宗反正后；本传未记确月",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p8",
          "originalRevision": 1,
          "originalSha256": "a77c1b728398c04345a43ff9b05348f3dee467c05d0b9699cb8a4c775cc94c1a",
          "excerpt": "昭宗反正，奏授秦州節度使、同平章事，遣兵援送，不克而還。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p5",
          "originalRevision": 1,
          "originalSha256": "41a52940f8000e80ae7659667497d9e24f380dc5ae9cf5c7e6bdf290f9225214",
          "excerpt": "天復元年正月乙酉朔，唐宰相崔允潛使人以帝密旨告于侍衛軍將孫德昭已下，令誅左右中尉劉季述、王仲先等，即時迎昭宗於東內，禦樓反正。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p9",
          "originalRevision": 1,
          "originalSha256": "02e93c9c73878385510e35b646505e0165e8d0e37d0c092e09524b42625d1866",
          "excerpt": "三年正月甲寅，岐人啟壁"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p9",
          "originalRevision": 1,
          "originalSha256": "02e93c9c73878385510e35b646505e0165e8d0e37d0c092e09524b42625d1866",
          "excerpt": "己巳，昭宗至長安，謁太廟，禦長樂樓。"
        }
      ],
      "notes": [
        "旧本纪天复元年正月只作天复纪年起点；此处本传昭宗反正按凤翔回京的903年语境，与901年废复位不是同一事件。"
      ]
    },
    {
      "id": "fu-daozhao-weibo",
      "title": "参与平魏博牙军后诸乱",
      "summary": "魏博牙军被诛后，符道昭协李周彝、寇彦卿等攻历亭、高唐，擒左行迁、史仁遇，继取澶博。旧传记诸军杀四万余，继取澶博又杀万余，作为联军动作呈现。",
      "year": 906,
      "sortOrder": 1,
      "precision": "year",
      "sourceDate": "天祐三年魏博牙军事件，原传接叙未独记年",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v021",
          "paragraphId": "old-v021-p8",
          "originalRevision": 1,
          "originalSha256": "a77c1b728398c04345a43ff9b05348f3dee467c05d0b9699cb8a4c775cc94c1a",
          "excerpt": "及太祖幸魏州，討牙軍，中軍前有魏博將山河營指揮使左行遷，聞府中有變，引軍還屯曆亭，自稱留後，從亂者數萬人。道昭佐周彝與彥卿已下大破之，殺四萬餘人，擒左行遷，斬之。有史仁遇亦聚徒數萬據高唐，又破之，擒仁遇以獻。乘勝取澶、博二州，平之，復殺萬餘人。道昭性勇果，多率先犯陣，屢有摧失，而周彝、彥卿犄角繼進，連以捷告；護兵者上功不實，皆以道昭為首。"
        },
        {
          "chapterId": "new-v21",
          "paragraphId": "new-v21-p46",
          "originalRevision": 1,
          "originalSha256": "d6b93e70b9ebf93fa0a842b0d7ffcacf21d554a9ff8b4ea4644f5beb6764940a",
          "excerpt": "羅紹威將誅其牙兵，惡魏兵彊，未敢發，求梁為助。太祖乃悉發魏兵使攻燕，而遣馬嗣勳助紹威誅牙兵。牙兵已誅，魏兵在外者聞之皆亂，魏將左行遷據歷亭、史仁遇據高唐以叛，道昭等從太祖悉破之。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p16",
          "originalRevision": 1,
          "originalSha256": "b5f2552be4f80a240d09db7d014e7a1838688f00a2d2dfb662c588f98cffa3a1",
          "excerpt": "三年正月，幽、滄稱兵，將寇于魏。魏人來乞師，且以牙軍驕悍，謀欲誅之，遣親吏臧延范密告於帝，帝陰許之。乙丑，北征。先是，帝之愛女適羅氏，是月卒於鄴城，因以兵仗數千事實於橐中，遣客將馬嗣勳領長直軍千人，雜以工匠、丁夫，肩其橐而入于魏，聲言為帝女設祭，魏人信而不疑。庚午夜，嗣勳率其眾與羅紹威親軍數百人同攻牙軍，遲明盡殺之，死者七千餘人，泊於嬰孺，亦無留者。是日，帝次於內黃，聞之，馳騎至魏。"
        },
        {
          "chapterId": "old-v002",
          "paragraphId": "old-v002-p11",
          "originalRevision": 1,
          "originalSha256": "32fa7c031cb031759dde8e809fb32de857557ff9d3e39204388c1d6a85467a86",
          "excerpt": "天祐元年正月己酉，帝發自大梁，西赴河中，京師聞之，為之震懼。"
        }
      ],
      "variants": [
        {
          "label": "旧本纪的军队、人数与处分记载",
          "sourceDate": "天祐三年正月至四月本纪接叙",
          "year": 906,
          "summary": "旧本纪记朱温军追至历亭杀数千，继攻高唐，军民无少长皆杀，生擒史仁遇后由朱温命支解；旧符传则记诸军历亭杀四万余、继取澶博又杀万余。各书人数与动作范围分别保留。",
          "notes": [
            "不把马嗣勋与罗绍威诛牙军写成符道昭亲为，不将各书数字求和为唯一战果。"
          ],
          "evidence": [
            {
              "chapterId": "old-v002",
              "paragraphId": "old-v002-p16",
              "originalRevision": 1,
              "originalSha256": "b5f2552be4f80a240d09db7d014e7a1838688f00a2d2dfb662c588f98cffa3a1",
              "excerpt": "時魏之大軍方與帝軍同伐滄州，聞牙軍之死，即時奔還。帝之軍追及曆亭，殺賊幾千，餘眾乃擁大將史仁遇保于高唐，帝遣兵圍之。"
            },
            {
              "chapterId": "old-v002",
              "paragraphId": "old-v002-p17",
              "originalRevision": 1,
              "originalSha256": "dc9cb1567e5a0c4558dc925f423c664aefd278556129aeb66992e33d60c026e8",
              "excerpt": "四月癸未，攻下高唐，軍民無少長皆殺之，生擒逆首史仁遇以獻，帝命支解之。未幾，又攻下澶、博、貝、衛等州，皆為魏軍殘黨所據故也。"
            }
          ]
        }
      ]
    },
    {
