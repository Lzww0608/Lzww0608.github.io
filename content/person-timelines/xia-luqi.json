  "events": [
    {
      "id": "xia-luqi-capture-yanzhang",
      "title": "中都单骑擒王彦章",
      "summary": "梁军败于中都，夏鲁奇认出旧识王彦章，单骑追及以枪制其颈，将其生擒，获赏绢千匹。",
      "year": 923,
      "sortOrder": 1,
      "precision": "month",
      "sourceDate": "中都之战；本纪同光元年十月甲戌同役擒王彦章",
      "phase": "service",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p3",
          "originalRevision": 1,
          "originalSha256": "3dd38c7646dd8015c22c6e09ed369cd0793d57b677dddf48698fecc611f91756",
          "excerpt": "中都之戰，汴人大敗，魯奇見王彥章，識之，單馬追及，槍擬其頸；彥章顧曰：「爾非餘故人乎？」即擒之以獻。"
        },
        {
          "chapterId": "old-v030",
          "paragraphId": "old-v030-p1",
          "originalRevision": 1,
          "originalSha256": "d71abe0cfc4af07b1afc1ad247ec5234a457dc79fcd44f697d561707641d8850",
          "excerpt": "同光元年冬十月辛未朔，日有食之。"
        },
        {
          "chapterId": "old-v030",
          "paragraphId": "old-v030-p1",
          "originalRevision": 1,
          "originalSha256": "d71abe0cfc4af07b1afc1ad247ec5234a457dc79fcd44f697d561707641d8850",
          "excerpt": "甲戌，帝攻之，中都素無城守，師既雲合，梁眾自潰。是日，擒梁將王彥章及都監張漢傑、趙廷隱、劉嗣彬、李知節、康文通、王山興等將吏二百餘人，斬馘二萬，奪馬千匹。"
        }
      ]
    },
    {
      "id": "xia-luqi-zhengzhou",
      "title": "平梁后任郑州防御使",
      "summary": "后梁平定后任郑州防御使。",
      "year": 924,
      "sortOrder": 2,
      "precision": "month",
      "sourceDate": "梁平后；本纪同光二年二月戊子任郑州防御使（赐名李绍奇）",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p3",
          "originalRevision": 1,
          "originalSha256": "3dd38c7646dd8015c22c6e09ed369cd0793d57b677dddf48698fecc611f91756",
          "excerpt": "梁平，授鄭州防禦使。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p1",
          "originalRevision": 1,
          "originalSha256": "56aeec50377f2b2ccf3e459c7bfe207e6f01c8817e3bd6c9000b7f3148a86eed",
          "excerpt": "同光二年春正月庚子朔，帝御明堂殿受朝賀，仗衛如式。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p4",
          "originalRevision": 1,
          "originalSha256": "61420c0d8dbbc98df3e1b7651e586890a749590c2f264f0e8f4a68bdc42d47a9",
          "excerpt": "二月己巳朔，親祀昊天上帝於圜丘，禮畢，宰臣率百官就次稱賀，還禦五鳳樓。"
        },
        {
          "chapterId": "old-v031",
          "paragraphId": "old-v031-p7",
          "originalRevision": 1,
          "originalSha256": "07a70d00c64c7eea09777dfa72d1589e161e4e25701afe15d8b0da96124a15ce",
          "excerpt": "戊子，以前右龍武軍都虞候、守左龍武大將軍李紹奇為鄭州防禦使，"
        }
      ]
    },
    {
      "id": "xia-luqi-heyang",
      "title": "同光四年授河阳节度",
      "summary": "同光四年由郑州防御使升任河阳节度使。迁许州及百姓请留的后续记载未独记年，保留在年代未定部分。",
      "year": 926,
      "sortOrder": 3,
      "precision": "year",
      "sourceDate": "同光四年",
      "phase": "later",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p3",
          "originalRevision": 1,
          "originalSha256": "3dd38c7646dd8015c22c6e09ed369cd0793d57b677dddf48698fecc611f91756",
          "excerpt": "四年，授河陽節度使。"
        }
      ]
    },
    {
      "id": "xia-luqi-death-suizhou",
      "title": "遂州被围，兵食尽而自刎",
      "summary": "孟知祥、董璋攻遂州，援路断绝，兵食耗尽，夏鲁奇自刎。通鉴明确正月庚午由李仁罕陷遂州；旧史记四十九岁、朝廷厚给家属并赠太师、齐国公。",
      "year": 931,
      "sortOrder": 4,
      "precision": "day",
      "sourceDate": "长兴二年正月庚午（《通鉴》）",
      "phase": "fall",
      "evidence": [
        {
          "chapterId": "old-v070",
          "paragraphId": "old-v070-p4",
          "originalRevision": 1,
          "originalSha256": "924f62a4689290d8d602d1a32c2c64878ca244ec08d702761af22158f4f043ef",
          "excerpt": "董璋之叛，與孟知祥攻遂州，援路斷絕，兵盡食窮，〈（《九國誌·李肇傳》：蜀師圍夏魯奇於遂州，唐師來援，劍門不守，肇領兵赴普安以拒之，唐師不得進。）〉魯奇自刎而卒，時年四十九。帝聞其死也，慟哭之，厚給其家，贈太師、齊國公。"
        },
        {
          "chapterId": "tongjian-v277",
          "paragraphId": "tongjian-v277-p59",
          "originalRevision": 1,
          "originalSha256": "6f4cbdc55ce99afa81550cf7df346b6dbfb52ee01e89159eb139dd371896e12a",
          "excerpt": "明宗聖德和武欽孝皇帝中之下長興二年（辛卯，公元九三一年）"
        },
        {
          "chapterId": "tongjian-v277",
          "paragraphId": "tongjian-v277-p60",
          "originalRevision": 1,
          "originalSha256": "a5c35de4127fec60239f13f5c620bc6ab4cb1c65fd4ffa14ac8f7226d4799190",
          "excerpt": "春，正月，壬戌，孟知祥奉表謝。"
        },
        {
          "chapterId": "tongjian-v277",
          "paragraphId": "tongjian-v277-p61",
          "originalRevision": 1,
          "originalSha256": "ff436a2add7b97dd11663f6ab956bbf7588be9baeb2c81593e8e42951a4ab77c",
          "excerpt": "庚午，李仁罕陷遂州，夏魯奇自殺。"
        }
      ]
    },
    {
