      "title": "从周德威攻幽州，与燕勇将交战",
      "summary": "随周德威攻幽州，与单廷珪、元行钦搏斗相持，平幽州时立功。",
      "year": null,
      "sortOrder": 6,
      "precision": "undated",
      "sourceDate": "攻幽州期间，原传未列具体战年",
      "phase": "uncertain",
      "evidence": [
        {
