      "translation": {
        "id": "66",
        "text": "癸丑年，广顺三年正月，将户部管理的田地赐给百姓。三月，诛杀王峻。六月，发生大水。十二月，诛杀王殷。",
        "origin": "ai",
        "version": 1,
        "language": "zh-Hans",
        "translator": "Codex（AI 初译，待人工修订）",
        "reviewNotes": [],
        "reviewStatus": "pending"
