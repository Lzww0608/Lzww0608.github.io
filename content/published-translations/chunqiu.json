      "translation": {
        "id": "3",
        "text": "后梁太祖（朱温）",
        "origin": "ai",
        "version": 1,
        "language": "zh-Hans",
        "translator": "Codex（AI 初译，待人工修订）",
        "reviewNotes": [],
