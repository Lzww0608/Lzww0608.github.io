      "originalRevision": 1,
      "parentTranslationId": "6834",
      "parentTranslationSha256": "4e5cf850ab431c708ab69be9e26cc4899a0ce1ba1af1e3923b3a66f1c31eff30",
      "parentTranslationVersion": 1
    },
    {
      "id": "sentence-old-v118-p3-u38-v1",
      "text": "庚戌，诏已故淮南节度使杨行密、已故升府节度使徐温各给守墓户，江南臣僚祖墓在江北的，当地长官派人查看保护。",
      "origin": "ai",
      "version": 1,
      "textSha256": "6d536aea761bdec44a6cbe2a2c6e6d7ba6d125951b5dea12457aea0c8141359d",
      "originalEnd": 1384,
      "paragraphId": "old-v118-p3",
      "reviewNotes": [],
      "humanReviewed": false,
      "originalStart": 1328,
