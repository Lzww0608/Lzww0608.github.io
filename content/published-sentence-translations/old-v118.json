      "originalRevision": 1,
      "parentTranslationId": "6834",
      "parentTranslationSha256": "4e5cf850ab431c708ab69be9e26cc4899a0ce1ba1af1e3923b3a66f1c31eff30",
      "parentTranslationVersion": 1
    },
    {
      "id": "sentence-old-v118-p3-u34-v1",
      "text": "甲辰，任右龙武统军赵赞为庐州节度使，殿前都虞候慕容延钊为淮南节度使兼殿前副指挥使。",
      "origin": "ai",
      "version": 1,
      "textSha256": "d032c646a5903cd4c89884314fb761e92e06f1d475bd1022a9d1e4e11406417f",
      "originalEnd": 1232,
      "paragraphId": "old-v118-p3",
      "reviewNotes": [],
      "humanReviewed": false,
      "originalStart": 1190,
