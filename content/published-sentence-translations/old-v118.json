      "originalRevision": 1,
      "parentTranslationId": "6834",
      "parentTranslationSha256": "4e5cf850ab431c708ab69be9e26cc4899a0ce1ba1af1e3923b3a66f1c31eff30",
      "parentTranslationVersion": 1
    },
    {
      "id": "sentence-old-v118-p3-u37-v1",
      "text": "丙午，李景派宰相冯延巳献劳军银十万两、绢十万匹、钱十万贯、茶五十万斤、米麦二十万石。",
      "origin": "ai",
      "version": 1,
      "textSha256": "fc43e24c169c5931ee2a16783c00d0645393de9c46ec4f7159bbc24615ed38c2",
      "originalEnd": 1328,
      "paragraphId": "old-v118-p3",
      "reviewNotes": [],
      "humanReviewed": false,
