      "originalRevision": 1,
      "parentTranslationId": "6834",
      "parentTranslationSha256": "4e5cf850ab431c708ab69be9e26cc4899a0ce1ba1af1e3923b3a66f1c31eff30",
      "parentTranslationVersion": 1
    },
    {
      "id": "sentence-old-v118-p3-u35-v1",
      "text": "派盐城监使申屠谔送信、御马十匹，配全金银马具，以及普通马四十、羊一千，赐李景。",
      "origin": "ai",
      "version": 1,
      "textSha256": "c2fe295f84f9d94539949225621a0df491a0a05cd939873ca2b585b409e8883e",
      "originalEnd": 1270,
      "paragraphId": "old-v118-p3",
      "reviewNotes": [],
      "humanReviewed": false,
      "originalStart": 1232,
      "originalSha256": "b6779ae162f91a69e2d0d2a95961ee80b88356abaf5455445a99084e6ada509c",
      "originalRevision": 1,
      "parentTranslationId": "6834",
      "parentTranslationSha256": "4e5cf850ab431c708ab69be9e26cc4899a0ce1ba1af1e3923b3a66f1c31eff30",
      "parentTranslationVersion": 1
    },
    {
      "id": "sentence-old-v118-p3-u36-v1",
      "text": "申屠谔先被王师俘，故派他。",
      "origin": "ai",
      "version": 1,
      "textSha256": "7ec54aaf52ac55e8e30f59cf2d3da9190c78bfaa2915d42645fd87ef6076b817",
      "originalEnd": 1282,
      "paragraphId": "old-v118-p3",
      "reviewNotes": [],
      "humanReviewed": false,
