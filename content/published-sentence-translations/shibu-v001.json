      "parentTranslationVersion": 1
    },
    {
      "id": "sentence-shibu-v001-p42-u4-v1",
      "text": "“上天嫌我的脸还不够端正，就替我的面孔装点花纹。”",
      "origin": "ai",
      "version": 1,
      "textSha256": "d43ccb828d27ee52960a3d51723d01351d97946be785af224f824a41fe98d388",
