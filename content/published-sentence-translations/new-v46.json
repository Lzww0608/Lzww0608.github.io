      "parentTranslationSha256": "73f009b02ca2905927c42431156125dade4bc10f2d0f02f95c286a42a14f4ea9",
      "parentTranslationVersion": 1
    },
    {
      "id": "sentence-new-v46-p23-u6-v1",
      "text": "（接前句）担任该州的刺史。",
      "origin": "ai",
