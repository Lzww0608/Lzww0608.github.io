        },
        {
          "sourceId": "tongjian-v270-p66",
          "excerpt": "甲子，晉王進攻濮陽，拔之。"
        },
        {
          "sourceId": "tongjian-v270-p68",
          "excerpt": "晉軍至德勝渡"
        },
        {
          "sourceId": "old-v029-p1",
          "excerpt": "天祐十六年春正月，李存審城德勝，夾河為柵。帝還魏州"
        },
        {
          "sourceId": "old-v029-p1",
          "excerpt": "三月，帝兼領幽州，遣近臣李紹宏提舉府事。"
        },
        {
          "sourceId": "old-v052-p10",
          "excerpt": "九月，以李紹宏代"
        },
        {
          "sourceId": "old-v056-p18",
          "excerpt": "七月，汴將王瓚自黎陽渡河寇澶州"
        },
        {
          "sourceId": "new-v25-p33",
          "excerpt": "梁將賀瓌攻其南城，以竹笮維戰艦于河"
        }
      ]
    }
  ]
}
