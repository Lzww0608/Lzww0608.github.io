  "differences": [
    {
      "id": "jinyang-battle-and-report",
      "title": "辛丑交战与甲辰奏报，不能混为一日",
      "stageId": "relief",
      "kind": "dating",
      "summary": "旧史唐纪明确“九月甲辰”是奏报，所报交战在本月十五日；旧史晋纪与《通鉴》把交战记在辛丑，《通鉴》又另记甲辰告败。新史唐纪则直接在甲辰下书交战败绩，保存这项纪日差别，不把新史的甲辰自动解释成奏报日。",
      "evidence": [
        {
          "sourceId": "old-v048-p11",
          "excerpt": "九月甲辰，張敬達奏，此月十五日，與契丹戰於太原城下，王師敗績。"
        },
        {
          "sourceId": "old-v075-p15",
          "excerpt": "九月辛丑，契丹主率眾自雁門而南"
        },
        {
          "sourceId": "tongjian-v280-p31",
          "excerpt": "辛丑，契丹主至晉陽，陳於汾北之虎北口。"
        },
        {
          "sourceId": "tongjian-v280-p31",
          "excerpt": "甲辰，敬達遣使告敗於唐，自是聲問不復通。"
        },
        {
          "sourceId": "new-v07-p10",
          "excerpt": "九月甲辰，張敬達及契丹戰于太原，敗績，契丹圍敬達于晉安。"
        }
      ]
    },
    {
      "id": "jinyang-accession-order",
      "title": "册立与晋安受降，各纪叙次有别",
      "stageId": "foundation",
      "kind": "dating",
      "summary": "旧史唐纪在闰十一月甲子杀张敬达、降军之后，接写丁卯册立。旧史晋纪册文却署正十一月十二日丁酉，新史两纪也记十一月丁酉，而晋安杀降另在闰月甲子。保留册立日期及先后次序的不同，不把闰月丁卯与正十一月丁酉视作同一天。",
      "evidence": [
        {
          "sourceId": "old-v048-p14",
          "excerpt": "甲子，太原行營副招討使楊光遠殺招討使張敬達於晉安寨，以兵降契丹。"
        },
        {
          "sourceId": "old-v048-p14",
          "excerpt": "丁卯，戎王立石敬瑭為大晉皇帝，約為父子之國，改元為天福。"
        },
        {
          "sourceId": "old-v075-p17",
          "excerpt": "十一月丙戌朔，十二日丁酉"
        },
        {
          "sourceId": "new-v07-p10",
          "excerpt": "丁酉，契丹立晉。閏月甲子，楊光遠殺張敬達，以其軍叛降于契丹。"
        },
        {
          "sourceId": "new-v08-p6",
          "excerpt": "十一月丁酉，皇帝即位"
        },
        {
          "sourceId": "old-v076-p2",
          "excerpt": "閏十一月甲子，晉安寨副招討使楊光遠等殺上將張敬達，以諸軍來降。"
        }
      ]
    },
    {
      "id": "jinyang-charter-era",
      "title": "册文的“天显九年”与夹注“十一年”并存",
      "stageId": "foundation",
      "kind": "dating",
      "summary": "旧史保存的册文原署“天显九年，岁次丙申”，同书前段所引《辽史太宗纪》却记“十一年”十一月丁酉。两处属于册文与后附引书的不同层次；不暗改底本年号数字，也不把这一夹注当成第四部独立完整战程。",
      "evidence": [
        {
          "sourceId": "old-v075-p17",
          "excerpt": "維天顯九年，歲次丙申，十一月丙戌朔，十二日丁酉"
        },
        {
          "sourceId": "old-v075-p16",
          "excerpt": "《遼史太宗紀》：十一年冬十月甲子，封敬瑭為晉王。十一月丁酉，冊敬瑭為大晉皇帝。"
        }
      ]
    },
    {
      "id": "jinyang-an-reinforcements",
      "title": "安重荣的归附月份与兵数分别保存",
      "stageId": "preparation",
      "kind": "conflict",
      "summary": "旧史唐纪把安重荣率五百骑归太原记在五月叙次，新史唐纪同样接于五月；旧史晋纪却写六月率部曲数千人入城。《通鉴》也记步骑五百。骑兵、步骑、部曲的口径及月份分别保留，安元信与安审信的另一组归附不混入安重荣的数字。",
      "evidence": [
        {
          "sourceId": "old-v048-p7",
          "excerpt": "己酉，振武節度使安叔千奏，西北界巡檢使安重榮驅掠戍兵五百騎叛入太原。"
        },
        {
          "sourceId": "new-v07-p10",
          "excerpt": "夏五月乙卯，建雄軍節度使張敬達為太原四面都招討使"
        },
        {
          "sourceId": "new-v07-p10",
          "excerpt": "己酉，振武戍將安重榮叛降于石敬瑭。"
        },
        {
          "sourceId": "old-v075-p14",
          "excerpt": "六月，北面招收指揮使安重榮以部曲數千人入城。"
        },
        {
          "sourceId": "tongjian-v280-p17",
          "excerpt": "振武西北巡檢使安重榮戍代北，帥步騎五百奔晉陽。"
        }
      ]
    },
    {
      "id": "jinyang-zhang-reinforcements",
      "title": "张万迪的五百骑与“等各千余骑”不是同一口径",
      "stageId": "preparation",
      "kind": "conflict",
      "summary": "旧史唐纪在七月写张万迪率五百骑归太原，新史唐纪也在七月记其叛降；旧史晋纪写八月张万迪等各率千余骑。《通鉴》另写张万迪率五百骑，并记诛其家。保留月份、是否合记多人及兵数的差别，不拿“等各”的数目直接作单人增减。",
      "evidence": [
        {
          "sourceId": "old-v048-p9",
          "excerpt": "彰聖指揮使張萬迪以部下五百騎叛入太原，詔誅家屬於懷州本營。"
        },
        {
          "sourceId": "new-v07-p10",
          "excerpt": "秋七月戊申，克魏州。壬子，張令昭伏誅。癸丑，彰聖指揮使張萬迪叛降于石敬瑭。"
        },
        {
          "sourceId": "old-v075-p14",
          "excerpt": "八月，懷州彰聖軍使張萬迪等各率千餘騎來降。"
        },
        {
