  "differences": [
    {
      "id": "baixiang-invading-force",
      "stageId": "preparation",
      "kind": "conflict",
      "title": "梁军人数：四万、七万、八万与十万",
      "summary": "《通鉴》记渡河会合罗周翰兵后“合四万”；旧史庄宗纪记审问俘虏所得“精兵七万”，周德威传作“八万”，王景仁传作获付“步骑十万”；新史周德威传作七万。另有晋方檄文自称敌十万。所计时点、对象与叙述载体不一，现有文本不足以合成唯一总兵力。",
      "evidence": [
        {
          "sourceId": "tongjian-v267-p116",
          "excerpt": "景仁等自河陽渡河，會羅周翰兵，合四萬"
        },
        {
          "sourceId": "old-v027-p17",
          "excerpt": "獲芻牧者二百人，問其兵數，精兵七萬"
        },
        {
          "sourceId": "old-v056-p6",
          "excerpt": "汴將王景仁軍八萬次柏鄉"
        },
        {
          "sourceId": "old-v023-p23",
          "excerpt": "付步騎十萬，為北面行營都招討使"
        },
        {
          "sourceId": "new-v25-p5",
          "excerpt": "梁遣王景仁將魏、滑、汴、宋等兵七萬人擊趙"
        },
        {
          "sourceId": "old-v027-p19",
          "excerpt": "賊將王景仁將兵十萬，屯據柏鄉"
        }
      ]
    },
    {
      "id": "baixiang-battle-day",
      "stageId": "battle",
      "kind": "dating",
      "title": "战日与日食：二日、丁亥、庚寅并存",
      "summary": "旧史庄宗纪和新史梁本纪记丁亥，旧史周德威传、梁太祖纪及《会要》记正月二日。《通鉴》把日食记在丙戌朔，战事记丁亥。新史王景仁传却记庚寅日食并称“是日”败于柏乡。旧史王景仁传还写“开平二年正月二日”，与其他篇纪年不同。原书及译文各自保留，不把相邻日食条自动当战日，也不暗改二年为五年。",
      "evidence": [
        {
          "sourceId": "old-v027-p18",
          "excerpt": "天祐八年正月丁亥"
        },
        {
          "sourceId": "new-v02-p42",
          "excerpt": "乾化元年春正月丁亥，王景仁及晉人戰于柏鄉，敗績"
        },
        {
          "sourceId": "old-v056-p7",
          "excerpt": "八年正月二日，德威率騎軍致師於柏鄉"
        },
        {
          "sourceId": "old-v006-p6",
          "excerpt": "二日，日旁有祲氣，向背若環耳。崇政使敬翔望之曰：「兵可憂矣！」帝為之旰食。是日，果為晉軍及鎮、定之師所敗"
        },
        {
          "sourceId": "huiyao-v010-p73",
          "excerpt": "至五年正月二日，果為後唐莊宗大敗于柏鄉"
        },
        {
          "sourceId": "tongjian-v267-p127",
          "excerpt": "春，正月，丙戌朔，日有食之"
        },
        {
          "sourceId": "tongjian-v267-p128",
          "excerpt": "丁亥，周德威與別將史建瑭、李嗣源將精騎三千壓梁壘門而詬之"
        },
        {
          "sourceId": "new-v23-p14",
          "excerpt": "乾化元年正月庚寅，日有食之"
        },
        {
          "sourceId": "new-v23-p14",
          "excerpt": "是日，景仁及晉人戰，大敗於柏鄉"
        },
        {
          "sourceId": "old-v023-p23",
          "excerpt": "開平二年正月二日，與晉軍戰於柏鄉，王師敗績"
        }
      ]
    },
    {
      "id": "baixiang-invasion-perspective",
      "stageId": "background",
      "kind": "perspective",
      "title": "同一出兵：梁纪称叛附，晋纪记救援",
      "summary": "旧史梁太祖纪和新史梁本纪把镇、定归晋写作“叛”，从梁方称臣关系解释出兵；旧史庄宗纪和《通鉴》展开梁军先占深、冀、王镕求援的背景。此处对照叙述立场与详略，不把一书没有展开的细节当作否认，也不把旧史夹注引《会要》当成另一份独立证据。",
      "evidence": [
        {
          "sourceId": "old-v006-p3",
          "excerpt": "時鎮州王镕、定州王處直叛，結連晉人，故遣將討之"
        },
        {
          "sourceId": "new-v02-p39",
          "excerpt": "趙王王鎔、北平王王處直叛附于晉，晉人救趙"
        },
        {
          "sourceId": "old-v027-p16",
          "excerpt": "因欲兼並鎮、定，遣供奉官杜廷隱、丁延徽督魏軍三千人入於深、冀，鎮人懼，故來告難"
        },
        {
          "sourceId": "tongjian-v267-p114",
          "excerpt": "聲言恐燕兵南寇，助趙守禦。又雲分兵就食"
        },
        {
          "sourceId": "tongjian-v267-p115",
          "excerpt": "廷隱等閉門盡殺趙戍兵，乘城拒守。鎔始命石公立攻之，不克，乃遣使求援於燕、晉"
        }
      ]
    },
    {
      "id": "baixiang-bridge-detail",
      "stageId": "battle",
      "kind": "detail",
      "title": "争桥细节在李建及本传与《通鉴》中补足",
      "summary": "旧史庄宗纪记梁军五百人争桥、镇定军反复血战；旧史李建及传、新史王建及传及《通鉴》补写晋王见守桥将败，命建及以二百人抵挡。王建及与李建及为同一人，在各书中保留原用名；这些补记并非本纪已明言否认的事。",
      "evidence": [
