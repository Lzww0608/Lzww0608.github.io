  {
    "id": "yougui-unknown-mother-son",
    "from": "liang-zhu-yougui-mother-unknown",
    "to": "zhu-yougui",
    "kind": "kinship",
    "label": "母子",
    "note": "失姓生母有明确传文；不从职业称谓推正式妃嫔名位。",
    "sources": [
      {
        "chapterId": "old-v012",
        "paragraphId": "old-v012-p11",
        "originalRevision": 1,
        "originalSha256": "02471d1f936f4e6f34494af69e0910043cf7f1fd96b20665a1ae8f2a7a373f19",
        "excerpt": "友珪，小字遙喜，母失其姓，本亳州營妓也。",
        "title": "《旧五代史》 · 卷 12 · 梁宗室传（含朱友珪）"
      },
      {
        "chapterId": "new-v13",
        "paragraphId": "new-v13-p45",
        "originalRevision": 1,
        "originalSha256": "cc889a04d0fff0014a3433a58d564d9e45971bb60d5d664a3ccb77ea23225d93",
        "excerpt": "庶人友珪者，太祖初鎮宣武，略地宋，亳間，與逆旅婦人野合而生也。",
        "title": "《新五代史》 · 卷 13 · 梁家人传（含朱友珪）"
      }
    ]
  },
  {
    "id": "zhu-wen-yougui-mother-summons",
    "from": "zhu-wen",
    "to": "liang-zhu-yougui-mother-unknown",
    "kind": "kinship",
    "label": "召侍与生子",
    "note": "旧史载朱温召侍、她告娠并报生男孩；此边不表示已正式婚配、册妃或返汴同行。",
    "sources": [
      {
        "chapterId": "old-v012",
        "paragraphId": "old-v012-p11",
        "originalRevision": 1,
        "originalSha256": "02471d1f936f4e6f34494af69e0910043cf7f1fd96b20665a1ae8f2a7a373f19",
        "excerpt": "唐光啟中，帝徇地亳州，召而侍寢。月餘，將舍之而去，以娠告。",
        "title": "《旧五代史》 · 卷 12 · 梁宗室传（含朱友珪）"
      },
      {
        "chapterId": "old-v012",
        "paragraphId": "old-v012-p11",
        "originalRevision": 1,
        "originalSha256": "02471d1f936f4e6f34494af69e0910043cf7f1fd96b20665a1ae8f2a7a373f19",
        "excerpt": "及期，妓以生男來告，帝喜，故字之曰遙喜。",
        "title": "《旧五代史》 · 卷 12 · 梁宗室传（含朱友珪）"
      }
    ]
  },
