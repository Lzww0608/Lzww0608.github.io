    "sources": [
      {
        "chapterId": "old-v063",
        "paragraphId": "old-v063-p6",
        "originalRevision": 1,
        "originalSha256": "a1894641c56b6efd24c182ad562f2fb33cb7c340d62db348bdbb583f11cb4aaa",
        "excerpt": "梁祖遂以其子福王納齊王之女。",
        "title": "《旧五代史》 · 卷 63 · 唐列传"
      },
      {
