{
  "id": "new-v03",
  "title": "卷 3 · 梁本纪第三",
  "position": 3,
  "scope": "full",
  "sourceUrl": "https://zh.wikisource.org/w/index.php?title=%E6%96%B0%E4%BA%94%E4%BB%A3%E5%8F%B2%2F%E5%8D%B703&oldid=2312022",
